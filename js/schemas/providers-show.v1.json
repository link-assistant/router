                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "exit_code": {
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "operation": {
      "const": "providers.show"
    },
    "schema": {
      "const": "link-assistant-router/providers-show/v1"
    },
    "success": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "operation",
    "success",
    "exit_code",
    "data",
    "diagnostics"
  ],
  "type": "object"
