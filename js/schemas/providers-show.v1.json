            "string",
            "null"
          ]
        },
        "base_url": {
          "type": "string"
        },
        "default_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "has_encrypted_api_key": {
          "type": "boolean"
        },
        "intermediary_risk_acknowledged": {
          "type": "boolean"
        },
        "kind": {
