{
  "name": "@link-assistant/router",
  "version": "1.25.7",
  "description": "Official typed Router operations and testing helpers for Node and Bun",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "import": "./testing.js"
    },
    "./native": {
      "types": "./native.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "catalog.json",
    "schemas",
    "README.md",
    "src",
    "runtime",
    "portable"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit --strict --module nodenext --moduleResolution nodenext test/types.ts",
    "native:test": "node --test test/native-*.test.*",
    "native:test:bun": "bun test test/native-*.test.*",
    "native:typecheck": "node node_modules/typescript-native/bin/tsc --noEmit --strict --module nodenext --moduleResolution nodenext test/native-types.ts"
  },
  "dependencies": {
    "@iarna/toml": "3.0.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "5.9.3",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/link-assistant/router.git",
    "directory": "js"
  },
  "license": "Unlicense",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "router-native": "src/cli.mjs"
  }
}
