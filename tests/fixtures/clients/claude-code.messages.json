{
  "client": "claude-code",
  "version": "2.1.259",
  "source": "the Anthropic Messages shape Claude Code sends; the router's primary surface",
  "method": "POST",
  "path": "/api/services/anthropic/v1/messages",
  "credential_carrier": "authorization",
  "expected_surface": "anthropic",
  "headers": {
    "content-type": "application/json",
    "anthropic-version": "2023-06-01",
    "user-agent": "claude-cli/2.1.259"
  },
  "body": {
    "model": "{model}",
    "max_tokens": 16,
    "messages": [{"role": "user", "content": "ping"}]
  }
}
