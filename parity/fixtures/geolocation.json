                    "city": "London"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "requests": [
          {
            "custom_id": "one",
            "params": {
              "tools": [
                {
                  "type": "web_search_20260209"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "User content and schemas",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": "Find London and latitude 51.5"
          }
        ],
        "metadata": {
          "location": "keep"
        },
        "tools": [
          {
            "type": "function",
            "name": "web_search",
            "user_location": "application value",
            "parameters": {
              "properties": {
                "location": {
                  "type": "string"
                },
                "user_location": {
                  "type": "object"
                }
              }
            }
          }
        ]
      },
      "expected": {
        "messages": [
          {
            "role": "user",
            "content": "Find London and latitude 51.5"
          }
        ],
        "metadata": {
          "location": "keep"
        },
        "tools": [
          {
            "type": "function",
            "name": "web_search",
            "user_location": "application value",
            "parameters": {
              "properties": {
                "location": {
                  "type": "string"
                },
                "user_location": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "Malformed optional containers",
      "input": {
        "tools": [
          null,
          1,
          {},
          []
        ],
        "toolConfig": null,
        "web_search_options": []
      },
      "expected": {
        "tools": [
          null,
          1,
          {},
          []
        ],
        "toolConfig": null,
        "web_search_options": []
      }
    },
    {
      "name": "Malformed search tool types stay unchanged",
      "input": {
        "tools": [
          {
            "type": [
              "web_search"
            ],
            "user_location": {
              "city": "London"
            }
          },
          {
            "type": {
              "toString": "web_search"
            },
            "user_location": {
              "city": "London"
            }
          },
          {
            "type": 7,
            "user_location": {
              "city": "London"
            }
          }
        ]
      },
      "expected": {
        "tools": [
          {
            "type": [
              "web_search"
            ],
            "user_location": {
              "city": "London"
            }
          },
          {
            "type": {
              "toString": "web_search"
            },
            "user_location": {
              "city": "London"
            }
          },
          {
            "type": 7,
            "user_location": {
              "city": "London"
            }
          }
        ]
      }
