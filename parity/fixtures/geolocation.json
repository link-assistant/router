  "bodies": [
    {
      "name": "Responses search",
      "input": {
        "model": "alias",
        "tools": [
          {
            "type": "web_search",
            "user_location": {
              "type": "approximate",
              "city": "London",
              "country": "GB",
              "timezone": "Europe/London"
            },
            "search_context_size": "low"
          }
        ]
      },
      "expected": {
        "model": "alias",
        "tools": [
          {
            "type": "web_search",
            "search_context_size": "low"
          }
        ]
      }
    },
    {
      "name": "Responses preview",
      "input": {
        "tools": [
          {
            "type": "web_search_preview_2025",
            "user_location": {
              "city": "keep unsupported tool"
            }
          },
          {
            "type": "web_search_preview_20250311",
            "user_location": {
              "city": "London"
            }
          }
        ]
      },
      "expected": {
        "tools": [
          {
            "type": "web_search_preview_2025",
            "user_location": {
              "city": "keep unsupported tool"
            }
          },
          {
            "type": "web_search_preview_20250311"
          }
        ]
      }
    },
    {
      "name": "OpenAI dated preview",
      "input": {
        "tools": [
          {
            "type": "web_search_preview_2025_03_11",
            "user_location": {
              "city": "London"
            }
          }
        ]
      },
      "expected": {
        "tools": [
          {
            "type": "web_search_preview_2025_03_11"
          }
        ]
      }
    },
    {
      "name": "Anthropic search",
      "input": {
        "tools": [
          {
            "type": "web_search_20250305",
            "name": "web_search",
            "user_location": {
              "city": "London"
            },
            "max_uses": 2
          }
        ]
      },
      "expected": {
        "tools": [
          {
            "type": "web_search_20250305",
            "name": "web_search",
            "max_uses": 2
          }
        ]
      }
    },
    {
      "name": "Chat search",
      "input": {
        "web_search_options": {
          "user_location": {
            "approximate": {
              "city": "London"
            }
          },
          "search_context_size": "medium"
        }
      },
      "expected": {
        "web_search_options": {
          "search_context_size": "medium"
        }
      }
    },
    {
      "name": "Gemini Maps",
      "input": {
        "toolConfig": {
          "retrievalConfig": {
            "latLng": {
              "latitude": 51.5,
              "longitude": -0.1
            },
            "languageCode": "en"
          }
        }
      },
      "expected": {
        "toolConfig": {
          "retrievalConfig": {
            "languageCode": "en"
          }
        }
      }
    },
    {
      "name": "Gemini snake case",
      "input": {
        "tool_config": {
          "retrieval_config": {
            "lat_lng": {
              "latitude": 51.5
            }
          }
        }
      },
      "expected": {
        "tool_config": {
          "retrieval_config": {}
        }
      }
    },
    {
