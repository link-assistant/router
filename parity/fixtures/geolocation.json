      "input": {
        "type": "session.update",
        "session": {
          "tools": [
            {
              "type": "web_search",
              "user_location": {
                "city": "London"
              }
            }
          ]
        }
      },
      "expected": {
        "type": "session.update",
        "session": {
          "tools": [
            {
              "type": "web_search"
            }
          ]
        }
      }
    },
    {
      "name": "Anthropic batches",
      "input": {
        "requests": [
          {
            "custom_id": "one",
