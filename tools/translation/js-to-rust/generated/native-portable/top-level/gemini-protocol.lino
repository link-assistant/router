8current%29.root%29%20return%20stat%3Bcurrent=dirname%28current%29%3B%5Cn%20%20%7D%5Cn%7D%5Cnexport%20async%20function%20readNativeText%28path%2C%7Bcwd=process.cwd%28%29%2CmaxBytes=64*1024*1024%7D=%7B%7D%29%20%7B%5Cn%20%20path=resolve%28cwd%2Cpath%29%3Bawait%20requireNativePath%28path%29%3Bconst%20file=await%20open%28path%2Cconstants.O_RDONLY%20|%20%28constants.O_NOFOLLOW%20%3F%3F%200%29%29%3B%5Cn%20%20try%20%7B%5Cn%20%20%20%20const%20stat=await%20file.stat%28%29%3Bif%20%28!stat.isFile%28%29%20||%20stat.size>maxBytes%29%20throw%20fail%28%27Operation%20input%20requires%20a%20regular%20file%20within%20its%20byte%20budget%27%29%3B%5Cn%20%20%20%20const%20chunks=%5B%5D%3Blet%20bytes=0%3B%5Cn%20%20%20%20while%20%28true%29%20%7Bconst%20buffer=Buffer.alloc%28Math.min%2865536%2CmaxBytes-bytes+1%29%29%2Cpart=await%20file.read%28buffer%2C0%2Cbuffer.length%2Cnull%29%3Bif%20%28!part.bytesRead%29%20break%3Bbytes+=part.bytesRead%3Bif%20%28bytes>maxBytes%29%20throw%20fail%28%27Operation%20input%20exceeds%20its%20byte%20budget%27%29%3Bchunks.push%28buffer.subarray%280%2Cpart.bytesRead%29%29%3B%7D%5Cn%20%20%20%20return%20new%20TextDecoder%28%27utf-8%27%2C%7Bfatal%3Atrue%2CignoreBOM%3Atrue%7D%29.decode%28Buffer.concat%28chunks%2Cbytes%29%29%3B%5Cn%20%20%7D%20finally%20%7Bawait%20file.close%28%29%3B%7D%5Cn%7D%5Cn%22%7D%2C%7B%22path%22%3A%22js/src/operations.mjs%22%2C%22source%22%3A%22/**%20Native%20operation%20dispatcher.%20This%20module%20never%20resolves%20or%20spawns%20a%20Rust%20executable.%20*/%5Cnimport%20%7B%20readFileSync%20%7D%20from%20%27node%3Afs%27%3B%5Cnimport%20%7BexecuteCredentialOperation%2CcredentialWithdrawal%7D%20from%20%27./credential-operations.mjs%27%3B%5Cnimport%20%7BreadNativeText%7D%20from%20%27./operation-input.mjs%27%3B%5Cnimport%20%7BreadTokenImportSource%2CimportTokenRecords%7D%20from%20%27./token-import.mjs%27%3B%5Cnimport%20%7B%20executeResourceOperation%2C%20supportedResourceOperations%20%7D%20from%20%27./resources.mjs%27%3B%5Cnimport%20%7B%20executeAuth