  {
    "name": "Unicode prefix and suffix Option values",
    "source": "pub fn prefix(s: &'static str, pattern: &str) -> Option<&'static str> { s.strip_prefix(pattern) } pub fn suffix(s: &'static str, pattern: &str) -> Option<&'static str> { s.strip_suffix(pattern) } pub fn fallback(s: &str) -> String { s.strip_prefix(\"pre-\").unwrap_or(\"missing\").to_string() }",
