      {
        "name": "prefix",
        "args": [
          "\ud83d\ude00\u00e9",
          "\ud83d\ude00"
        ],
        "expected": {
          "$": "Some",
          "field0": "\u00e9"
        }
      },
      {
        "name": "suffix",
        "args": [
          "\u00e9\ud83d\ude00",
          "\ud83d\ude00"
        ],
        "expected": {
          "$": "Some",
          "field0": "\u00e9"
        }
      },
      {
        "name": "suffix",
        "args": [
          "\u00e9\ud83d\ude00",
          ""
        ],
        "expected": {
          "$": "Some",
          "field0": "\u00e9\ud83d\ude00"
        }
      },
      {
        "name": "prefix",
        "args": [
          "abc",
          "z"
        ],
        "expected": {
          "$": "None"
        }
      },
      {
        "name": "fallback",
        "args": [
          "pre-value"
        ],
        "expected": "value"
      },
      {
        "name": "fallback",
        "args": [
          "value"
        ],
        "expected": "missing"
      }
    ]
  },
