      {
        "name": "quota",
        "args": [
          "12n",
          "20n"
        ],
        "expected": "8n"
      },
      {
        "name": "quota",
        "args": [
          "25n",
          "20n"
        ],
        "expected": "0n"
      }
    ]
  },
