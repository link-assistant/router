        "originalText": "pub fn is_lazy(&self) -> bool {\n        matches!(self, BinOpKind::And | BinOpKind::Or)\n    }"
      },
      {
        "signature": "pub fn precedence(&self)",
        "span": {
          "start": 30875,
          "end": 31417,
          "unit": "utf16"
        },
        "sha256": "6e5f50993d06b81c49812c4b1911e8b965dbb2b73aece4ddb070824b0bf0e61c",
        "originalText": "pub fn precedence(&self) -> ExprPrecedence {\n        use BinOpKind::*;\n        match *self {\n            Mul | Div | Rem => ExprPrecedence::Product,\n            Add | Sub => ExprPrecedence::Sum,\n            Shl | Shr => ExprPrecedence::Shift,\n            BitAnd => ExprPrecedence::BitAnd,\n            BitXor => ExprPrecedence::BitXor,\n            BitOr => ExprPrecedence::BitOr,\n            Lt | Gt | Le | Ge | Eq | Ne => ExprPrecedence::Compare,\n            And => ExprPrecedence::LAnd,\n            Or => ExprPrecedence::LOr,\n        }\n    }"
      },
      {
        "signature": "pub fn fixity(&self)",
        "span": {
          "start": 31423,
          "end": 31712,
          "unit": "utf16"
        },
        "sha256": "e9553f4a959262176dc1ff609618489efd2e372be606df2512587cf9a67ab8ed",
        "originalText": "pub fn fixity(&self) -> Fixity {\n        use BinOpKind::*;\n        match self {\n            Eq | Ne | Lt | Le | Gt | Ge => Fixity::None,\n            Add | Sub | Mul | Div | Rem | And | Or | BitXor | BitAnd | BitOr | Shl | Shr => {\n                Fixity::Left\n            }\n        }\n    }"
      }
    ],
