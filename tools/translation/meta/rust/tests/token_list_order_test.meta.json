sume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":441,"unit":"utf16","byteStart":0,"byteEnd":441},"sha256":"daf8dc39881de5119e736fd9b1406be14a234226bc0044e4ee310b5a9150b7c6","source":"//! Regression coverage for issue #618: `tokens list` has one stable order.\n//!\n//! Every token store keeps its records in a `HashMap`, whose iteration order\n//! is seeded per process. Two `router tokens list --json` runs over the same\n//! store therefore printed the same records in different orders, and the\n//! rolling-update test's byte comparison of the old backend's list with its\n//! successor's failed although nothing had changed.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"link_assistant_router","span":{"start":441,"end":488,"unit":"utf16","byteStart":441,"byteEnd":488},"sha256":"1b8814219ff48df63d9111434854d544aa0b2ca79901fbd7718fe908417b904c","source":"use link_assistant_router::token::TokenManager;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":441,"end":488},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":488,"end":490,"unit":"utf16","byteStart":488,"byteEnd":490},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"listing_tokens_orders_them_by_issue_time_then_id","span":{"start":490,"end":1563,"unit":"utf16","byteStart":490,"byteEnd":1563},"sha256":"3a8bd4297ceb8ca13e6b2417879ae6ac25bfba434a3ebd4151786d6f946ef91a","source":"#[test]\nfn listing_tokens_orders_them_by_issue_time_then_id() {\n    let manager = TokenManager::new(\"token-list-order-secret\");\n    // Enough records that a per-process hash order matching the sorted one\n    // by chance is not a realistic outcome.\n    for index in 0..24 {\n        manager\n            .issue_token(24, &format!(\"token-{index}\"))\n            .expect(\"issue\");\n    }\n\n    let listed = manager.list_tokens().expect(\"list\");\n    let order: Vec<(i64, String)> = listed\n        .iter()\n        .map(|record| (record.issued_at, record.id.clone()))\n        .collect();\n    let mut sorted = order.clone();\n    sorted.sort();\n    assert_eq!(order.len(), 24);\n    assert_eq!(order, sorted, \"tokens are listed in hash order\");\n\n    // A second read, like a second process, gives the same answer.\n    let again: Vec<String> = manager\n        .list_tokens()\n        .expect(\"list\")\n        .into_iter()\n        .map(|record| record.id)\n        .collect();\n    let first: Vec<String> = listed.into_iter().map(|record| record.id).collect();\n    assert_eq!(again, first);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":490,"end":496},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1563,"end":1564,"unit":"utf16","byteStart":1563,"byteEnd":1564},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Regression coverage for issue #618: `tokens list` has one stable order.\n//!\n//! Every token store keeps its records in a `HashMap`, whose iteration order\n//! is seeded per process. Two `router tokens list --json` runs over the same\n//! store therefore printed the same records in different orders, and the\n//! rolling-update test's byte comparison of the old backend's list with its\n//! successor's failed although nothing had changed.\n\nuse link_assistant_router::token::TokenManager;\n\n#[test]\nfn listing_tokens_orders_them_by_issue_time_then_id() {\n    let manager = TokenManager::new(\"token-list-order-secret\");\n    // Enough records that a per-process hash order matching the sorted one\n    // by chance is not a realistic outcome.\n    for index in 0..24 {\n        manager\n            .issue_token(24, &format!(\"token-{index}\"))\n            .expect(\"issue\");\n    }\n\n    let listed = manager.list_tokens().expect(\"list\");\n    let order: Vec<(i64, String)> = listed\n        .iter()\n        .map(|record| (record.issued_at, record.id.clone()))\n        .collect();\n    let mut sorted = order.clone();\n    sorted.sort();\n    assert_eq!(order.len(), 24);\n    assert_eq!(order, sorted, \"tokens are listed in hash order\");\n\n    // A second read, like a second process, gives the same answer.\n    let again: Vec<String> = manager\n        .list_tokens()\n        .expect(\"list\")\n        .into_iter()\n        .map(|record| record.id)\n        .collect();\n    let first: Vec<String> = listed.into_iter().map(|record| record.id).collect();\n    assert_eq!(again, first);\n}\n","sourceEncoding":{"utf16CodeUnits":1564,"utf8Bytes":1564,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root