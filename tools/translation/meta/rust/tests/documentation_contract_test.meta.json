6ffce56acc708d552e6935a918c094eda9ea0e85f5e0f3dd8","source":"#[test]\nfn readme_pins_the_registered_github_routes() {\n    let path = Path::new(env!(\"CARGO_MANIFEST_DIR\")).parent().expect(\"workspace root\").join(\"README.md\");\n    let text = std::fs::read_to_string(&path).expect(\"README should be readable\");\n\n    for canonical in [\n        \"`/api/services/github/api/*`\",\n        \"`/api/services/github/api/graphql`\",\n        \"`/api/services/github/git/*`\",\n    ] {\n        assert!(\n            text.contains(canonical),\n            \"README must document canonical GitHub route {canonical}\"\n        );\n    }\n    assert!(\n        !text.contains(\"`/api/services/github/graphql`\"),\n        \"README must not advertise the unregistered GitHub GraphQL path\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":104,"end":110},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":801,"end":803,"unit":"utf16","byteStart":801,"byteEnd":803},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"public_guides_never_promise_synthesized_anthropic_headers","span":{"start":803,"end":1851,"unit":"utf16","byteStart":803,"byteEnd":1851},"sha256":"e63a8aa1bbdc1f42c6833d2df47802b3d94c62d3e598af465592334dc9c21318","source":"#[test]\nfn public_guides_never_promise_synthesized_anthropic_headers() {\n    for relative in [\n        \"README.md\",\n        \"docs/use-cases/cli-claude-code.md\",\n        \"docs/use-cases/per-task-tokens.md\",\n    ] {\n        let path = Path::new(env!(\"CARGO_MANIFEST_DIR\")).parent().expect(\"workspace root\").join(relative);\n        let text = std::fs::read_to_string(&path).expect(\"public guide\");\n        let normalized = text.to_ascii_lowercase();\n        for forbidden in [\n            \"router injects `anthropic-version`\",\n            \"router injects the `anthropic-version`\",\n            \"router injects `anthropic-beta`\",\n            \"router injects the `anthropic-beta`\",\n            \"injects those itself\",\n            \"synthesizes a missing `anthropic-version`\",\n            \"synthesizes a missing `anthropic-beta`\",\n        ] {\n            assert!(\n                !normalized.contains(forbidden),\n                \"{} contradicts transparent native-header policy: {forbidden}\",\n                path.display()\n            );\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":803,"end":809},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1851,"end":1852,"unit":"utf16","byteStart":1851,"byteEnd":1852},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Public operating documentation must match enforced transparent proxy policy.\n\nuse std::path::Path;\n\n#[test]\nfn readme_pins_the_registered_github_routes() {\n    let path = Path::new(env!(\"CARGO_MANIFEST_DIR\")).parent().expect(\"workspace root\").join(\"README.md\");\n    let text = std::fs::read_to_string(&path).expect(\"README should be readable\");\n\n    for canonical in [\n        \"`/api/services/github/api/*`\",\n        \"`/api/services/github/api/graphql`\",\n        \"`/api/services/github/git/*`\",\n    ] {\n        assert!(\n            text.contains(canonical),\n            \"README must document canonical GitHub route {canonical}\"\n        );\n    }\n    assert!(\n        !text.contains(\"`/api/services/github/graphql`\"),\n        \"README must not advertise the unregistered GitHub GraphQL path\"\n    );\n}\n\n#[test]\nfn public_guides_never_promise_synthesized_anthropic_headers() {\n    for relative in [\n        \"README.md\",\n        \"docs/use-cases/cli-claude-code.md\",\n        \"docs/use-cases/per-task-tokens.md\",\n    ] {\n        let path = Path::new(env!(\"CARGO_MANIFEST_DIR\")).parent().expect(\"workspace root\").join(relative);\n        let text = std::fs::read_to_string(&path).expect(\"public guide\");\n        let normalized = text.to_ascii_lowercase();\n        for forbidden in [\n            \"router injects `anthropic-version`\",\n            \"router injects the `anthropic-version`\",\n            \"router injects `anthropic-beta`\",\n            \"router injects the `anthropic-beta`\",\n            \"injects those itself\",\n            \"synthesizes a missing `anthropic-version`\",\n            \"synthesizes a missing `anthropic-beta`\",\n        ] {\n            assert!(\n                !normalized.contains(forbidden),\n                \"{} contradicts transparent native-header policy: {forbidden}\",\n                path.display()\n            );\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1852,"utf8Bytes":1852,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1852,0,1852,-1],["trivia","comment",0,80,0,80,0],["trivia","whitespace",80,82,80,82,0],["token","identifier",82,85,82,85,0],["trivia","whitespace",85,86,85,86,0],["token","identifier",86,89,86,89,0],["token","punct",89,91,89,91,0],["token","identifier",91,95,91,95,0],["token","punct",95,97,95,97,0],["token","identifier",97,101,97,101,0],["token","punct",101,102,101,102,0],["trivia","whitespace",102,104,102,104,0],["token","punct",104,105,104,105,0],["group","bracket",105,111,105,111,0],["token","delimiter",105,106,105,106,13],["token","identifier",106,110,106,110,13],["token","delimiter",110,111,110,111,13],["trivia","whitespace",111,11