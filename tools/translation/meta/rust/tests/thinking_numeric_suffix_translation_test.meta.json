, \"- 0\", \"-0 \", \"-\\t0\",\n    ] {\n        assert_eq!(parse_numeric_suffix(input), None, \"{input:?}\");\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1284,"utf8Bytes":1296,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1284,0,1296,-1],["trivia","comment",0,87,0,87,0],["trivia","whitespace",87,88,87,88,0],["trivia","comment",88,168,88,168,0],["trivia","whitespace",168,169,168,169,0],["token","identifier",169,172,169,172,0],["trivia","whitespace",172,173,172,173,0],["token","identifier",173,194,173,194,0],["token","punct",194,196,194,196,0],["token","identifier",196,204,196,204,0],["token","punct",204,206,204,206,0],["token","identifier",206,226,206,226,0],["token","punct",226,227,226,227,0],["trivia","whitespace",227,229,227,229,0],["token","punct",229,230,229,230,0],["group","bracket",230,236,230,236,0],["token","delimiter",230,231,230,231,15],["token","identifier",231,235,231,235,15],["token","delimiter",235,236,235,236,15],["trivia","whitespace",236,237,236,237,0],["token","identifier",237,239,237,239,0],["trivia","whitespace",239,240,239,240,0],["token","identifier",240,295,240,295,0],["group","paren",295,297,295,297,0],["token","delimiter",295,296,295,296,23],["token","delimiter",296,297,296,297,23],["trivia","whitespace",297,298,297,298,0],["group","brace",298,967,298,967,0],["token","delimiter",298,299,298,299,27],["trivia","whitespace",299,304,299,304,27],["token","identifier",304,307,304,307,27],["trivia","whitespace",307,308,307,308,27],["group","paren",308,325,308,325,27],["token","delimiter",308,309,308,309,32],["token","identifier",309,314,309,314,32],["token","punct",314,315,314,315,32],["trivia","whitespace",315,316,315,316,32],["token","identifier",316,324,316,324,32],["token","delimiter",324,325,324,325,32],["trivia","whitespace",325,326,325,326,27],["token","identifier",326,328,326,328,27],["trivia","whitespace",328,329,328,329,27],["group","bracke