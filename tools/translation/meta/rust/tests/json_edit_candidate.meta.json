 second edit\");\n    }))).is_err());\n    assert_eq!(slot.snapshot(), json!({\"c\": 3}));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":916,"end":922},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1510,"end":1512,"unit":"utf16","byteStart":1512,"byteEnd":1514},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"nested_reborrow_releases_parent_and_child_at_lexical_exit","span":{"start":1512,"end":1892,"unit":"utf16","byteStart":1514,"byteEnd":1894},"sha256":"40c8eac49e5b3186883ad624d9d30bc40c083af3c1a5d92b6173fc5f575e4f4d","source":"#[test]\nfn nested_reborrow_releases_parent_and_child_at_lexical_exit() {\n    let mut slot = JsonEditSlot::new(json!({\"a\": 1, \"b\": 2}));\n    slot.with_edit(|parent| {\n        parent.with_reborrow(|child| assert_eq!(child.remove_if_object(\"a\"), Some(json!(1))));\n        assert_eq!(parent.remove_if_object(\"b\"), Some(json!(2)));\n    });\n    assert_eq!(slot.snapshot(), json!({}));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1512,"end":1518},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1892,"end":1893,"unit":"utf16","byteStart":1894,"byteEnd":1895},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"// CI-only oracle source; no local Rust execution. The candidate facade is unused.\n#[path = \"../src/translation_core/json_edit_candidate.rs\"]\nmod json_edit_candidate;\nuse json_edit_candidate::JsonEditSlot;\nuse serde_json::json;\nuse std::panic::{AssertUnwindSafe, catch_unwind};\n\n#[test]\nfn no_op_remove_owned_return_and_unicode_keys() {\n    for value in [json!(null), json!(true), json!([1]), json!(\"text\"), json!(2)] {\n        let mut slot = JsonEditSlot::new(value.clone());\n        assert_eq!(slot.with_edit(|loan| loan.remove_if_object(\"x\")), None);\n        assert_eq!(slot.snapshot(), value);\n    }\n    let mut slot = JsonEditSlot::new(json!({\"\": 1, \"__proto__\": 2, \"é\": [3]}));\n    assert_eq!(slot.with_edit(|loan| loan.remove_if_object(\"missing\")), None);\n    assert_eq!(slot.with_edit(|loan| loan.remove_if_object(\"é\")), Some(json!([3])));\n    assert_eq!(slot.snapshot(), json!({\"\": 1, \"__proto__\": 2}));\n}\n\n#[test]\nfn return_err_and_unwind_preserve_completed_edits() {\n    let mut slot = JsonEditSlot::new(json!({\"a\": 1, \"b\": 2, \"c\": 3}));\n    let result: Result<(), &str> = slot.with_edit(|loan| {\n        loan.remove_if_object(\"a\");\n        Err(\"after first edit\")\n    });\n    assert_eq!(result, Err(\"after first edit\"));\n    assert_eq!(slot.snapshot(), json!({\"b\": 2, \"c\": 3}));\n    assert!(catch_unwind(AssertUnwindSafe(|| slot.with_edit::<()>(|loan| {\n        loan.remove_if_object(\"b\");\n        panic!(\"after second edit\");\n    }))).is_err());\n    assert_eq!(slot.snapshot(), json!({\"c\": 3}));\n}\n\n#[test]\nfn nested_reborrow_releases_parent_and_child_at_lexical_exit() {\n    let mut slot = JsonEditSlot::new(json!({\"a\": 1, \"b\": 2}));\n    slot.with_edit(|parent| {\n        parent.with_reborrow(|child| assert_eq!(child.remove_if_object(\"a\"), Some(json!(1))));\n        assert_eq!(parent.remove_if_object(\"b\"), Some(json!(2)));\n    });\n    assert_eq!(slot.snapshot(), json!({}));\n}\n","sourceEncoding":{"utf16CodeUnits":1893,"utf8Bytes":1895,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1893,0,189