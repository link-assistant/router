ssume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":4,"preserved":5},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":183,"unit":"utf16","byteStart":0,"byteEnd":183},"sha256":"8aa4fd42d2c843051ed85cb803bc5a2607f53fccfa92d8b05ce46bb5ae45989f","source":"//! The release archive must contain every binary the manifest declares.\n//!\n//! Split from `release_workflow_test.rs` to keep that file within the\n//! repository's 1000-line limit.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"fn","name":"read_lf","span":{"start":183,"end":348,"unit":"utf16","byteStart":183,"byteEnd":348},"sha256":"ccc4d6dc5a0b9f0b3773970f41bc7038c7585e31bfe65c1ce0043667fff3530d","source":"fn read_lf(path: &str) -> String {\n    std::fs::read_to_string(path)\n        .unwrap_or_else(|error| panic!(\"read {path}: {error}\"))\n        .replace(\"\\r\\n\", \"\\n\")\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":200,"end":204},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":348,"end":479,"unit":"utf16","byteStart":348,"byteEnd":479},"sha256":"023b017674bcd971bbc8db43dcedf387511dbae3c84b03701fb885abc3721cad","source":"\n\n/// The `name` of every `[[bin]]` table, and of no other table (`[[bench]]`\n/// targets have names too, but are never packaged).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"declared_binaries","span":{"start":479,"end":960,"unit":"utf16","byteStart":479,"byteEnd":960},"sha256":"13bb40a23358d56d1b942cfd025c44cbc8ea75e0443265fa31af03eca7622cdc","source":"fn declared_binaries(manifest: &str) -> Vec<String> {\n    let mut in_bin = false;\n    let mut binaries = Vec::new();\n    for line in manifest.lines() {\n        if line.starts_with('[') {\n            in_bin = line.trim() == \"[[bin]]\";\n        } else if in_bin\n            && let Some(name) = line\n                .strip_prefix(\"name = \\\"\")\n                .and_then(|rest| rest.strip_suffix('\"'))\n        {\n            binaries.push(name.to_string());\n        }\n    }\n    binaries\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":510,"end":514},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":960,"end":1447,"unit":"utf16","byteStart":960,"byteEnd":1449},"sha256":"d9d77a6d9cfc8514d5255dff4f384c21853ef7001aeec6c93252fa55720c8153","source":"\n\n/// Every binary the manifest declares must be packaged into the release\n/// archive, and must be smoke-tested there.\n///\n/// `router` was added to `Cargo.toml` in v0.92.0 but not to the packaging step,\n/// so it built in CI, passed every test, and was still absent from all eight\n/// published archives — reaching only users who install with `cargo install`\n/// (issue #222). The packaging list is hand-written, so this asserts it against\n/// the manifest rather than against itself.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"every_declared_binary_is_packaged_and_smoke_tested","span":{"start":1447,"end":2173,"unit":"utf16","byteStart":1449,"byteEnd":2175},"sha256":"9fad591fa38d3f2760f113d3648128db8f86a6303346ff47225553136990151a","source":"#[test]\nfn every_declared_binary_is_packaged_and_smoke_tested() {\n    let manifest = read_lf(\"Cargo.toml\");\n    let workflow = read_lf(\".github/workflows/release.yml\");\n\n    let binaries = declared_binaries(&manifest);\n    assert!(\n        binaries.len() >= 3,\n        \"expected the declared binaries, found {binaries:?}\"\n    );\n\n    for binary in binaries {\n        assert!(\n            workflow.contains(&format!(\"release/{binary}\\\"\")),\n            \"{binary} is declared in Cargo.toml but never copied into the release package\"\n        );\n        assert!(\n            workflow.contains(&format!(\"dist/package/{binary} \")),\n            \"{binary} is packaged but never smoke-tested in the published archive\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1447,"end":1453},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2173,"end":2661,"unit":"utf16","byteStart":2175,"byteEnd":2665},"sha256":"2825ab4a7715476be4aa4642fa1295ca1084ff9e096d794f91e337f9625a6510","source":"\n\n/// Every command name the release archive ships must also resolve inside the\n/// published container image.\n///\n/// The image copied one binary under its long name while `cargo install` put\n/// both names on a workstation's PATH, so `docker exec … router --version`\n/// failed with \"executable file not found\" on the exact command the docs\n/// prescribe (issue #243). The two installation paths are described in\n/// different files, which is how they drifted; this ties them together.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"every_packaged_binary_is_reachable_in_the_container_image","span":{"start":2661,"end":3374,"unit":"utf16","byteStart":2665,"byteEnd":3378},"sha256":"5899d9ef9fe27a8afe9ce066e350cf11e7c526b6cd3b6201def3f9726d6e40ee","source":"#[test]\nfn every_packaged_binary_is_reachable_in_the_container_image() {\n    let manifest = read_lf(\"Cargo.toml\");\n    let dockerfile = read_lf(\"Dockerfile\");\n\n    let binaries = declared_binaries(&manifest);\n    assert!(\n        binaries.len() >= 3,\n        \"expected the declared binaries, found {binaries:?}\"\n    );\n\n    for binary in binaries {\n        let copied = dockerfile.contains(&format!(\"/usr/local/bin/{binary}\\n\"));\n        let linked = dockerfile.contains(&format!(\n            \"ln -s link-assistant-router /usr/local/bin/{binary}\"\n        ));\n        assert!(\n            copied || linked,\n            \"{binary} is packaged for release but is not on PATH in the container image\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2661,"end":2667},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":3374,"end":3375,"unit":"utf16","byteStart":3378,"byteEnd":3379},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! The release archive must contain every binary the manifest declares.\n//!\n//! Split from `release_workflow_test.rs` to keep that file within the\n//! repository's 1000-line limit.\n\nfn read_lf(path: &str) -> String {\n    std::fs::read_to_string(path)\n        .unwrap_or_else(|error| panic!(\"read {path}: {error}\"))\n        .replace(\"\\r\\n\", \"\\n\")\n}\n\n/// The `name` of every `[[bin]]` table, and of no other table (`[[bench]]`\n/// targets have names too, but are never packaged).\nfn declared_binaries(manifest: &str) -> Vec<String> {\n    let mut in_bin = false;\n    let mut binaries = Vec::new();\n    for line in manifest.lines() {\n        if line.starts_with('[') {\n            in_bin = line.trim() == \"[[bin]]\";\n        } else if in_bin\n            && let Some(name) = line\n                .strip_prefix(\"name = \\\"\")\n                .and_then(|rest| rest.strip_suffix('\"'))\n        {\n            binaries.push(name.to_string());\n        }\n    }\n    binaries\n}\n\n/// Every binary the manifest declares must be packaged into the release\n/// archive, and must be smoke-tested there.\n///\n/// `router` was added to `Cargo.toml` in v0.92.0 but not to the packaging step,\n/// so it built in CI, passed every test, and was still absent from all eight\n/// published archives — reaching only users who install with `cargo install`\n/// (issue #222). The packaging list is hand-written, so this asserts it against\n/// the manifest rather than against itself.\n#[test]\nfn every_declared_binary_is_packaged_and_smoke_tested() {\n    let manifest = read_lf(\"Cargo.toml\");\n    let workflow = read_lf(\".github/workflows/release.yml\");\n\n    let binaries = declared_binaries(&manifest);\n    assert!(\n        binaries.len() >= 3,\n        \"expected the declared binaries, found {binaries:?}\"\n    );\n\n    for binary in binaries {\n        assert!(\n            workflow.contains(&format!(\"release/{binary}\\\"\")),\n            \"{binary} is declared in Cargo.toml but never copied into the release package\"\n        );\n        assert!(\n            workflow.contains(&format!(\"dist/package/{binary} \")),\n            \"{binary} is packaged but never smoke-tested in the published archive\"\n        );\n    }\n}\n\n/// Every command name the release archive ships must also resolve inside the\n/// published container image.\n///\n/// The image copied one binary under its long name while `cargo install` put\n/// both names on a workstation's PATH, so `docker exec … router --version`\n/// failed with \"executable file not found\" on the exact command the docs\n/// prescribe (issue #243). The two installation paths are described in\n/// different files, which is how they drifted; this ties them together.\n#[test]\nfn every_packaged_binary_is_reachable_in_the_container_image() {\n    let manifest = read_lf(\"Cargo.toml\");\n    let dockerfile = read_lf(\"Dockerfile\");\n\n    let binaries = declared_binaries(&manifest);\n    assert!(\n        binaries.len() >= 3,\n        \"expected the declared binaries, found {binaries:?}\"\n    );\n\n    for binary in binaries {\n        let copied = dockerfile.contains(&format!(\"/usr/local/bin/{binary}\\n\"));\n        let linked = dockerfile.contains(&format!(\n            \"ln -s link-assistant-router /usr/local/bin/{binary}\"\n        ));\n        assert!(\n            copied || linked,\n            \"{binary} is packaged for release but is not on PATH in the container image\"\n        );\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":3375,"utf8Bytes":3379,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,3375,0,3379,-1],["trivia","comment",0,72,0,72,0],["trivia","whitespace",72,73,72,73,0],["trivia","comment",73,76,73,76,0],["trivia","whitespace",76,77,76,77,0],["trivia","comment",77,147,77,147,0],["trivia","whitespace",147,148,147,148,0],["trivia","comment",148,181,148,181,0],["trivia","whitespace",181,183,181,183,0],["token","identifier",183,185,183,185,0],["trivia","whitespace",185,186,185,186,0],["token","identifier",186,193,186,193,0],["group","paren",193,205,193,205,0],["token","delimiter",193,194,193,194,12],["token","identifier",194,198,194,198,12],["token","punct",198,199,198,199,12],["trivia","whitespace",199,200,199,200,12],["token","punct",200,201,200,201,12],["token","identifier",20