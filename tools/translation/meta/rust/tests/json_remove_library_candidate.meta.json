:547},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1233,"end":1235,"unit":"utf16","byteStart":1239,"byteEnd":1241},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"original_rust_accepts_values_outside_the_js_bounded_abi","span":{"start":1235,"end":1590,"unit":"utf16","byteStart":1241,"byteEnd":1596},"sha256":"5ca2af029946406785ed611a3c55bad2031b960fc2d0a0636559224769b9d3a3","source":"#[test]\nfn original_rust_accepts_values_outside_the_js_bounded_abi() {\n    // This intentionally does NOT assert whole-domain Rust/JS equivalence.\n    let value = Value::Array(vec![Value::Null; 4096]);\n    let mut slot = JsonEditSlot::new(value.clone());\n    slot.with_edit(|loan| library_remove(loan, \"unused\"));\n    assert_eq!(slot.snapshot(), value);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1235,"end":1241},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1590,"end":1592,"unit":"utf16","byteStart":1596,"byteEnd":1598},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"child_library_borrow_restores_parent_with_completed_removals","span":{"start":1592,"end":1917,"unit":"utf16","byteStart":1598,"byteEnd":1923},"sha256":"6d3805969afbf4cc4a37cd536a43647aaf29a55314256dbe315c1c8d3fd75b48","source":"#[test]\nfn child_library_borrow_restores_parent_with_completed_removals() {\n    let mut slot = JsonEditSlot::new(json!({\"a\": 1, \"b\": 2}));\n    slot.with_edit(|parent| {\n        parent.with_reborrow(|child| library_remove(child, \"a\"));\n        library_remove(parent, \"b\");\n    });\n    assert_eq!(slot.snapshot(), json!({}));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1592,"end":1598},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1917,"end":1918,"unit":"utf16","byteStart":1923,"byteEnd":1924},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"// CI-only bounded library ABI oracle; the default facade is unchanged.\n#[path = \"../src/translation_core/json_edit_candidate.rs\"]\nmod json_edit_candidate;\nuse json_edit_candidate::{JsonEdit, JsonEditSlot};\nuse serde_json::{Value, json};\n\nfn original_remove(root: &mut Value, key: &str) {\n    if let Some(object) = root.as_object_mut() {\n        object.remove(key);\n    }\n}\n\n// Explicit loan ABI, matching the emitted unit-returning JS leaf.\nfn library_remove(loan: &mut JsonEdit<'_>, key: &str) {\n    let _ = loan.remove_if_object(key);\n}\n\n#[test]\nfn bounded_values_and_unicode_keys_match_the_original_closed_body() {\n    let values = [\n        json!(null),\n        json!(true),\n        json!(7),\n        json!(\"text\"),\n        json!([null, {\"a\": 1}]),\n        json!({}),\n        json!({\"\": 1, \"__proto__\": 2, \"é\": [3], \"😀\": {\"nested\": true}}),\n    ];\n    for value in values {\n        for key in [\"missing\", \"\", \"__proto__\", \"é\", \"😀\"] {\n            let mut expected = value.clone();\n            original_remove(&mut expected, key);\n            let mut slot = JsonEditSlot::new(value.clone());\n            slot.with_edit::<()>(|loan| library_remove(loan, key));\n            assert_eq!(slot.snapshot(), expected);\n        }\n    }\n}\n\n#[test]\nfn original_rust_accepts_values_outside_the_js_bounded_abi() {\n    // This intentionally does NOT assert whole-domain Rust/JS equivalence.\n    let value = Value::Array(vec![Value::Null; 4096]);\n    let mut slot = JsonEditSlot::new(value.clone());\n    slot.with_edit(|loan| library_remove(loan, \"unused\"));\n    assert_eq!(slot.snapshot(), value);\n}\n\n#[test]\nfn child_library_borrow_restores_parent_with_completed_removals() {\n    let mut slot = JsonEditSlot::new(json!({\"a\": 1, \"b\": 2}));\n    slot.with_edit(|parent| {\n        parent.with_reborrow(|child| library_remove(child, \"a\"));\n        library_remove(parent, \"b\");\n    });\n    assert_eq!(slot.snapshot(), json!({}));\n}\n","sourceEncoding":{"utf16CodeUnits":1918,"utf8Bytes":1924,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1918,0,1924,-1],["trivia","comment",0,71,0,71,0],["trivia","whitespace",71,72,71,72,0],["token","punct",72,73,72,73,0],["group","bracket",73,130,73,130,0],["token","delimiter",73,74,73,74,4],["token","identifier",74,78,74,78,4],["trivia","whitespace",78,79,78,79,4],["token","punct",79,80,79,80,4],["trivia","whitespace",80,81,80,81,4],["token","string",81,129,81,129,4],["token","delimiter",129,130,129,130,4],["trivia","whitespace",130,131,130,131,0],["token","identifier",131,134,131,134,0],["trivia","whitespace",134,135,134,135,0],["token","identifier",135,154,135,154,0],["token","punct",154,155,154,155,0],["trivia","whitespace",155,156,155,156,0],["token","identifier",156,159,156,159,0],["trivia","whitespace",159,160,159,160,0],["token","identifier",160,179,160,179,0],["token","punct",179,181,179,181,0],["group","brace",181,205,181,205,0],["token","delimiter",181,182,181,182,22],["token","identifier",182,190,182,190,22],["token","punct",190,191,190,191,22],["trivia","whitespace",191,192,191,192,22],["token","identifier",192,204,192,204,22],["token","delimiter",204,205,204,205,22],["token","punct",205,206,205,206,0],["trivia","whitespace",206,207,206,207,0],["token","identifier",207,210,207,210,0],["trivia"