ll},{"term":"use","name":"std","span":{"start":242,"end":262,"unit":"utf16","byteStart":242,"byteEnd":262},"sha256":"09f97dc293215ba945cc84a484cbac9e1e4435ab73f6d6a9412f59b35515d15f","source":"use std::cell::Cell;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":242,"end":262},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":262,"end":264,"unit":"utf16","byteStart":262,"byteEnd":264},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"nested_copy_interpolations_evaluate_each_written_argument_once","span":{"start":264,"end":1178,"unit":"utf16","byteStart":264,"byteEnd":1182},"sha256":"aedfad91670d82cd3b278ca6aecc69b0e85a258d3e2ef0a94ade59ae60f8094d","source":"#[test]\nfn nested_copy_interpolations_evaluate_each_written_argument_once() {\n    // The counter is an independent native evaluation witness, not permission\n    // for arbitrary effectful operands in the translated pure-copy domain.\n    fn observed<'a>(value: &'a Json, calls: &Cell<usize>) -> &'a Json {\n        calls.set(calls.get() + 1);\n        value\n    }\n    let calls = Cell::new(0);\n    let value = core::json!({\"nested\": [true, \"猫😀\"]});\n    let result = core::json!({\n        \"left\": core::json_copy(observed(&value, &calls)),\n        \"right\": core::json_copy(observed(&value, &calls)),\n    });\n    assert_eq!(calls.get(), 2);\n    assert_eq!(result[\"left\"], value);\n    assert_eq!(result[\"right\"], value);\n    let mut changed = core::json_copy(&result);\n    changed[\"left\"][\"nested\"][0] = core::json!(false);\n    assert_eq!(value[\"nested\"][0], true);\n    assert_eq!(result[\"right\"][\"nested\"][0], true);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":264,"end":270},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1178,"end":1180,"unit":"utf16","byteStart":1182,"byteEnd":1184},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"original","span":{"start":1180,"end":1418,"unit":"utf16","byteStart":1184,"byteEnd":1422},"sha256":"e2aa78512a55bb7fb91c3e2f7a9e53e0d1b606fbffd7d1ef7a5903cb805048f2","source":"fn original(flag: bool, value: Maybe<&Str>) -> Maybe<Json> {\n    let mut document = core::json!({});\n    if !flag {\n        document[\"selected\"] = core::json!(true);\n    }\n    document[\"text\"] = core::json!([value?]);\n    Some(document)\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"type Maybe<…>: generic types are outside the portable core","span":{"start":1211,"end":1216},"details":{"construct":"type Maybe<…>"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1418,"end":1420,"unit":"utf16","byteStart":1422,"byteEnd":1424},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"adopted","span":{"start":1420,"end":1836,"unit":"utf16","byteStart":1424,"byteEnd":1840},"sha256":"24c7d8da835038f9fa2b9e6c6cdda8e16058489afa8c380691f5351c404f790c","source":"fn adopted(flag: bool, value: Maybe<&Str>) -> Maybe<Json> {\n    let mut document = core::json!({});\n    if !flag {\n        {\n            let computed = core::json!(true);\n            document = core::json_with_field(document, \"selected\", computed);\n        };\n    }\n    {\n        let computed = core::json!([value?]);\n        document = core::json_with_field(document, \"text\", computed);\n    };\n    Some(document,)\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"type Maybe<…>: generic types are outside the portable core","span":{"start":1450,"end":1455},"details":{"construct":"type Maybe<…>"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1836,"end":1838,"unit":"utf16","byteStart":1840,"byteEnd":1842},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"block_semicolons_unary_negation_and_constructor_commas_keep_native_results","span":{"start":1838,"end":2099,"unit":"utf16","byteStart":1842,"byteEnd":2106},"sha256":"6c5b5808ef28813ecbaf75f7181e20eb6e057dc0c3f103ffaaffca8fa9337892","source":"#[test]\nfn block_semicolons_unary_negation_and_constructor_commas_keep_native_results() {\n    for flag in [false, true] {\n        for value in [None, Some(\"\"), Some(\"Ω😀\")] {\n            assert_eq!(original(flag, value), adopted(flag, value));\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1838,"end":1844},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2099,"end":2100,"unit":"utf16","byteStart":2106,"byteEnd":2107},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Independent native witnesses for nested copy evaluation and the repaired\n//! statement/constructor spelling. UNRUN locally; same-SHA JavaScript CI gates Rust.\nuse link_assistant_router::translation_core::{self as core, Json, Maybe, Str};\nuse std::cell::Cell;\n\n#[test]\nfn nested_copy_interpolations_evaluate_each_written_argument_once() {\n    // The counter is an independent native evaluation witness, not permission\n    // for arbitrary effectful operands in the translated pure-copy domain.\n    fn observed<'a>(value: &'a Json, calls: &Cell<usize>) -> &'a Json {\n        calls.set(calls.get() + 1);\n        value\n    }\n    let calls = Cell::new(0);\n    let value = core::json!({\"nested\": [true, \"猫😀\"]});\n    let result = core::json!({\n        \"left\": core::json_copy(observed(&value, &calls)),\n        \"right\": core::json_copy(observed(&value, &calls)),\n    });\n    assert_eq!(calls.get(), 2);\n    assert_eq!(result[\"left\"], value);\n    assert_eq!(result[\"right\"], value);\n    let mut changed = core::json_copy(&result);\n    changed[\"left\"][\"nested\"][0] = core::json!(false);\n    assert_eq!(value[\"nested\"][0], true);\n    assert_eq!(result[\"right\"][\"nested\"][0], true);\n}\n\nfn original(flag: bool, value: Maybe<&Str>) -> Maybe<Json> {\n    let mut document = core::json!({});\n    if !flag {\n        document[\"selected\"] = core::json!(true);\n    }\n    document[\"text\"] = core::json!([value?]);\n    Some(document)\n}\n\nfn adopted(flag: bool, value: Maybe<&Str>) -> Maybe<Json> {\n    let mut document = core::json!({});\n    if !flag {\n        {\n            let computed = core::json!(true);\n            document = core::json_with_field(document, \"selected\", computed);\n        };\n    }\n    {\n        let computed = core::json!([value?]);\n        document = core::json_with_field(document, \"text\", computed);\n    };\n    Some(document,)\n}\n\n#[test]\nfn block_semicolons_unary_negation_and_constructor_commas_keep_native_results() {\n    for flag in [false, true] {\n        for value in [None, Some(\"\"), Some(\"Ω😀\")] {\n            assert_eq!(original(flag, value), adopted(flag, value));\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2100,"utf8Bytes":2107,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2100,0,2107,-1],["trivia","comment",0,76,0,76,0],["trivia","whitespace",76,77,76,77,0],["trivia","comment",77,162,77,162,0],["trivia","whitespace",162,163,162,163,0],["tok