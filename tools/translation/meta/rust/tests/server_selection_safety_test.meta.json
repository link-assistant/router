,"source":"use std::fs;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":93,"end":105},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":105,"end":106,"unit":"utf16","byteStart":105,"byteEnd":106},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"std","span":{"start":106,"end":142,"unit":"utf16","byteStart":106,"byteEnd":142},"sha256":"f3b0e4ab936ef268acb2e8ee23889b7d4106f2ba0f5c63137f9ee95218a05501","source":"use std::process::{Command, Output};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":106,"end":142},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":142,"end":144,"unit":"utf16","byteStart":142,"byteEnd":144},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"server_status","span":{"start":144,"end":500,"unit":"utf16","byteStart":144,"byteEnd":500},"sha256":"221b242d974fa0a3fcc10e9151565ba6a3c1c577f601c1d5021478cf956a24c4","source":"fn server_status(home: &std::path::Path) -> Output {\n    Command::new(env!(\"CARGO_BIN_EXE_link-assistant-router\"))\n        .args([\"server\", \"status\"])\n        .env(\"HOME\", home)\n        .env(\"TOKEN_SECRET\", \"legacy-load-secret\")\n        .env_remove(\"XDG_CONFIG_HOME\")\n        .env_remove(\"APPDATA\")\n        .output()\n        .expect(\"server status runs\")\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"macro env!: requires actual source macro expansion and binding resolution","span":{"start":214,"end":218},"details":{"construct":"macro env!"}},"comment":false},{"term":"trivia","name":null,"span":{"start":500,"end":502,"unit":"utf16","byteStart":500,"byteEnd":502},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_unsafe_legacy_selection_fails_closed_without_echoing_secrets","span":{"start":502,"end":1509,"unit":"utf16","byteStart":502,"byteEnd":1509},"sha256":"006175b59a65b16bf354403b709f2deea446f3dbb7483e2b8244704e42d75183","source":"#[test]\nfn an_unsafe_legacy_selection_fails_closed_without_echoing_secrets() {\n    let home = tempfile::tempdir().expect(\"temporary home\");\n    let directory = home.path().join(\".config/link-assistant-router\");\n    fs::create_dir_all(&directory).expect(\"create config directory\");\n    fs::write(\n        directory.join(\"server.json\"),\n        r#\"{\"server\":\"https://private-user:private-password@router.example/?token=private-query\",\"token\":\"la_sk_private\"}\"#,\n    )\n    .expect(\"seed unsafe legacy selection\");\n    let output = server_status(home.path());\n    assert!(!output.status.success());\n    let rendered = format!(\n        \"{}{}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n    for secret in [\n        \"private-user\",\n        \"private-password\",\n        \"private-query\",\n        \"la_sk_private\",\n    ] {\n        assert!(\n            !rendered.contains(secret),\n            \"legacy rejection leaked {secret}: {rendered}\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":502,"end":508},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1509,"end":1771,"unit":"utf16","byteStart":1509,"byteEnd":1771},"sha256":"7657944b647ee311b0e1199c82cb1324de7fe4f1fdc1f2c3d76be97a7d373d10","source":"\n\n/// State written by an earlier release is JSON, and must keep loading: the\n/// stores moved to links notation without changing their file names, so an\n/// existing installation migrates on its next write rather than losing its\n/// configuration (issue #235).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_json_server_selection_from_an_earlier_release_still_loads","span":{"start":1771,"end":2636,"unit":"utf16","byteStart":1771,"byteEnd":2636},"sha256":"af6cd3495fe0667b6644d293c8fc6ebda16bd25b17922c05253d65be807bda6d","source":"#[test]\nfn a_json_server_selection_from_an_earlier_release_still_loads() {\n    let home = tempfile::tempdir().expect(\"temporary home\");\n    let directory = home.path().join(\".config/link-assistant-router\");\n    fs::create_dir_all(&directory).expect(\"create config directory\");\n    fs::write(\n        directory.join(\"server.json\"),\n        r#\"{\"server\":\"https://legacy.example\",\"token\":\"la_sk_legacy\",\"run_max_requests\":5}\"#,\n    )\n    .expect(\"seed a legacy JSON selection\");\n    let output = server_status(home.path());\n    let rendered = format!(\n        \"{}{}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n    assert!(\n        rendered.contains(\"https://legacy.example\"),\n        \"the legacy selection must still load: {rendered}\"\n    );\n    assert!(!rendered.contains(\"la_sk_legacy\"), \"{rendered}\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1771,"end":1777},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2636,"end":2637,"unit":"utf16","byteStart":2636,"byteEnd":2637},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Secret-safety and compatibility coverage for persisted server selection.\n\n#![cfg(unix)]\n\nuse std::fs;\nuse std::process::{Command, Output};\n\nfn server_status(home: &std::path::Path) -> Output {\n    Command::new(env!(\"CARGO_BIN_EXE_link-assistant-router\"))\n        .args([\"server\", \"status\"])\n        .env(\"HOME\", home)\n        .env(\"TOKEN_SECRET\", \"legacy-load-secret\")\n        .env_remove(\"XDG_CONFIG_HOME\")\n        .env_remove(\"APPDATA\")\n        .output()\n        .expect(\"server status runs\")\n}\n\n#[test]\nfn an_unsafe_legacy_selection_fails_closed_without_echoing_secrets() {\n    let home = tempfile::tempdir().expect(\"temporary home\");\n    let directory = home.path().join(\".config/link-assistant-router\");\n    fs::create_dir_all(&directory).expect(\"create config directory\");\n    fs::write(\n        directory.join(\"server.json\"),\n        r#\"{\"server\":\"https://private-user:private-password@router.example/?token=private-query\",\"token\":\"la_sk_private\"}\"#,\n    )\n    .expect(\"seed unsafe legacy selection\");\n    let output = server_status(home.path());\n    assert!(!output.status.success());\n    let rendered = format!(\n        \"{}{}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n    for secret in [\n        \"private-user\",\n        \"private-password\",\n        \"private-query\",\n        \"la_sk_private\",\n    ] {\n        assert!(\n            !rendered.contains(secret),\n            \"legacy rejection leaked {secret}: {rendered}\"\n        );\n    }\n}\n\n/// State written by an earlier release is JSON, and must keep loading: the\n/// stores moved to links notation without changing their file names, so an\n/// existing installation migrates on its next write rather than losing its\n/// configuration (issue #235).\n#[test]\nfn a_json_server_selection_from_an_earlier_release_still_loads() {\n    let home = tempfile::tempdir().expect(\"temporary home\");\n    let directory = home.path().join(\".config/link-assistant-router\");\n    fs::create_dir_all(&directory).expect(\"create config directory\");\n    fs::write(\n        directory.join(\"server.json\"),\n        r#\"{\"server\":\"https://legacy.example\",\"token\":\"la_sk_legacy\",\"run_max_requests\":5}\"#,\n    )\n    .expect(\"seed a legacy JSON selection\");\n    let output = server_status(home.path());\n    let rendered = format!(\n        \"{}{}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n    assert!(\n        rendered.contains(\"https://legacy.example\"),\n        \"the legacy selection must still load: {rendered}\"\n    );\n    assert!(!rendered.contains(\"la_sk_legacy\"), \"{rendered}\");\n}\n","sourceEncoding":{"utf16CodeUnits":2637,"utf8Bytes":2637,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2637,0,2637,-1],["trivia","comment",0,76,0,76,0],["trivia","whitespace",76,78,76,78,0],["token","punct",78,79,78,79,0],["token","punct",79,80,79,80,0],["group","bracket",80,91,80,91,0],["token","delimiter",80,81,80,81,5],["token","identifier",81,84,81,84,5],["group","paren",84,90,84,90,5],["token","delimiter",84,85,84,85,8],["token","identifier",85,89,85,89,8],["token","delimiter",89,90,89,90,8],["token","delimiter",90,91,90,91,5],["trivia","whitespace",91,93,91,93,0],["token","identifier",93,96,93,96,0],["trivia","whitespace",96,97,96,97,0],["token","identifier",97,100,97,100,0],["token","punct",100,102,100,102,0],["token","identifier",102,104,102,104,0],["token","punct",104,105,104,105,0],["trivia","whitespace",105,106,105,106,0],["token","identifier",106,109,106,109,0],["trivia","whitespace",109,110,109,110,0],["token","identifier",110,113,110,113,0],["token","punct",113,115,113,115,0],["token","identifier",115,122,115,122,0],["token","punct",122,124,122,124,0],["group","brace",124,141,124,141,0],["token","delimiter",124,125,124,125,