7,"byteEnd":805},"sha256":"59bf59d1b789bc92d3d33e74e5f6904ac4a6234a3b0583eadf372d8eda566ace","source":"#[test]\nfn ascii_alphabet_and_unicode_boundaries() {\n    for (value, alphabet, expected) in [\n        (\"\", \"\", true), (\"\", \"é猫😀\", true), (\"a\", \"\", false),\n        (\"aAa0-_\", \"aA0-_\", true), (\"é\", \"é\", false), (\"猫😀\", \"猫😀\", false),\n        (\"A\", \"aé猫😀\", false), (\"a\", \"aé猫😀\", true),\n        (\"\\0\\r\\n\", \"\\0\\r\\n\", true), (\"e\\u{301}\", \"e\\u{301}\", false),\n        (\"\\u{7f}\", \"\\u{7f}\", true), (\"/\", \".-_\", false),\n    ] {\n        assert_eq!(ascii_chars_in(value, alphabet), expected);\n    }\n    for byte in 0u8..=127 {\n        assert_eq!(ascii_chars_in(&char::from(byte).to_string(), \"0123456789ABCDEFabcdef\"), byte.is_ascii_hexdigit());\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":137,"end":143},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":780,"end":782,"unit":"utf16","byteStart":805,"byteEnd":807},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"arguments_evaluate_once_in_written_order","span":{"start":782,"end":1093,"unit":"utf16","byteStart":807,"byteEnd":1118},"sha256":"054b2e217c2a32be216b55d5148e5c7b2e16bf987a42c35440504bccd10e792a","source":"#[test]\nfn arguments_evaluate_once_in_written_order() {\n    let order = std::cell::RefCell::new(Vec::new());\n    assert!(ascii_chars_in(\n        { order.borrow_mut().push(\"value\"); \"abc\" },\n        { order.borrow_mut().push(\"alphabet\"); \"abc\" },\n    ));\n    assert_eq!(*order.borrow(), [\"value\", \"alphabet\"]);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":782,"end":788},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1093,"end":1094,"unit":"utf16","byteStart":1118,"byteEnd":1119},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! CI-only native oracle for the explicit owned ASCII predicate boundary.\nuse link_assistant_router::translation_core::ascii_chars_in;\n\n#[test]\nfn ascii_alphabet_and_unicode_boundaries() {\n    for (value, alphabet, expected) in [\n        (\"\", \"\", true), (\"\", \"é猫😀\", true), (\"a\", \"\", false),\n        (\"aAa0-_\", \"aA0-_\", true), (\"é\", \"é\", false), (\"猫😀\", \"猫😀\", false),\n        (\"A\", \"aé猫😀\", false), (\"a\", \"aé猫😀\", true),\n        (\"\\0\\r\\n\", \"\\0\\r\\n\", true), (\"e\\u{301}\", \"e\\u{301}\", false),\n        (\"\\u{7f}\", \"\\u{7f}\", true), (\"/\", \".-_\", false),\n    ] {\n        assert_eq!(ascii_chars_in(value, alphabet), expected);\n    }\n    for byte in 0u8..=127 {\n        assert_eq!(ascii_chars_in(&char::from(byte).to_string(), \"0123456789ABCDEFabcdef\"), byte.is_ascii_hexdigit());\n    }\n}\n\n#[test]\nfn arguments_evaluate_once_in_written_order() {\n    let order = std::cell::RefCell::new(Vec::new());\n    assert!(ascii_chars_in(\n        { order.borrow_mut().push(\"value\"); \"abc\" },\n        { order.borrow_mut().push(\"alphabet\"); \"abc\" },\n    ));\n    assert_eq!(*order.borrow(), [\"value\", \"alphabet\"]);\n}\n","sourceEncoding":{"utf16CodeUnits":1094,"utf8Bytes":1119,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1094,0,1119,-1],["trivia","comment",0,74,0,74,0],["trivia","whitespace",74,75,74,75,0],["token","identifier",75,78,75,78,0],["trivia","whitespace",78,79,78,79,0],["token","ident