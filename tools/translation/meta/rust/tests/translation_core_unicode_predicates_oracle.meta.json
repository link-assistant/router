start":176,"end":1120,"unit":"utf16","byteStart":176,"byteEnd":1130},"sha256":"796be99af539df1f08c6491e09ed6a08b2d2832ac296118b5efdb4b7bcb2885c","source":"#[test]\nfn unicode_predicate_boundaries() {\n    let whitespace = [9_u32,10,11,12,13,32,133,160,5760,8192,8193,8194,8195,8196,\n        8197,8198,8199,8200,8201,8202,8232,8233,8239,8287,12288];\n    for scalar in 0..=0x10ffff {\n        let Some(ch) = char::from_u32(scalar) else { continue };\n        let value = ch.to_string();\n        assert_eq!(has_unicode_control(&value), ch.is_control(), \"control {scalar:x}\");\n        assert_eq!(has_unicode_control(&value), scalar <= 31 || (127..=159).contains(&scalar));\n        let expected = if whitespace.contains(&scalar) { String::new() } else { value.clone() };\n        assert_eq!(strip_unicode_whitespace(&value), expected, \"whitespace {scalar:x}\");\n    }\n    assert_eq!(strip_unicode_whitespace(\" \\t猫😀e\\u{301}\\u{200d}\\0\\u{feff}\\n\"), \"猫😀e\\u{301}\\u{200d}\\0\\u{feff}\");\n    assert!(!has_unicode_control(\"😀e\\u{301}\\u{200d}\\u{feff}\\u{2028}\"));\n    assert!(has_unicode_control(\"before\\u{85}after\"));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":176,"end":182},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1120,"end":1121,"unit":"utf16","byteStart":1130,"byteEnd":1131},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"// Independent native oracle; local Rust execution is prohibited for issue #759.\nuse link_assistant_router::translation_core::{has_unicode_control, strip_unicode_whitespace};\n\n#[test]\nfn unicode_predicate_boundaries() {\n    let whitespace = [9_u32,10,11,12,13,32,133,160,5760,8192,8193,8194,8195,8196,\n        8197,8198,8199,8200,8201,8202,8232,8233,8239,8287,12288];\n    for scalar in 0..=0x10ffff {\n        let Some(ch) = char::from_u32(scalar) else { continue };\n        let value = ch.to_string();\n        assert_eq!(has_unicode_control(&value), ch.is_control(), \"control {scalar:x}\");\n        assert_eq!(has_unicode_control(&value), scalar <= 31 || (127..=159).contains(&scalar));\n        let expected = if whitespace.contains(&scalar) { String::new() } else { value.clone() };\n        assert_eq!(strip_unicode_whitespace(&value), expected, \"whitespace {scalar:x}\");\n    }\n    assert_eq!(strip_unicode_whitespace(\" \\t猫😀e\\u{301}\\u{200d}\\0\\u{feff}\\n\"), \"猫😀e\\u{301}\\u{200d}\\0\\u{feff}\");\n    assert!(!has_unicode_control(\"😀e\\u{301}\\u{200d}\\u{feff}\\u{2028}\"));\n    assert!(has_unicode_control(\"before\\u{85}after\"));\n}\n","sourceEncoding":{"utf16CodeUnits":1121,"utf8Bytes":1131,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1121,0,1131,-1],["trivia","comment",0,80,0,80,0],["trivia","whitespace",80,81,80,81,0],["token","identifier",81,84,81,84,0],["trivia","whitespace",84,85,84,85,0],["token","identifier",85,106,85,106,0],["token","punct",106,108,106,108,0],["token","identifier",108,124,108,124,0],["token","punct",124,126,124,126,0],["group","brace",126,173,126,173,0],["token","delimiter",126,127,126,127,9],["token","identifier",127,146,127,146,9],["token","punct",146,147,146,147,9],["trivia","whitespace",147,148,147,148,9],["token","identifier",148,172,148,172,9],["token","delimiter",172,173,172,173,9],["token","punct",173,174,173,174,0],["trivia","whitespace",174,176,174,176,0],["token","punct",176,177,176,177,0],["group","bracket",177,183,177,183,0],["token","delimiter",177,178,177,178,19],["token","identifier",178,182,178,182,19],["token","delimiter",182,183,182,183,19],["trivia","whitespace",183,184,18