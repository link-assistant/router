11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"replay","span":{"start":373,"end":1010,"unit":"utf16","byteStart":373,"byteEnd":1010},"sha256":"71b5d81f8250c15c8a5694bb9dc060aa974339e3467239fade7427b070c5336f","source":"fn replay(target: &str, run: fn(&[u8])) {\n    let dir = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"fuzz/corpus\")\n        .join(target);\n    let mut seen = 0;\n    for entry in std::fs::read_dir(&dir).expect(\"corpus directory\") {\n        let path = entry.expect(\"corpus entry\").path();\n        let data = std::fs::read(&path).expect(\"corpus file\");\n        run(&data);\n        // Every prefix too: a stream cut anywhere must not panic either.\n        for end in (0..data.len()).step_by(7) {\n            run(&data[..end]);\n        }\n        seen += 1;\n    }\n    assert!(seen > 0, \"empty corpus at {}\", dir.display());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":391,"end":395},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1010,"end":1012,"unit":"utf16","byteStart":1010,"byteEnd":1012},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"sse_stream_translator_corpus_replays_without_panic","span":{"start":1012,"end":1150,"unit":"utf16","byteStart":1012,"byteEnd":1150},"sha256":"5d4520ca477b45c8b1743699f04e8254f2b33564ae44e51fd4ae77882613de92","source":"#[test]\nfn sse_stream_translator_corpus_replays_without_panic() {\n    replay(\"sse_stream_translators\", harness::sse_stream_translators);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1012,"end":1018},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1150,"end":1152,"unit":"utf16","byteStart":1150,"byteEnd":1152},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"request_translator_corpus_replays_without_panic","span":{"start":1152,"end":1281,"unit":"utf16","byteStart":1152,"byteEnd":1281},"sha256":"204b209898482041e72418163fe38ef24c8d22285fcd7a28c3affff5274d64b0","source":"#[test]\nfn request_translator_corpus_replays_without_panic() {\n    replay(\"request_translators\", harness::request_translators);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1152,"end":1158},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1281,"end":1282,"unit":"utf16","byteStart":1281,"byteEnd":1282},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Replay the committed fuzz corpus on the stable toolchain (issue #670).\n//!\n//! `cargo +nightly fuzz` explores new inputs in the scheduled fuzz workflow;\n//! this test keeps every committed seed and every minimized crash input\n//! (added to `fuzz/corpus/<target>/`) running on each pull request.\n\n#[allow(dead_code)]\nmod harness {\n    include!(\"../fuzz/harness.rs\");\n}\n\nfn replay(target: &str, run: fn(&[u8])) {\n    let dir = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"fuzz/corpus\")\n        .join(target);\n    let mut seen = 0;\n    for entry in std::fs::read_dir(&dir).expect(\"corpus directory\") {\n        let path = entry.expect(\"corpus entry\").path();\n        let data = std::fs::read(&path).expect(\"corpus file\");\n        run(&data);\n        // Every prefix too: a stream cut anywhere must not panic either.\n        for end in (0..data.len()).step_by(7) {\n            run(&data[..end]);\n        }\n        seen += 1;\n    }\n    assert!(seen > 0, \"empty corpus at {}\", dir.display());\n}\n\n#[test]\nfn sse_stream_translator_corpus_replays_without_panic() {\n    replay(\"sse_stream_translators\", harness::sse_stream_translators);\n}\n\n#[test]\nfn request_translator_corpus_replays_without_panic() {\n    replay(\"request_translators\", harness::request_translators);\n}\n","sourceEncoding":{"utf16CodeUnits":1282,"utf8Bytes":1282,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1282,0,1282,-1],["trivia","comment",0,74,0,74,0],["trivia","whitespace",74,75,74,75,0],["trivia","comment",75,78,75,78,0],["trivia","whitespace",78,79,78,79,0],["trivia","comment",79,156,79,156,0],["trivia","whitespace",156,157,156,157,0],["trivia","comment",157,229,157,229,0],["trivia","whitespace",229,230,229,230,0],["trivia","comment",230,298,230,298,0],["trivia","whitespace",298,300,298,300,0],["token","punct",300,301,300,301,0],["group","bracket",301,319,301,319,0],["token","delimiter",301,302,301,302,12],["token","identifier",302,307,302,307,12],["group","paren",307,318,307,318,12],["token","delimiter",307,308,307,308,15],["token","identifier",308,317,308,317,15],["token","delimiter",317,318,317,318,15],["token","delimiter",318,319,318,319,12],["trivia","whitespace",319,320,319,320,0],["token","identifier",320,323,320,323,0],["trivia","whitespace",323,324,323,324,0],["token","identifier",324,331,324,331,0],["trivia","whitespace",331,332,331,332,0],["group","brace",332,371,332,371,0],["token","delimiter",332,333,332,333,25],["trivia","whitespace",333,338,333,338,25],["token","identifier",338,346,338,346,25],["group","paren",346,3