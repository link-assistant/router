":{"start":187,"end":926,"unit":"utf16","byteStart":187,"byteEnd":930},"sha256":"70e29953de91f5bed91a0bf059adf6ad35cbd17ed5c7a4979cf41c7b7604c8cc","source":"#[test]\nfn primitive_text_and_empty_vectors() {\n    let numbers: Vec<u8> = translation_core::vec![0_u8, 255_u8, 7_u8];\n    assert_eq!(numbers, [0, 255, 7]);\n    let flags: Vec<bool> = translation_core::vec![true, false];\n    assert_eq!(flags, [true, false]);\n    let empty: Vec<bool> = translation_core::vec![];\n    assert!(empty.is_empty());\n    let headers: Vec<&'static translation_core::Str> =\n        translation_core::vec![\"user-agent\", \"😀\", \"content-type\"];\n    assert_eq!(headers, [\"user-agent\", \"😀\", \"content-type\"]);\n    let text: Vec<translation_core::Text> = translation_core::vec![\n        translation_core::format!(\"alpha\"),\n        translation_core::format!(\"{}\", \"beta\"),\n    ];\n    assert_eq!(text, [\"alpha\", \"beta\"]);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":187,"end":193},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":926,"end":928,"unit":"utf16","byteStart":930,"byteEnd":932},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"each_operand_runs_once_in_source_order","span":{"start":928,"end":1284,"unit":"utf16","byteStart":932,"byteEnd":1288},"sha256":"1563c134b143a632452ce44b6ee906eff1a18de1a78c48486feb3be7d16d7e83","source":"#[test]\nfn each_operand_runs_once_in_source_order() {\n    let mut observations = Vec::new();\n    let values = translation_core::vec![\n        {\n            observations.push(1);\n            4_u8\n        },\n        {\n            observations.push(2);\n            5_u8\n        },\n    ];\n    assert_eq!(observations, [1, 2]);\n    assert_eq!(values, [4, 5]);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":928,"end":934},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1284,"end":1286,"unit":"utf16","byteStart":1288,"byteEnd":1290},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"borrowed_elements_keep_their_original_lifetime","span":{"start":1286,"end":1567,"unit":"utf16","byteStart":1290,"byteEnd":1577},"sha256":"7f5a60a18cbfdbb8d15db378bd3b62186f63c21b99c13aa43fe19f871a370615","source":"#[test]\nfn borrowed_elements_keep_their_original_lifetime() {\n    let value = String::from(\"borrowed 😀\");\n    let references: Vec<&translation_core::Str> = translation_core::vec![value.as_str()];\n    assert_eq!(references, [\"borrowed 😀\"]);\n    assert_eq!(value, \"borrowed 😀\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1286,"end":1292},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1567,"end":1568,"unit":"utf16","byteStart":1577,"byteEnd":1578},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Independent native oracle for the owned vector construction boundary.\n//! Run in CI only, after the complete same-head JavaScript gate.\n\nuse link_assistant_router::translation_core;\n\n#[test]\nfn primitive_text_and_empty_vectors() {\n    let numbers: Vec<u8> = translation_core::vec![0_u8, 255_u8, 7_u8];\n    assert_eq!(numbers, [0, 255, 7]);\n    let flags: Vec<bool> = translation_core::vec![true, false];\n    assert_eq!(flags, [true, false]);\n    let empty: Vec<bool> = translation_core::vec![];\n    assert!(empty.is_empty());\n    let headers: Vec<&'static translation_core::Str> =\n        translation_core::vec![\"user-agent\", \"😀\", \"content-type\"];\n    assert_eq!(headers, [\"user-agent\", \"😀\", \"content-type\"]);\n    let text: Vec<translation_core::Text> = translation_core::vec![\n        translation_core::format!(\"alpha\"),\n        translation_core::format!(\"{}\", \"beta\"),\n    ];\n    assert_eq!(text, [\"alpha\", \"beta\"]);\n}\n\n#[test]\nfn each_operand_runs_once_in_source_order() {\n    let mut observations = Vec::new();\n    let values = translation_core::vec![\n        {\n            observations.push(1);\n            4_u8\n        },\n        {\n            observations.push(2);\n            5_u8\n        },\n    ];\n    assert_eq!(observations, [1, 2]);\n    assert_eq!(values, [4, 5]);\n}\n\n#[test]\nfn borrowed_elements_keep_their_original_lifetime() {\n    let value = String::from(\"borrowed 😀\");\n    let references: Vec<&translation_core::Str> = translation_core::vec![value.as_str()];\n    assert_eq!(references, [\"borrowed 😀\"]);\n    assert_eq!(value, \"borrowed 😀\");\n}\n","sourceEncoding":{"utf16CodeUnits":1568,"utf8Bytes":1578,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1568,0,1578,-1],["trivia","comment",0,73,0,73,0],["trivia","whitespace",73,74,73,74,0],["trivia","comment",74,139,74,139,0],["trivia","whitespace",139,141,139,141,0],["token","identifier",141,144,141,144,0],["trivia","whitespace",144,145,144,145,0],["token","identifier",145,166,145,166,0],["token","punct",166,168,166,168,0],["token","identifier",168,184,168,184,0],["token","punct",184,185,184,185,0],["trivia","whitespace",185,187,185,187,0],["token","punct",187,188,187,188,0],["group","bracket",188,194,188,194,0],["token","delimiter",188,189,188,189,13],["token","identifier