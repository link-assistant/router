"status":"preserved","diagnostic":null},{"term":"fn","name":"model_qualification_observes_literal_ascii_slashes","span":{"start":268,"end":585,"unit":"utf16","byteStart":268,"byteEnd":593},"sha256":"c73786a5495c99c28706b200202ae2b993538bae4c789acc7cdd6324f0ccf1cb","source":"#[test]\nfn model_qualification_observes_literal_ascii_slashes() {\n    for value in [\"/\", \"/model\", \"provider/model\", \"a//b\", \"Ω/😀\", \"\\0/\\0\"] {\n        assert!(is_qualified_model(value), \"{value:?}\");\n    }\n    for value in [\"\", \"plain\", \"／\", \"Ω😀\"] {\n        assert!(!is_qualified_model(value), \"{value:?}\");\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":268,"end":274},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":585,"end":587,"unit":"utf16","byteStart":593,"byteEnd":595},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"credential_prefix_keeps_empty_unicode_and_nul_semantics","span":{"start":587,"end":1186,"unit":"utf16","byteStart":595,"byteEnd":1205},"sha256":"ee5bfe271ce0fce8a87774a8b3824558fde0f954b5f8399224af19d523c975bc","source":"#[test]\nfn credential_prefix_keeps_empty_unicode_and_nul_semantics() {\n    for (value, prefix) in [\n        (\"\", \"\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"ab\"),\n        (\"Ω😀tail\", \"Ω😀\"),\n        (\"\\0abc\", \"\\0\"),\n    ] {\n        assert!(\n            credential_prefix_matches(value, prefix),\n            \"{value:?}/{prefix:?}\"\n        );\n    }\n    for (value, prefix) in [\n        (\"\", \"a\"),\n        (\"abc\", \"bc\"),\n        (\"e\\u{301}\", \"é\"),\n        (\"😀Ω\", \"Ω\"),\n    ] {\n        assert!(\n            !credential_prefix_matches(value, prefix),\n            \"{value:?}/{prefix:?}\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":587,"end":593},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1186,"end":1188,"unit":"utf16","byteStart":1205,"byteEnd":1207},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"generic_owned_string_pattern_calls_match_the_independent_contract","span":{"start":1188,"end":1609,"unit":"utf16","byteStart":1207,"byteEnd":1632},"sha256":"91379bc9b5a6e60d552ab7f832267759b2af48eab4dba98489f6e01d68029c41","source":"#[test]\nfn generic_owned_string_pattern_calls_match_the_independent_contract() {\n    let value = String::from(\"😀\\0tail\");\n    let contained = String::from(\"\\0\");\n    let prefix = String::from(\"😀\");\n    assert!(value.contains(&contained));\n    assert!(value.starts_with(&prefix));\n    assert!(!value.starts_with(&contained));\n    assert!(value.contains(&String::new()));\n    assert!(value.starts_with(&String::new()));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1188,"end":1194},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1609,"end":1610,"unit":"utf16","byteStart":1632,"byteEnd":1633},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Independent public-API oracle for the checked String Pattern forwarding rule.\n//! Source only locally: CI runs Rust after the complete JavaScript gate.\nuse link_assistant_router::generated_js_first::policy::{\n    credential_prefix_matches, is_qualified_model,\n};\n\n#[test]\nfn model_qualification_observes_literal_ascii_slashes() {\n    for value in [\"/\", \"/model\", \"provider/model\", \"a//b\", \"Ω/😀\", \"\\0/\\0\"] {\n        assert!(is_qualified_model(value), \"{value:?}\");\n    }\n    for value in [\"\", \"plain\", \"／\", \"Ω😀\"] {\n        assert!(!is_qualified_model(value), \"{value:?}\");\n    }\n}\n\n#[test]\nfn credential_prefix_keeps_empty_unicode_and_nul_semantics() {\n    for (value, prefix) in [\n        (\"\", \"\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"ab\"),\n        (\"Ω😀tail\", \"Ω😀\"),\n        (\"\\0abc\", \"\\0\"),\n    ] {\n        assert!(\n            credential_prefix_matches(value, prefix),\n            \"{value:?}/{prefix:?}\"\n        );\n    }\n    for (value, prefix) in [\n        (\"\", \"a\"),\n        (\"abc\", \"bc\"),\n        (\"e\\u{301}\", \"é\"),\n        (\"😀Ω\", \"Ω\"),\n    ] {\n        assert!(\n            !credential_prefix_matches(value, prefix),\n            \"{value:?}/{prefix:?}\"\n        );\n    }\n}\n\n#[test]\nfn generic_owned_string_pattern_calls_match_the_independent_contract() {\n    let value = String::from(\"😀\\0tail\");\n    let contained = String::from(\"\\0\");\n    let prefix = String::from(\"😀\");\n    assert!(value.contains(&contained));\n    assert!(value.starts_with(&prefix));\n    assert!(!value.starts_with(&contained));\n    assert!(value.contains(&String::new()));\n    assert!(value.starts_with(&String::new()));\n}\n","sourceEncoding":{"utf16CodeUnits":1610,"utf8Bytes":1633,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1610,0,1633,-1],["trivia","comment",0,81,0,81,0],["trivia","whitespace",81,82,81,82,0],["trivia","comment",82,155,82,155,0],["trivia","whitespace",155,156,155,156,0],["token","identifier",156,159,156,159,0],["trivia","whitespace",159,160,159,160,0],["token","identifier",160,181,160,181,0],["token","punct",181,183,1