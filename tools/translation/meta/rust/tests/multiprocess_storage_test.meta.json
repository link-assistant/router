e assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":3,"preserved":4},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":116,"unit":"utf16","byteStart":0,"byteEnd":116},"sha256":"c4a012db171618768a507b4a1065f7079ffa80136e68934312730e27723af5aa","source":"//! Black-box regression coverage for concurrent router processes sharing the\n//! default dual-format token store.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"std","span":{"start":116,"end":158,"unit":"utf16","byteStart":116,"byteEnd":158},"sha256":"75b259297889edddcdf02ce8a065116ca7d89b3434ae5a0e7755eecc5819d4af","source":"use std::process::{Child, Command, Stdio};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":116,"end":158},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":158,"end":160,"unit":"utf16","byteStart":158,"byteEnd":160},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"command","span":{"start":160,"end":492,"unit":"utf16","byteStart":160,"byteEnd":492},"sha256":"2fe6ac04fb26ce10d0d7b62421666dc1f2319bf095111a94b0fa6bc3a5a0bb79","source":"fn command(home: &std::path::Path) -> Command {\n    let mut command = Command::new(env!(\"CARGO_BIN_EXE_link-assistant-router\"));\n    command\n        .env(\"HOME\", home)\n        .env(\"DATA_DIR\", home.join(\"router-data\"))\n        .env(\"TOKEN_SECRET\", \"multiprocess-storage-secret\")\n        .env(\"STORAGE_POLICY\", \"both\");\n    command\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"macro env!: requires actual source macro expansion and binding resolution","span":{"start":243,"end":247},"details":{"construct":"macro env!"}},"comment":false},{"term":"trivia","name":null,"span":{"start":492,"end":494,"unit":"utf16","byteStart":492,"byteEnd":494},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"concurrent_processes_do_not_lose_dual_store_updates","span":{"start":494,"end":1881,"unit":"utf16","byteStart":494,"byteEnd":1881},"sha256":"f0887743a10e3ded45685f119fa7f7bb2567491c9983a7db7723097ea3d62566","source":"#[test]\nfn concurrent_processes_do_not_lose_dual_store_updates() {\n    let home = tempfile::tempdir().expect(\"temporary home\");\n    let mut children: Vec<(String, Child)> = (0..8)\n        .map(|index| {\n            let label = format!(\"process-{index}\");\n            let child = command(home.path())\n                .args([\"tokens\", \"issue\", \"--label\", &label])\n                .stdout(Stdio::null())\n                .stderr(Stdio::null())\n                .spawn()\n                .expect(\"spawn token issuer\");\n            (label, child)\n        })\n        .collect();\n\n    for (label, child) in &mut children {\n        let status = child.wait().expect(\"wait for token issuer\");\n        assert!(status.success(), \"issuer for {label} failed with {status}\");\n    }\n\n    let output = command(home.path())\n        .args([\"tokens\", \"list\"])\n        .output()\n        .expect(\"list tokens after concurrent writes\");\n    assert!(output.status.success());\n    let listing = String::from_utf8(output.stdout).expect(\"UTF-8 token list\");\n    for (label, _) in children {\n        assert!(\n            listing.contains(&label),\n            \"missing concurrent update {label}\"\n        );\n    }\n\n    let data = home.path().join(\"router-data\");\n    assert!(data.join(\"tokens.lino\").exists());\n    assert!(data.join(\"tokens.bin\").exists());\n    assert!(!data.join(\"tokens.transaction.json\").exists());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":494,"end":500},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1881,"end":1882,"unit":"utf16","byteStart":1881,"byteEnd":1882},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Black-box regression coverage for concurrent router processes sharing the\n//! default dual-format token store.\n\nuse std::process::{Child, Command, Stdio};\n\nfn command(home: &std::path::Path) -> Command {\n    let mut command = Command::new(env!(\"CARGO_BIN_EXE_link-assistant-router\"));\n    command\n        .env(\"HOME\", home)\n        .env(\"DATA_DIR\", home.join(\"router-data\"))\n        .env(\"TOKEN_SECRET\", \"multiprocess-storage-secret\")\n        .env(\"STORAGE_POLICY\", \"both\");\n    command\n}\n\n#[test]\nfn concurrent_processes_do_not_lose_dual_store_updates() {\n    let home = tempfile::tempdir().expect(\"temporary home\");\n    let mut children: Vec<(String, Child)> = (0..8)\n        .map(|index| {\n            let label = format!(\"process-{index}\");\n            let child = command(home.path())\n                .args([\"tokens\", \"issue\", \"--label\", &label])\n                .stdout(Stdio::null())\n                .stderr(Stdio::null())\n                .spawn()\n                .expect(\"spawn token issuer\");\n            (label, child)\n        })\n        .collect();\n\n    for (label, child) in &mut children {\n        let status = child.wait().expect(\"wait for token issuer\");\n        assert!(status.success(), \"issuer for {label} failed with {status}\");\n    }\n\n    let output = command(home.path())\n        .args([\"tokens\", \"list\"])\n        .output()\n        .expect(\"list tokens after concurrent writes\");\n    assert!(output.status.success());\n    let listing = String::from_utf8(output.stdout).expect(\"UTF-8 token list\");\n    for (label, _) in children {\n        assert!(\n            listing.contains(&label),\n            \"missing concurrent update {label}\"\n        );\n    }\n\n    let data = home.path().join(\"router-data\");\n    assert!(data.join(\"tokens.lino\").exists());\n    assert!(data.join(\"tokens.bin\").exists());\n    assert!(!data.join(\"tokens.transaction.json\").exists());\n}\n","sourceEncoding":{"utf16CodeUnits":1882,"utf8Bytes":1882,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1882,0,1882,-1],["trivia","comment",0,77,0,77,0],["trivia","whitespace",77,78,77,78,0],["trivia","comment",78,114,78,114,0],["trivia","whitespace",114,116,114,116,0],["token","identifier",116,119,116,119,0],["trivia","whitespace",119,120,119,120,0],["token","identifier",120,123,120,123,0],["token","punct",123,125,123,125,0],["token","identifier",125,132,125,132,0],["token","punct",132,134,132,134,0],["group","brace",134,157,134,157,0],["token","delimiter",134,135,134,135,11],["token","identifier",135,140,135,140,11],["token","punct",140,141,140,141,11],["trivia","whitespace",141,142,141,142,11],["token