,"byteStart":141,"byteEnd":876},"sha256":"3422c3d6af7be0988a8a2ee7b6d28938558b4ec4a2867270a0ea127ec40caa0f","source":"#[test]\nfn compatibility_primitive_format_cases() {\n    let value: Text = translation_core::format!(\"core {{text}}\");\n    assert_eq!(value, \"core {text}\");\n    assert_eq!(translation_core::format!(\"{:<5}\", \"Ω\"), \"Ω    \");\n    assert_eq!(translation_core::format!(\"{:>4}\", \"xy\"), \"  xy\");\n    assert_eq!(translation_core::format!(\"{:*^5}\", \"猫\"), \"**猫**\");\n    assert_eq!(translation_core::format!(\"{:.2}\", \"😀猫x\"), \"😀猫\");\n    assert_eq!(translation_core::format!(\"{:#06x}\", 42u8), \"0x002a\");\n    assert_eq!(translation_core::format!(\"{}\", true), \"true\");\n    assert_eq!(translation_core::format!(\"{0}/{0}/{word}\", \"x\", word = \"y\"), \"x/x/y\");\n    assert_eq!(translation_core::format!(r##\"{{{}}} Ω\"##, \"ok\"), \"{ok} Ω\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":141,"end":147},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":860,"end":862,"unit":"utf16","byteStart":876,"byteEnd":878},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"compatibility_operands_are_left_to_right_once","span":{"start":862,"end":1127,"unit":"utf16","byteStart":878,"byteEnd":1143},"sha256":"f716c3bba8e0f2334cbbc69d23426c6de2e06c52ef2668b1221e30bdad6a954e","source":"#[test]\nfn compatibility_operands_are_left_to_right_once() {\n    let mut tape = Vec::new();\n    let output = translation_core::format!(\"{0}:{1}:{0}\", { tape.push(1); 2u8 }, { tape.push(2); 3u8 });\n    assert_eq!(output, \"2:3:2\");\n    assert_eq!(tape, vec![1, 2]);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":862,"end":868},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1127,"end":1129,"unit":"utf16","byteStart":1143,"byteEnd":1145},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"real_accounts_header_matches_the_declared_shared_case","span":{"start":1129,"end":1342,"unit":"utf16","byteStart":1145,"byteEnd":1358},"sha256":"917da48e0d2ba8959b2971264a1f3b8af0317b065a9e4598f62d2f15cb84a239","source":"#[test]\nfn real_accounts_header_matches_the_declared_shared_case() {\n    assert_eq!(link_assistant_router::accounts_cli::header(), \"name              healthy   credential    used    limit      remaining  home\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1129,"end":1135},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1342,"end":1343,"unit":"utf16","byteStart":1358,"byteEnd":1359},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Shared compatibility-core behavior. UNRUN locally; Rust executes in CI only.\nuse link_assistant_router::translation_core::{self, Text};\n\n#[test]\nfn compatibility_primitive_format_cases() {\n    let value: Text = translation_core::format!(\"core {{text}}\");\n    assert_eq!(value, \"core {text}\");\n    assert_eq!(translation_core::format!(\"{:<5}\", \"Ω\"), \"Ω    \");\n    assert_eq!(translation_core::format!(\"{:>4}\", \"xy\"), \"  xy\");\n    assert_eq!(translation_core::format!(\"{:*^5}\", \"猫\"), \"**猫**\");\n    assert_eq!(translation_core::format!(\"{:.2}\", \"😀猫x\"), \"😀猫\");\n    assert_eq!(translation_core::format!(\"{:#06x}\", 42u8), \"0x002a\");\n    assert_eq!(translation_core::format!(\"{}\", true), \"true\");\n    assert_eq!(translation_core::format!(\"{0}/{0}/{word}\", \"x\", word = \"y\"), \"x/x/y\");\n    assert_eq!(translation_core::format!(r##\"{{{}}} Ω\"##, \"ok\"), \"{ok} Ω\");\n}\n\n#[test]\nfn compatibility_operands_are_left_to_right_once() {\n    let mut tape = Vec::new();\n    let output = translation_core::format!(\"{0}:{1}:{0}\", { tape.push(1); 2u8 }, { tape.push(2); 3u8 });\n    assert_eq!(output, \"2:3:2\");\n    assert_eq!(tape, vec![1, 2]);\n}\n\n#[test]\nfn real_accounts_header_matches_the_declared_shared_case() {\n    assert_eq!(link_assistant_router::accounts_cli::header(), \"name              healthy   credential    used    limit      remaining  home\");\n}\n","sourceEncoding":{"utf16CodeUnits":1343,"utf8Bytes":1359,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1343,0,1359,-1],["trivia","comment",0,80,0,80,0],["trivia","whitespace",80,81,80,81,0],["token","identifier",81,84,81,84,0],["trivia","whitespace",84,85,84,85,0],["token","identifier",85,106,85,106,0],["token","punct",106,108,106,108,0],["token","identifier",108,124,108,124,0],["token","punct",124,126,124,126,0],["group","brace",126,138,126,138,0],["token","delimiter",126,127,126,127,9],["token","identifier",127,131,127,131,9],["token","punct",131,132,131,132,9],["trivia","whitespace",132,133,132,133,9],["token","identifier",133,137,133,137,9],["token","delimiter",137,138,137,138,9],["token","punct",138,139,138,139,0],["trivia","whitespace",139,141,139,141,0],["token","punct",141,142,141,142,0],["group","bracket",142,148,142,148,0],["token","delimiter",142,143,142,143,19],["token","identifier",143,147,143,147,19],["token","delimiter",147,148,147,148,19],["trivia","whitespace",148,149,148,149,0],["token","identifier",149,151,149,151,0],["trivia","whitespace",151,152,1