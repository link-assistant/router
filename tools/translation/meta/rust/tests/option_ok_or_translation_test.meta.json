on;\n\n#[test]\nfn activity_validation_preserves_exact_required_field_errors() {\n    for (activity, expected) in [\n        (json!({}), Err(\"activity id is required\")),\n        (json!({\"id\": \"\"}), Err(\"activity id is required\")),\n        (json!({\"id\": \"1\"}), Err(\"activity type is required\")),\n        (\n            json!({\"id\": \"1\", \"type\": false}),\n            Err(\"activity type is required\"),\n        ),\n        (\n            json!({\"id\": \"1\", \"type\": \"Create\"}),\n            Err(\"activity must include actor or attributedTo\"),\n        ),\n        (\n            json!({\"id\": \"1\", \"type\": \"Create\", \"actor\": false}),\n            Err(\"activity must include actor or attributedTo\"),\n        ),\n        (json!({\"id\": \"1\", \"type\": \"Create\", \"actor\": \"\"}), Ok(())),\n        (\n            json!({\"id\": \"Ω😀\\u{0}\", \"type\": \"Create\", \"attributedTo\": \"actor\"}),\n            Ok(()),\n        ),\n    ] {\n        assert_eq!(validate_activity(&activity), expected);\n    }\n}\n\n#[test]\nfn ok_or_evaluates_receiver_then_error_once_even_for_some() {\n    for value in [Some(0_u64), Some(u64::MAX), None] {\n        let calls = RefCell::new(Vec::new());\n        let receive = || {\n            calls.borrow_mut().push(\"receiver\");\n            value\n        };\n        let failure = || {\n            calls.borrow_mut().push(\"error\");\n            \"missing Ω😀\"\n        };\n        let actual = receive().ok_or(failure());\n        #[allow(\n            clippy::manual_ok_or,\n            reason = \"independent match oracle for the eager method\"\n        )]\n        let expected = match value {\n            Some(number) => Ok(number),\n            None => Err(\"missing Ω😀\"),\n        };\n        assert_eq!(actual, expected);\n        assert_eq!(*calls.borrow(), [\"receiver\", \"error\"]);\n    }\n}\n\n#[test]\nfn ok_or_does_not_defer_or_replace_the_eager_panic_payload() {\n    fn failure() -> bool {\n        std::panic::panic_any(205_usize)\n    }\n    for value in [Some(1_u8), None] {\n        let caught = std::panic::catch_unwind(|| value.ok_or(failure()));\n        assert_eq!(caught.unwrap_err().downcast_ref::<usize>(), Some(&205));\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2354,"utf8Bytes":2363,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2354,0,2363,-1],["trivia","comment",0,72,0,72,0],["trivia","whitespace",72,73,72,73,0],["trivia","comment",73,148,73,148,0],["trivia","whitespace",148,150,148,150,0],["token","identifier",150,153,150,153,0],["trivia","whitespace",153,154,153,154,0],["token","identifier",154,157,154,157,0],["token","punct",157,159,157,159,0],["token","identifier",159,163,159,163,0],["token","punct",163,165,163,165,0],["token","identifier",165,172,165,172,0],["token","punct",172,173,172,173,0],["trivia","whitespace",173,175,173,175,0],["token","identifier",175,178,175,178,0],["trivia","whitespace",178,179,178,179,0],["token","identifier",179,200,179,200,0],["token","punct",200,202,200,202,0],["token","identifier",202,213,202,213,0],["token","punct",213,215,213,215,0],["token","identifier",215,232,215,232,0],["token","punct",232,233,232,233,0],["trivia","whitespace",233,234,233,234,0],["token","identifier",234,237,234,237,0],["trivia","whitespace",237,238,237,238,0],["token","identifier",238,248,238,248,0],["token","punct",248,250,248,250,0],["token","identifier",250,254,250,254,0],["token","punct",254,255,254,255,0],["trivia","whitespace",255,257,255,257,0],["token","punct",257,258,257,258,0],["group","bracket",258,264,258,264,0],["token","delimiter",258,259,258,259,31],["token","identifier",259,263,259,263,31],["token","delimiter",263,264,263,264,31],["trivia","whitespace",264,265,264,265,0],["token","identifier",265,267,265,267,0],["trivia","whitespace",267,268,267,268,0],["token","identifier",268,325,268,325,0],["group","paren",325,327,325,32