plete_original_client_launch_option_predicates() {\n    let values = [\n        \"-c\",\n        \"--config\",\n        \"--enable\",\n        \"--disable\",\n        \"-i\",\n        \"--image\",\n        \"-m\",\n        \"--model\",\n        \"--local-provider\",\n        \"--profile\",\n        \"-s\",\n        \"--sandbox\",\n        \"-a\",\n        \"--ask-for-approval\",\n        \"-C\",\n        \"--cd\",\n        \"--add-dir\",\n    ];\n    let flags = [\n        \"--oss\",\n        \"--search\",\n        \"--full-auto\",\n        \"--dangerously-bypass-approvals-and-sandbox\",\n        \"--no-alt-screen\",\n        \"-h\",\n        \"--help\",\n        \"-V\",\n        \"--version\",\n    ];\n    for value in values {\n        assert!(codex_root_option_takes_value(value));\n        assert!(!codex_root_boolean_option(value));\n    }\n    for value in flags {\n        assert!(codex_root_boolean_option(value));\n        assert!(!codex_root_option_takes_value(value));\n    }\n    for value in [\"\", \"--missing\", \"😀\"] {\n        assert!(!codex_root_option_takes_value(value));\n        assert!(!codex_root_boolean_option(value));\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1668,"end":1674},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2747,"end":2748,"unit":"utf16","byteStart":2751,"byteEnd":2752},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Native compatibility oracle; CI only after the complete JavaScript gate.\nuse link_assistant_router::translation_core;\n\n#[test]\nfn literal_patterns_preserve_value_and_subject_order() {\n    assert!(translation_core::matches!(\"--config\", \"-c\" | \"--config\"));\n    assert!(!translation_core::matches!(\"😀\", \"-c\" | \"--config\"));\n    assert!(translation_core::matches!(255_u8, 0_u8 | 255_u8));\n    assert!(translation_core::matches!(true, true));\n    let mut calls = 0;\n    let selected = translation_core::matches!(\n        {\n            calls += 1;\n            7_u8\n        },\n        3_u8 | 7_u8\n    );\n    assert!(selected);\n    assert_eq!(calls, 1);\n}\n\n// Complete original production functions; only the explicit macro API is adopted.\nfn codex_root_option_takes_value(argument: &crate::translation_core::Str) -> bool {\n    crate::translation_core::matches!(\n        argument,\n        \"-c\" | \"--config\"\n            | \"--enable\"\n            | \"--disable\"\n            | \"-i\"\n            | \"--image\"\n            | \"-m\"\n            | \"--model\"\n            | \"--local-provider\"\n            | \"--profile\"\n            | \"-s\"\n            | \"--sandbox\"\n            | \"-a\"\n            | \"--ask-for-approval\"\n            | \"-C\"\n            | \"--cd\"\n            | \"--add-dir\"\n    )\n}\n\nfn codex_root_boolean_option(argument: &crate::translation_core::Str) -> bool {\n    crate::translation_core::matches!(\n        argument,\n        \"--oss\"\n            | \"--search\"\n            | \"--full-auto\"\n            | \"--dangerously-bypass-approvals-and-sandbox\"\n            | \"--no-alt-screen\"\n            | \"-h\"\n            | \"--help\"\n            | \"-V\"\n            | \"--version\"\n    )\n}\n\n#[test]\nfn complete_original_client_launch_option_predicates() {\n    let values = [\n        \"-c\",\n        \"--config\",\n        \"--enable\",\n        \"--disable\",\n        \"-i\",\n        \"--image\",\n        \"-m\",\n        \"--model\",\n        \"--local-provider\",\n        \"--profile\",\n        \"-s\",\n        \"--sandbox\",\n        \"-a\",\n        \"--ask-for-approval\",\n        \"-C\",\n        \"--cd\",\n        \"--add-dir\",\n    ];\n    let flags = [\n        \"--oss\",\n        \"--search\",\n        \"--full-auto\",\n        \"--dangerously-bypass-approvals-and-sandbox\",\n        \"--no-alt-screen\",\n        \"-h\",\n        \"--help\",\n        \"-V\",\n        \"--version\",\n    ];\n    for value in values {\n        assert!(codex_root_option_takes_value(value));\n        assert!(!codex_root_boolean_option(value));\n    }\n    for value in flags {\n        assert!(codex_root_boolean_option(value));\n        assert!(!codex_root_option_takes_value(value));\n    }\n    for value in [\"\", \"--missing\", \"😀\"] {\n        assert!(!codex_root_option_takes_value(value));\n        assert!(!codex_root_boolean_option(value));\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2748,"utf8Bytes":2752,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2748,0,2752,-1],["trivia","comment",0,76,0,76,0],["trivia","whitespace",76,77,76,77,0],["token","identifier",77,80,77,80,0],["trivia","whitespace",80,81,80,81,0],["token","identifier",81,102,81,102,0],["token","punct",102,104,102,104,0],["token","identifier",104,120,104,120,0],["token","punct",120,121,120,121,0],["trivia","whitespace",121,123,121,123,0],["token","punct",123,124,123,124,0],["group","bracket",124,130,124,130,0],["token","delimiter",124,125,124,125,11],["token","identifier",125,129,125,129,11],["token","delimiter",129,130,129,130,11],["trivia","whitespace",130,131,130,131,0],["token","identifier",131,133,131,133,0],["trivia","whitespace",133,134,133,134,0],["token","identifier",134,183,134,183,0],["group","paren",183,185,183,185,0],["token","delimiter",183,184,183,184,19],["token","delimiter",184,185,184,185,19],["trivia","whitespace",185,186,185,186,0],["group","brace",186,653,186,655,0],["token","delimiter",186,187,186,187,23],["trivia","whitespace",187,192,187,192,23],["token","identifier",192,199,192,199,23],["group","paren",199