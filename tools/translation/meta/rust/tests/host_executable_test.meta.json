ume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":78,"unit":"utf16","byteStart":0,"byteEnd":78},"sha256":"d0937958b6b2a723f7f5e85f398d8e35d920c8dd86ebb183278f2e7007003962","source":"//! A real Router CLI keeps working when its installed executable is renamed.\n","status":"preserved","diagnostic":null,"comment":true},{"term":"opaque","name":null,"span":{"start":78,"end":91,"unit":"utf16","byteStart":78,"byteEnd":91},"sha256":"fd53a6e6818666d4971c853bcb20e26ff6211823191477ae9946fb69967e4786","source":"#![cfg(unix)]","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item opaque: no supported library declaration emission","span":{"start":78,"end":91},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":91,"end":93,"unit":"utf16","byteStart":91,"byteEnd":93},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"renamed_router_cli_validates_its_actual_daemon_version","span":{"start":93,"end":1619,"unit":"utf16","byteStart":93,"byteEnd":1619},"sha256":"e0575732e8486f959bf73eab784a37ab204fde56e1aaeaa1f3c0eda499795fe7","source":"#[test]\nfn renamed_router_cli_validates_its_actual_daemon_version() {\n    let root = tempfile::tempdir().unwrap();\n    let installation = root.path().join(\"installation\");\n    std::fs::create_dir(&installation).unwrap();\n    let installation_alias = root.path().join(\"installation-alias\");\n    std::os::unix::fs::symlink(&installation, &installation_alias).unwrap();\n    let binary = installation_alias.join(\"router-installed-under-another-name\");\n    std::fs::copy(env!(\"CARGO_BIN_EXE_router\"), &binary).unwrap();\n    let output = std::process::Command::new(&binary)\n        .args([\"deploy\", \"--mode\", \"host\", \"--status\", \"--json\", \"--root\"])\n        .arg(root.path().join(\"deployment\"))\n        .env_clear()\n        .env(\"HOME\", root.path())\n        .env(\"DATA_DIR\", root.path().join(\"data\"))\n        .env(\"TOKEN_SECRET\", \"renamed-router-fixture-secret\")\n        .env(\"STORAGE_POLICY\", \"text\")\n        .current_dir(root.path())\n        .output()\n        .unwrap();\n    assert!(\n        output.status.success(),\n        \"{} {}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n    let report: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();\n    assert_eq!(\n        report[\"data\"][\"host_router\"][\"executable\"],\n        binary.canonicalize().unwrap().to_str().unwrap()\n    );\n    assert_eq!(\n        report[\"data\"][\"host_router\"][\"version\"],\n        link_assistant_router::VERSION\n    );\n    assert_eq!(report[\"data\"][\"status_is_read_only\"], true);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":93,"end":99},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1619,"end":1620,"unit":"utf16","byteStart":1619,"byteEnd":1620},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! A real Router CLI keeps working when its installed executable is renamed.\n#![cfg(unix)]\n\n#[test]\nfn renamed_router_cli_validates_its_actual_daemon_version() {\n    let root = tempfile::tempdir().unwrap();\n    let installation = root.path().join(\"installation\");\n    std::fs::create_dir(&installation).unwrap();\n    let installation_alias = root.path().join(\"installation-alias\");\n    std::os::unix::fs::symlink(&installation, &installation_alias).unwrap();\n    let binary = installation_alias.join(\"router-installed-under-another-name\");\n    std::fs::copy(env!(\"CARGO_BIN_EXE_router\"), &binary).unwrap();\n    let output = std::process::Command::new(&binary)\n        .args([\"deploy\", \"--mode\", \"host\", \"--status\", \"--json\", \"--root\"])\n        .arg(root.path().join(\"deployment\"))\n        .env_clear()\n        .env(\"HOME\", root.path())\n        .env(\"DATA_DIR\", root.path().join(\"data\"))\n        .env(\"TOKEN_SECRET\", \"renamed-router-fixture-secret\")\n        .env(\"STORAGE_POLICY\", \"text\")\n        .current_dir(root.path())\n        .output()\n        .unwrap();\n    assert!(\n        output.status.success(),\n        \"{} {}\",\n        String::from_utf8_lossy(&output.stdout),\n        String::from_utf8_lossy(&output.stderr)\n    );\n    let report: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();\n    assert_eq!(\n        report[\"data\"][\"host_router\"][\"executable\"],\n        binary.canonicalize().unwrap().to_str().unwrap()\n    );\n    assert_eq!(\n        report[\"data\"][\"host_router\"][\"version\"],\n        link_assistant_router::VERSION\n    );\n    assert_eq!(report[\"data\"][\"status_is_read_only\"], true);\n}\n","sourceEncoding":