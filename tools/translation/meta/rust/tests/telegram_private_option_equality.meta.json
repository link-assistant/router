:{"start":200,"end":230,"unit":"utf16","byteStart":200,"byteEnd":230},"sha256":"6516041db96a99b0e62b88caae0f1c7a9dbcfee4831ad98d3dcd81ac0f4e7ede","source":"use serde_json::{Value, json};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":200,"end":230},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":230,"end":232,"unit":"utf16","byteStart":230,"byteEnd":232},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"private_chat_requires_the_exact_original_string","span":{"start":232,"end":633,"unit":"utf16","byteStart":232,"byteEnd":637},"sha256":"733fe1e80fcd50b3b8e98933bf6714cd7be5c4312d81e81d5d34b0100df1bbb0","source":"#[test]\nfn private_chat_requires_the_exact_original_string() {\n    assert!(is_private(&json!({\"chat\": {\"type\": \"private\"}})));\n    for kind in [\n        \"\",\n        \"group\",\n        \"supergroup\",\n        \"Private\",\n        \" private\",\n        \"private \",\n        \"private\\0\",\n        \"prívate\",\n        \"Ω😀\",\n    ] {\n        assert!(!is_private(&json!({\"chat\": {\"type\": kind}})), \"{kind:?}\");\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":232,"end":238},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":633,"end":635,"unit":"utf16","byteStart":637,"byteEnd":639},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"missing_and_non_string_chat_types_never_become_private","span":{"start":635,"end":1328,"unit":"utf16","byteStart":639,"byteEnd":1335},"sha256":"d8d39277531478df54eefc926aa4eb4cedd90ce577d2418288dcd24ecc0a5606","source":"#[test]\nfn missing_and_non_string_chat_types_never_become_private() {\n    for message in [\n        Value::Null,\n        json!([]),\n        json!({}),\n        json!({\"chat\": null}),\n        json!({\"chat\": []}),\n        json!({\"chat\": {}}),\n        json!({\"chat\": {\"type\": null}}),\n        json!({\"chat\": {\"type\": false}}),\n        json!({\"chat\": {\"type\": 1}}),\n        json!({\"chat\": {\"type\": 1.5}}),\n        json!({\"chat\": {\"type\": []}}),\n        json!({\"chat\": {\"type\": {}}}),\n    ] {\n        assert!(!is_private(&message), \"{message}\");\n    }\n    assert!(is_private(&json!({\n        \"chat\": {\"type\": \"private\", \"unrelated\": \"Ω😀\\0\"},\n        \"unrelated\": [null, false, \"private\"]\n    })));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":635,"end":641},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1328,"end":1330,"unit":"utf16","byteStart":1335,"byteEnd":1337},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"borrowed_option_equality_distinguishes_all_four_variant_pairs","span":{"start":1330,"end":1861,"unit":"utf16","byteStart":1337,"byteEnd":1871},"sha256":"da8773ecb0ef307b160ed7a4e2b17039901bc9f10bda37aea0d2f8d66cd62b9f","source":"#[test]\nfn borrowed_option_equality_distinguishes_all_four_variant_pairs() {\n    let values = [None, Some(\"\"), Some(\"private\"), Some(\"Ω😀\"), Some(\"a\\0b\")];\n    for left in values {\n        for right in values {\n            let expected = match (left, right) {\n                (Some(a), Some(b)) => a.as_bytes() == b.as_bytes(),\n                (None, None) => true,\n                (Some(_), None) | (None, Some(_)) => false,\n            };\n            assert_eq!(left == right, expected, \"{left:?} / {right:?}\");\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1330,"end":1336},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1861,"end":1862,"unit":"utf16","byteStart":1871,"byteEnd":1872},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Original production callers stay unchanged. These independent source\n//! regressions are Cargo integration tests, intended for CI execution only.\n\nuse link_assistant_router::telegram::is_private;\nuse serde_json::{Value, json};\n\n#[test]\nfn private_chat_requires_the_exact_original_string() {\n    assert!(is_private(&json!({\"chat\": {\"type\": \"private\"}})));\n    for kind in [\n        \"\",\n        \"group\",\n        \"supergroup\",\n        \"Private\",\n        \" private\",\n        \"private \",\n        \"private\\0\",\n        \"prívate\",\n        \"Ω😀\",\n    ] {\n        assert!(!is_private(&json!({\"chat\": {\"type\": kind}})), \"{kind:?}\");\n    }\n}\n\n#[test]\nfn missing_and_non_string_chat_types_never_become_private() {\n    for message in [\n        Value::Null,\n        json!([]),\n        json!({}),\n        json!({\"chat\": null}),\n        json!({\"chat\": []}),\n        json!({\"chat\": {}}),\n        json!({\"chat\": {\"type\": null}}),\n        json!({\"chat\": {\"type\": false}}),\n        json!({\"chat\": {\"type\": 1}}),\n        json!({\"chat\": {\"type\": 1.5}}),\n        json!({\"chat\": {\"type\": []}}),\n        json!({\"chat\": {\"type\": {}}}),\n    ] {\n        assert!(!is_private(&message), \"{message}\");\n    }\n    assert!(is_private(&json!({\n        \"chat\": {\"type\": \"private\", \"unrelated\": \