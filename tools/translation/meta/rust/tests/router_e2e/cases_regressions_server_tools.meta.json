etic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":2},"items":[{"term":"use","name":"super","span":{"start":0,"end":13,"unit":"utf16","byteStart":0,"byteEnd":13},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":0,"end":13},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":13,"end":466,"unit":"utf16","byteStart":13,"byteEnd":466},"sha256":"304af01bf301def3216ec26863b39b4cb2c8e316772dacb33d1443ca2fd8dea1","source":"\n\n/// Issue #187 (comment): an Anthropic `web_search_20250305` request with\n/// `tool_choice: {\"type\":\"any\"}` against a Codex model returned nothing for\n/// more than eighty seconds. `any` demands a function call, but the only tool\n/// offered is executed by the backend and never surfaces as one, so the\n/// upstream had no way to comply. Every input protocol must answer such a\n/// request promptly instead of stalling, and must not reach the vendor.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_forced_call_on_server_tools_only_fails_fast_on_every_surface","span":{"start":466,"end":2477,"unit":"utf16","byteStart":466,"byteEnd":2477},"sha256":"84068690e145783fb03b7fac40243bf2788cea2dc498da33b53e717317cfadf5","source":"#[tokio::test]\nasync fn a_forced_call_on_server_tools_only_fails_fast_on_every_surface() {\n    let router = TestRouter::start(UpstreamProvider::Codex).await;\n    let cases = [\n        (\n            \"/api/services/anthropic/v1/messages\",\n            json!({\n                \"model\":\"gpt-5\",\n                \"max_tokens\":256,\n                \"messages\":[{\"role\":\"user\",\"content\":\"research Rust\"}],\n                \"tools\":[{\"type\":\"web_search_20250305\",\"name\":\"web_search\",\"max_uses\":1}],\n                \"tool_choice\":{\"type\":\"any\"}\n            }),\n        ),\n        (\n            \"/api/services/openai/v1/chat/completions\",\n            json!({\n                \"model\":\"gpt-5\",\n                \"messages\":[{\"role\":\"user\",\"content\":\"research Rust\"}],\n                \"tools\":[{\"type\":\"web_search\"}],\n                \"tool_choice\":\"required\"\n            }),\n        ),\n        (\n            \"/api/services/openai/v1/responses\",\n            json!({\n                \"model\":\"gpt-5\",\n                \"input\":\"research Rust\",\n                \"tools\":[{\"type\":\"web_search\"}],\n                \"tool_choice\":\"required\"\n            }),\n        ),\n    ];\n\n    for (path, body) in cases {\n        let started = std::time::Instant::now();\n        let response = tokio::time::timeout(\n            std::time::Duration::from_secs(10),\n            router.post(path, &body).send(),\n        )\n        .await\n        .unwrap_or_else(|_| panic!(\"{path} never answered\"))\n        .expect(\"server-tool response\");\n        assert_eq!(response.status(), StatusCode::BAD_REQUEST, \"{path}\");\n        assert!(started.elapsed() < std::time::Duration::from_secs(10));\n        let payload: Value = response.json().await.expect(\"error JSON\");\n        let message = payload\n            .pointer(\"/error/message\")\n            .and_then(Value::as_str)\n            .expect(\"error message\");\n        assert!(message.contains(\"server-side tools\"), \"{path}: {message}\");\n    }\n    assert!(router.requests.lock().expect(\"stub requests\").is_empty());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[tokio]: attributes that change compilation are outside the portable core","span":{"start":466,"end":473},"details":{"construct":"#[tokio]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2477,"end":2478,"unit":"utf16","byteStart":2477,"byteEnd":2478},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use super::*;\n\n/// Issue #187 (comment): an Anthropic `web_search_20250305` request with\n/// `tool_choice: {\"type\":\"any\"}` against a Codex model returned nothing for\n/// more than eighty seconds. `any` demands a function call, but the only tool\n/// offered is executed by the backend and never surfaces as one, so the\n/// upstream had no way to comply. Every input protocol must answer such a\n/// request promptly instead of stalling, and must not reach the vendor.\n#[tokio::test]\nasync fn a_forced_call_on_server_tools_only_fails_fast_on_every_surface() {\n    let router = TestRouter::start(UpstreamProvider::Codex).await;\n    let cases = [\n        (\n            \"/api/services/anthropic/v1/messages\",\n            json!({\n                \"model\":\"gpt-5\",\n                \"max_tokens\":256,\n                \"messages\":[{\"role\":\"user\",\"content\":\"research Rust\"}],\n                \"tools\":[{\"type\":\"web_search_20250305\",\"name\":\"web_search\",\"max_uses\":1}],\n                \"tool_choice\":{\"type\":\"any\"}\n            }),\n        ),\n        (\n            \"/api/services/openai/v1/chat/completions\",\n            json!({\n                \"model\":\"gpt-5\",\n                \"messages\":[{\"role\":\"user\",\"content\":\"research Rust\"}],\n                \"tools\":[{\"type\":\"web_search\"}],\n                \"tool_choice\":\"required\"\n            }),\n        ),\n        (\n            \"/api/services/openai/v1/responses\",\n            json!({\n                \"model\":\"gpt-5\",\n                \"input\":\"research Rust\",\n                \"tools\":[{\"type\":\"web_search\"}],\n                \"tool_choice\":\"required\"\n            }),\n        ),\n    ];\n\n    for (path, body) in cases {\n        let started = std::time::Instant::now();\n        let response = tokio::time::timeout(\n            std::time::Duration::from_secs(10),\n            router.post(path, &body).send(),\n        )\n        .await\n        .unwrap_or_else(|_| panic!(\"{path} never answered\"))\n        .expect(\"server-tool response\");\n        assert_eq!(response.status(), StatusCode::BAD_REQUEST, \"{path}\");\n        assert!(started.elapsed() < std::time::Duration::from_secs(10));\n        let payload: Value = response.json().await.expect(\"error JSON\");\n        let message = payload\n            .pointer(\"/error/message\")\n            .and_then(Value::as_str)\n            .expect(\"error message\");\n        assert!(message.contains(\"server-side tools\"), \"{path}: {message}\");\n    }\n    assert!(router.requests.lock().expect(\"stub requests\").is_empty());\n}\n","sourceEncoding":{"utf16CodeUnits":2478,"utf8Bytes":2478,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2478,0,2478,-1],["token","identifier",0,3,0,3,0],["trivia","whitespace",3,4,3,4,0],["token","identifier",4,9,4,9,0],["token","punct",9,11,9,11,0],["token","punct",11,12,1