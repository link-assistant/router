ze assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":2},"items":[{"term":"use","name":"super","span":{"start":0,"end":13,"unit":"utf16","byteStart":0,"byteEnd":13},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":0,"end":13},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":13,"end":426,"unit":"utf16","byteStart":13,"byteEnd":426},"sha256":"caefa5cf6f222ab74301af9c9840edf7d888594f07f8c9a17dd4e580b0bc93b3","source":"\n\n/// Chat Completions owns its request contract before any provider is selected.\n///\n/// A missing `messages` field used to reach Codex as an empty Responses\n/// `input`, while passthrough providers received the invalid body verbatim and\n/// automatic routing could fail on the model first. Besides leaking the wrong\n/// dialect, that made the same public request depend on the chosen upstream\n/// (issue #387).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"missing_chat_messages_is_rejected_locally_for_every_provider","span":{"start":426,"end":2231,"unit":"utf16","byteStart":426,"byteEnd":2231},"sha256":"1ecdcf8b47cce9beb247436bcb6f55f0bc8f19eb18e9beff7a166f604769b4b0","source":"#[tokio::test]\nasync fn missing_chat_messages_is_rejected_locally_for_every_provider() {\n    for provider in [\n        UpstreamProvider::Auto,\n        UpstreamProvider::Anthropic,\n        UpstreamProvider::Gonka,\n        UpstreamProvider::Crater,\n        UpstreamProvider::Codex,\n        UpstreamProvider::Gemini,\n        UpstreamProvider::Qwen,\n        UpstreamProvider::OpenAICompatible,\n    ] {\n        let router = TestRouter::start(provider).await;\n        let response = router\n            .post(\n                \"/api/services/openai/v1/chat/completions\",\n                &json!({\"model\":\"gpt-5\"}),\n            )\n            .send()\n            .await\n            .expect(\"invalid Chat Completions response\");\n\n        assert_eq!(response.status(), StatusCode::BAD_REQUEST, \"{provider:?}\");\n        assert_eq!(\n            response\n                .headers()\n                .get(\"content-type\")\n                .and_then(|value| value.to_str().ok()),\n            Some(\"application/json\"),\n            \"{provider:?}\"\n        );\n        let payload: Value = response.json().await.expect(\"OpenAI error envelope\");\n        assert_eq!(\n            payload[\"error\"][\"type\"], \"invalid_request_error\",\n            \"{provider:?}: {payload}\"\n        );\n        let message = payload[\"error\"][\"message\"].as_str().expect(\"error message\");\n        assert!(message.contains(\"messages\"), \"{provider:?}: {message}\");\n        for leaked in [\"input\", \"previous_response_id\", \"prompt\", \"conversation\"] {\n            assert!(\n                !message.contains(leaked),\n                \"{provider:?} leaked {leaked}: {message}\"\n            );\n        }\n        assert!(\n            router.requests.lock().expect(\"stub requests\").is_empty(),\n            \"{provider:?} forwarded a client-schema error\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[tokio]: attributes that change compilation are outside the portable core","span":{"start":426,"end":433},"details":{"construct":"#[tokio]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2231,"end":2232,"unit":"utf16","byteStart":2231,"byteEnd":2232},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use super::*;\n\n/// Chat Completions owns its request contract before any provider is selected.\n///\n/// A missing `messages` field used to reach Codex as an empty Responses\n/// `input`, while passthrough providers received the invalid body verbatim and\n/// automatic routing could fail on the model first. Besides leaking the wrong\n/// dialect, that made the same public request depend on the chosen upstream\n/// (issue #387).\n#[tokio::test]\nasync fn missing_chat_messages_is_rejected_locally_for_every_provider() {\n    for provider in [\n        UpstreamProvider::Auto,\n        UpstreamProvider::Anthropic,\n        UpstreamProvider::Gonka,\n        UpstreamProvider::Crater,\n        UpstreamProvider::Codex,\n        UpstreamProvider::Gemini,\n        UpstreamProvider::Qwen,\n        UpstreamProvider::OpenAICompatible,\n    ] {\n        let router = TestRouter::start(provider).await;\n        let response = router\n            .post(\n                \"/api/services/openai/v1/chat/completions\",\n                &json!({\"model\":\"gpt-5\"}),\n            )\n            .send()\n            .await\n            .expect(\"invalid Chat Completions response\");\n\n        assert_eq!(response.status(), StatusCode::BAD_REQUEST, \"{provider:?}\");\n        assert_eq!(\n            response\n                .headers()\n                .get(\"content-type\")\n                .and_then(|value| value.to_str().ok()),\n            Some(\"application/json\"),\n            \"{provider:?}\"\n        );\n        let payload: Value = response.json().await.expect(\"OpenAI error envelope\");\n        assert_eq!(\n            payload[\"error\"][\"type\"], \"invalid_request_error\",\n            \"{provider:?}: {payload}\"\n        );\n        let message = payload[\"error\"][\"message\"].as_str().expect(\"error message\");\n        assert!(message.contains(\"messages\"), \"{provider:?}: {message}\");\n        for leaked in [\"input\", \"previous_response_id\", \"prompt\", \"conversation\"] {\n            assert!(\n                !message.contains(leaked),\n                \"{provider:?} leaked {leaked}: {message}\"\n            );\n        }\n        assert!(\n            router.requests.lock().expect(\"stub requests\").is_empty(),\n            \"{provider:?} forwarded a client-schema error\"\n        );\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2232,"utf8Bytes":2232,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2232,0,2232,-1],["token","identifier",0,3,0,3,0],["trivia","whitespace",3,4,3,4,0],["token","identifier",4,9,4,9,0],["token","punct",9,11,9,11,0],["token","punct",11,12,11,12,0],["token","punct",12,13,12,13,0],["trivia","whitespace",13,15,13,15,0],["trivia","comment",15,94,15,94,0],["trivia","whitespace",94,95,94,95,0],["trivia","comment",95,98,95,98,0],["trivia","whitespace",98,99,98,99,0],["trivia","comment",99,171,99,171,0],["trivia","whitespace",171,172,171,172,0],["trivia","comment",172,251,172,251,0],["trivia","whitespace",251,252,251,252,0],["trivia","comment",252,330,252,330,0],["trivia","whitespace",330,331,330,331,0],["trivia","comment",331,407,331,407,0],["trivia","whitespace",407,408,407,408,0],["trivia","comment",408,425,408,425,0],["trivia","whitespace",425,426,425,426