8,"byteEnd":380},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"conditions","span":{"start":380,"end":1999,"unit":"utf16","byteStart":380,"byteEnd":1999},"sha256":"6c32d11ab6523dc5895fe7adc8a6dac4602d088af77adc66d060f244c8b37a9b","source":"mod conditions {\n    include!(concat!(\n        env!(\"CARGO_MANIFEST_DIR\"),\n        \"/../tools/translation/test/fixtures/namespace-condition/oracle.rs\"\n    ));\n\n    #[test]\n    fn original_condition_fixture_preserves_short_circuit_and_while_let() {\n        main();\n    }\n\n    #[test]\n    fn every_boolean_and_option_boundary_preserves_evaluation_order() {\n        for first in [false, true] {\n            for value in [None, Some(0), Some(1), Some(u8::MAX)] {\n                for last in [false, true] {\n                    let expected_result = first && value.is_some_and(|v| v > 0) && last;\n                    let expected_trace = if !first {\n                        vec![\"first\"]\n                    } else if value.is_none() {\n                        vec![\"first\", \"next\"]\n                    } else {\n                        vec![\"first\", \"next\", \"last\"]\n                    };\n                    assert_eq!(\n                        condition(first, value, last),\n                        (expected_result, expected_trace)\n                    );\n                }\n            }\n        }\n    }\n\n    #[test]\n    fn while_let_observes_reverse_order_and_does_not_enter_for_empty_input() {\n        for input in [vec![], vec![0], vec![0, 1, u8::MAX]] {\n            let expected: Vec<_> = input.iter().rev().copied().collect();\n            let mut remaining = input;\n            let mut observed = Vec::new();\n            while let Some(value) = remaining.pop() {\n                observed.push(value);\n            }\n            assert_eq!(observed, expected);\n            assert!(remaining.is_empty());\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item mod: no supported library declaration emission","span":{"start":380,"end":1999},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1999,"end":2000,"unit":"utf16","byteStart":1999,"byteEnd":2000},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Independent source oracles, executed by Cargo only in gated CI.\n//! No local Rust compilation or execution qualified this source.\n\nmod literal_include {\n    // Keep the fixture's own physical callsites: oracle -> parent -> child.\n    include!(concat!(\n        env!(\"CARGO_MANIFEST_DIR\"),\n        \"/../tools/translation/test/fixtures/literal-include-type/oracle.rs\"\n    ));\n}\n\nmod conditions {\n    include!(concat!(\n        env!(\"CARGO_MANIFEST_DIR\"),\n        \"/../tools/translation/test/fixtures/namespace-condition/oracle.rs\"\n    ));\n\n    #[test]\n    fn original_condition_fixture_preserves_short_circuit_and_while_let() {\n        main();\n    }\n\n    #[test]\n    fn every_boolean_and_option_boundary_preserves_evaluation_order() {\n        for first in [false, true] {\n            for value in [None, Some(0), Some(1), Some(u8::MAX)] {\n                for last in [false, true] {\n                    let expected_result = first && value.is_some_and(|v| v > 0) && last;\n                    let expected_trace = if !first {\n                        vec![\"first\"]\n                    } else if value.is_none() {\n                        vec![\"first\", \"next\"]\n                    } else {\n                        vec![\"first\", \"next\", \"last\"]\n                    };\n                    assert_eq!(\n                        condition(first, value, last),\n                        (expected_result, expected_trace)\n                    );\n                }\n            }\n        }\n    }\n\n    #[test]\n    fn while_let_observes_reverse_order_and_does_not_enter_for_empty_input() {\n        for input in [vec![], vec![0], vec![0, 1, u8::MAX]] {\n            let expected: Vec<_> = input.iter().rev().copied().collect();\n            let mut remaining = input;\n            let mut observed = Vec::new();\n            while let Some(value) = remaining.pop() {\n                observed.push(value);\n            }\n            assert_eq!(observed, expected);\n            assert!(remaining.is_empty());\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2000,"utf8Bytes":2000,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2000,0,2000,-1],["trivia","comment",0,67,0,67,0],["trivia","whitespace",67,68,67,68,0],["trivia","comment",68,133,68,133,0],["trivia","whitespace",133,135,133,135,0],["token","identifier",135,138,135,138,0],["trivia","whitespace",138,139,138,139,0],["token","identifier",139,154,139,154,0],["trivia","whitespace",154,155,154,155,0],["group","brace",155,378,155,378,0],["token","delimiter",155,156,155,156,9],["trivia","whitespace",156,161,156,161,9],["trivia","comment",161,233,161,233,9],["trivia","whitespace",233,238,233,238,9],["token","identifier",238,246,238,246,9],["group","paren",246,375,246,375,9],["token","delimiter",246,247,246,247,15],["token","identifier",247,254,247,254,15],["group","paren",254,374,254,374,15],["token","delimiter",254,255,254,255,18],["trivia","whitespace",255,264,255,264,18],["token","identifier",264,268,264,268,18],["group","paren",268,290,268,290,18],["token","delimiter",268,269,268,269,22],["token","string",269,289,269,289,22],["token","delimiter",289,290,289,290,22],["token","punct",290,291,290,291,18],["trivia","whitespace",291,300,291,300,18],["token","string",300,368,300,368,18],["