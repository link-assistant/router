Instant};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":202,"end":237},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":237,"end":239,"unit":"utf16","byteStart":237,"byteEnd":239},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"aborting_a_pty_cleans_up_a_hup_ignoring_grandchild","span":{"start":239,"end":1293,"unit":"utf16","byteStart":239,"byteEnd":1293},"sha256":"2e5cae4f38db85c8c9455c359dc515dcf87675a33282ef50d1ffa98e1a39ecb5","source":"#[test]\nfn aborting_a_pty_cleans_up_a_hup_ignoring_grandchild() {\n    let mut command = CommandBuilder::new(\"sh\");\n    command.args([\"-c\", \"trap '' HUP; sleep 30 & echo CHILD:$!; wait\"]);\n    let session = PtySession::spawn(command).unwrap();\n    let transcript = session\n        .wait_for(\n            |text| text.contains(\"CHILD:\"),\n            Duration::from_millis(20),\n            Duration::from_secs(3),\n        )\n        .unwrap();\n    let pid = transcript\n        .split(\"CHILD:\")\n        .nth(1)\n        .unwrap()\n        .split_whitespace()\n        .next()\n        .unwrap();\n    let start = Instant::now();\n    drop(session);\n    assert!(\n        start.elapsed() < Duration::from_secs(3),\n        \"cleanup was not bounded\"\n    );\n    let status = Command::new(\"ps\")\n        .args([\"-p\", pid, \"-o\", \"stat=\"])\n        .output()\n        .unwrap();\n    let state = String::from_utf8_lossy(&status.stdout);\n    assert!(\n        state.trim().is_empty() || state.trim().starts_with('Z'),\n        \"verification child remains running: {state}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":239,"end":245},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1293,"end":1294,"unit":"utf16","byteStart":1293,"byteEnd":1294},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Cancellation owns the verification process tree, including PTY children.\n#![cfg(unix)]\nuse link_assistant_router::login_pty::PtySession;\nuse portable_pty::CommandBuilder;\nuse std::process::Command;\nuse std::time::{Duration, Instant};\n\n#[test]\nfn aborting_a_pty_cleans_up_a_hup_ignoring_grandchild() {\n    let mut command = CommandBuilder::new(\"sh\");\n    command.args([\"-c\", \"trap '' HUP; sleep 30 & echo CHILD:$!; wait\"]);\n    let session = PtySession::spawn(command).unwrap();\n    let transcript = session\n        .wait_for(\n            |text| text.contains(\"CHILD:\"),\n            Duration::from_millis(20),\n            Duration::from_secs(3),\n        )\n        .unwrap();\n    let pid = transcript\n        .split(\"CHILD:\")\n        .nth(1)\n        .unwrap()\n        .split_whitespace()\n        .next()\n        .unwrap();\n    let start = Instant::now();\n    drop(session);\n    assert!(\n        start.elapsed() < Duration::from_secs(3),\n        \"cleanup was not bounded\"\n    );\n    let status = Command::new(\"ps\")\n        .args([\"-p\", pid, \"-o\", \"stat=\"])\n        .output()\n        .unwrap();\n    let state = String::from_utf8_lossy(&status.stdout);\n    assert!(\n        state.trim().is_empty() || state.trim().starts_with('Z'),\n        \"verification child remains running: {state}\"\n    );\n}\n","sourceEncoding":{"utf16CodeUnits":1294,"utf8Bytes":1294,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1294,0,1294,-1],["trivia","comment",0,76,0,76,0],["trivia","wh