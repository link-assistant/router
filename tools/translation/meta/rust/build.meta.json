ain() {\n    println!(\"cargo:rerun-if-env-changed=ROUTER_SOURCE_COMMIT\");\n    // Resolve metadata from the crate directory, including linked worktrees.\n    for name in [\"HEAD\", \"refs\", \"packed-refs\"] {\n        if let Ok(output) = Command::new(\"git\").args([\"rev-parse\", \"--git-path\", name]).output() {\n            if output.status.success() {\n                let path = String::from_utf8_lossy(&output.stdout);\n                let path = path.trim();\n                if !path.is_empty() && !path.contains(['\\n', '\\r']) {\n                    println!(\"cargo:rerun-if-changed={path}\");\n                }\n            }\n        }\n    }\n    let commit = std::env::var(\"ROUTER_SOURCE_COMMIT\")\n        .ok()\n        .or_else(|| {\n            Command::new(\"git\")\n                .args([\"rev-parse\", \"HEAD\"])\n                .output()\n                .ok()\n                .filter(|output| output.status.success())\n                .map(|output| String::from_utf8_lossy(&output.stdout).trim().to_owned())\n        })\n        .unwrap_or_else(|| \"unknown\".into());\n    assert!(\n        commit == \"unknown\"\n            || (commit.len() == 40 && commit.bytes().all(|byte| byte.is_ascii_hexdigit())),\n        \"invalid ROUTER_SOURCE_COMMIT\"\n    );\n    println!(\"cargo:rustc-env=ROUTER_SOURCE_COMMIT={commit}\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":102,"end":1399},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1399,"end":1400,"unit":"utf16","byteStart":1399,"byteEnd":1400},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Embed immutable source metadata without changing the package version.\nuse s