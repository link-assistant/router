sume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":65,"unit":"utf16","byteStart":0,"byteEnd":65},"sha256":"bf16baa3a881caa1d87657b35ee0a6e8647f8554ab4ed183db19d8a9a6809a32","source":"//! Import operations directly; never execute the Router binary.\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"link_assistant_router","span":{"start":65,"end":158,"unit":"utf16","byteStart":65,"byteEnd":158},"sha256":"e64e370d069948e8114eb564617d77fab4c3342c32ef9c0ef22c68c77d13814e","source":"use link_assistant_router::{cli, contracts, operation_context::OperationContext, operations};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":65,"end":158},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":158,"end":160,"unit":"utf16","byteStart":158,"byteEnd":160},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":160,"end":1654,"unit":"utf16","byteStart":160,"byteEnd":1654},"sha256":"874fcd65951ac2072be33a73962e5868a13274bea30d66ed99b388d18862f9d5","source":"#[tokio::main]\nasync fn main() -> Result<(), Box<dyn std::error::Error>> {\n    let home = tempfile::tempdir()?;\n    let mut context = OperationContext::isolated(home.path());\n    context.set_env(\"TOKEN_SECRET\", \"example-isolated-secret\");\n    context.set_env(\"STORAGE_POLICY\", \"text\");\n    let version = operations::request(context.clone(), cli::Command::Version).await?;\n    assert_eq!(version.data[\"version\"], link_assistant_router::VERSION);\n    let issued = context.scope(|| {\n        cli::try_parse_arguments(vec![\n            \"router\".into(),\n            \"tokens\".into(),\n            \"issue\".into(),\n            \"--label\".into(),\n            \"example\".into(),\n        ])\n    })?;\n    let issued = operations::execute(context.clone(), issued).await?;\n    assert!(issued.data[\"token\"].as_str().unwrap().starts_with(\"la_sk_\"));\n    // Use the same entry point for every catalog operation. Each command's\n    // help supplies a complete invocation without executing that operation.\n    for operation in contracts::operations() {\n        let mut arguments = vec![\"router\".into()];\n        arguments.extend(\n            operation[\"command\"]\n                .as_array()\n                .unwrap()\n                .iter()\n                .map(|argument| argument.as_str().unwrap().into()),\n        );\n        arguments.push(\"--help\".into());\n        assert!(\n            context\n                .scope(|| cli::try_parse_arguments(arguments))\n                .is_err()\n        );\n    }\n    Ok(())\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":160,"end":1654},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1654,"end":1655,"unit":"utf16","byteStart":1654,"byteEnd":1655},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Import operations directly; never execute the Router binary.\nuse link_assistant_router::{cli, contracts, operation_context::OperationContext, operations};\n\n#[tokio::main]\nasync fn main() -> Result<(), Box<dyn std::error::Error>> {\n    let home = tempfile::tempdir()?;\n    let mut context = OperationContext::isolated(home.path());\n    context.set_env(\"TOKEN_SECRET\", \"example-isolated-secret\");\n    context.set_env(\"STORAGE_POLICY\", \"text\");\n    let version = operations::request(context.clone(), cli::Command::Version).await?;\n    assert_eq!(version.data[\"version\"], link_assistant_router::VERSION);\n    let issued = context.scope(|| {\n        cli::try_parse_arguments(vec![\n            \"router\".into(),\n            \"tokens\".into(),\n            \"issue\".into(),\n            \"--label\".into(),\n            \"example\".into(),\n        ])\n    })?;\n    let issued = operations::execute(context.clone(), issued).await?;\n    assert!(issued.data[\"token\"].as_str().unwrap().starts_with(\"la_sk_\"));\n    // Use the same entry point for every catalog operation. Each command's\n    // help supplies a complete invocation without executing that operation.\n    for operation in contracts::operations() {\n        let mut arguments = vec![\"router\".into()];\n        arguments.extend(\n            operation[\"command\"]\n                .as_array()\n                .unwrap()\n                .iter()\n                .map(|argument| argument.as_str().unwrap().into()),\n        );\n        arguments.push(\"--help\".into());\n        assert!(\n            context\n                .scope(|| cli::try_parse_arguments(arguments))\n                .is_err()\n        );\n    }\n    Ok(())\n}\n","sourceEncoding":{"utf16CodeUnits":1655,"utf8Bytes":1