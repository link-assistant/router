 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":180,"unit":"utf16","byteStart":0,"byteEnd":180},"sha256":"b6853684e49ea6ab8983b42003e29dce67b7b2d7864af8ab8d9bd5a184ba0035","source":"//! Basic usage example for Link.Assistant.Router token management.\n//!\n//! Demonstrates issuing and validating custom tokens.\n//!\n//! Run with: `cargo run --example basic_usage`\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"link_assistant_router","span":{"start":180,"end":227,"unit":"utf16","byteStart":180,"byteEnd":227},"sha256":"1b8814219ff48df63d9111434854d544aa0b2ca79901fbd7718fe908417b904c","source":"use link_assistant_router::token::TokenManager;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":180,"end":227},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":227,"end":229,"unit":"utf16","byteStart":227,"byteEnd":229},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":229,"end":1030,"unit":"utf16","byteStart":229,"byteEnd":1030},"sha256":"1201dfe8f503c26fa1c25653037d6d14bf8ab46c7e18dbdc844acc751ebfbf56","source":"fn main() {\n    let manager = TokenManager::new(\"example-secret-key\");\n\n    // Issue a token\n    let token = manager\n        .issue_token(24, \"demo-user\")\n        .expect(\"Failed to issue token\");\n    println!(\"Issued token: {token}\");\n\n    // Validate the token\n    let claims = manager\n        .validate_token(&token)\n        .expect(\"Token should be valid\");\n    println!(\"Token ID: {}\", claims.sub);\n    println!(\"Label: {}\", claims.label);\n    println!(\"Expires at: {}\", claims.exp);\n\n    // Revoke the token\n    manager.revoke_token(&claims.sub).expect(\"Should revoke\");\n    println!(\"Token revoked.\");\n\n    // Try to validate again\n    match manager.validate_token(&token) {\n        Ok(_) => println!(\"Token still valid (unexpected)\"),\n        Err(e) => println!(\"Token rejected: {e}\"),\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":229,"end":1030},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1030,"end":1031,"unit":"utf16","byteStart":1030,"byteEnd":1031},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Basic usage example for Link.Assistant.Router token management.\n//!\n//! Demonstrates issuing and validating custom tokens.\n//!\n//! Run with: `cargo run --example basic_usage`\n\nuse link_assistant_router::token::TokenManager;\n\nfn main() {\n    let manager = TokenManager::new(\"example-secret-key\");\n\n    // Issue a token\n    let token = manager\n        .issue_token(24, \"demo-user\")\n        .expect(\"Failed to issue token\");\n    println!(\"Issued token: {token}\");\n\n    // Validate the token\n    let claims = manager\n        .validate_token(&token)\n        .expect(\"Token should be valid\");\n    println!(\"Token ID: {}\", claims.sub);\n    println!(\"Label: {}\", claims.label);\n    println!(\"Expires at: {}\", claims.exp);\n\n    // Revoke the token\n    manager.revoke_token(&claims.sub).expect(\"Should revoke\");\n    println!(\"Token revoked.\");\n\n    // Try to validate again\n    match manager.validate_token(&token) {\n        Ok(_) => println!(\"Token still valid (unexpected)\"),\n        Err(e) => println!(\"Token rejected: {e}\"),\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1031,"utf8Bytes":1031,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1031,0,1031,-1],["trivia","comment",0,67,0,67,0],["trivia","whitespace",67,68,67,68,0],["trivia","comment",68,71,68,71,0],["trivia","whitespace",71,72,71,72,0],["trivia","comment",72,126,72,126,0],["trivia","whitespace",126,127,126,127,0],["trivia","comment",127,130,127,130,0],["trivia","whitespace",130,131,130,131,0],["trivia","comment",131,178,131,178,0],["trivia","whitespace",178,180,178,180,0],["token","identifier",180,183,180,183,0],["trivia","whitespace",183,184,183,184,0],["token","identifier",184,205,184,205,0],["token","punct",205,207,205,207,0],["token","identifier",207,212,207,212,0],["token","punct",212,214,212,214,0],["token","identifier",214,226,214,226,0],["token","punct",226,227,226,227,0],["trivia","whitespace",227,229,227,229,0],["token","identifier",229,231,229,231,0],["trivia","whitespace",231,232,231,232,0],["token","identifier",232,236,232,236,0],["group","paren",236,238,236,238,0],["token","delimiter",236,237,236,237,23],["token","delimiter",237,238,237,238,23],["trivia","whitespace",238,239,238,239,0],["group","brace",239,1030,239,1030,0],["token","delimiter",239,240,239,240,27],["trivia","