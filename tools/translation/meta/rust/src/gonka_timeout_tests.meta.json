rted","message":"draft item use: no supported library declaration emission","span":{"start":187,"end":214},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":214,"end":215,"unit":"utf16","byteStart":214,"byteEnd":215},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"axum","span":{"start":215,"end":244,"unit":"utf16","byteStart":215,"byteEnd":244},"sha256":"0992ddb40d3b0dabf5d4259d8a883653e072aac28e87ec41da910772d131aa9d","source":"use axum::response::Response;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":215,"end":244},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":244,"end":245,"unit":"utf16","byteStart":244,"byteEnd":245},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"futures_util","span":{"start":245,"end":278,"unit":"utf16","byteStart":245,"byteEnd":278},"sha256":"a35ede8e3619db51d2768869cfa8b43ded4e3056d56773669665006d0291f1e7","source":"use futures_util::StreamExt as _;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":245,"end":278},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":278,"end":280,"unit":"utf16","byteStart":278,"byteEnd":280},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"catalog_deadline_covers_a_slow_trickled_response_body","span":{"start":280,"end":2286,"unit":"utf16","byteStart":280,"byteEnd":2286},"sha256":"9d786e13fb094998ed424f7da233397b440dfb6253e7e7320acf6ac7edcbdd2b","source":"#[tokio::test]\nasync fn catalog_deadline_covers_a_slow_trickled_response_body() {\n    let requests = Arc::new(AtomicUsize::new(0));\n    let observed = Arc::clone(&requests);\n    let app = axum::Router::new().route(\n        \"/v1/models\",\n        axum::routing::get(move || {\n            let observed = Arc::clone(&observed);\n            async move {\n                observed.fetch_add(1, Ordering::SeqCst);\n                let prefix = futures_util::stream::iter([Ok::<_, std::io::Error>(\n                    bytes::Bytes::from_static(b\"{\\\"data\\\":[\"),\n                )]);\n                let suffix = futures_util::stream::once(async {\n                    tokio::time::sleep(Duration::from_secs(1)).await;\n                    Ok::<_, std::io::Error>(bytes::Bytes::from_static(b\"]}\"))\n                });\n                Response::builder()\n                    .status(StatusCode::OK)\n                    .header(\"content-type\", \"application/json\")\n                    .body(Body::from_stream(prefix.chain(suffix)))\n                    .unwrap()\n            }\n        }),\n    );\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n    let base_url = format!(\"http://{}\", listener.local_addr().unwrap());\n    let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });\n    let gonka = crate::gonka::GonkaConfig::new(\n        Some(\"broker-secret\".into()),\n        Some(&base_url),\n        String::new(),\n    )\n    .unwrap();\n\n    assert!(\n        gonka\n            .refresh_catalog_with_timeout(&reqwest::Client::new(), Duration::from_millis(40))\n            .await\n            .is_err(),\n        \"the total deadline must expire after headers and a partial body\"\n    );\n    assert_eq!(requests.load(Ordering::SeqCst), 1);\n    assert!(\n        gonka.live_catalog(&reqwest::Client::new()).await.is_err(),\n        \"a timed-out refresh must fail closed during the retry interval\"\n    );\n    assert_eq!(requests.load(Ordering::SeqCst), 1);\n    server.abort();\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[tokio]: attributes that change compilation are outside the portable core","span":{"start":280,"end":287},"details":{"construct":"#[tokio]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2286,"end":2287,"unit":"utf16","byteStart":2286,"byteEnd":2287},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Total-deadline regression for Gonka's authenticated live catalog.\n\nuse std::sync::Arc;\nuse std::sync::atomic::{AtomicUsize, Ordering};\nuse std::time::Duration;\n\nuse axum::body::Body;\nuse axum::http::StatusCode;\nuse axum::response::Response;\nuse futures_util::StreamExt as _;\n\n#[tokio::test]\nasync fn catalog_deadline_covers_a_slow_trickled_response_body() {\n    let requests = Arc::new(AtomicUsize::new(0));\n    let observed = Arc::clone(&requests);\n    let app = axum::Router::new().route(\n        \"/v1/models\",\n        axum::routing::get(move || {\n            let observed = Arc::clone(&observed);\n            async move {\n                observed.fetch_add(1, Ordering::SeqCst);\n                let prefix = futures_util::stream::iter([Ok::<_, std::io::Error>(\n                    bytes::Bytes::from_static(b\"{\\\"data\\\":[\"),\n                )]);\n                let suffix = futures_util::stream::once(async {\n                    tokio::time::sleep(Duration::from_secs(1)).await;\n                    Ok::<_, std::io::Error>(bytes::Bytes::from_static(b\"]}\"))\n                });\n                Response::builder()\n                    .status(StatusCode::OK)\n                    .header(\"content-type\", \"application/json\")\n                    .body(Body::from_stream(prefix.chain(suffix)))\n                    .unwrap()\n            }\n        }),\n    );\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n    let base_url = format!(\"http://{}\", listener.local_addr().unwrap());\n    let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });\n    let gonka = crate::gonka::GonkaConfig::new(\n        Some(\"broker-secret\".into()),\n        Some(&base_url),\n        String::new(),\n    )\n    .unwrap();\n\n    assert!(\n        gonka\n            .refresh_catalog_with_timeout(&reqwest::Client::new(), Duration::from_millis(40))\n            .await\n            .is_err(),\n        \"the total deadline must expire after headers and a partial body\"\n    );\n    assert_eq!(requests.load(Ordering::SeqCst), 1);\n    assert!(\n        gonka.live_catalog(&reqwest::Client::new()).await.is_err(),\n        \"a timed-out refresh must fail closed during the retry interval\"\n    );\n    assert_eq!(requests.load(Ordering::SeqCst), 1);\n    server.abort();\n}\n","sourceEncoding":{"utf16CodeUnits":2287,"utf8Bytes":2287,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2287,0,2287,-1],["trivia","comment",0,69,0,69,0],["trivia","whitespace",69,71,69,71,0],["token","identifier",71,74,71,74,0],["trivia","whitespace",74,75,74,75,0],["token","identifier",75,78,75,78,0],["token","punct",78,80,78,80,0],["token","identifier",80,84,80,84,0],["token","punct",84,86,84,86,0],["token","identifier",86,89,86,89,0],["token","punct",89,90,89,90,0],["trivia","whitespace",90,91,90,91,0],["token","identifier",91,94,91,94,0],["trivia","whitespace",94,95,94,95,0],["token","identifier",95,98,95,98,0],["token","punct",98,100,98,100,0],["token","identifier",100,104,100,104,0],["token","punct",104,106,104,106,0],["token","identifier",106,112,106,112,0],["token","punct",112,114,112,114,0],["group","brace",114,137,114,137,0],["token","delimiter",114,115,114,115,20],["token","identifier",115,126,115,126,20],["token","p