conflicts: Vec<String>,\n    /// Why this client's configuration could not be read, if it could not.\n    ///\n    /// A damaged file is a property of one row, not of the listing: propagating\n    /// it ended the table at that client and silently hid every client after\n    /// it, while the error named a *different* client than the one missing\n    /// (issue #304).\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    pub unreadable: Option<String>,\n    /// Why the router cannot manage this client at all, if it cannot.\n    ///\n    /// `configured: false` is indistinguishable from a real answer for a\n    /// client whose reader is a hardcoded `None` (issue #303).\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    pub unsupported: Option<&'static str>,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(Serialize): derive requires a separately checked capability","span":{"start":1261,"end":1270},"details":{"construct":"derive(Serialize)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":56},"tokens":["#","[","derive","(","Clone",",","Debug",",","Serialize",",","schemars","::","JsonSchema",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2697,"end":2743,"unit":"utf16","byteStart":2701,"byteEnd":2747},"sha256":"218804dd6b67b2166cb0a9910a3924916a82cb70731d6cab1352fed7d0e41f3e","source":"\n\n/// Result of a successful setup operation.\n","status":"preserved","diagnostic":null},{"term":"struct","name":"SetupResult","span":{"start":2743,"end":2865,"unit":"utf16","byteStart":2747,"byteEnd":2869},"sha256":"1004de01e6cac7cfa0d89a8fcf33607530bc024d31c29769e575e735281c94c1","source":"#[derive(Debug)]\npub struct SetupResult {\n    pub path: PathBuf,\n    pub backup: Option<PathBuf>,\n    pub changed: bool,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed Option generic: the standard prelude type requires actual resolution","span":{"start":2824,"end":2839},"details":{"construct":"shadowed Option generic"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":16},"tokens":["#","[","derive","(","Debug",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2865,"end":2866,"unit":"utf16","byteStart":2869,"byteEnd":2870},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use std::fmt;\nuse std::path::PathBuf;\n\nuse serde::Serialize;\n\nuse super::{ConfigSource, OwnershipState};\n\n#[derive(Debug)]\npub struct ClientError(String);\n\nimpl ClientError {\n    /// Build a diagnostic with credential-looking runs already removed.\n    ///\n    /// Every client diagnostic quotes something the router or an upstream sent\n    /// back — a URL, a response body, a transport error — and any of those can\n    /// carry the bearer token that was just used. Redacting here, at the single\n    /// constructor, keeps that out of terminals, logs, and CI output.\n    pub(super) fn message(message: impl Into<String>) -> Self {\n        Self(crate::login_url::redact_secrets(&message.into()))\n    }\n}\n\nimpl fmt::Display for ClientError {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        f.write_str(&self.0)\n    }\n}\n\nimpl std::error::Error for ClientError {}\n\nimpl From<std::io::Error> for ClientError {\n    fn from(error: std::io::Error) -> Self {\n        Self::message(error.to_string())\n    }\n}\n\nimpl From<serde_json::Error> for ClientError {\n    fn from(error: serde_json::Error) -> Self {\n        Self::message(error.to_string())\n    }\n}\n\n/// Secret-free state returned by `clients list` and `clients show`.\n#[derive(Clone, Debug, Serialize, schemars::JsonSchema)]\npub struct ClientStatus {\n    pub client: String,\n    pub installed: bool,\n    pub configured: bool,\n    pub config_path: PathBuf,\n    pub dialect: &'static str,\n    pub base_url: Option<String>,\n    pub token_env: Option<&'static str>,\n    pub token_env_set: bool,\n    /// Router ownership of the effective routing configuration.\n    pub ownership_state: OwnershipState,\n    /// Highest-precedence source which currently selects the endpoint.\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    pub effective_source: Option<ConfigSource>,\n    /// Routing-critical key names which disagree; values are never retained.\n    pub conflicts: Vec<String>,\n    /// Why this client's configuration could not be read, if it could not.\n    ///\n    /// A damaged file is a property of one row, not of the listing: propagating\n    /// it ended the table at that client and silently hid every client after\n    /// it, while the error named a *different* client than the one missing\n    /// (issue #304).\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    pub unreadable: Option<String>,\n    /// Why the router cannot manage this client at all, if it cannot.\n    ///\n    /// `configured: false` is indistinguishable from a real answer for a\n    /// client whose reader is a hardcoded `None` (issue #303).\n    #[serde(skip_serializing_if = \"Option::is_none\")]\n    pub unsupported: Option<&'static str>,\n}\n\n/// Result of a successful setup operation.\n#[derive(Debug)]\npub struct SetupResult {\n    pub path: PathBuf,\n    pub backup: Option<PathBuf>,\n    pub changed: bool,\n}\n","sourceEncoding":{"utf16CodeUnits":2866,"utf8Bytes":2870,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2866,0,2870,-1],["token","identifier",0,3,0,3,0],["trivia","whitespace",3,4,3,4,0],["token","identifier",4,7,4,7,0],["token","punct",7,9,7,9,0],["token","identifier",9