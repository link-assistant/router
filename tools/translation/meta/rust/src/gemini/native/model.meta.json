;\n    if let Some(raw) = raw {\n        for key in [\n            \"baseModelId\",\n            \"version\",\n            \"displayName\",\n            \"description\",\n            \"inputTokenLimit\",\n            \"outputTokenLimit\",\n            \"supportedGenerationMethods\",\n            \"temperature\",\n            \"maxTemperature\",\n            \"topP\",\n            \"topK\",\n        ] {\n            if let Some(value) = raw.get(key) {\n                projected.insert(key.into(), value.clone());\n            }\n        }\n    }\n    Value::Object(projected)\n}\n","sourceEncoding":{"utf16CodeUnits":871,"utf8Bytes":871,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,871,0,871,-1],["trivia","comment",0,78,0,78,0],["trivia","whitespace",78,79,78,79,0],["token","identifier",79,82,79,82,0],["trivia","whitespace",82,83,82,83,0],["token","identifier",83,93,83,93,0],["token","punct",93,95,93,95,0],["token","identifier",95,100,95,100,0],["token","punct",100,101,100,101,0],["trivia","whitespace",101,103,101,103,0],["token","identifier",103,106,103,106,0],["group","paren",106,113,106,113,0],["token","delimiter",106,107,106,107,11],["token","identifier",107,112,107,112,11],["token","delimiter",112,113,112,113,11],["trivia","whitespace",113,114,113,114,0],["token","identifier",114,116,114,116,0],["trivia","whitespace",116,117,116,117,0],["token","identifier",117,138,117,138,0],["group","paren",138,208,138,208,0],["token","delimiter",138,139,138,139,19],["trivia","whitespace",139,144,139,144,19],["token","identifier",144,149,144,149,19],["token","punct",149,150,149,150,19],["trivia","whitespace",150,151,150,151,19],["token","punct",151,152,151,152,19],["token","identifier",152,155,152,155,19],["token","punct",155,156,155,156,19],["trivia","whitespace",156,161,156,161,19],["token","identifier",161,164,161,164,19],["token","punct",164,165,164,165,19],["trivia","whitespace",16