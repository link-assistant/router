 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":3,"preserved":4},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":43,"unit":"utf16","byteStart":0,"byteEnd":43},"sha256":"8d39bbc83ba9838784c220091c84568426867ddc355d1bdde7c4f21c9bfec44b","source":"//! Unit tests for [`crate::entrypoint`].\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":43,"end":56,"unit":"utf16","byteStart":43,"byteEnd":56},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":43,"end":56},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":56,"end":403,"unit":"utf16","byteStart":56,"byteEnd":405},"sha256":"62c2addabda1be033e55ee0f4b350bb7075f0ee2106bb934cc0ee25bea2e416c","source":"\n\n/// The entry point runs off the process main thread, so its stack is one this\n/// crate chose rather than one the linker fixed.\n///\n/// Windows fixes the main thread at 1 MB, which a debug build of the router's\n/// entry future exceeded — every subcommand died before doing any work, while\n/// Linux and macOS were fine on their 8 MB defaults.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_entry_point_runs_on_a_named_thread_of_its_own","span":{"start":403,"end":879,"unit":"utf16","byteStart":405,"byteEnd":881},"sha256":"76b447f53d4383b2790d41b678d939cc931d71679db6c71b798dd5d49dab3828","source":"#[test]\nfn the_entry_point_runs_on_a_named_thread_of_its_own() {\n    let code = run_on_a_deep_stack(|| async {\n        let thread = std::thread::current();\n        assert_eq!(\n            thread.name(),\n            Some(\"router-main\"),\n            \"the entry point must not run on the process main thread\"\n        );\n        std::process::ExitCode::SUCCESS\n    });\n\n    assert_eq!(\n        format!(\"{code:?}\"),\n        format!(\"{:?}\", std::process::ExitCode::SUCCESS)\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":403,"end":409},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":879,"end":991,"unit":"utf16","byteStart":881,"byteEnd":993},"sha256":"c8d8e033af1c127326164a2d22460f8fc2e45c1c8e76a9b43bc92e126f03a1c2","source":"\n\n/// A deep call chain completes, where the platform's main-thread stack would\n/// decide the outcome instead.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_deep_call_chain_completes","span":{"start":991,"end":1567,"unit":"utf16","byteStart":993,"byteEnd":1569},"sha256":"596267be6060e31e1a1413a718f48d65f6e1581628670fe1d085df0687269238","source":"#[test]\nfn a_deep_call_chain_completes() {\n    fn descend(depth: u32) -> u32 {\n        // Each frame holds a kilobyte, so the chain needs far more than a\n        // 1 MB stack to finish.\n        let ballast = [0u8; 1024];\n        if depth == 0 {\n            return u32::from(ballast[0]);\n        }\n        descend(depth - 1)\n    }\n\n    let code = run_on_a_deep_stack(|| async {\n        assert_eq!(descend(3_000), 0);\n        std::process::ExitCode::SUCCESS\n    });\n\n    assert_eq!(\n        format!(\"{code:?}\"),\n        format!(\"{:?}\", std::process::ExitCode::SUCCESS)\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":991,"end":997},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1567,"end":1568,"unit":"utf16","byteStart":1569,"byteEnd":1570},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Unit tests for [`crate::entrypoint`].\n\nuse super::*;\n\n/// The entry point runs off the process main thread, so its stack is one this\n/// crate chose rather than one the linker fixed.\n///\n/// Windows fixes the main thread at 1 MB, which a debug build of the router's\n/// entry future exceeded — every subcommand died before doing any work, while\n/// Linux and macOS were fine on their 8 MB defaults.\n#[test]\nfn the_entry_point_runs_on_a_named_thread_of_its_own() {\n    let code = run_on_a_deep_stack(|| async {\n        let thread = std::thread::current();\n        assert_eq!(\n            thread.name(),\n            Some(\"router-main\"),\n            \"the entry point must not run on the process main thread\"\n        );\n        std::process::ExitCode::SUCCESS\n    });\n\n    assert_eq!(\n        format!(\"{code:?}\"),\n        format!(\"{:?}\", std::process::ExitCode::SUCCESS)\n    );\n}\n\n/// A deep call chain completes, where the platform's main-thread stack would\n/// decide the outcome instead.\n#[test]\nfn a_deep_call_chain_completes() {\n    fn descend(depth: u32) -> u32 {\n        // Each frame holds a kilobyte, so the chain needs far more than a\n        // 1 MB stack to finish.\n        let ballast = [0u8; 1024];\n        if depth == 0 {\n            return u32::from(ballast[0]);\n        }\n        descend(depth - 1)\n    }\n\n    let code = run_on_a_deep_stack(|| async {\n        assert_eq!(descend(3_000), 0);\n        std::process::ExitCode::SUCCESS\n    });\n\n    assert_eq!(\n        format!(\"{code:?}\"),\n        format!(\"{:?}\", std::process::ExitCode::SUCCESS)\n    );\n}\n","sourceEncoding":{"utf16CodeUnits":1568,"utf8Bytes":1570,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1568,0,1570,-1],["trivia","comment",0,41,0,41,0],["trivia","whitespace",41,43,41,43,0],["token","identifier",43,46,43,46,0],["trivia","whitespace",46,47,46,47,0],["token","identifier",47,52,47,52,0],["token","punct",52,54,52,54,0],["token","punct",54,55,54,55,0],["token","punct",55,56,55,56,0],["trivia","whitespace",56,58,56,58,0],["trivia","comment",58,136,58,136,0],["trivia","whitespace",136,137,136,137,0],["trivia","comment",137,186,137,186,0],["trivia","whitespace",186,187,186,187,0],["trivia","comment",187,190,187,190,0],["trivia","whitespace",190,191,190,191,0],["trivia","comment",191,269,191,269,0],["trivia","whitespace",269,270,269,270,0],["trivia","comment",270,348,270,350,0],["trivia","whitespace",348,349,350,351,0],["trivia","comment",349,402,351,404,0],["trivia","whitespace",402,403,404,405,0],["token","punct",403,404,405,406,0],["group","bracket",404,410,406,412,0],["token","delimiter",404,405,406,407,23],["token","identifier",405,409,407,411,23],["token","delimiter",409,410,411,412,23],["trivia","whitespace",410,411,412,413,0],["token","identifier",411,413,413,415,0],["trivia","whitespace",413,414,415,416,0],["token","identifier",414,463,416,465,0],["group","paren",463,465,465,467,0],["token","delimiter",463,464,465,466,31],["token","delimiter",464,465,466,467,31],["trivia","whitespace"