ing":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":79,"unit":"utf16","byteStart":0,"byteEnd":79},"sha256":"3adc4afe875247c4c74b1eda527bf53e0b2b92c1e4ce70b82b10b48467f3a952","source":"//! Remove URL credentials and query values before diagnostics reach any sink.\n","status":"preserved","diagnostic":null,"comment":true},{"term":"fn","name":"urls","span":{"start":79,"end":1300,"unit":"utf16","byteStart":79,"byteEnd":1300},"sha256":"43d5d2668621db3b3d5cf5d898f20a9ae3801e9555fde16b554e951a039c11e3","source":"pub fn urls(message: &crate::translation_core::Str) -> String {\n    let mut result = String::new();\n    let mut remaining = message;\n    while let Some(start) = remaining\n        .find(\"http://\")\n        .into_iter()\n        .chain(remaining.find(\"https://\"))\n        .min()\n    {\n        result.push_str(&remaining[..start]);\n        remaining = &remaining[start..];\n        let end = remaining\n            .find(|character: char| {\n                character.is_whitespace() || matches!(character, '\\'' | '\"' | ')' | ',' | '>')\n            })\n            .unwrap_or(remaining.len());\n        let candidate = &remaining[..end];\n        if let Ok(mut url) = url::Url::parse(candidate)\n            && (!url.username().is_empty()\n                || url.password().is_some()\n                || url.query().is_some()\n                || url.fragment().is_some())\n        {\n            let _ = url.set_username(\"\");\n            let _ = url.set_password(None);\n            url.set_query(None);\n            url.set_fragment(None);\n            result.push_str(url.as_str());\n        } else {\n            result.push_str(candidate);\n        }\n        remaining = &remaining[end..];\n    }\n    result.push_str(remaining);\n    result\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":79,"end":1300,"unit":"utf16","byteStart":79,"byteEnd":1300}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1300,"end":1302,"unit":"utf16","byteStart":1300,"byteEnd":1302},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":1302,"end":1832,"unit":"utf16","byteStart":1302,"byteEnd":1832},"sha256":"4cfd99b9555efa16d405418939d7b1f5514cbff720b1d69a718d186cde3549a0","source":"#[cfg(test)]\nmod tests {\n    #[test]\n    fn redacts_url_credentials_and_parameters_without_losing_error_context() {\n        let message = \"connection failed (https://operator:sentinel@router.example/api?token=sentinel#sentinel), retry http://127.0.0.1:8080\";\n        let safe = super::urls(message);\n        assert!(!safe.contains(\"sentinel\"));\n        assert!(!safe.contains(\"operator\"));\n        assert!(safe.contains(\n            \"connection failed (https://router.example/api), retry http://127.0.0.1:8080\"\n        ));\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":1302,"end":1832},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1832,"end":1833,"unit":"utf16","byteStart":1832,"byteEnd":1833},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Remove URL credentials and query values before diagnostics reach any sink.\npub fn urls(message: &crate::translation_core::Str) -> String {\n    let mut result = String::new();\n    let mut remaining = message;\n    while let Some(start) = remaining\n        .find(\"http://\")\n        .into_iter()\n        .chain(remaining.find(\"https://\"))\n        .min()\n    {\n        result.push_str(&remaining[..start]);\n        remaining = &remaining[start..];\n        let end = remaining\n            .find(|character: char| {\n                character.is_whitespace() || matches!(character, '\\'' | '\"' | ')' | ',' | '>')\n            })\n            .unwrap_or(remaining.len());\n        let candidate = &remaining[..end];\n        if let Ok(mut url) = url::Url::parse(candidate)\n            && (!url.username().is_empty()\n                || url.password().is_some()\n                || url.query().is_some()\n                || url.fragment().is_some())\n        {\n            let _ = url.set_username(\"\");\n            let _ = url.set_password(None);\n            url.set_query(None);\n            url.set_fragment(None);\n            result.push_str(url.as_str());\n        } else {\n            result.push_str(candidate);\n        }\n        remaining = &remaining[end..];\n    }\n    result.push_str(remaining);\n    result\n}\n\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn redacts_url_credentials_and_parameters_without_losing_error_context() {\n        let message = \"connection failed (https://operator:sentinel@router.example/api?token=sentinel#sentinel), retry http://127.0.0.1:8080\";\n        let safe = super::urls(message);\n        assert!(!safe.contains(\"sentinel\"));\n        assert!(!safe.contains(\"operator\"));\n        assert!(safe.contains(\n            \"connection failed (https://router.example/api), retry http://127.0.0.1:8080\"\n        ));\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1833,"utf8Bytes":1833,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1833,0,1833,-1],["trivia","comment",0,78,0,78,0],["trivia","whitespace",78,79,78,79,0],["token","identifier",79,82,79,82,0],["trivia","whitespace",82,83,82,83,0],["token","identifier",83,85,83,85,0],["trivia","whitespace",85,86,85,86,0],["token","identifier",86,90,86,90,0],["group","paren",90,130,90,130,0],["token","delimiter",90,91,90,91,8],["token","identifier",91,98,91,98,8],["token","punct",98,99,98,99,8],["trivia","whitespace",99,100,99,100,8],["token","punct",100,101,100,101,8],["token","identifier",101,106,101,106,8],["token","punct",106,108,106,108,8],["token","identifier",108,124,108,124,8],["token","punct",124,126,124,126,8],["token","identifier",126,129,126,129,8],["token","delimiter",129,130,129,130,8],["trivia","whitespace",130,131,130,131,0],["token","punct",131,133,131,133,0],["trivia","whitespace",133,134,133,134,0],["token","identifier",134,140,134,140,0],["trivia","whitespace",140,141,140,141,0],["group","brace",141,1300,141,1300,0],["token","delimiter",141,142,141,142,25],["trivia","whitespace",142,147,142,147,25],["token","identifier",147,150,147,150,25],["trivia","whi