t":107,"end":131,"unit":"utf16","byteStart":107,"byteEnd":131},"sha256":"6ddd16fc08d6d321b57de50496eb1f749d9f92b7bd5eaf606e986a325b8fb032","source":"use std::time::Duration;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":107,"end":131},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":131,"end":133,"unit":"utf16","byteStart":131,"byteEnd":133},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"supervise","span":{"start":133,"end":1385,"unit":"utf16","byteStart":133,"byteEnd":1385},"sha256":"c377396dec156cdf4180aec55609a44f0ec048baee12375c8320028666cb467e","source":"pub async fn supervise(\n    child: &mut tokio::process::Child,\n    shutdown: impl std::future::Future<Output = &'static str>,\n) -> Result<ExitStatus, Box<dyn std::error::Error + Send + Sync>> {\n    let pid = child.id();\n    let status = tokio::select! {\n        result = child.wait() => result?,\n        signal = shutdown => {\n            #[cfg(unix)]\n            if let Some(pid) = pid {\n                let _ = crate::operation_context::process_output(\n                    crate::operation_context::command(\"kill\")\n                        .args([if signal == \"SIGTERM\" { \"-TERM\" } else { \"-INT\" }, &pid.to_string()])\n                        .stdout(std::process::Stdio::null())\n                        .stderr(std::process::Stdio::null()),\n                );\n            }\n            #[cfg(windows)]\n            child.start_kill()?;\n            if let Ok(result) = tokio::time::timeout(Duration::from_secs(5), child.wait()).await {\n                result?\n            } else {\n                super::event(format_args!(\"client_forced_termination child_pid={pid:?} after={signal}\"));\n                child.start_kill()?;\n                child.wait().await?\n            }\n        }\n    };\n    super::child_exit(\"client\", pid, status);\n    Ok(status)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":133,"end":1385,"unit":"utf16","byteStart":133,"byteEnd":1385}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1385,"end":1386,"unit":"utf16","byteStart":1385,"byteEnd":1386},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Wait for an interactive child while forwarding process shutdown signals.\nuse std::process::ExitStatus;\nuse std::time::Duration;\n\npub async fn supervise(\n    child: &mut tokio::process::Child,\n    shutdown: impl std::future::Future<Output = &'static str>,\n) -> Result<ExitStatus, Box<dyn std::error::Error + Send + Sync>> {\n    let pid = child.id();\n    let status = tokio::select! {\n        result = child.wait() => result?,\n        signal = shutdown => {\n            #[cfg(unix)]\n            if let Some(pid) = pid {\n                let _ = crate::operation_context::process_output(\n                    crate::operation_context::command(\"kill\")\n                        .args([if signal == \"SIGTERM\" { \"-TERM\" } else { \"-INT\" }, &pid.to_string()])\n                        .stdout(std::process::Stdio::null())\n                        .stderr(std::process::Stdio::null()),\n                );\n            }\n            #[cfg(windows)]\n            child.start_kill()?;\n            if let Ok(result) = tokio::time::timeout(Duration::from_secs(5), child.wait()).await {\n                result?\n            } else {\n                super::event(format_args!(\"client_forced_termination child_pid={pid:?} after={signal}\"));\n                child.start_kill()?;\n                child.wait().await?\n            }\n        }\n    };\n    super::child_exit(\"client\", pid, status);\n    Ok(status)\n}\n","sourceEncoding":{"utf16CodeUnits":1386,"utf8Bytes":1386,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1386,0,1386,-1],["trivia","comment",0,76,0,76,0],["trivia","whitespace",76,77,76,77,0],["token","identifier",77,80,77,80,0],["trivia","whitespace",80,81,80,81,0],["token","identifier",81,84,81,84,0],["token","punct",84,86,84,86,0],["token","identifier",86,93,86,93,0],["token","punct",93,95,93,95,0],["token","identifier",95,105,95,105,0],["token","punct",105,106,105,106,0],["trivia","whitespace",106,107,106,107,0],["token","identifier",107,110,107,110,0],["trivia","whitespace",110,111,110,111,0],["token","identifier",111,114,111,114,0],["token","punct",114,116,114,116,0],["token","identifier",116,120,116,120,0],["token","punct",120,122,120,122,0],["token","identifier",122,130,122,130,0],["token","punct",130,131,130,131,0],["trivia","whitespace",131,133,131,133,0],["token","identifier",133,136,133,136,0],["trivia","whitespace",136,137,136,137,0],["token","identifier",137,142,137,142,0],["trivia","whitespace",142,143,142,143,0],["token","identifier",143,145,143,145,0],["trivia","whitespace",145,146,145,146,0],["token","identifier",146,155,146,155,0],["group","paren",155,260,155,260,0],["token","delimiter",155,156,155,156,28],["trivia","whitespace",156,161,156,161,28],["token","identifier",161,166,161,166,28],["token","punct",166,167,166,167,28],["trivia","whitespace",167,168,167,168,28],["token","punct",168,169,168,169,28],["token","identifier",169,172,169,172,28],["trivia","whitespace",172,173,172,173,28],["token","identifier",173,178,173,178,28],["token","punct",178,180,178,180,28],["token","identifier",180,187,1