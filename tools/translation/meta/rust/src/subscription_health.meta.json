oding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":5,"preserved":6},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":207,"unit":"utf16","byteStart":0,"byteEnd":207},"sha256":"73492386e8466e904f04f4b599066fe7aadc7b59eb55e7afddff62ca21845873","source":"//! Subscription health reporting (issue #318).\n//!\n//! Separate from `proxy::health`, which answers liveness only: `/api/health` drives\n//! both Kubernetes probes and a restart cannot mint an OAuth token.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"axum","span":{"start":207,"end":232,"unit":"utf16","byteStart":207,"byteEnd":232},"sha256":"79f2a40b4aa179741bbd54be3abfeced9614f4681a85f9ae6167dbc6e3876827","source":"use axum::extract::State;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":207,"end":232},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":232,"end":233,"unit":"utf16","byteStart":232,"byteEnd":233},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"axum","span":{"start":233,"end":260,"unit":"utf16","byteStart":233,"byteEnd":260},"sha256":"a6b6befee47ca3fa230235d3c899c5049260396e5900ef2ee0a34e1d703bba5d","source":"use axum::http::StatusCode;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":233,"end":260},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":260,"end":261,"unit":"utf16","byteStart":260,"byteEnd":261},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"axum","span":{"start":261,"end":294,"unit":"utf16","byteStart":261,"byteEnd":294},"sha256":"4cad65541e5e03f9bbcc60d428fd4b5c3793aef9af593f68949a72c2ccc23617","source":"use axum::response::IntoResponse;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":261,"end":294},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":294,"end":296,"unit":"utf16","byteStart":294,"byteEnd":296},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"use","name":"crate","span":{"start":296,"end":327,"unit":"utf16","byteStart":296,"byteEnd":327},"sha256":"7b34e0b7970bd52372e406184d42079cdc19471411bac676913498d4796775ed","source":"use crate::app_state::AppState;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":296,"end":327},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":327,"end":1073,"unit":"utf16","byteStart":327,"byteEnd":1075},"sha256":"4288416b1d4fbb898288101f5db742e53ebe8aebf8248f46ec1db88490cf81bb","source":"\n\n/// `GET /api/management/health/subscriptions` — can this router serve what it advertises?\n///\n/// The signal that did not exist. A revoked subscription left `/api/health` at\n/// `ok`, `degraded_providers` empty and no counter anywhere, so the operator\n/// learned about it from a client hours later via a message that named neither\n/// the subscription nor the credential (issue #318).\n///\n/// Answers `503` when a *configured* subscription is degraded, which is what\n/// lets a stock uptime check fire without knowing anything about router\n/// internals. A readable credential still awaiting its first live catalog is\n/// listed as starting and answers `200`; a deployment with no credential also\n/// answers `200` with empty provider lists.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"subscription_health","span":{"start":1073,"end":3258,"unit":"utf16","byteStart":1075,"byteEnd":3260},"sha256":"70a304f20cda0f110fbc8f2ac3b8200b5f1ffef4066166f828fcd76ccc96143c","source":"pub async fn subscription_health(State(state): State<AppState>) -> impl IntoResponse {\n    let providers = crate::model_routing::configured_provider_health_report(&state).await;\n    let mut degraded = providers\n        .iter()\n        .filter(|health| health.is_degraded())\n        .map(|health| {\n            crate::translation_core::json!({\n                \"provider\": health.provider.as_str(),\n                \"reason\": health.summary,\n            })\n        })\n        .collect::<Vec<_>>();\n    let mut healthy = providers\n        .iter()\n        .filter(|health| health.state == crate::model_routing::ProviderHealthState::Healthy)\n        .map(|health| health.provider.as_str())\n        .collect::<Vec<_>>();\n    let starting = providers\n        .iter()\n        .filter(|health| health.state == crate::model_routing::ProviderHealthState::Starting)\n        .map(|health| health.provider.as_str())\n        .collect::<Vec<_>>();\n    match crate::zai_coding_plan::configured_health(&state).await {\n        Some(true) => healthy.push(\"z.ai\"),\n        Some(false) => degraded.push(crate::zai_coding_plan::recorded_exhaustion(&state).map_or_else(\n            || {\n                crate::translation_core::json!({\n                    \"provider\": \"z.ai\",\n                    \"reason\": \"the Coding Plan credential was rejected upstream and needs replacement\",\n                })\n            },\n            |exhaustion| {\n                crate::translation_core::json!({\n                    \"provider\": \"z.ai\",\n                    \"state\": \"exhausted\",\n                    \"reason\": exhaustion.summary(),\n                    \"upstream_code\": exhaustion.code.to_string(),\n                })\n            },\n        )),\n        None => {}\n    }\n    let status = if degraded.is_empty() {\n        StatusCode::OK\n    } else {\n        StatusCode::SERVICE_UNAVAILABLE\n    };\n    (\n        status,\n        axum::Json(crate::translation_core::json!({\n            \"status\": if degraded.is_empty() { \"ok\" } else { \"degraded\" },\n            \"starting_providers\": starting,\n            \"healthy_providers\": healthy,\n            \"degraded_providers\": degraded,\n        })),\n    )\n        .into_response()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1073,"end":3258,"unit":"utf16","byteStart":1075,"byteEnd":3260}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3258,"end":3259,"unit":"utf16","byteStart":3260,"byteEnd":3261},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Subscription health reporting (issue #318).\n//!\n//! Separate from `proxy::health`, which answers liveness only: `/api/health` drives\n//! both Kubernetes probes and a restart cannot mint an OAuth token.\n\nuse axum::extract::State;\nuse axum::http::StatusCode;\nuse axum::response::IntoResponse;\n\nuse crate::app_state::AppState;\n\n/// `GET /api/management/health/subscriptions` — can this router serve what it advertises?\n///\n/// The signal that did not exist. A revoked subscription left `/api/health` at\n/// `ok`, `degraded_providers` empty and no counter anywhere, so the operator\n/// learned about it from a client hours later via a message that named neither\n/// the subscription nor the credential (issue #318).\n///\n/// Answers `503` when a *configured* subscription is degraded, which is what\n/// lets a stock uptime check fire without knowing anything about router\n/// internals. A readable credential still awaiting its first live catalog is\n/// listed as starting and answers `200`; a deployment with no credential also\n/// answers `200` with empty provider lists.\npub async fn subscription_health(State(state): State<AppState>) -> impl IntoResponse {\n    let providers = crate::model_routing::configured_provider_health_report(&state).await;\n    let mut degraded = providers\n        .iter()\n        .filter(|health| health.is_degraded())\n        .map(|health| {\n            crate::translation_core::json!({\n                \"provider\": health.provider.as_str(),\n                \"reason\": health.summary,\n            })\n        })\n        .collect::<Vec<_>>();\n    let mut healthy = providers\n        .iter()\n        .filter(|health| health.state == crate::model_routing::ProviderHealthState::Healthy)\n        .map(|health| health.provider.as_str())\n        .collect::<Vec<_>>();\n    let starting = providers\n        .iter()\n        .filter(|health| health.state == crate::model_routing::ProviderHealthState::Starting)\n        .map(|health| health.provider.as_str())\n        .collect::<Vec<_>>();\n    match crate::zai_coding_plan::configured_health(&state).await {\n        Some(true) => healthy.push(\"z.ai\"),\n        Some(false) => degraded.push(crate::zai_coding_plan::recorded_exhaustion(&state).map_or_else(\n            || {\n                crate::translation_core::json!({\n                    \"provider\": \"z.ai\",\n                    \"reason\": \"the Coding Plan credential was rejected upstream and needs replacement\",\n                })\n            },\n            |exhaustion| {\n                crate::translation_core::json!({\n                    \"provider\": \"z.ai\",\n                    \"state\": \"exhausted\",\n                    \"reason\": exhaustion.summary(),\n                    \"upstream_code\": exhaustion.code.to_string(),\n                })\n            },\n        )),\n        None => {}\n    }\n    let status = if degraded.is_empty() {\n        StatusCode::OK\n    } else {\n        StatusCode::SERVICE_UNAVAILABLE\n    };\n    (\n        status,\n        axum::Json(crate::translation_core::json!({\n            \"status\": if degraded.is_empty() { \"ok\" } else { \"degraded\" },\n            \"starting_providers\": starting,\n            \"healthy_providers\": healthy,\n            \"degraded_providers\": degraded,\n        })),\n    )\n        .into_response()\n}\n","sourceEncoding":{"utf16CodeUnits":3259,"utf8Bytes":3261,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,3259,0,3261,-1],["trivia","comment",0,47,0,47,0],["trivia","whitespace",47,48,47,48,0],["trivia","comment",48,51,48,51,0],["trivia","whitespace",51,52,51,52,0],["trivia","comment",52,136,52,136,0],["trivia","whitespace",136,137,136,137,0],["trivia","comment