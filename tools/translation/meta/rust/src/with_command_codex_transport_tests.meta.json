the same authorized catalog also\n/// contains an OpenAI-owned model.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"codex_selected_zai_model_disables_websocket_transport","span":{"start":363,"end":3074,"unit":"utf16","byteStart":363,"byteEnd":3074},"sha256":"c7892b3622d3e9439a138f5f76cb8018a6c1c71e23e9e45069842bbbf481dc32","source":"#[test]\nfn codex_selected_zai_model_disables_websocket_transport() {\n    let models = [\n        RouterModel {\n            id: \"gpt-live\".to_string(),\n            owned_by: crate::clients::OPENAI_MODEL_OWNER.to_string(),\n            default_reasoning_level: Some(\"high\".to_string()),\n            supported_reasoning_levels: Some(vec![crate::clients::RouterReasoningLevel {\n                effort: \"high\".to_string(),\n                description: \"Deep reasoning\".to_string(),\n            }]),\n            ..RouterModel::default()\n        },\n        RouterModel {\n            id: \"glm-4.5\".to_string(),\n            owned_by: crate::clients::ZAI_MODEL_OWNER.to_string(),\n            default_reasoning_level: Some(\"max\".to_string()),\n            supported_reasoning_levels: Some(vec![crate::clients::RouterReasoningLevel {\n                effort: \"max\".to_string(),\n                description: \"Deep reasoning\".to_string(),\n            }]),\n            ..RouterModel::default()\n        },\n    ];\n    let prepared = TemporaryClient::prepare(&Preparation {\n        client: ClientKind::Codex,\n        base_url: \"http://router.test\",\n        token: \"task-token\",\n        model_override: Some(\"glm-4.5\"),\n        models: &models,\n        isolated_config: false,\n        extend_user_configuration: false,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: None,\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: None,\n        user_claude_settings: None,\n    })\n    .expect(\"prepare selected z.ai model\");\n    let provider = prepared\n        .command\n        .get_args()\n        .map(|argument| argument.to_string_lossy())\n        .find(|argument| argument.starts_with(\"model_providers.\"))\n        .expect(\"process-local model provider\");\n    assert!(\n        provider.contains(\"supports_websockets = false\"),\n        \"{provider}\"\n    );\n\n    let isolated = TemporaryClient::prepare(&Preparation {\n        client: ClientKind::Codex,\n        base_url: \"http://router.test\",\n        token: \"task-token\",\n        model_override: Some(\"glm-4.5\"),\n        models: &models,\n        isolated_config: true,\n        extend_user_configuration: false,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: None,\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: None,\n        user_claude_settings: None,\n    })\n    .expect(\"prepare isolated selected z.ai model\");\n    let config = std::fs::read_to_string(isolated.directory.path().join(\".codex/config.toml\"))\n        .expect(\"read isolated Codex configuration\");\n    assert!(config.contains(\"supports_websockets = false\"), \"{config}\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":363,"end":369},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":3074,"end":3075,"unit":"utf16","byteStart":3074,"byteEnd":3075},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Codex transport tests for temporary client launches.\n//!\n//! Split from `with_command_tests.rs` to stay inside the repository's\n//! per-file line limit.\n\nuse super::*;\n\n/// Issue #578: z.ai's Responses adapter is HTTP/SSE-only. Codex must not try\n/// its WebSocket transport merely because the same authorized catalog also\n/// contains an OpenAI-owned model.\n#[test]\nfn codex_selected_zai_model_disables_websocket_transport() {\n    let models = [\n        RouterModel {\n            id: \"gpt-live\".to_string(),\n            owned_by: crate::clients::OPENAI_MODEL_OWNER.to_string(),\n            default_reasoning_level: Some(\"high\".to_string()),\n            supported_reasoning_levels: Some(vec![crate::clients::RouterReasoningLevel {\n                effort: \"high\".to_string(),\n                description: \"Deep reasoning\".to_string(),\n            }]),\n            ..RouterModel::default()\n        },\n        RouterModel {\n            id: \"glm-4.5\".to_string(),\n            owned_by: crate::clients::ZAI_MODEL_OWNER.to_string(),\n            default_reasoning_level: Some(\"max\".to_string()),\n            supported_reasoning_levels: Some(vec![crate::clients::RouterReasoningLevel {\n                effort: \"max\".to_string(),\n                description: \"Deep reasoning\".to_string(),\n            }]),\n            ..RouterModel::default()\n        },\n    ];\n    let prepared = TemporaryClient::prepare(&Preparation {\n        client: ClientKind::Codex,\n        base_url: \"http://router.test\",\n        token: \"task-token\",\n        model_override: Some(\"glm-4.5\"),\n        models: &models,\n        isolated_config: false,\n        extend_user_configuration: false,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: None,\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: None,\n        user_claude_settings: None,\n    })\n    .expect(\"prepare selected z.ai model\");\n    let provider = prepared\n        .command\n        .get_args()\n        .map(|argument| argument.to_string_lossy())\n        .find(|argument| argument.starts_with(\"model_providers.\"))\n        .expect(\"