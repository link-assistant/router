claration":"security_headers.CONTENT_SECURITY_POLICY"}}},{"term":"trivia","name":null,"span":{"start":1782,"end":1847,"unit":"utf16","byteStart":1788,"byteEnd":1853},"sha256":"6b6d77b4a6c71c0ca25a5864d8d55ab7ac863a77d6e62b26e1323f902240339b","source":"\n\n/// Headers applied to every response from the admin listener.\n","status":"preserved","diagnostic":null},{"term":"const","name":"HEADERS","span":{"start":1847,"end":2122,"unit":"utf16","byteStart":1853,"byteEnd":2128},"sha256":"d0ecc270035dac0cc3287eab1d1d3e4596d6b8c534386d35990b190a0aa2e9c0","source":"const HEADERS: &[(header::HeaderName, &crate::translation_core::Str)] = &[\n    (header::CONTENT_SECURITY_POLICY, CONTENT_SECURITY_POLICY),\n    (header::X_FRAME_OPTIONS, \"DENY\"),\n    (header::X_CONTENT_TYPE_OPTIONS, \"nosniff\"),\n    (header::REFERRER_POLICY, \"no-referrer\"),\n];","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1847,"end":2122,"unit":"utf16","byteStart":1853,"byteEnd":2128}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2122,"end":2325,"unit":"utf16","byteStart":2128,"byteEnd":2331},"sha256":"e34d01d5eadb5967ab9b0328ae0e7c566036423423d93b002bf7c7afcf5c25f1","source":"\n\n/// Middleware that hardens every admin response.\n///\n/// Existing headers are overwritten: nothing downstream has a reason to set a\n/// weaker policy, and silently keeping one would defeat the point.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"apply","span":{"start":2325,"end":2596,"unit":"utf16","byteStart":2331,"byteEnd":2602},"sha256":"334fec75c850df8eab704ed34147a9c3eb46be9bc5e1679a654e6a0984cbac34","source":"pub async fn apply(request: Request, next: Next) -> Response {\n    let mut response = next.run(request).await;\n    let headers = response.headers_mut();\n    for (name, value) in HEADERS {\n        headers.insert(name, HeaderValue::from_static(value));\n    }\n    response\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2325,"end":2596,"unit":"utf16","byteStart":2331,"byteEnd":2602}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2596,"end":2598,"unit":"utf16","byteStart":2602,"byteEnd":2604},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":2598,"end":3342,"unit":"utf16","byteStart":2604,"byteEnd":3348},"sha256":"ca1c7c62dfa4193769b4b10a3399aafbe310bbb33099aeb4e9ee216024775e42","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn the_policy_pins_scripts_to_this_origin_and_forbids_framing() {\n        assert!(CONTENT_SECURITY_POLICY.contains(\"script-src 'self'\"));\n        assert!(CONTENT_SECURITY_POLICY.contains(\"frame-ancestors 'none'\"));\n        assert!(\n            !CONTENT_SECURITY_POLICY.contains(\"script-src 'self' 'unsafe-inline'\"),\n            \"inline script would re-open the injection path to the localStorage token\"\n        );\n    }\n\n    #[test]\n    fn every_hardening_header_has_a_valid_value() {\n        for (name, value) in HEADERS {\n            assert!(\n                HeaderValue::from_str(value).is_ok(),\n                \"{name} carries an unsendable value\"\n            );\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":2598,"end":3342},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3342,"end":3343,"unit":"utf16","byteStart":3348,"byteEnd":3349},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Response hardening for the admin listener.\n//!\n//! The admin console keeps its credential in `localStorage` (see `ui/src/api.js`),\n//! which makes two browser-side attacks worth closing at the HTTP layer rather\n//! than trusting the bundle:\n//!\n//! * **script injection** — any script that runs on this origin can read the\n//!   token. React escapes what it renders, but a Content-Security-Policy that\n//!   allows scripts only from this origin means an injected `<script src=…>` or\n//!   an exfiltrating `fetch()` to another host fails even if escaping ever does;\n//! * **clickjacking** — the console has one-click destructive actions (revoke,\n//!   rotate). `frame-ancestors 'none'` plus `X-Frame-Options: DENY` keeps it out\n//!   of a third-party frame, and `form-action 'none'` keeps a submitted form\n//!   from posting the page's data elsewhere.\n//!\n//! `style-src` has to allow inline styles: Chakra/emotion injects its rules into\n//! a `<style>` element at runtime. That is the one relaxation, and it does not\n//! help an attacker reach the token.\n//!\n//! These are defence in depth. The primary control is still that the admin\n//! listener does not exist unless the operator gives it a port, and binds to\n//! loopback when they do.\n\nuse axum::extract::Request;\nuse axum::http::{HeaderValue, header};\nuse axum::middleware::Next;\nuse axum::response::Response;\n\n/// Content-Security-Policy served with every admin response.\npub const CONTENT_SECURITY_POLICY: &crate::translation_core::Str = \"default-src 'self'; \\\n     script-src 'self'; \\\n     style-src 'self' 'unsafe-inline'; \\\n     img-src 'self' data:; \\\n     font-src 'self' data:; \\\n     connect-src 'self'; \\\n     object-src 'none'; \\\n     base-uri 'none'; \\\n     form-action 'none'; \\\n     frame-ancestors 'none'\";\n\n/// Headers applied to every response from the admin listener.\nconst HEADERS: &[(header::HeaderName, &crate::translation_core::Str)] = &[\n    (header::CONTENT_SECURITY_POLICY, CONTENT_SECURITY_POLICY),\n    (header::X_FRAME_OPTIONS, \"DENY\"),\n    (header::X_CONTENT_TYPE_OPTIONS, \"nosniff\"),\n    (header::REFERRER_POLICY, \"no-referrer\"),\n];\n\n/// Middleware that hardens every admin response.\n///\n/// Existing headers are overwritten: nothing downstream has a reason to set a\n/// weaker policy, and silently keeping one would defeat the point.\npub async fn apply(request: Request, next: Next) -> Response {\n    let mut response = next.run(request).await;\n    let headers = response.headers_mut();\n    for (name, value) in HEADERS {\n        headers.insert(name, HeaderValue::from_static(value));\n    }\n    response\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn the_policy_pins_scripts_to_this_origin_and_forbids_framing() {\n        assert!(CONTENT_SECURITY_POLICY.contains(\"script-src 'self'\"));\n        assert!(CONTENT_SECURITY_POLICY.contains(\"frame-ancestors 'none'\"));\n        assert!(\n            !CONTENT_SECURITY_POLICY.contains(\"script-src 'self' 'unsafe-inline'\"),\n            \"inline script would re-open the injection path to the localStorage token\"\n        );\n    }\n\n    #[test]\n    fn every_hardening_header_has_a_valid_value() {\n        for (name, value) in HEADERS {\n            assert!(\n                HeaderValue::from_str(value).is_ok(),\n                \"{name} carries an unsendable value\"\n            );\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":3343,"utf8Bytes":3349,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"