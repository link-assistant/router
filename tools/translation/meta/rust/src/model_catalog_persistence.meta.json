eEnd":1572},"sha256":"2caa2f42d02afba754e9a5958bfc8180ddcf20a5a7421c3265c4643e4b3425c8","source":"pub(super) fn invalidation_path(\n    directory: &Path,\n    provider: SubscriptionProvider,\n    router_account: &str,\n) -> PathBuf {\n    use sha2::Digest as _;\n    let digest = sha2::Sha256::digest(format!(\"{provider}\\0{router_account}\").as_bytes());\n    directory.join(format!(\n        \"{}-{}.invalidated\",\n        provider.as_str(),\n        hex::encode(digest)\n    ))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1202,"end":1572,"unit":"utf16","byteStart":1202,"byteEnd":1572}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1572,"end":1574,"unit":"utf16","byteStart":1572,"byteEnd":1574},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"secure_directory","span":{"start":1574,"end":1853,"unit":"utf16","byteStart":1574,"byteEnd":1853},"sha256":"037fb1de43ff7c460b8fea2093dce65abfa8e781c96423d0c2f8332f2e7d34fe","source":"pub(super) fn secure_directory(path: &Path) -> std::io::Result<()> {\n    std::fs::create_dir_all(path)?;\n    #[cfg(unix)]\n    {\n        use std::os::unix::fs::PermissionsExt as _;\n        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o700))?;\n    }\n    Ok(())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1574,"end":1853,"unit":"utf16","byteStart":1574,"byteEnd":1853}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1853,"end":1854,"unit":"utf16","byteStart":1853,"byteEnd":1854},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! On-disk model catalog state: the persisted catalogs and the owner-only\n//! invalidation markers. Split from `model_catalog.rs` to keep that file\n//! within the repository's 1000-line limit.\n\nuse std::collections::HashMap;\nuse std::path::{Path, PathBuf};\n\nuse super::{CatalogStatus, PERSISTED_CATALOG_VERSION, PersistedCatalogs};\nuse crate::subscription::SubscriptionProvider;\n\npub(super) fn load_persisted_catalogs(\n    path: &Path,\n) -> Result<HashMap<(SubscriptionProvider, String), CatalogStatus>, String> {\n    let bytes = match std::fs::read(path) {\n        Ok(bytes) => bytes,\n        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(HashMap::new()),\n        Err(error) => return Err(error.to_string()),\n    };\n    let persisted: PersistedCatalogs =\n        serde_json::from_slice(&bytes).map_err(|error| error.to_string())?;\n    if persisted.version != PERSISTED_CATALOG_VERSION {\n        return Err(format!(\n            \"unsupported persisted catalog version {}\",\n            persisted.version\n        ));\n    }\n    Ok(persisted\n        .entries\n        .into_iter()\n        .map(|entry| ((entry.provider, entry.router_account), entry.status))\n        .collect())\n}\n\npub(super) fn invalidation_path(\n    directory: &Path,\n    provider: SubscriptionProvider,\n    router_account: &str,\n) -> PathBuf {\n    use sha2::Digest as _;\n    let digest = sha2::Sha256::digest(format!(\"{provider}\\0{router_account}\").as_bytes());\n    directory.join(format!(\n        \"{}-{}.invalidated\",\n        provider.as_str(),\n        hex::encode(digest)\n    ))\n}\n\npub(super) fn secure_directory(path: &Path) -> std::io::Result<()> {\n    std::fs::create_dir_all(path)?;\n    #[cfg(unix)]\n    {\n        use std::os::unix::fs::PermissionsExt as _;\n        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o700))?;\n    }\n    Ok(())\n}\n","sourceEncoding":{"utf16CodeUnits":1854,"utf8Bytes":1854,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1854,0,1854,-1],["trivia","comment",0,74,0,74,0],["trivia","whitespace",74,75,74,75,0],["trivia","comment",75,148,75,148,0],["trivia","whitespace",148,149,148,149,0],["trivia","comment",149,193,149,193,0],["trivia","whitespace",193,195,193,195,0],["token","identifier",195,198,195,198,0],["trivia","whitespace",198,199,198,199,0],["token","identifier",199,202,199,202,0],["token","punct",202,204,202,204,0],["token","identifier",204,215,204,215,0],["token","punct",215,217,215,217,0],["token","identifier",217,224,217,224,0],["token","punct",224,225,224,225,0],["trivia","whitespace",225,226,225,226,0],["token","identifier",226,229,226,229,0],["trivia","whitespace",229,230,229,230,0],["token","identifier",230,233,230,233,0],["token","punct",233,235,233,235,0],["token","identifier",235,239,235,239,0],["token","punct",239,241,239,241,0],["group","brace",241,256,241,256,0],["token","delimiter",241,242,241,242,22],["token","identifier",242,246,242,246,22],["token","punct",246,247,246,247,22],["trivia","whitespace",247,248,247,248,22],["token","identifier",248,255,248,255,22],["token","delimiter",255,256,255,256,22],["token","punct",256,257,256,257,0],["trivia","whitespace",257,259,257,259,0],["token","identifier",259,262,259,262,0],["trivia","whitespace",262,263,262,263,0],["token","identifier",263,268,263,268,0],["token","punct",268,270,268,270,0],["group","brace",270,331,270,331,0],["token","delimiter",270,271,270,271,35],["token","identifier",271,284,271,284,35],["token","punct",284,285,284,285,35],["trivia","whitespace",285,286,285,286,35],["token","identifier",286,311,286,311,35],["token","punct",311,312,311,312,35],["trivia","whitespace",312,313,312,313,35],["token"