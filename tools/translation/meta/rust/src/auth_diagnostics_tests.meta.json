ic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":799,"end":805},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1527,"end":1529,"unit":"utf16","byteStart":1527,"byteEnd":1529},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_token_id_is_read_only_when_it_is_a_uuid","span":{"start":1529,"end":2016,"unit":"utf16","byteStart":1529,"byteEnd":2016},"sha256":"304780a0fbde06376a669cbbca2f5e97b7ae7adbd3a27dee51ceb1f53b8145f3","source":"#[test]\nfn the_token_id_is_read_only_when_it_is_a_uuid() {\n    let manager = crate::token::TokenManager::new(\"diagnostics-secret\");\n    let (token, id) = manager\n        .issue_with_id(&crate::token::IssueRequest {\n            ttl_hours: 1,\n            label: \"probe\",\n            ..crate::token::IssueRequest::default()\n        })\n        .unwrap();\n    assert_eq!(unverified_subject(&token).as_deref(), Some(id.as_str()));\n    assert_eq!(unverified_subject(\"la_sk_not.a.jwt\"), None);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1529,"end":1535},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2016,"end":2018,"unit":"utf16","byteStart":2016,"byteEnd":2018},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"one_request_counts_its_authentication_outcome_once","span":{"start":2018,"end":2613,"unit":"utf16","byteStart":2018,"byteEnd":2613},"sha256":"fdb9c655e90a8900c265b9959fff323ea61fec7dc6047ed09ab6582aa24d9306","source":"#[tokio::test]\nasync fn one_request_counts_its_authentication_outcome_once() {\n    assert!(\n        first_outcome_in_request(),\n        \"outside a request every call counts\"\n    );\n    assert!(first_outcome_in_request());\n    let counted = scope_request(async {\n        [\n            first_outcome_in_request(),\n            first_outcome_in_request(),\n            first_outcome_in_request(),\n        ]\n    })\n    .await;\n    assert_eq!(counted, [true, false, false]);\n    let next = scope_request(async { first_outcome_in_request() }).await;\n    assert!(next, \"each request starts uncounted\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[tokio]: attributes that change compilation are outside the portable core","span":{"start":2018,"end":2025},"details":{"construct":"#[tokio]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2613,"end":2614,"unit":"utf16","byteStart":2613,"byteEnd":2614},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use super::*;\n\n#[test]\nfn every_rejection_has_its_own_reason_code() {\n    let codes = [\n        TokenError::InvalidPrefix,\n        TokenError::Invalid(\"x\".into()),\n        TokenError::SignatureInvalid,\n        TokenError::IssuerSecretUnset,\n        TokenError::Expired(None),\n        TokenError::Revoked,\n        TokenError::MissingRecord,\n        TokenError::BindingMismatch,\n        TokenError::NotFound(\"id\".into()),\n        TokenError::InsufficientScope,\n        TokenError::LimitExceeded(None),\n        TokenError::TokenLimitExceeded(None),\n        TokenError::RateLimitExceeded,\n        TokenError::Storage(\"disk\".into()),\n    ]\n    .iter()\n    .map(TokenError::reason_code)\n    .collect::<std::collections::BTreeSet<_>>();\n    assert_eq!(codes.len(), 14, \"reason codes must be distinct\");\n}\n\n#[test]\nfn recent_failures_are_bounded_and_hold_no_token_value() {\n    let diagnostics = AuthDiagnostics::default();\n    let token = \"la_sk_secret-material-that-must-not-leak\";\n    for _ in 0..(RECENT_CAPACITY + 10) {\n        diagnostics.record(reason::SIGNATURE_INVALID, Some(token));\n    }\n    let snapshot = diagnostics.snapshot();\n    assert_eq!(snapshot.recent_failures.len(), RECENT_CAPACITY);\n    assert_eq!(\n        snapshot.failures_by_reason[reason::SIGNATURE_INVALID],\n        (RECENT_CAPACITY + 10) as u64\n    );\n    let rendered = serde_json::to_string(&snapshot).unwrap() + &diagnostics.render_prometheus();\n    assert!(!rendered.contains(\"secret-material\"));\n    assert!(rendered.contains(\"signature_invalid\"));\n}\n\n#[test]\nfn the_token_id_is_read_only_when_it_is_a_uuid() {\n    let manager = crate::token::TokenManager::new(\"diagnostics-secret\");\n    let (token, id) = manager\n        .issue_with_id(&crate::token::IssueRequest {\n            ttl_hours: 1,\n            label: \"probe\",\n            ..crate::token::IssueRequest::default()\n        })\n        .unwrap();\n    assert_eq!(unverified_subject(&token).as_deref(), Some(id.as_str()));\n    assert_eq!(unverified_subject(\"la_sk_not.a.jwt\"), None);\n}\n\n#[tokio::test]\nasync fn one_request_counts_its_authentication_outcome_once() {\n    assert!(\n        first_outcome_in_request(),\n        \"outside a request every call counts\"\n    );\n    assert!(first_outcome_in_request());\n    let counted = scope_request(async {\n        [\n            first_outcome_in_request(),\n            first_outcome_in_request(),\n            first_outcome_in_request(),\n        ]\n    })\n    .await;\n    assert_eq!(counted, [true, false, false]);\n    let next = scope_request(async { first_outcome_in_request() }).await;\n    assert!(next, \"each request starts uncounted\");\n}\n","sourceEncoding":{"utf16CodeUnits":2614,"utf8Bytes":2614,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["