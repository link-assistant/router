gerEncoding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":384,"unit":"utf16","byteStart":0,"byteEnd":384},"sha256":"823bfd2dacc7d0b958d12ada28af10a6b0a68845db6d5064d2993f16077b2a9b","source":"//! The client token a local deployment issues, and its limits (issue #679).\n//!\n//! Every accepted candidate carries one unrevoked `deploy`-labelled client\n//! token. `--token-*` flags (or `[tokens]` in `--config`) bound it: lifetime,\n//! request and token caps, rate and the exact models it may request. Without\n//! them it is issued exactly as before. The value is never printed.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":384,"end":433,"unit":"utf16","byteStart":384,"byteEnd":433},"sha256":"b2eb9a1f1fd7e576d37abf74efb57c845130810d5997dd41299d003d5dafc8f0","source":"use super::{Coordinator, LABEL_KEY, runtime_env};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":384,"end":433},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":433,"end":435,"unit":"utf16","byteStart":433,"byteEnd":435},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"Coordinator","span":{"start":435,"end":1724,"unit":"utf16","byteStart":435,"byteEnd":1724},"sha256":"4322410d782356c3cd2f081e6cc4f2caba886913a63641f26581b5732c0277d9","source":"impl Coordinator<'_> {\n    pub(super) fn ensure_deploy_token(&self, backend: &str) {\n        let present = self\n            .docker\n            .token_inventory(backend)\n            .ok()\n            .and_then(|rendered| {\n                crate::operations::decode_token_inventory(rendered.as_bytes()).ok()\n            })\n            .is_some_and(|records| {\n                records\n                    .iter()\n                    .any(|record| record.label == \"deploy\" && !record.revoked)\n            });\n        if !present {\n            let policy = runtime_env::current().tokens.issue_arguments();\n            let mut arguments = vec![\"router\", \"tokens\", \"issue\", \"--label\", \"deploy\"];\n            arguments.extend(policy.iter().map(String::as_str));\n            match self.docker.exec(backend, &arguments) {\n                Ok(_) => println!(\"issued deploy client token (value withheld)\"),\n                Err(error) => println!(\"deploy client token skipped: {error}\"),\n            }\n        }\n    }\n\n    /// The runtime environment fingerprint a backend was launched with.\n    pub(super) fn runtime_env_label(&self, backend: &str) -> Option<String> {\n        self.docker.label(\n            backend,\n            &format!(\"{LABEL_KEY}.{}\", runtime_env::LABEL_SUFFIX),\n        )\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":435,"end":1724},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1724,"end":1725,"unit":"utf16","byteStart":1724,"byteEnd":1725},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! The client token a local deployment issues, and its limits (issue #679).\n//!\n//! Every accepted candidate carries one unrevoked `deploy`-labelled client\n//! token. `--token-*` flags (or `[tokens]` in `--config`) bound it: lifetime,\n//! request and token caps, rate and the exact models it may request. Without\n//! them it is issued exactly as before. The value is never printed.\n\nuse super::{Coordinator, LABEL_KEY, runtime_env};\n\nimpl Coordinator<'_> {\n    pub(super) fn ensure_deploy_token(&self, backend: &str) {\n        let present = self\n            .docker\n            .token_inventory(backend)\n            .ok()\n            .and_then(|rendered| {\n                crate::operations::decode_token_inventory(rendered.as_bytes()).ok()\n            })\n            .is_some_and(|records| {\n                records\n                    .iter()\n                    .any(|record| record.label == \"deploy\" && !record.revoked)\n            });\n        if !present {\n            let policy = runtime_env::current().tokens.issue_arguments();\n            let mut arguments = vec![\"router\", \"tokens\", \"issue\", \"--label\", \"deploy\"];\n            arguments.extend(policy.iter().map(String::as_str));\n            match self.docker.exec(backend, &arguments) {\n                Ok(_) => println!(\"issued deploy client token (value withheld)\"),\n                Err(error) => println!(\"deploy client token skipped: {error}\"),\n            }\n        }\n    }\n\n    /// The runtime environment fingerprint a backend was launched with.\n    pub(super) fn runtime_env_label(&self, backend: &str) -> Option<String> {\n        self.docker.label(\n            backend,\n            &format!(\"{LABEL_KEY}.{}\", runtime_env::LABEL_SUFFIX),\n        )\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1725,"utf8Bytes":1725,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1725,0,1725,-1],["trivia","comment",0,76,0,76,0],["trivia","whitespace",76,77,76,77,0],["trivia","comment",77,80,77,80,0],["trivia","whitespace",80,81,80,81,0],["trivia","comment",81,156,81,156,0],["trivia","whitespace",156,157,156,157,0],["trivia","comment",157,235,157,235,0],["trivia","whitespace",235,236,235,236,0],["trivia","comment",236,313,236,313,0],["trivia","whitespace",313,314,313,314,0],["trivia","comment",314,382,314,382,0],["trivia","whitespace",382,384,382,384,0],["token","identifier",384,387,384,387,0],["trivia","whitespace",387,388,387,388,0],["token","identifier",388,393,388,393,0],["token","punct",393,395,393,395,0],["group","brace",395,432,395,432,0],["token","delimiter",395,396,395,396,17],["token","identifier",396,407,396,407,17],["token","punct",407,408,407,408,17],["trivia","whitespace",408,409,408,409,17],["token","identifier",409,418,409,418,17],["token","punct",418,419,418,419,17],["trivia","whitespace",419,420,419,420,17],["token","identifier",420,431,420,431,17],["token","delimiter",431,432,431,432,17],["token","punct",432,433,432,433,0],["trivia","whitespace",433,435,433,435,0],["token","identifier",435,439,435,439,0],["trivia","whitespace",439,440,439,440,0],["token","identifier",440,451,440,451,0],["token","punct",451,452,451,452,0],["token","char",452,454,452,454,0],["token","punct",454,455,454,455,0],["trivia","whitespace",455,456,455,456,0],["group","brace",456,1724,456,1724,0],["token","delimiter",456,457,456,457,36],["trivia","whitespace",457,462,457,462,36],["token","