an":{"start":125,"end":444,"unit":"utf16","byteStart":125,"byteEnd":444},"sha256":"f3984c205948f334a20466fd6d96af249623d28bf6185dcea587a7a14adeeb0b","source":"impl Drop for OperationLock {\n    fn drop(&mut self) {\n        // Closing one descriptor does not release a Unix lock while an\n        // unrelated child still has a copy between fork and exec. Release\n        // ownership explicitly when the operation and its awaited work end.\n        let _ = self.0.unlock();\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":125,"end":444},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":444,"end":446,"unit":"utf16","byteStart":444,"byteEnd":446},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":446,"end":1600,"unit":"utf16","byteStart":446,"byteEnd":1600},"sha256":"338fb100d9f06624e8f94f8049e89c98a3055896827d55cb19bc7ad710d4374a","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn inherited_descriptors_do_not_keep_a_finished_operation_locked() {\n        let directory = tempfile::tempdir().unwrap();\n        let path = directory.path().join(\"operation.lock\");\n        let open = || {\n            std::fs::OpenOptions::new()\n                .create(true)\n                .truncate(false)\n                .read(true)\n                .write(true)\n                .open(&path)\n                .unwrap()\n        };\n        let file = open();\n        file.try_lock().unwrap();\n        let operation = OperationLock(file);\n        // A duplicated descriptor shares the lock, just as one inherited by\n        // an unrelated child between fork and exec does on Unix.\n        let inherited = operation.0.try_clone().unwrap();\n        let next = open();\n        assert!(\n            next.try_lock().is_err(),\n            \"the active operation owns its lock\"\n        );\n        drop(operation);\n        next.try_lock()\n            .expect(\"finishing the operation releases its lock even while a descriptor survives\");\n        next.unlock().unwrap();\n        drop(inherited);\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":446,"end":1600},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1600,"end":1601,"unit":"utf16","byteStart":1600,"byteEnd":1601},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! A deployment lifecycle lock owned by the operation's scope.\n\npub(super) struct OperationLock(pub(super) std::fs::File);\n\nimpl Drop for OperationLock {\n    fn drop(&mut self) {\n        // Closing one descriptor does not release a Unix lock while an\n        // unrelated child still has a copy between fork and exec. Release\n        // ownership explicitly when the operation and its awaited work end.\n        let _ = self.0.unlock();\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn inherited_descriptors_do_not_keep_a_finished_operation_locked() {\n        let directory = tempfile::tempdir().unwrap();\n        let path = directory.path().join(\"operation.lock\");\n        let open = || {\n            std::fs::OpenOptions::new()\n                .create(true)\n                .truncate(false)\n                .read(true)\n                .write(true)\n                .open(&path)\n                .unwrap()\n        };\n        let file = open();\n        file.try_lock().unwrap();\n        let operation = OperationLock(file);\n        // A duplicated descriptor shares the lock, just as one inherited by\n        // an unrelated child between fork and exec does on Unix.\n        let inherited = operation.0.try_clone().unwrap();\n        let next = open();\n        assert!(\n            next.try_lock().is_err(),\n            \"the active operation owns its lock\"\n        );\n        drop(operation);\n        next.try_lock()\n            .expect(\"finishing the operation releases its lock even while a descriptor survives\");\n        next.unlock().unwrap();\n        drop(inherited);\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1601,"utf8Bytes":1601,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1601,0,1601,-1],["trivia","comment",0,63,0,63,0],["trivia","whitespace",63,65,63,65,0],["token","identifier",65,68,65,68,0],["group","paren",68,75,68,75,0],["token","delimiter",68,69,68,69,4],["token","identifier",69,74,69,74,4],["token","delimiter",74,75,74,75,4],["trivia","whitespace",75,76,75,76,0],["token","identifier",76,82,76,82,0],["trivia","whitespace",82,83,82,83,0],["token","identifier",83,96,83,96,0],["group","paren",96,122,96,122,0],["token","delimiter",96,97,96,97,12],["token","identifier",97,100,97,100,12],["group","paren",100,107,100,107,12],["token","delimiter",100,101,100,101,15],["token","identifier",101,106,101,106,15],["token","delimiter",106,107,106,107,15],["trivia","whitespace",107,108,107,108,12],["token","identifier",108,111,108,111,12],["token","punct",111,113,111,113,12],["token","identifier",113,115,113,115,12],["token","punct",115,117,115,117,12],["token","identifier",117,121,117,121,12],["token","delimiter",121,122,121,122,12],["token"