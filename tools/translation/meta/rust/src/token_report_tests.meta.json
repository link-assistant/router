) -> Value {\n    serde_json::json!({\n        \"id\": \"tok-1\",\n        \"label\": \"ci\",\n        \"issued_at\": 1_700_000_000_i64,\n        \"expires_at\": 1_700_086_400_i64,\n        \"revoked\": false,\n        \"used_requests\": 7,\n        \"max_requests\": 100,\n        \"used_tokens\": 1_234,\n        \"max_tokens\": 50_000,\n        \"reserved_tokens\": 12,\n        \"rate_limit_per_minute\": 60,\n        \"scope\": \"\",\n    })\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"json! context: requires actual sealed dependency/features and original module scope","span":{"start":112,"end":122},"details":{"construct":"json! context"}},"comment":false},{"term":"trivia","name":null,"span":{"start":499,"end":574,"unit":"utf16","byteStart":499,"byteEnd":574},"sha256":"024c3a6d5bd059f180ea531adbeedfcfa888532a020048678b1e098df93e6f3e","source":"\n\n/// The row carries every column an operator reads, in the local format.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_row_reports_usage_against_its_caps","span":{"start":574,"end":1018,"unit":"utf16","byteStart":574,"byteEnd":1018},"sha256":"c9c280f0806e6fbcc5e05297e4dd624e57265a2bda9135ad75811d4574e6ccc8","source":"#[test]\nfn a_row_reports_usage_against_its_caps() {\n    let line = row(&record());\n\n    assert!(line.contains(\"tok-1\"), \"{line}\");\n    assert!(line.contains(\"7/100\"), \"requests used over cap: {line}\");\n    assert!(line.contains(\"1234/50000\"), \"tokens used over cap: {line}\");\n    assert!(line.contains(\"60\"), \"the per-minute rate: {line}\");\n    assert!(\n        line.trim_end().ends_with(\"ci\"),\n        \"the label ends the row: {line}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":574,"end":580},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1018,"end":1197,"unit":"utf16","byteStart":1018,"byteEnd":1199},"sha256":"b131eeae80b0428c90409bc3651f05874acf5c0b66be45df26f8d0a8fdca0067","source":"\n\n/// An absent cap prints as unlimited rather than as zero.\n///\n/// `0/0` would read as a token that can make no requests at all — the opposite\n/// of what an omitted cap means.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_absent_cap_reads_as_unlimited","span":{"start":1197,"end":1682,"unit":"utf16","byteStart":1199,"byteEnd":1684},"sha256":"ec956be12e61422a7d87daa9addfe7cddcadd77c1df8e1c054371c86891fcd99","source":"#[test]\nfn an_absent_cap_reads_as_unlimited() {\n    let mut value = record();\n    value[\"max_requests\"] = Value::Null;\n    value[\"max_tokens\"] = Value::Null;\n    value[\"rate_limit_per_minute\"] = Value::Null;\n\n    let line = row(&value);\n\n    assert!(line.contains(\"7/-\"), \"an unlimited request cap: {line}\");\n    assert!(line.contains(\"1234/-\"), \"an unlimited token cap: {line}\");\n    assert!(\n        line.contains(\" - \"),\n        \"an unlimited rate prints as a dash: {line}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1197,"end":1203},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1682,"end":1746,"unit":"utf16","byteStart":1684,"byteEnd":1748},"sha256":"a4ddbb3ab68d5675075d9090dab64728c041e44c4006e77b71a984ba7eb74734","source":"\n\n/// An empty scope is the ordinary client token, and says so.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_empty_scope_reads_as_client","span":{"start":1746,"end":2048,"unit":"utf16","byteStart":1748,"byteEnd":2050},"sha256":"dbee78edc89c4ded3019bea136d2b77506f8be4ad705213b4c45106eaa0f520f","source":"#[test]\nfn an_empty_scope_reads_as_client() {\n    assert!(row(&record()).contains(\"client\"));\n\n    let mut admin = record();\n    admin[\"scope\"] = Value::String(\"admin\".into());\n    let line = row(&admin);\n    assert!(line.contains(\"admin\"), \"{line}\");\n    assert!(!line.contains(\"client\"), \"{line}\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1746,"end":1752},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2048,"end":2249,"unit":"utf16","byteStart":2050,"byteEnd":2251},"sha256":"da644489b1f31a679b38f6e6cc67d9cc1b68fe85058f8bd399c96dbe2a8a64a4","source":"\n\n/// A record missing fields still renders a row rather than panicking.\n///\n/// The remote path receives whatever the deployment sends, which may be an\n/// older or newer shape than this build knows.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_unfamiliar_record_still_renders","span":{"start":2249,"end":2508,"unit":"utf16","byteStart":2251,"byteEnd":2510},"sha256":"7276adaffe420c89be54e1868e15b022458e3e1645757d8dd2fb729cf478e3c4","source":"#[test]\nfn an_unfamiliar_record_still_renders() {\n    let line = row(&serde_json::json!({\"id\": \"tok-2\"}));\n\n    assert!(line.contains(\"tok-2\"), \"{line}\");\n    assert!(\n        line.contains(\"0/-\"),\n        \"unknown usage is zero of unlimited: {line}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2249,"end":2255},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2508,"end":2509,"unit":"utf16","byteStart":2510,"byteEnd":2511},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Unit tests for the shared token table ([`crate::token_report`]).\n\nuse super::*;\n\nfn record() -> Value {\n    serde_json::json!({\n        \"id\": \"tok-1\",\n        \"label\": \"ci\",\n        \"issued_at\": 1_700_000_000_i64,\n        \"expires_at\": 1_700_086_400_i64,\n        \"revoked\": false,\n        \"used_requests\": 7,\n        \"max_requests\": 100,\n        \"used_tokens\": 1_234,\n        \"max_tokens\": 50_000,\n        \"reserved_tokens\": 12,\n        \"rate_limit_per_minute\": 60,\n        \"scope\": \"\",\n    })\n}\n\n/// The row carries every column an operator reads, in the local format.\n#[test]\nfn a_row_reports_usage_against_its_caps() {\n    let line = row(&record());\n\n    assert!(line.contains(\"tok-1\"), \"{line}\");\n    assert!(line.contains(\"7/100\"), \"requests used over cap: {line}\");\n    assert!(line.contains(\"1234/50000\"), \"tokens used over cap: {line}\");\n    assert!(line.contains(\"60\"), \"the per-minute rate: {line}\");\n    assert!(\n        line.trim_end().ends_with(\"ci\"),\n        \"the label ends the row: {line}\"\n    );\n}\n\n/// An absent cap prints as unlimited rather than as zero.\n///\n/// `0/0` would read as a token that can make no requests at all — the opposite\n/// of what an omitted cap means.\n#[test]\nfn an_absent_cap_reads_as_unlimited() {\n    let mut value = record();\n    value[\"max_requests\"] = Value::Null;\n    value[\"max_tokens\"] = Value::Null;\n    value[\"rate_limit_per_minute\"] = Value::Null;\n\n    let line = row(&value);\n\n    assert!(line.contains(\"7/-\"), \"an unlimited request cap: {line}\");\n    assert!(line.contains(\"1234/-\"), \"an unlimited token cap: {line}\");\n    assert!(\n        line.contains(\" - \"),\n        \"an unlimited rate prints as a dash: {line}\"\n    );\n}\n\n/// An empty scope is the ordinary client token, and says so.\n#[test]\nfn an_empty_scope_reads_as_client() {\n    assert!(row(&record()).contains(\"client\"));\n\n    let mut admin = record();\n    admin[\"scope\"] = Value::String(\"admin\".into());\n    let line = row(&admin);\n    assert!(line.contains(\"admin\"), \"{line}\");\n    assert!(!line.contains(\"client\"), \"{line}\");\n}\n\n/// A record missing fields still renders a row rather than panicking.\n///\n/// The remote path receives whatever the deployment sends, which may be an\n/// older or newer shape than this build knows.\n#[test]\nfn an_unfamiliar_record_still_renders() {\n    let line = row(&serde_json::json!({\"id\": \"tok-2\"}));\n\n    assert!(line.contains(\"tok-2\"), \"{line}\");\n    assert!(\n        line.contains(\"0/-\"),\n        \"unknown usage is zero of unlimited: {line}\"\n    );\n}\n","sourceEncoding":{"utf16CodeUnits":2509,"utf8Bytes":2511,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2509,0,2511,-1],["trivia","comment",0,68,0,68,0],["trivia","whitespace",68,70,68,70,0],["token","identifier",70,73,70,73,0],["trivia","whitespace",73,74,73,74,0],["token","identifier",74,79,74,79,0],["token","punct",79,81,79,81,0],["token","punct",81,82,81,82,0],["token","punct",82,83,82,83,0],["trivia","whitespace",83,85,83,85,0],["token","identifier",85,87,85,87,0],["trivia","whitespace",87,88,87,88,0],["token","identifier",88,94,88,94,0],["group","paren",94,96,94,96,0],["token","delimiter",94,95,94,95,13],["token","delimiter",95,96,95,96,13],["trivia","whitespace",96,97,96,97,0],["token","punct",97,99,97,99,0],["trivia","whitespace",99,100,99,100,0],["token","identifier",100,105,100,105,0],["trivia","whitespace",105,106,105,106,0],["group","brace",106,499,106,499,0],["token","delimiter",106,107,106,107,21],["trivia","whitespace",107,112,107,112,21],["token","identifier",112,122,112,122,21],["token","punct",122,124,122,124,21],["token","identifier",124,129,124,129,21],["group","paren",129,497,129,497,21],["token","delimiter",129,130,129,130,27],["group","brace",130,496,130,496,27],["token","delimiter",130,131,130,131,29],["trivia","whitespace",131,140,131,14