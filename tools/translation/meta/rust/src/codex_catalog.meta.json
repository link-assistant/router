ed_in_api\": true,\n        \"priority\": i32::try_from(priority).unwrap_or(i32::MAX),\n        \"availability_nux\": null,\n        \"upgrade\": null,\n        \"support_verbosity\": false,\n        \"default_verbosity\": null,\n        \"apply_patch_tool_type\": \"freeform\",\n        \"truncation_policy\": {\"mode\": \"tokens\", \"limit\": 10_000},\n        \"experimental_supported_tools\": [],\n        \"base_instructions\": \"\"\n    })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":668,"end":1583,"unit":"utf16","byteStart":668,"byteEnd":1583}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1583,"end":1584,"unit":"utf16","byteStart":1583,"byteEnd":1584},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Codex model-catalog projection shared by process-local and HTTP discovery.\n\nuse serde_json::Value;\n\n/// Inputs retained from one authorized live catalog row.\npub struct ModelDescription<'a> {\n    pub id: &'a str,\n    pub display_name: &'a str,\n    pub owner: &'a str,\n    pub default_reasoning_level: Option<Value>,\n    pub supported_reasoning_levels: Value,\n}\n\n/// Produce the `ModelInfo` shape accepted by current Codex clients.\n///\n/// The deprecated `base_instructions` field remains because Codex's own\n/// serializer includes it for older clients. Empty instructions ask the client\n/// to use its built-in fallback without inventing model-specific behavior.\npub fn model_info(model: &ModelDescription<'_>, priority: usize) -> Value {\n    crate::translation_core::json!({\n        \"slug\": model.id,\n        \"display_name\": model.display_name,\n  