570dfa8c21435b59450e","source":"use crate::cli::AuthTarget;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":116,"end":143},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":143,"end":145,"unit":"utf16","byteStart":143,"byteEnd":145},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"args","span":{"start":145,"end":408,"unit":"utf16","byteStart":145,"byteEnd":408},"sha256":"3e0fc228a61254bab3191bdc4fe1e8563add79eedbf90f44142bd6926dbd6ce7","source":"fn args(client: Option<ClientKind>) -> ConfigureArgs {\n    ConfigureArgs {\n        client,\n        all: client.is_none(),\n        undo: false,\n        target: AuthTarget::default(),\n        token: None,\n        token_stdin: false,\n        ttl_hours: 8760,\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed Option generic: the standard prelude type requires actual resolution","span":{"start":161,"end":179},"details":{"construct":"shadowed Option generic"}},"comment":false},{"term":"trivia","name":null,"span":{"start":408,"end":636,"unit":"utf16","byteStart":408,"byteEnd":636},"sha256":"fe595586182bfa94009165c50457ddb9e7fa985b572c7d084e84565bbfec10e3","source":"\n\n/// A client the router can never point at by writing a file is named and\n/// skipped, not attempted. Reversal makes the same check, because `--undo`\n/// used to report success for a configuration that could not exist (#303).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"clients_that_cannot_be_configured_by_file_are_named","span":{"start":636,"end":1286,"unit":"utf16","byteStart":636,"byteEnd":1286},"sha256":"4acf1ea7a6fa6e589a1fa99f97adb138b754feec797546519c5339ae3d97b199","source":"#[test]\nfn clients_that_cannot_be_configured_by_file_are_named() {\n    for client in [ClientKind::Cursor, ClientKind::GeminiCli] {\n        let reason = unconfigurable(client).expect(\"must be reported as unconfigurable\");\n        assert!(!reason.is_empty(), \"{client} must say why, not just refuse\");\n    }\n    // Everything else is configurable, so a skip list cannot silently grow.\n    for client in ClientKind::ALL {\n        if matches!(client, ClientKind::Cursor | ClientKind::GeminiCli) {\n            continue;\n        }\n        assert!(\n            unconfigurable(client).is_none(),\n            \"{client} must be configurable\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":636,"end":642},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1286,"end":1483,"unit":"utf16","byteStart":1286,"byteEnd":1483},"sha256":"b27ba44cf3abcc71153066732aa03461ffb8903ac6c10eb89c0bced6292b493b","source":"\n\n/// Grok CLI has no persistent base-URL setting, so the credential file is the\n/// whole configuration. `with --global` refused it outright and withheld the\n/// half that does work (issue #296).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"only_the_environment_only_client_skips_the_config_file","span":{"start":1483,"end":1866,"unit":"utf16","byteStart":1483,"byteEnd":1866},"sha256":"d22b1d45e98256dbb4b0a26cb6842702ceb2157698d04c87cc66b15acee2b65e","source":"#[test]\nfn only_the_environment_only_client_skips_the_config_file() {\n    assert!(environment_only(ClientKind::GrokCli));\n    for client in ClientKind::ALL {\n        if client == ClientKind::GrokCli {\n            continue;\n        }\n        assert!(\n            !environment_only(client),\n            \"{client} is configured by a file, not only by the environment\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1483,"end":1489},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1866,"end":1932,"unit":"utf16","byteStart":1866,"byteEnd":1932},"sha256":"e7865e3294007c3977e57e61088eab2b3960f0808aeefcbf82b9570c7c80490b","source":"\n\n/// A bare name acts on that client; `--all` acts on every one.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_named_client_is_the_only_one_acted_on","span":{"start":1932,"end":2162,"unit":"utf16","byteStart":1932,"byteEnd":2162},"sha256":"29466d72e50a20cbe59fba0154aa26656584a142e8bde69ca91dd766f338d729","source":"#[test]\nfn a_named_client_is_the_only_one_acted_on() {\n    assert_eq!(\n        args(Some(ClientKind::ClaudeCode)).clients(),\n        [ClientKind::ClaudeCode]\n    );\n    assert_eq!(args(None).clients(), ClientKind::ALL.to_vec());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1932,"end":1938},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2162,"end":2360,"unit":"utf16","byteStart":2162,"byteEnd":2362},"sha256":"eb1a29918da33d7c79f1f3c15a3485bb7c7002488dfd5b89a335fbcee881d654","source":"\n\n/// Undo removes local files and has to keep working offline, so it never\n/// resolves a target — it asks only what is already to hand, and an explicit\n/// `--token` wins over anything persisted.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_explicit_token_is_the_admin_credential_for_undo","span":{"start":2360,"end":2672,"unit":"utf16","byteStart":2362,"byteEnd":2674},"sha256":"a8d6e34384ce81ed5c9d052782c7a08cc591fb04062a18cb2c9eec938a5959c4","source":"#[test]\nfn an_explicit_token_is_the_admin_credential_for_undo() {\n    let mut with_token = args(Some(ClientKind::ClaudeCode));\n    with_token.token = Some(\"la_sk_explicit\".into());\n    assert_eq!(\n        admin_token_for(&with_token, \"https://router.example\"),\n        Some(\"la_sk_explicit\".to_string())\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2360,"end":2366},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2672,"end":2828,"unit":"utf16","byteStart":2674,"byteEnd":2830},"sha256":"687076f41d5f0824302f1628534a328b73735bf5f79f6eddc9e80ff1460ef719","source":"\n\n/// The default TTL is a year: this is the permanent path, and a credential\n/// that lapses next week makes \"configured\" mean \"configured until Tuesday\".\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_default_credential_outlives_the_week","span":{"start":2828,"end":2953,"unit":"utf16","byteStart":2830,"byteEnd":2955},"sha256":"ca6d4de80a45b25239eb79e1cf420e32f36f83abbdfdc10f06949698d01c4c9e","source":"#[test]\nfn the_default_credential_outlives_the_week() {\n    assert_eq!(args(Some(ClientKind::ClaudeCode)).ttl_hours, 8760);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2828,"end":2834},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2953,"end":2954,"unit":"utf16","byteStart":2955,"byteEnd":2956},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Tests for the decisions `router configure` makes before it touches the\n//! network (issue #296).\n\nuse super::*;\nuse crate::cli::AuthTarget;\n\nfn args(client: Option<ClientKind>) -> ConfigureArgs {\n    ConfigureArgs {\n        client,\n        all: client.is_none(),\n        undo: false,\n        target: AuthTarget::default(),\n        token: None,\n        token_stdin: false,\n        ttl_hours: 8760,\n    }\n}\n\n/// A client the router can never point at by writing a file is named and\n/// skipped, not attempted. Reversal makes the same check, because `--undo`\n/// used to report success for a configuration that could not exist (#303).\n#[test]\nfn clients_that_cannot_be_configured_by_file_are_named() {\n    for client in [ClientKind::Cursor, ClientKind::GeminiCli] {\n        let reason = unconfigurable(client).expect(\"must be reported as unconfigurable\");\n        assert!(!reason.is_empty(), \"{client} must say why, not just refuse\");\n    }\n    // Everything else is configurable, so a skip list cannot silently grow.\n    for client in ClientKind::ALL {\n        if matches!(client, ClientKind::Cursor | ClientKind::GeminiCli) {\n            continue;\n        }\n        assert!(\n            unconfigurable(client).is_none(),\n            \"{client} must be configurable\"\n        );\n    }\n}\n\n/// Grok CLI has no persistent base-URL setting, so the credential file is the\n/// whole configuration. `with --global` refused it outright and withheld the\n/// half that does work (issue #296).\n#[test]\nfn only_the_environment_only_client_skips_the_config_file() {\n    assert!(environment_only(ClientKind::GrokCli));\n    for client in ClientKind::ALL {\n        if client == ClientKind::GrokCli {\n            continue;\n        }\n        assert!(\n            !environment_only(client),\n            \"{client} is configured by a file, not only by the environment\"\n        );\n    }\n}\n\n/// A bare name acts on that client; `--all` acts on every one.\n#[test]\nfn a_named_client_is_the_only_one_acted_on() {\n    assert_eq!(\n        args(Some(ClientKind::ClaudeCode)).clients(),\n        [ClientKind::ClaudeCode]\n    );\n    assert_eq!(args(None).clients(), ClientKind::ALL.to_vec());\n}\n\n/// Undo removes local files and has to keep working offline, so it never\n/// resolves a target — it asks only what is already to hand, and an explicit\n/// `--token` wins over anything persisted.\n#[test]\nfn an_explicit_token_is_the_admin_credential_for_undo() {\n    let mut with_token = args(Some(ClientKind::ClaudeCode));\n    with_token.token = Some(\"la_sk_explicit\".into());\n    assert_eq!(\n        admin_token_for(&with_token, \"https://router.example\"),\n        Some(\"la_sk_explicit\".to_string())\n    );\n}\n\n/// The default TTL is a year: this is the permanent path, and a credential\n/// that lapses next week makes \"configured\" mean \"configured until Tuesday\".\n#[test]\nfn the_default_credential_outlives_the_week() {\n    assert_eq!(args(Some(ClientKind::ClaudeCode)).ttl_hours, 8760);\n}\n","sourceEncoding":{"utf16CodeUnits":2954,"utf8Bytes":2956,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2954,0,2956,-1],["trivia","comment",0,74,0,74,0],["trivia","whitespace",74,75,74,75,0],["trivia","comment",75,100,75,100,0],["trivia","whitespace",100,102,100,102,0],["token","identifier",102,105,102,105,0],["trivia","whitespace",105,106,105,106,0],["token","identifier",106,111,106,111,0],["token","punct",111,113,111,113,0],["token","punct",113,114,113,114,0],["token","punct",114,115,114,115,0],["trivia","whitespace",115,116,115,116,0],["token","identifier",116,119,116,119,0],["trivia","whitespace",119,120,119,120,0],["token","identifier",120,125,120,125,0],["token","punct",125,127,125,127,0],["token","identifier",127,130,127,130,0],["token","punct",130,132,130,132,0],["token","identifier",132,142,132,142,0],["token","punct",142,143,142,143,0],["trivia","whitespace",143,145,143,145,0],["token","identifier",145,147,145,147,0],["trivia","whitespace",147,148,147,148,0],["token","identifier",148,152,148,152,0],["group","paren",152,180,152,180,0],["token","delimiter",152,153,152,153,24],["token","identifier",153,159,153,159,24],["token","punct",