52e4475726174696f6e","modulePath":[]}],"encodings":[{"id":"host-contract-std_time_duration_from_secs","statement":"Pinned pure semantic profile: Rust 1.89.0 core/time.rs, stable functions only; clocks and Tokio sleep require separate checked effects. Duration values are immutable tagged records with own u64 BigInt seconds and normalized u32 BigInt nanoseconds below 1000000000; private fields describe the lowering ABI, not source-level constructor permission. Checked operations return frozen Rust Option values; ordinary operation overflow and invalid float constructors abort as Rust panics, never synthetic successful Results. Source f64 conversions preserve IEEE-754 values and nearest-nanosecond ties-to-even; f32 contracts are omitted until the frontend distinguishes binary32. constEligible means the pinned source declares the function const; pure alone never grants const evaluation to trait or floating constructor methods. Source-derived fixtures establish the adapter subset; Rust differential execution stays gated on complete JavaScript checks."},{"id":"data","statement":"a data value is a frozen object whose $ property names its constructor and whose other properties are its fields"},{"id":"numbers","statement":"every natural, integer and machine integer is a BigInt; machine-integer results are range-checked and throw RangeError where Rust would panic"}],"assumptions":[],"mappings":[{"kind":"function","source":"rp_6d6f64656c5f636174616c6f672e737461727475702e494e495449414c5f524546524553485f54494d454f5554","target":"rp_6d6f64656c5f636174616c6f672e737461727475702e494e495449414c5f524546524553485f54494d454f5554","sourceSpan":{"start":2327250,"end":2327255}},{"kind":"data","source":"rp_7374642e74696d652e4475726174696f6e","target":"rp_7374642e74696d652e4475726174696f6e","sourceSpan":{"start":0,"end":0}},{"kind":"constructor","source":"rp_7374642e74696d652e4475726174696f6e.Duration","target":"rp_7374642e74696d652e4475726174696f6e.Duration","sourceSpan":{"start":0,"end":0}},{"kind":"function","source":"INITIAL_REFRESH_TIMEOUT","target":"rp_6d6f64656c5f636174616c6f672e737461727475702e494e495449414c5f524546524553485f54494d454f5554","sourceSpan":{"start":2327250,"end":2327255}}],"params":[],"returns":{"kind":"data","name":"rp_7374642e74696d652e4475726174696f6e","rustSourceType":true},"project":{"entry":"rust/src/lib.rs","declaration":"model_catalog.startup.INITIAL_REFRESH_TIMEOUT"}}},{"term":"trivia","name":null,"span":{"start":1197,"end":1336,"unit":"utf16","byteStart":1197,"byteEnd":1336},"sha256":"212db3f78d7ddc939f69b67280db39cdb9d4e65a7ce97a4513e25fd3ca8c7d67","source":"\n\n/// Refresh every account's catalog once, bounded by `timeout`, then keep\n/// refreshing in the background. Returns the background task.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"refresh_catalogs_from_startup","span":{"start":1336,"end":2292,"unit":"utf16","byteStart":1336,"byteEnd":2292},"sha256":"29c81fd9dd098eae645abdf8d3e483e3d6929c86d86ea9858ba49c6a0aa0e56d","source":"pub async fn refresh_catalogs_from_startup(\n    client: reqwest::Client,\n    readers: Vec<(String, SubscriptionReader)>,\n    token_cache: Arc<crate::refresh::TokenCache>,\n    cache: Arc<ModelCatalogCache>,\n    timeout: Duration,\n) -> tokio::task::JoinHandle<()> {\n    let first = refresh_catalogs_for_accounts(&client, &readers, &token_cache, &cache);\n    let refreshed = tokio::time::timeout(timeout, first).await.is_ok();\n    if !refreshed {\n        tracing::warn!(\n            \"the first model catalog refresh did not finish within {}s; serving now and \\\n             reporting unrefreshed subscriptions as starting\",\n            timeout.as_secs()\n        );\n    }\n    tokio::spawn(async move {\n        if refreshed {\n            tokio::time::sleep(CATALOG_TTL).await;\n        }\n        loop {\n            refresh_catalogs_for_accounts(&client, &readers, &token_cache, &cache).await;\n            tokio::time::sleep(CATALOG_TTL).await;\n        }\n    })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1336,"end":2292,"unit":"utf16","byteStart":1336,"byteEnd":2292}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2292,"end":2293,"unit":"utf16","byteStart":2292,"byteEnd":2293},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! The first catalog refresh, completed before Router serves (issue #665).\n//!\n//! The refresh loop used to start in the background while the listeners were\n//! already answering, so `/api/models` served its first responses before any\n//! subscription catalog had loaded: a healthy Claude subscription's rows were\n//! missing, and a client launched in that window cached a list without them.\n//! A deployment waits for `/api/health` before it reports ready, so awaiting\n//! this one refresh before binding is also what makes \"ready\" mean \"catalogs\n//! loaded or definitively failed\".\n\nuse std::sync::Arc;\nuse std::time::Duration;\n\nuse super::{CATALOG_TTL, ModelCatalogCache, refresh_catalogs_for_accounts};\nuse crate::subscription::SubscriptionReader;\n\n/// The longest startup waits for the first refresh.\n///\n/// Each catalog request is already bounded by its own fetch timeout; this caps a slow credential\n/// refresh too, staying well inside the 60-second readiness wait of every\n/// deployment mode. A catalog still unrefreshed at the deadline is reported\n/// as starting, never degraded, until the loop below decides it.\npub const INITIAL_REFRESH_TIMEOUT: Duration = Duration::from_secs(20);\n\n/// Refresh every account's catalog once, bounded by `timeout`, then keep\n/// refreshing in the background. Returns the background task.\npub async fn refresh_catalogs_from_startup(\n    client: reqwest::Client,\n    readers: Vec<(String, SubscriptionReader)>,\n    token_cache: Arc<crate::refresh::TokenCache>,\n    cache: Arc<ModelCatalogCache>,\n    timeout: Duration,\n) -> tokio::task::JoinHandle<()> {\n    let first = refresh_catalogs_for_accounts(&client, &readers, &token_cache, &cache);\n    let refreshed = tokio::time::timeout(timeout, first).await.is_ok();\n    if !refreshed {\n        tracing::warn!(\n            \"the first model catalog refresh did not finish within {}s; serving now and \\\n             reporting unrefreshed subscriptions as starting\",\n            timeout.as_secs()\n        );\n    }\n    tokio::spawn(async move {\n        if refreshed {\n            tokio::time::sleep(CATALOG_TTL).await;\n        }\n        loop {\n            refresh_catalogs_for_accounts(&client, &readers, &token_cache, &cache).await;\n            tokio::time::sleep(CATALOG_TTL).await;\n        }\n    })\n}\n","sourceEncoding":{"utf16CodeUnits":2293,"utf8Bytes":2293,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2293,0,2293,-1],["trivia","comment",0,75,0,75,0],["trivia","whitespace",75,76,75,76,0],["trivia","comment",76,79,76,79,0],["trivia","whitespace",79,80,79,80,0],["trivia","comment",80,157,80,157,0],["trivia","whitespace",157,158,157,158,0],["trivia","comment",158,235,158,235,0],["trivia","whitespace",235,236,235,236,0],["trivia","comment",236,314,236,314,0],["trivia","whitespace",314,315,314,315,0],["trivia","comment",315,392,315,392,0],["trivia","whitespace",392,393,392,393,0],["trivia","comment",393,470,393,470,0],["trivia","whitespace",470,471,470,471,0],["trivia","comment",471,548,471,548,0],["trivia","whitespace",548,549,548,549,0],["trivia","comment",549,584,549,584,0],["trivia","whitespace",584,586,584,586,0],["token","identifier",586,589,586,589,0],["trivia