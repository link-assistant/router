per) fn push(\n        &mut self,\n        lane: Option<String>,\n        tracker: crate::usage::UsageTracker,\n        target: &UpstreamTarget,\n        event: &Value,\n    ) {\n        let observer = target.pool.as_ref().map(|(router, account)| {\n            crate::pool_stream_limits::StreamLimits::new(\n                router.clone(),\n                account.clone(),\n                event\n                    .get(\"model\")\n                    .and_then(Value::as_str)\n                    .map(str::to_string),\n            )\n        });\n        self.by_lane\n            .entry(lane)\n            .or_default()\n            .push_back((tracker, observer));\n    }\n\n    pub(super) fn feed_terminal(&mut self, value: &Value, bytes: &[u8]) {\n        let event_type = value\n            .get(\"type\")\n            .and_then(Value::as_str)\n            .unwrap_or_default();\n        if !matches!(\n            event_type,\n            \"response.completed\" | \"response.incomplete\" | \"response.failed\" | \"error\"\n        ) {\n            return;\n        }\n        let lane = value\n            .get(\"stream_id\")\n            .and_then(Value::as_str)\n            .map(str::to_string);\n        let remove_lane = self.by_lane.get_mut(&lane).is_some_and(|queue| {\n            if let Some((mut tracker, observer)) = queue.pop_front() {\n                tracker.feed(bytes);\n                if let Some(observer) = observer {\n                    observer.observe_event(value);\n                }\n            }\n            queue.is_empty()\n        });\n        if remove_lane {\n            self.by_lane.remove(&lane);\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":375,"end":2109},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2109,"end":2110,"unit":"utf16","byteStart":2109,"byteEnd":2110},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Per-lane usage and cooldown observation for accepted WebSocket turns.\nuse super::{UpstreamTarget, Value};\nuse std::collections::{HashMap, VecDeque};\n\npub(super) struct TurnTracking {\n    by_lane: HashMap<\n        Option<String>,\n        VecDeque<(\n            crate::usage::UsageTracker,\n            Option<crate::pool_stream_limits::StreamLimits>,\n        )>,\n    >,\n}\n\nimpl TurnTracking {\n    pub(super) fn new() -> Self {\n        Self {\n            by_lane: HashMap::new(),\n        }\n    }\n\n    pub(super) fn push(\n        &mut self,\n        lane: Option<String>,\n        tracker: crate::usage::UsageTracker,\n        target: &UpstreamTarget,\n        event: &Value,\n    ) {\n        let observer = target.pool.as_ref().map(|(router, account)| {\n            crate::pool_stream_limits::StreamLimits::new(\n                router.clone(),\n                account.clone(),\n                event\n                    .get(\"model\")\n                    .and_then(Value::as_str)\n                    .map(str::to_string),\n            )\n        });\n        self.by_lane\n            .entry(lane)\n            .or_default()\n            .push_back((tracker, observer));\n    }\n\n    pub(super) fn feed_terminal(&mut self, value: &Value, bytes: &[u8]) {\n        let event_type = value\n            .get(\"type\")\n            .and_then(Value::as_str)\n            .unwrap_or_default();\n        if !matches!(\n            event_type,\n            \"response.completed\" | \"response.incomplete\" | \"response.failed\" | \"error\"\n        ) {\n            return;\n        }\n        let lane = value\n            .get(\"stream_id\")\n            .and_then(Value::as_s