teEnd":228},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"project","span":{"start":228,"end":1950,"unit":"utf16","byteStart":228,"byteEnd":1950},"sha256":"3f9e2ddee4b7acd140bb5acce6647ee6a2cd754fc460e1ce2abbec3926833036","source":"pub fn project(\n    state: &AppState,\n    provider: SubscriptionProvider,\n    records: Vec<CatalogRecord>,\n) -> Vec<CatalogRecord> {\n    let Some(router) = state\n        .account_router\n        .as_ref()\n        .filter(|r| r.provider() == provider)\n    else {\n        return records;\n    };\n    records\n        .into_iter()\n        .flat_map(|record| {\n            let Ok(policy) = router.routing_policy(&record.account) else {\n                return Vec::new();\n            };\n            policy\n                .visible_models(&record.canonical_id, router.force_model_prefix())\n                .into_iter()\n                .filter(|id| {\n                    // Publish a spelling only when this account resolves it\n                    // to the same native record; aliases can shadow records.\n                    router.upstream_model(&record.account, id).as_deref()\n                        == Some(record.canonical_id.as_str())\n                })\n                .map(|id| {\n                    let mut projected = record.clone();\n                    if id != record.canonical_id {\n                        projected.raw.insert(\n                            \"_router_policy_upstream\".into(),\n                            crate::translation_core::Json::String(record.canonical_id.clone()),\n                        );\n                        projected.raw.insert(\n                            \"selector_kind\".into(),\n                            crate::translation_core::Json::String(\"operator_alias\".into()),\n                        );\n                    }\n                    projected.canonical_id = id;\n                    projected\n                })\n                .collect::<Vec<_>>()\n        })\n        .collect()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":228,"end":1950,"unit":"utf16","byteStart":228,"byteEnd":1950}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1950,"end":2038,"unit":"utf16","byteStart":1950,"byteEnd":2038},"sha256":"92ad0163ffb2c8bb308306d8a9146190f15c0308732bc94dddb1519ad673ac77","source":"\n\n/// Durable grants always refer to the vendor identity, including projected catalogs.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"native_id","span":{"start":2038,"end":2277,"unit":"utf16","byteStart":2038,"byteEnd":2277},"sha256":"9504849facb28fb74e5966e62fda83e04ecd951fb92a9b3da2ca1625358b9109","source":"pub fn native_id(record: &CatalogRecord) -> &crate::translation_core::Str {\n    record\n        .raw\n        .get(\"_router_policy_upstream\")\n        .and_then(crate::translation_core::Json::as_str)\n        .unwrap_or(&record.canonical_id)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2038,"end":2277,"unit":"utf16","byteStart":2038,"byteEnd":2277}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2277,"end":2279,"unit":"utf16","byteStart":2277,"byteEnd":2279},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"permitted","span":{"start":2279,"end":2642,"unit":"utf16","byteStart":2279,"byteEnd":2642},"sha256":"e293adbb2908f0b0dcdc34e1f043739ab5218b3a7e308001390e12e06d51fe2b","source":"pub fn permitted(\n    policy: &crate::model_contract::ModelAccessPolicy,\n    provider: SubscriptionProvider,\n    native: &crate::translation_core::Str,\n) -> bool {\n    policy.permits(native)\n        || (provider == SubscriptionProvider::Gemini\n            && native\n                .strip_prefix(\"models/\")\n                .is_some_and(|id| policy.permits(id)))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2279,"end":2642,"unit":"utf16","byteStart":2279,"byteEnd":2642}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2642,"end":2643,"unit":"utf16","byteStart":2642,"byteEnd":2643},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Project only live, account-owned model records into operator-visible spellings.\nuse crate::app_state::AppState;\nuse crate::model_catalog::CatalogRecord;\nuse crate::subscription::SubscriptionProvider;\nuse serde_json::Value;\n\npub fn project(\n    state: &AppState,\n    provider: SubscriptionProvider,\n    records: Vec<CatalogRecord>,\n) -> Vec<CatalogRecord> {\n    let Some(router) = state\n        .account_router\n        .as_ref()\n        .filter(|r| r.provider() == provider)\n    else {\n        return records;\n    };\n    records\n        .into_iter()\n        .flat_map(|record| {\n            let Ok(policy) = router.routing_policy(&record.account) else {\n                return Vec::new();\n            };\n            policy\n                .visible_models(&record.canonical_id, router.force_model_prefix())\n                .into_iter()\n                .filter(|id| {\n                    // Publish a spelling only when this account resolves it\n                    // to the same native record; aliases can shadow records.\n                    router.upstream_model(&record.account, id).as_deref()\n                        == Some(record.canonical_id.as_str())\n                })\n                .map(|id| {\n                    let mut projected = record.clone();\n                    if id != record.canonical_id {\n                        projected.raw.insert(\n                            \"_router_policy_upstream\".into(),\n                            crate::translation_core::Json::String(record.canonical_id.clone()),\n                        );\n                        projected.raw.insert(\n                            \"selector_kind\".into(),\n                            crate::translation_core::Json::String(\"operator_alias\".into()),\n                        );\n                    }\n                    projected.canonical_id = id;\n                    projected\n                })\n                .collect::<Vec<_>>()\n        })\n        .collect()\n}\n\n/// Durable grants always refer to the vendor identity, including projected catalogs.\npub fn native_id(record: &CatalogRecord) -> &crate::translation_core::Str {\n    record\n        .raw\n        .get(\"_router_policy_upstream\")\n        .and_then(crate::translation_core::Json::as_str)\n        .unwrap_or(&record.canonical_id)\n}\n\npub fn permitted(\n    policy: &crate::model_contract::ModelAccessPolicy,\n    provider: SubscriptionProvider,\n    native: &crate::translation_core::Str,\n) -> bool {\n    policy.permits(native)\n        || (provider == SubscriptionProvider::Gemini\n            && native\n                .strip_prefix(\"models/\")\n                .is_some_and(|id| policy.permits(id)))\n}\n","sourceEncoding":{"utf16CodeUnits":2643,"utf8Bytes":2643,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2643,0,2643,-1],["trivia","comment",0,83,0,83,0],["trivia","whitespace",83,84,83,84,0],["token","iden