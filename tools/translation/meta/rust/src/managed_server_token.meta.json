3da3a3","source":"pub fn token_client_binding(token: &str) -> Result<(Option<String>, Option<String>), AnyError> {\n    let claims = token_claim(token)?;\n    Ok((\n        claims\n            .get(\"client_kind\")\n            .and_then(Value::as_str)\n            .map(str::to_string),\n        claims\n            .get(\"principal_id\")\n            .and_then(Value::as_str)\n            .map(str::to_string),\n    ))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":757,"end":1146,"unit":"utf16","byteStart":757,"byteEnd":1146}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1146,"end":1148,"unit":"utf16","byteStart":1146,"byteEnd":1148},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"exact_token_binding","span":{"start":1148,"end":1687,"unit":"utf16","byteStart":1148,"byteEnd":1687},"sha256":"bae1f77ae2b7adab811f6f59675bd233a853211496862981f5035ed65b1f2dcd","source":"pub(super) fn exact_token_binding(token: &str, client: ClientKind) -> Result<String, AnyError> {\n    let (bound, principal) = token_client_binding(token)?;\n    if bound.as_deref() != Some(client.canonical_name()) {\n        return Err(format!(\n            \"the supplied token must carry the exact `{}` client binding\",\n            client.canonical_name()\n        )\n        .into());\n    }\n    principal\n        .filter(|value| !value.trim().is_empty())\n        .ok_or_else(|| \"the supplied token must carry a subscriber principal\".into())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1148,"end":1687,"unit":"utf16","byteStart":1148,"byteEnd":1687}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1687,"end":1689,"unit":"utf16","byteStart":1687,"byteEnd":1689},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"token_claim","span":{"start":1689,"end":2109,"unit":"utf16","byteStart":1689,"byteEnd":2109},"sha256":"5c0b99175bc083c81a749493dc017061bc4a1899ff4292e1fc6dffc9c59e01cd","source":"fn token_claim(token: &str) -> Result<Value, AnyError> {\n    let payload = token\n        .split('.')\n        .nth(1)\n        .ok_or(\"router returned a token without a JWT payload\")?;\n    let decoded = base64::engine::general_purpose::URL_SAFE_NO_PAD\n        .decode(payload)\n        .map_err(|error| format!(\"router returned an invalid JWT payload: {error}\"))?;\n    serde_json::from_slice(&decoded).map_err(Into::into)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1689,"end":2109,"unit":"utf16","byteStart":1689,"byteEnd":2109}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2109,"end":2110,"unit":"utf16","byteStart":2109,"byteEnd":2110},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use super::*;\n\nimpl RunCredential {\n    /// The durable record id retained so a persistent credential remains\n    /// revocable later (issue #190).\n    #[must_use]\n    pub fn id(&self) -> Option<String> {\n        token_subject(&self.token).ok()\n    }\n\n    /// Whether this command minted the credential. Supplied tokens may be\n    /// shared with other machines and must not be revoked implicitly (#296).\n    #[must_use]\n    pub const fn was_minted(&self) -> bool {\n        self.revocation.is_some()\n    }\n}\n\npub fn token_subject(token: &str) -> Result<String, AnyError> {\n    token_claim(token)?\n        .get(\"sub\")\n        .and_then(Value::as_str)\n        .map(str::to_string)\n        .ok_or_else(|| \"router run token has no subject to revoke\".into())\n}\n\npub fn token_client_binding(token: &str) -> Result<(Option<String>, Option<String>), AnyError> {\n    let claims = token_claim(token)?;\n    Ok((\n        claims\n            .get(\"client_kind\")\n            .and_then(Value::as_str)\n            .map(str::to_string),\n        claims\n            .get(\"principal_id\")\n            .and_then(Value::as_str)\n            .map(str::to_string),\n    ))\n}\n\npub(super) fn exact_token_binding(token: &str, client: ClientKind) -> Result<String, AnyError> {\n    let (bound, principal) = token_client_binding(token)?;\n    if bound.as_deref() != Some(client.canonical_name()) {\n        return Err(format!(\n            \"the supplied token must carry the exact `{}` client binding\",\n            client.canonical_name()\n        )\n        .into());\n    }\n    principal\n        .filter(|value| !value.trim().is_empty())\n        .ok_or_else(|| \"the supplied token must carry a subscriber principal\".into())\n}\n\nfn token_claim(token: &str) -> Result<Value, AnyError> {\n    let payload = token\n        .split('.')\n        .nth(1)\n        .ok_or(\"router returned a token without a JWT payload\")?;\n    let decoded = base64::engine::general_purpose::URL_SAFE_NO_PAD\n        .decode(payload)\n        .map_err(|error| format!(\"router returned an invalid JWT payload: {error}\"))?;\n    serde_json::from_slice(&decoded).map_err(Into::into)\n}\n","sourceEncoding":{"utf16CodeUnits":2110,"utf8Bytes":2110,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2110,0,2110,-1],["token","identifi