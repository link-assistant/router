same_origin","span":{"start":118,"end":312,"unit":"utf16","byteStart":118,"byteEnd":312},"sha256":"5cc049af4a5f8b3a3ab7b83ad9bfd18d949091e4563e7f1fb7033df79617f61b","source":"pub(super) fn same_origin(one: &str, other: &str) -> bool {\n    match (normalize_server(one), normalize_server(other)) {\n        (Ok(one), Ok(other)) => one == other,\n        _ => false,\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":118,"end":312,"unit":"utf16","byteStart":118,"byteEnd":312}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":312,"end":314,"unit":"utf16","byteStart":312,"byteEnd":314},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"normalize_server","span":{"start":314,"end":1394,"unit":"utf16","byteStart":314,"byteEnd":1394},"sha256":"95d56a732ffe000011ed01b311dcd375237ef3cfd6cd856054bd9dfeb9b4920a","source":"pub(super) fn normalize_server(server: &str) -> Result<String, AnyError> {\n    let parsed = url::Url::parse(server.trim()).map_err(|_| {\n        \"server URL must be an absolute http:// or https:// origin without credentials, path, query, or fragment\"\n    })?;\n    if !matches!(parsed.scheme(), \"http\" | \"https\")\n        || parsed.cannot_be_a_base()\n        || parsed.host_str().is_none()\n        || !parsed.username().is_empty()\n        || parsed.password().is_some()\n        || parsed.path() != \"/\"\n        || parsed.query().is_some()\n        || parsed.fragment().is_some()\n    {\n        return Err(\n            \"server URL must be an absolute http:// or https:// origin without credentials, path, query, or fragment\"\n                .into(),\n        );\n    }\n    let host = match parsed.host().expect(\"checked above\") {\n        url::Host::Ipv6(address) => format!(\"[{address}]\"),\n        host => host.to_string(),\n    };\n    Ok(parsed.port().map_or_else(\n        || format!(\"{}://{host}\", parsed.scheme()),\n        |port| format!(\"{}://{host}:{port}\", parsed.scheme()),\n    ))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":314,"end":1394,"unit":"utf16","byteStart":314,"byteEnd":1394}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1394,"end":1508,"unit":"utf16","byteStart":1394,"byteEnd":1508},"sha256":"fb081ef88e556b7866916ce309ddca1c710705bf9fec6cf21e21656ada1ac4c4","source":"\n\n/// Validate and canonicalize a public server origin without ever embedding\n/// the rejected input in an error.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"canonical_server_origin","span":{"start":1508,"end":1613,"unit":"utf16","byteStart":1508,"byteEnd":1613},"sha256":"a594889294384096e01dbfecb214a08769df203f7a503ca708a91e9beb85d294","source":"pub fn canonical_server_origin(server: &str) -> Result<String, AnyError> {\n    normalize_server(server)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1508,"end":1613,"unit":"utf16","byteStart":1508,"byteEnd":1613}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1613,"end":1614,"unit":"utf16","byteStart":1613,"byteEnd":1614},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Canonical, credential-free Router origins.\n\nuse super::AnyError;\n\n/// Whether two spellings name the same Router.\npub(super) fn same_origin(one: &str, other: &str) -> bool {\n    match (normalize_server(one), normalize_server(other)) {\n        (Ok(one), Ok(other)) => one == other,\n        _ => false,\n    }\n}\n\npub(super) fn normalize_server(server: &str) -> Result<String, AnyError> {\n    let parsed = url::Url::parse(server.trim()).map_err(|_| {\n        \"server URL must be an absolute http:// or https:// origin without credentials, path, query, or fragment\"\n    })?;\n    if !matches!(parsed.scheme(), \"http\" | \"https\")\n        || parsed.cannot_be_a_base()\n        || parsed.host_str().is_none()\n        || !parsed.username().is_empty()\n        || parsed.password().is_some()\n        || parsed.path() != \"/\"\n        || parsed.query().is_some()\n        || parsed.fragment().is_some()\n    {\n        return Err(\n            \"server URL must be an absolute http:// or https:// origin without credentials, path, query, or fragment\"\n                .into(),\n        );\n    }\n    let host = match parsed.host().expect(\"checked above\") {\n        url::Host::Ipv6(address) => format!(\"[{address}]\"),\n        host => host.to_string(),\n    };\n    Ok(parsed.port().map_or_else(\n        || format!(\"{}://{host}\", parsed.scheme()),\n        |port| format!(\"{}://{host}:{port}\", parsed.scheme()),\n    ))\n}\n\n/// Validate and canonicalize a public server origin without ever embedding\n/// the rejected input in an error.\npub fn canonical_server_origin(server: &str) -> Result<String, AnyError> {\n    normalize_server(server)\n}\n","sourceEncoding":{"utf16CodeUnits":1614,"utf8Bytes":1614,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1614,0,1614,-1],["trivia","comment",0,46,0,46,0],["trivia","whitespace",46,48,46,48,0],["token","identifier",48,51,48,51,0],["trivia","whitespace",51,52,51,52,0],["token","identifier",52,57,52,57,0],["token","punct",57,59,57,59,0],["token",