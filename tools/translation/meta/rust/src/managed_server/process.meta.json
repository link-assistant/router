cess::Stdio;\n\npub(super) fn process_alive(pid: u32) -> bool {\n    if pid == std::process::id() {\n        return true;\n    }\n    #[cfg(unix)]\n    {\n        crate::operation_context::process_output(\n            crate::operation_context::command(\"kill\")\n                .args([\"-0\", &pid.to_string()])\n                .stdout(Stdio::null())\n                .stderr(Stdio::null()),\n        )\n        .is_ok_and(|output| output.status.success())\n    }\n    #[cfg(windows)]\n    {\n        crate::operation_context::process_output(\n            &mut crate::operation_context::command(\"tasklist\").args([\n                \"/FI\",\n                &format!(\"PID eq {pid}\"),\n                \"/NH\",\n            ]),\n        )\n        .is_ok_and(|output| {\n            output.status.success()\n                && String::from_utf8_lossy(&output.stdout).contains(&pid.to_string())\n        })\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":971,"utf8Bytes":971,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,971,0,971,-1],["trivia","comment",0,66,0,66,0],["trivia","whitespace",66,68,66,68,0],["token","punct",68,69,68,69,0],["group","bracket",69,80,69,80,0],["token","delimiter",69,70,69,70,4],["token","identifier",70,73,70,73,4],["group","paren",73,79,73,79,4],["token","delimiter",73,74,73,74,7],["token","identifier",74,78,74,78,7],["token","delimiter",78,79,78,79,7],["token","delimiter",79,80,79,80,4],["trivia","whitespace",80,81,80,81,0],["token","identifier",81,84,81,84,0],["trivia","whitespace",84,85,84,85,0],["token","identifier",85,88,85,88,0],["token","punct",88,90,88,90,0],["token","identifier",90,97,90,97,0],["token","punct",97,99,97,99,0],["token","identifier",99,104,99,104,0],["token","punct",104,105,104,105,0],["trivia","whitespace",105,107,105,107,0],["token","identifier",107,110,107,110,0],["group","paren",110,117,110,117,0],["token","delimiter",110,111,110,11