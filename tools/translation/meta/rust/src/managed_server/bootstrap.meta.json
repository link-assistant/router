me":"read_token","span":{"start":116,"end":1163,"unit":"utf16","byteStart":116,"byteEnd":1163},"sha256":"1140fb44fc82b763ece8441a55076deecf45209e5092ae2359e79626ff50d797","source":"pub(super) fn read_token(container: &str) -> Result<String, AnyError> {\n    const MARKER: &str = \"Admin token (shown once, store it now):\";\n    let output = crate::operation_context::process_output(\n        crate::operation_context::command(\"docker\").args([\"logs\", container]),\n    )?;\n    check_docker_output(&output)?;\n    let stdout = String::from_utf8_lossy(&output.stdout);\n    let stderr = String::from_utf8_lossy(&output.stderr);\n    stdout\n        .lines()\n        .chain(stderr.lines())\n        .find_map(|line| {\n            line.find(MARKER)\n                .map(|position| line[position + MARKER.len()..].trim())\n                .filter(|token| {\n                    token.starts_with(\"la_sk_\") && !token.contains(char::is_whitespace)\n                })\n                .map(str::to_string)\n        })\n        .ok_or_else(|| {\n            format!(\n                \"managed router did not expose its bootstrap administrator in `docker logs {container}`; inspect the container startup logs\"\n            )\n            .into()\n        })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":116,"end":1163,"unit":"utf16","byteStart":116,"byteEnd":1163}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1163,"end":1164,"unit":"utf16","byteStart":1163,"byteEnd":1164},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Recovery of the router-generated managed bootstrap administrator.\n\nuse super::{AnyError, check_docker_output};\n\npub(super) fn read_token(container: &str) -> Result<String, AnyError> {\n    const MARKER: &str = \"Admin token (shown once, store it now):\";\n    let output = crate::operation_context::process_output(\n        crate::operation_context::command(\"docker\").args([\"logs\", container]),\n    )?;\n    check_docker_output(&output)?;\n    let stdout = String::from_utf8_lossy(&output.stdout);\n    let stderr = String::from_utf8_lossy(&output.stderr);\n    stdout\n        .lines()\n        .chain(stderr.lines())\n        .find_map(|line| {\n            line.find(MARKER)\n                .map(|position| line[position + MARKER.len()..].trim())\n                .filter(|token| {\n                    token.starts_with(\"la_sk_\") && !token.contains(char::is_whitespace)\n                })\n                .map(str::to_string)\n        })\n        .ok_or_else(|| {\n            format!(\n                \"managed router did not expose its bootstrap administrator in `docker logs {container}`; inspect the container startup logs\"\n            )\n            .into()\n        })\n}\n","sourceEncoding":{"utf16CodeUnits":1164,"utf8Bytes":1164,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1164,0,1164,-1],["trivia","comment",0,69,0,69,0],["trivia","whitespace",69,71,69,71,0],["token","identifier",71,74,71,74,0],["trivia","whitespace",74,75,74,75,0],["token","identifier",75,80,75,80,0],["token","punct",80,82,80,82,0],["group","brace",82,113,82,113,0],["token","delimiter",82,83,82,83,7],["token","identifier",83,91,83,91,7],["token","punct",91,92,91,92,7],["trivia","whitespace",92,93,92,93,7],["token","identifier",93,112,93,112,7],["token","delimiter",112,113,112,113,7],["token","punct",113,114,113,114,0],["trivia","whitespace",114,116,114,116,0],["token","identifier",116,119,116,119,0],["group","paren",119,126,119,126,0],["token","delimite