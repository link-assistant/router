meral: true,\n        },\n        Some(policy),\n    )\n    .await\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2028,"end":2537,"unit":"utf16","byteStart":2028,"byteEnd":2537}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2537,"end":2539,"unit":"utf16","byteStart":2537,"byteEnd":2539},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"require_minting_authority","span":{"start":2539,"end":2930,"unit":"utf16","byteStart":2539,"byteEnd":2930},"sha256":"c7b006ffe5ace43b77520e56d9464eff3b5bf2c64e487e4162bdbbfb914a450d","source":"pub(super) fn require_minting_authority(\n    policy: &ModelAccessPolicy,\n    surface: &str,\n) -> Result<(), AnyError> {\n    if policy.allowed_models.is_empty() {\n        return Ok(());\n    }\n    Err(format!(\n        \"`--model` requires {surface} so Router can mint a server-enforced exact-model token (requested allow-list: {})\",\n        policy.allowed_models.join(\", \")\n    )\n    .into())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2539,"end":2930,"unit":"utf16","byteStart":2539,"byteEnd":2930}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2930,"end":2931,"unit":"utf16","byteStart":2930,"byteEnd":2931},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use crate::clients::ClientKind;\nuse crate::model_contract::ModelAccessPolicy;\n\nuse super::{AnyError, CredentialOptions, ResolvedServer, RunCredential};\n\n/// Validate an ordinary token or exchange an admin credential for a run token.\npub async fn prepare_run_credential(\n    server: &ResolvedServer,\n    client_kind: ClientKind,\n    label: &str,\n    ttl_hours: i64,\n    sliding: bool,\n) -> Result<RunCredential, AnyError> {\n    super::prepare_credential(\n        server,\n        client_kind,\n        label,\n        CredentialOptions {\n            ttl_hours,\n            sliding,\n            allow_supplied: true,\n            ephemeral: true,\n        },\n        None,\n    )\n    .await\n}\n\n/// Mint the client-bound credential used by a permanent repair.\n///\n/// Repair is a trust takeover, not a one-shot launch. It must never persist a\n/// supplied ordinary token merely because the selected listener cannot mint a\n/// replacement: only a candidate minted for this exact client is eligible.\npub async fn prepare_repair_credential(\n    server: &ResolvedServer,\n    client_kind: ClientKind,\n    label: &str,\n    ttl_hours: i64,\n) -> Result<RunCredential, AnyError> {\n    super::prepare_credential(\n        server,\n        client_kind,\n        label,\n        CredentialOptions {\n            ttl_hours,\n            sliding: false,\n            allow_supplied: false,\n            ephemeral: false,\n        },\n        None,\n    )\n    .await\n}\n\n/// Mint or reuse a credential that remains after this command exits.\npub async fn prepare_persistent_credential(\n    server: &ResolvedServer,\n    client_kind: ClientKind,\n    label: &str,\n    ttl_hours: i64,\n) -> Result<RunCredential, AnyError> {\n    super::prepare_credential(\n        server,\n        client_kind,\n        label,\n        CredentialOptions {\n            ttl_hours,\n            sliding: false,\n            allow_supplied: true,\n            ephemeral: false,\n        },\n        None,\n    )\n    .await\n}\n\n/// Mint a per-run credential with exact server-enforced model authority.\npub async fn prepare_run_credential_with_model_policy(\n    server: &ResolvedServer,\n    client_kind: ClientKind,\n    label: &str,\n    ttl_hours: i64,\n    sliding: bool,\n    policy: &ModelAccessPolicy,\n) -> Result<RunCredential, AnyError> {\n    super::prepare_credential(\n        server,\n        client_kind,\n        label,\n        CredentialOptions {\n            ttl_hours,\n            sliding,\n            allow_supplied: true,\n            ephemeral: true,\n        },\n        Some(policy),\n    )\n    .await\n}\n\npub(super) fn require_minting_authority(\n    policy: &ModelAccessPolicy,\n    surface: &str,\n) -> Result<(), AnyError> {\n    if policy.allowed_models.is_empty() {\n        return Ok(());\n    }\n    Err(format!(\n        \"`--model` requires {surface} so Router can mint a server-enforced exact-model token (requested allow-list: {})\",\n        policy.allowed_models.join(\", \")\n    )\n    .into())\n}\n","sourceEncoding":{"utf16CodeUnits":2931,"utf8Bytes":2931,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2931,0,2931,-1],["token","identifier",0,3,0,3,0],["trivia","whitespace",3,4,3,4,0],["token","identifier",4,9,4,9,0],["token","punct",9,11,9,11,0],["token","identifier",11,18,11,18,0],["token","punct",18,20,18,20,0],["token","identifier",20,30,20,30,0],["token","punct",30,31,30,31,0],["trivia","whitespace",31,32,31,32,0],["token","identifier",32,35,32,35,0],["trivia","whitespace",35,36,35,36,0],["token","identifier",36,41,36,41,0],["token","punct",41,43,41,43,0],["token","identifier",43,57,43,57,0],["token","punct",57,59,57,59,0],["token","identifier",59,76,59,76,0],["token","punct",76,77,76,77,0],["trivia","whitespace",77,79,77,79,0],["token","identifier",79,82,79,82,0],["trivia","whitespace",82,83,82,83,0],["token","identifier",83,88,83,88,0],["token","punct",88,90,88,90,0],["group","brace",90,150,90,150,0],["token","delimiter",90,9