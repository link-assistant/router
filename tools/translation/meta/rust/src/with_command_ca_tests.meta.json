me 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":3,"preserved":4},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":60,"unit":"utf16","byteStart":0,"byteEnd":60},"sha256":"25ec0fda4d8e66891e0d30bafb79f8103bf07fd6bf6a5f7b82ac2de96d20ade6","source":"//! Trust propagation tests for temporary client launches.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":60,"end":73,"unit":"utf16","byteStart":60,"byteEnd":73},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":60,"end":73},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":73,"end":228,"unit":"utf16","byteStart":73,"byteEnd":228},"sha256":"8d6e92478ecadd890785d9ea42104a8f6aa2c06646ba522a4218bb10f4cff1e6","source":"\n\n/// The CA associated with the inference origin reaches Node-based clients as\n/// additional trust without disabling certificate or hostname validation.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"claude_receives_the_selected_router_ca_as_additional_trust","span":{"start":228,"end":1579,"unit":"utf16","byteStart":228,"byteEnd":1579},"sha256":"0b861b63db77e4b0d51e6b1a6f807be51e04f066a1505729cfc727703f607c5e","source":"#[test]\nfn claude_receives_the_selected_router_ca_as_additional_trust() {\n    let directory = tempfile::tempdir().expect(\"profile root\");\n    let certificate = directory.path().join(\"router-ca.pem\");\n    std::fs::write(&certificate, \"test certificate\").expect(\"certificate fixture\");\n    let prepared = TemporaryClient::prepare(&Preparation {\n        client: ClientKind::ClaudeCode,\n        base_url: \"https://router.example\",\n        token: \"la_sk_test\",\n        model_override: None,\n        models: &[],\n        isolated_config: false,\n        extend_user_configuration: true,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: Some(directory.path()),\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: Some(&certificate),\n        user_claude_settings: None,\n    })\n    .expect(\"prepare Claude\");\n    let environment = prepared\n        .command\n        .get_envs()\n        .collect::<std::collections::HashMap<_, _>>();\n    assert_eq!(\n        environment\n            .get(std::ffi::OsStr::new(\"NODE_EXTRA_CA_CERTS\"))\n            .and_then(|value| *value),\n        Some(certificate.as_os_str())\n    );\n    assert!(\n        environment\n            .keys()\n            .all(|name| *name != \"NODE_TLS_REJECT_UNAUTHORIZED\"),\n        \"trust must not disable verification\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":228,"end":234},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1579,"end":1816,"unit":"utf16","byteStart":1579,"byteEnd":1816},"sha256":"2913c630dbf5643ae96e389843e9e7266b7fc6a361bf811628f22cd2907f0ef9","source":"\n\n/// Preparing an extended Claude launch reads only the settings file its caller\n/// resolved, never the host's own profile. A developer whose Claude had saved\n/// `opus` made the test above fail against its empty catalog (issue #613).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_extended_claude_launch_reads_only_the_saved_model_it_is_given","span":{"start":1816,"end":3193,"unit":"utf16","byteStart":1816,"byteEnd":3193},"sha256":"649b9de164286ec0f26f28558462caed4ccb16c502dce4838827234a3e06ee49","source":"#[test]\nfn an_extended_claude_launch_reads_only_the_saved_model_it_is_given() {\n    let directory = tempfile::tempdir().expect(\"profile root\");\n    let external = directory.path().join(\"external-claude/settings.json\");\n    std::fs::create_dir_all(external.parent().expect(\"parent\")).expect(\"external profile\");\n    std::fs::write(&external, r#\"{\"model\":\"opus\"}\"#).expect(\"saved model\");\n    let preparation = |user_claude_settings| Preparation {\n        client: ClientKind::ClaudeCode,\n        base_url: \"https://router.example\",\n        token: \"la_sk_test\",\n        model_override: None,\n        models: &[],\n        isolated_config: false,\n        extend_user_configuration: true,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: Some(directory.path()),\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: None,\n        user_claude_settings,\n    };\n    let Err(error) = TemporaryClient::prepare(&preparation(Some(&external))) else {\n        panic!(\"a saved `opus` cannot run on an empty catalog\");\n    };\n    assert!(error.to_string().contains(\"`opus`\"), \"{error}\");\n    // Without a resolved profile there is no saved model to honour, whatever\n    // the process environment's HOME or CLAUDE_CONFIG_DIR hold.\n    TemporaryClient::prepare(&preparation(None)).expect(\"no external profile consulted\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1816,"end":1822},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":3193,"end":3194,"unit":"utf16","byteStart":3193,"byteEnd":3194},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Trust propagation tests for temporary client launches.\n\nuse super::*;\n\n/// The CA associated with the inference origin reaches Node-based clients as\n/// additional trust without disabling certificate or hostname validation.\n#[test]\nfn claude_receives_the_selected_router_ca_as_additional_trust() {\n    let directory = tempfile::tempdir().expect(\"profile root\");\n    let certificate = directory.path().join(\"router-ca.pem\");\n    std::fs::write(&certificate, \"test certificate\").expect(\"certificate fixture\");\n    let prepared = TemporaryClient::prepare(&Preparation {\n        client: ClientKind::ClaudeCode,\n        base_url: \"https://router.example\",\n        token: \"la_sk_test\",\n        model_override: None,\n        models: &[],\n        isolated_config: false,\n        extend_user_configuration: true,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: Some(directory.path()),\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: Some(&certificate),\n        user_claude_settings: None,\n    })\n    .expect(\"prepare Claude\");\n    let environment = prepared\n        .command\n        .get_envs()\n        .collect::<std::collections::HashMap<_, _>>();\n    assert_eq!(\n        environment\n            .get(std::ffi::OsStr::new(\"NODE_EXTRA_CA_CERTS\"))\n            .and_then(|value| *value),\n        Some(certificate.as_os_str())\n    );\n    assert!(\n        environment\n            .keys()\n            .all(|name| *name != \"NODE_TLS_REJECT_UNAUTHORIZED\"),\n        \"trust must not disable verification\"\n    );\n}\n\n/// Preparing an extended Claude launch reads only the settings file its caller\n/// resolved, never the host's own profile. A developer whose Claude had saved\n/// `opus` made the test above fail against its empty catalog (issue #613).\n#[test]\nfn an_extended_claude_launch_reads_only_the_saved_model_it_is_given() {\n    let directory = tempfile::tempdir().expect(\"profile root\");\n    let external = directory.path().join(\"external-claude/settings.json\");\n    std::fs::create_dir_all(external.parent().expect(\"parent\")).expect(\"external profile\");\n    std::fs::write(&external, r#\"{\"model\":\"opus\"}\"#).expect(\"saved model\");\n    let preparation = |user_claude_settings| Preparation {\n        client: ClientKind::ClaudeCode,\n        base_url: \"https://router.example\",\n        token: \"la_sk_test\",\n        model_override: None,\n        models: &[],\n        isolated_config: false,\n        extend_user_configuration: true,\n        one_shot: true,\n        user_model_selection: None,\n        profile_root: Some(directory.path()),\n        codex_reasoning_effort: None,\n        codex_backend_base_url: None,\n        ca_cert: None,\n        user_claude_settings,\n    };\n    let Err(error) = TemporaryClient::prepare(&preparation(Some(&external))) else {\n        panic!(\"a saved `opus` cannot run on an empty catalog\");\n    };\n    assert!(error.to_string().contains(\"`opus`\"), \"{error}\");\n    // Without a resolved profile there is no saved model to honour, whatever\n    // the process environment's HOME or CLAUDE_CONFIG_DIR hold.\n    TemporaryClient::prepare(&preparation(None)).expect(\"no external profile consulted\");\n}\n","sourceEncoding":{"utf16CodeUnits":3194,"utf8Bytes":3194,"wellFormedUnicode":tru