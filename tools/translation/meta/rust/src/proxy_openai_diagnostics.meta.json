ssume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":387,"unit":"utf16","byteStart":0,"byteEnd":387},"sha256":"bfc9dda2361c63abcaa4e067e0f1a495af9a44bc8baf429b6897aedf29ca8091","source":"/// Provider-independent fields owned by the Chat Completions surface.\n///\n/// Passthrough providers may accept extensions and some provide a default\n/// model, so validating the entire normalized request here would narrow their\n/// public contract. `messages`, however, belongs to Chat Completions itself and\n/// must exist before routing or translating to any upstream dialect (#387).\n","status":"preserved","diagnostic":null,"comment":true},{"term":"struct","name":"RequiredChatFields","span":{"start":387,"end":510,"unit":"utf16","byteStart":387,"byteEnd":510},"sha256":"5fee2ef903a90abbb83cb841c09f896bcf53b5e0edb9ef80b6507d52058b43e1","source":"#[derive(serde::Deserialize)]\nstruct RequiredChatFields {\n    #[allow(dead_code)]\n    messages: Vec<openai::ChatMessage>,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(serde): derive requires a separately checked capability","span":{"start":396,"end":401},"details":{"construct":"derive(serde)"}},"comment":false},{"term":"trivia","name":null,"span":{"start":510,"end":589,"unit":"utf16","byteStart":510,"byteEnd":589},"sha256":"6c476bc177aac4894c58f55ecd9b325fc54b698bf7533285152ba54265f32554","source":"\n\n/// Record dropped tools locally without extending a public vendor protocol.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"report_dropped_tools","span":{"start":589,"end":1177,"unit":"utf16","byteStart":589,"byteEnd":1177},"sha256":"15f67aed963ab07eafaf4b4f7a7489ba996b7e509fb87f4ebc9d3672038dfd97","source":"fn report_dropped_tools(\n    state: &AppState,\n    headers: &HeaderMap,\n    response: Response,\n    dropped: &[String],\n) -> Response {\n    if dropped.is_empty() {\n        return response;\n    }\n    let summary = dropped.join(\", \");\n    state.logger.debug(|| {\n        format!(\n            \"dropped {} tool(s) Anthropic cannot represent: {summary}\",\n            dropped.len()\n        )\n    });\n    state.request_log.record(\n        &crate::request_log::correlation_id(headers),\n        \"translation_diagnostic\",\n        serde_json::json!({\"dropped_tools\": dropped}),\n    );\n    response\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"macro format!: requires actual source macro expansion and binding resolution","span":{"start":858,"end":865},"details":{"construct":"macro format!"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1177,"end":1178,"unit":"utf16","byteStart":1177,"byteEnd":1178},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"/// Provider-independent fields owned by the Chat Completions surface.\n///\n/// Passthrough providers may accept extensions and some provide a default\n/// model, so validating the entire normalized request here would narrow their\n/// public contract. `messages`, however, belongs to Chat Completions itself and\n/// must exist before routing or translating to any upstream dialect (#387).\n#[derive(serde::Deserialize)]\nstruct RequiredChatFields {\n    #[allow(dead_code)]\n    messages: Vec<openai::ChatMessage>,\n}\n\n/// Record dropped tools locally without extending a public vendor protocol.\nfn report_dropped_tools(\n    state: &AppState,\n    headers: &HeaderMap,\n    response: Response,\n    dropped: &[String],\n) -> Response {\n    if dropped.is_empty() {\n        return response;\n    }\n    let summary = dropped.join(\", \");\n    state.logger.debug(|| {\n        format!(\n            \"dropped {} tool(s) Anthropic cannot represent: {summary}\",\n            dropped.len()\n        )\n    });\n    state.request_log.record(\n        &crate::request_log::correlation_id(headers),\n        \"translation_diagnostic\",\n        serde_json::json!({\"dropped_tools\": dropped}),\n    );\n    response\n}\n","sourceEncoding":{"utf16CodeUnits":1178,"utf8Bytes":1178,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1178,0,1178,-1],["trivia","comment",0,70,0,70,0],["trivia","whitespace",70,71,70,71,0],["trivia","comment",71,74,71,74,0],["trivia","whitespace",74,75,74,75,0],["trivia","comment",75,149,75,149,0],["trivia","whitespace",149,150,149,150,0],["trivia","comment",150,228,150,228,0],["trivia","whitespace",228,229,228,229,0],["trivia","comment",229,309,229,309,0],["trivia","whitespace",309,310,309,310,0],["trivia","comment",310,386,310,386,0],["trivia","whitespace",386,387,386,387,0],["token","punct",387,388,387,388,0],["group","bracket",388,416,388,416,0],["token","delimiter",388,389,388,389,14],["token","identifier",389,395,389,395,14],["group","paren",395,415,395,415,14],["token","delimiter",395,396,395,396,17],["token","identifier",396,401,396,401,17],["toke