ith checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":3,"preserved":4},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":407,"unit":"utf16","byteStart":0,"byteEnd":407},"sha256":"ace7376571d41045fd81d527162997934bf726df42f8f3968edf89f7bd1f423f","source":"//! Byte-safe incremental Server-Sent Events framing.\n\n/// Append one arbitrary transport chunk and return every complete SSE block.\n///\n/// Transport chunks may split a multi-byte UTF-8 scalar. Keeping the pending\n/// tail as bytes ensures conversion happens only after a complete SSE block is\n/// available, so a valid event cannot acquire replacement characters merely\n/// because of a network boundary.\n","status":"preserved","diagnostic":null,"comment":true},{"term":"fn","name":"push_blocks","span":{"start":407,"end":806,"unit":"utf16","byteStart":407,"byteEnd":806},"sha256":"94156eb94eec94e1c3f2195cfd0a426ec26473c79f005e966b76974f43563242","source":"pub fn push_blocks(buffer: &mut Vec<u8>, chunk: &[u8]) -> Vec<String> {\n    buffer.extend_from_slice(chunk);\n    let mut blocks = Vec::new();\n    while let Some((index, separator_len)) = find_separator(buffer) {\n        let block = buffer.drain(..index).collect::<Vec<_>>();\n        buffer.drain(..separator_len);\n        blocks.push(String::from_utf8_lossy(&block).into_owned());\n    }\n    blocks\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":407,"end":806,"unit":"utf16","byteStart":407,"byteEnd":806}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":806,"end":808,"unit":"utf16","byteStart":806,"byteEnd":808},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"find_separator","span":{"start":808,"end":1318,"unit":"utf16","byteStart":808,"byteEnd":1318},"sha256":"ec33777bbb3adf69e70b704d61d1c071bd14170002093347e2c26259b8a588a1","source":"fn find_separator(buffer: &[u8]) -> crate::translation_core::Maybe<(usize, usize)> {\n    let crlf = buffer.windows(4).position(|window| window == b\"\\r\\n\\r\\n\");\n    let lf = buffer.windows(2).position(|window| window == b\"\\n\\n\");\n    match (crlf, lf) {\n        (Some(left), Some(right)) if left <= right => Some((left, 4)),\n        (Some(_), Some(right)) => Some((right, 2)),\n        (Some(index), None) => Some((index, 4)),\n        (None, Some(index)) => Some((index, 2)),\n        (None, None) => None,\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":808,"end":1318,"unit":"utf16","byteStart":808,"byteEnd":1318}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1318,"end":1320,"unit":"utf16","byteStart":1318,"byteEnd":1320},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":1320,"end":1961,"unit":"utf16","byteStart":1320,"byteEnd":1965},"sha256":"e03a185821be160de4993859ef3b4a99ea2e18fe856febb6ab0561bc59fea270","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_multibyte_scalar_split_across_chunks_is_decoded_once_complete() {\n        let frame = \"data: {\\\"delta\\\":\\\"世\\\"}\\n\\n\".as_bytes();\n        let character = frame.iter().position(|byte| *byte == 0xe4).unwrap();\n        for split in [character + 1, character + 2] {\n            let mut buffer = Vec::new();\n            assert!(push_blocks(&mut buffer, &frame[..split]).is_empty());\n            let blocks = push_blocks(&mut buffer, &frame[split..]);\n            assert_eq!(blocks, [\"data: {\\\"delta\\\":\\\"世\\\"}\"]);\n            assert!(!blocks[0].contains('\\u{fffd}'));\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":1320,"end":1961},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1961,"end":1962,"unit":"utf16","byteStart":1965,"byteEnd":1966},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Byte-safe incremental Server-Sent Events framing.\n\n/// Append one arbitrary transport chunk and return every complete SSE block.\n///\n/// Transport chunks may split a multi-byte UTF-8 scalar. Keeping the pending\n/// tail as bytes ensures conversion happens only after a complete SSE block is\n/// available, so a valid event cannot acquire replacement characters merely\n/// because of a network boundary.\npub fn push_blocks(buffer: &mut Vec<u8>, chunk: &[u8]) -> Vec<String> {\n    buffer.extend_from_slice(chunk);\n    let mut blocks = Vec::new();\n    while let Some((index, separator_len)) = find_separator(buffer) {\n        let block = buffer.drain(..index).collect::<Vec<_>>();\n        buffer.drain(..separator_len);\n        blocks.push(String::from_utf8_lossy(&block).into_owned());\n    }\n    blocks\n}\n\nfn find_separator(buffer: &[u8]) -> crate::translation_core::Maybe<(usize, usize)> {\n    let crlf = buffer.windows(4).position(|window| window == b\"\\r\\n\\r\\n\");\n    let lf = buffer.windows(2).position(|window| window == b\"\\n\\n\");\n    match (crlf, lf) {\n        (Some(left), Some(right)) if left <= right => Some((left, 4)),\n        (Some(_), Some(right)) => Some((right, 2)),\n        (Some(index), None) => Some((index, 4)),\n        (None, Some(index)) => Some((index, 2)),\n        (None, None) => None,\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_multibyte_scalar_split_across_chunks_is_decoded_once_complete() {\n        let frame = \"data: {\\\"delta\\\":\\\"世\\\"}\\n\\n\".as_bytes();\n        let character = frame.iter().position(|byte| *byte == 0xe4).unwrap();\n        for split in [character + 1, character + 2] {\n            let mut buffer = Vec::new();\n            assert!(push_blocks(&mut buffer, &frame[..split]).is_empty());\n            let blocks = push_blocks(&mut buffer, &frame[split..]);\n            assert_eq!(blocks, [\"data: {\\\"delta\\\":\\\"世\\\"}\"]);\n            assert!(!blocks[0].contains('\\u{fffd}'));\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1962,"utf8Bytes":1966,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1962,0,1966,-1],["trivia","comment",0,53,0,53,0],["trivia","whitespace",53,55,53,55,0],["tr