y).map_or_else(\n        |_| String::from_utf8_lossy(body).to_string(),\n        |value| {\n            value\n                .get(\"error\")\n                .and_then(|e| e.get(\"message\"))\n                .and_then(Value::as_str)\n                .map_or_else(|| value.to_string(), String::from)\n        },\n    );\n    let error_type = match status {\n        StatusCode::UNAUTHORIZED | StatusCode::FORBIDDEN => \"authentication_error\",\n        StatusCode::TOO_MANY_REQUESTS => \"rate_limit_error\",\n        StatusCode::BAD_REQUEST => \"invalid_request_error\",\n        _ => \"api_error\",\n    };\n    (\n        status,\n        axum::Json(json!({\n            \"type\": \"error\",\n            \"error\": {\"type\": error_type, \"message\": text},\n        })),\n    )\n        .into_response()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":63,"end":956,"unit":"utf16","byteStart":63,"byteEnd":956}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":956,"end":957,"unit":"utf16","byteStart":956,"byteEnd":957},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use super::{IntoResponse, Response, StatusCode, Value, json};\n\npub(super) fn anthropic_error(status: StatusCode, body: &[u8]) -> Response {\n    let text = serde_json::from_slice::<Value>(body).map_or_else(\n        |_| String::from_utf8_lossy(body).to_string(),\n        |value| {\n            value\n                .get(\"error\")\n                .and_then(|e| e.get(\"message\"))\n                .and_then(Value::as_str)\n                .map_or_else(|| value.to_string(), String::from)\n        },\n    );\n    let error_type = match status {\n        StatusCode::UNAUTHORIZED | StatusCode::FORBIDDEN => \"authentication_error\",\n        StatusCode::TOO_MANY_REQUESTS => \"rate_limit_error\",\n        StatusCode::BAD_REQUEST => \"invalid_request_error\",\n        _ => \"api_error\",\n    };\n    (\n        status,\n        axum::Json(json!({\n            \"type\": \"error\",\n            \"error\": {\"type\": error_type, \"message\": text},\n        })),\n    )\n        .into_response()\n}\n","sourceEncoding":{"utf16CodeUnits":957,"utf8Bytes":957,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,957,0,957,-1],["token","identifier",0,3,0,3,0],["trivia","whitespace",3,4,3,4,0],["token","identifier",4,9,4,9,0],["token","punct",9,11,9,11,0],["group","brace",11,60,11,60,0],["token","delimiter",11,12,11,12,5],["token","identifier",12,24,12,24,5],["token","punct",24,25,24,25,5],["trivia","whitespace",25,26,25,26,5],["token","identifier",26,34,26,34,5],["token","punct",34,35,34,35,5],["trivia","whitespace",35,36,35,36,5],["token","identifier",36,46,36,46,5],["token","punct",46,47,46,47,5],["trivia","whitespace",47,48,47,48,5],["token","identifier",48,53,48,53,5],["token","punct",53,54,53,54,5],["trivia","whitespace",54,55,54,55,5],["token","identifier",55,59,55,59,5],["token","delimiter",59,60,59,60,5],["token","punct",60,61,60,61,0],["trivia","whitespace",61,63,61,63,0],["token","identifier",63,66,63,66,0],["group","paren",66,73,66,73,0],["token","delimiter",66,67,66,67,24],["token","identifier",67,72,67,72,24],["token","delimiter",72,73,72,73,24],["trivia","whitespace",73,74,73,74,0],["token","identifier",74,76,74,76,0],["trivia","whitespace",76,77,76,77,0],["token","identifier",77,92,77,92,0],["group","paren",92,125,92,125,0],["token","delimiter",92,93,92,93,32],["token","identifier",93,99,93,99,32],["token","punct",99,100,99,100,32],["trivia","whitespace",100,101,100,101,32],["token","identif