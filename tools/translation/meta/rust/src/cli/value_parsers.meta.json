ing":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":310,"unit":"utf16","byteStart":0,"byteEnd":310},"sha256":"49646859434cb5f3b558870b0696b328e625677edb1e2f194efcc125a837e7b4","source":"//! Small reusable value parsers for command-line and environment inputs.\n\n/// Parse a boolean switch that may also arrive from the environment.\n///\n/// Clap's plain `bool` accepts only `true`/`false` from an env var, which makes\n/// the `=1` spelling used throughout the deployment docs a hard startup error.\n","status":"preserved","diagnostic":null,"comment":true},{"term":"fn","name":"parse_truthy","span":{"start":310,"end":651,"unit":"utf16","byteStart":310,"byteEnd":651},"sha256":"74f675f0cf537180b078f50ae0ac6dbe90dce260053484d322238feeadc11501","source":"pub(super) fn parse_truthy(value: &str) -> Result<bool, String> {\n    match value.trim().to_ascii_lowercase().as_str() {\n        \"1\" | \"true\" | \"yes\" | \"on\" => Ok(true),\n        \"0\" | \"false\" | \"no\" | \"off\" | \"\" => Ok(false),\n        other => Err(format!(\n            \"expected a boolean (1/0, true/false), got '{other}'\"\n        )),\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":310,"end":651,"unit":"utf16","byteStart":310,"byteEnd":651}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":651,"end":852,"unit":"utf16","byteStart":651,"byteEnd":852},"sha256":"e20cb77348cd817b6bfe20679e626fa59efa4dbcab055b29bf9e2b341953df2f","source":"\n\n/// Parse when an account pause lifts into Unix seconds (issue #677).\n///\n/// Accepts Unix seconds, an RFC 3339 time, or a delay from now written as a\n/// number with an `s`, `m`, `h` or `d` suffix.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_until","span":{"start":852,"end":1787,"unit":"utf16","byteStart":852,"byteEnd":1787},"sha256":"722781b1a6f93f61c0aae863a3b99ccd304d9b8d20d5e1802702c287fd4a72e4","source":"pub(super) fn parse_until(value: &str) -> Result<u64, String> {\n    let value = value.trim();\n    if let Ok(unix) = value.parse::<u64>() {\n        return Ok(unix);\n    }\n    if let Ok(time) = chrono::DateTime::parse_from_rfc3339(value) {\n        return u64::try_from(time.timestamp())\n            .map_err(|_| format!(\"'{value}' is before the Unix epoch\"));\n    }\n    let unit = value.chars().next_back().unwrap_or('?');\n    let amount = value.strip_suffix(unit).unwrap_or_default();\n    let scale = match unit {\n        's' => 1,\n        'm' => 60,\n        'h' => 3600,\n        'd' => 86_400,\n        _ => 0,\n    };\n    match amount.parse::<u64>() {\n        Ok(amount) if scale > 0 => {\n            Ok(crate::account_limits::now_unix().saturating_add(amount.saturating_mul(scale)))\n        }\n        _ => Err(format!(\n            \"expected Unix seconds, an RFC 3339 time or a delay like 90m, 6h, 2d; got '{value}'\"\n        )),\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":852,"end":1787,"unit":"utf16","byteStart":852,"byteEnd":1787}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1787,"end":1788,"unit":"utf16","byteStart":1787,"byteEnd":1788},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Small reusable value parsers for command-line and environment inputs.\n\n/// Parse a boolean switch that may also arrive from the environment.\n///\n/// Clap's plain `bool` accepts only `true`/`false` from an env var, which makes\n/// the `=1` spelling used throughout the deployment docs a hard startup error.\npub(super) fn parse_truthy(value: &str) -> Result<bool, String> {\n    match value.trim().to_ascii_lowercase().as_str() {\n        \"1\" | \"true\" | \"yes\" | \"on\" => Ok(true),\n        \"0\" | \"false\" | \"no\" | \"off\" | \"\" => Ok(false),\n        other => Err(format!(\n            \"expected a boolean (1/0, true/false), got '{other}'\"\n        )),\n    }\n}\n\n/// Parse when an account pause lifts into Unix seconds (issue #677).\n///\n/// Accepts Unix seconds, an RFC 3339 time, or a delay from now written as a\n/// number with an `s`, `m`, `h` or `d` suffix.\npub(super) fn parse_until(value: &str) -> Result<u64, String> {\n    let value = value.trim();\n    if let Ok(unix) = value.parse::<u64>() {\n        return Ok(unix);\n    }\n    if let Ok(time) = chrono::DateTime::parse_from_rfc3339(value) {\n        return u64::try_from(time.timestamp())\n            .map_err(|_| format!(\"'{value}' is before the Unix epoch\"));\n    }\n    let unit = value.chars().next_back().unwrap_or('?');\n    let amount = value.strip_suffix(unit).unwrap_or_default();\n    let scale = match unit {\n        's' => 1,\n        'm' => 60,\n        'h' => 3600,\n        'd' => 86_400,\n        _ => 0,\n    };\n    match amount.parse::<u64>() {\n        Ok(amount) if scale > 0 => {\n            Ok(crate::account_limits::now_unix().saturating_add(amount.saturating_mul(scale)))\n        }\n        _ => Err(format!(\n            \"expected Unix seconds, an RFC 3339 time or a delay like 90m, 6h, 2d; got '{value}'\"\n        )),\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1788,"utf8Bytes":1788,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1788,0,1788,-1],["trivia","comment",0,73,0,73,0],["trivia","whitespace",73,75,73,75,0],["trivia","comment",75,144,75,144,0],["trivia","whitespace",144,145,144,145,0],["trivia","comment",145,148,145,148,0],["trivia","whitespace",148,149,148,149,0],["trivia","comment",149,229,149,229,0],["trivia","whitespace",229,230,229,230,0],["trivia","comment",230,309,230,309,0],["trivia","whitespace",309,310,309,310,0],["token","identifier",310,313,310,313,0],["group","paren",313,320,313,320,0],["token","delimiter",313,314,313,314,12],["token","identifier",314,319,314,319,12],["token","delimiter",319,320,319,320,12],["trivia","whitespace",320,321,320,321,0],["token","identifier",321,323,321,323,0],["trivia","whitespace",323,324,323,324,0],["token","identifier",324,336,324,336,0],["group","paren",336,349,336,349,0],["token","delimiter",336,337,336,337,20],["token","identifier",337,342,337,342,20],["token","punct",342,343,342,343,20],["trivia","whitespace",343,344,343,344,20],["token","punct",344,345,344,345,20],["token","identifier",345,348,345,348,20],["token","delimiter",348,349,348,349,20],["trivia","whitespace",349,350,349,350,0],["token","punct",350,352,350,352,0],["trivia","whitespace",352,353,352,353,0],["token","identifier",353,359,353,359,0],["token","punct",359,360,359,360,0],["token","ide