,"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":45,"end":83,"unit":"utf16","byteStart":45,"byteEnd":83},"sha256":"2fc01dbea03c3cbd57d728861e71c2be19d82d3fbbf6c1ec77013416b1aa6488","source":"\n\n/// What to ask of the request log.\n","status":"preserved","diagnostic":null},{"term":"enum","name":"LogsOp","span":{"start":83,"end":1708,"unit":"utf16","byteStart":83,"byteEnd":1708},"sha256":"248ea97a10fbacde8ace5b63ee08000df36684ee20e75c8d71257687fbc85692","source":"#[derive(Debug, Subcommand)]\npub enum LogsOp {\n    /// Shape of the log: exchanges, records, statuses, time span, size.\n    Summary {\n        /// Restrict to one token's log directory, by its hashed name.\n        ///\n        /// Named `--token-id` because `--token` means a credential in `with`,\n        /// `server use` and `clients setup`, and one flag name meaning two\n        /// things is what makes a CLI unusable from memory (issue #314). The\n        /// old spelling is still accepted.\n        #[arg(long = \"token-id\", alias = \"token\", value_name = \"HASHED_NAME\")]\n        token: Option<String>,\n        /// Emit JSON, for a monitoring check rather than a human.\n        #[arg(long)]\n        json: bool,\n        #[command(flatten)]\n        target: AuthTarget,\n    },\n    /// Anomalies worth a name, with the correlation ids to inspect.\n    ///\n    /// Exits non-zero when any are found, so it works as a health gate.\n    Anomalies {\n        /// Restrict to one token's log directory, by its hashed name.\n        #[arg(long = \"token-id\", alias = \"token\", value_name = \"HASHED_NAME\")]\n        token: Option<String>,\n        /// Emit JSON, for a monitoring check rather than a human.\n        #[arg(long)]\n        json: bool,\n        #[command(flatten)]\n        target: AuthTarget,\n    },\n    /// One exchange, decoded and in order.\n    Show {\n        correlation_id: String,\n        /// Restrict to one token's log directory, by its hashed name.\n        #[arg(long = \"token-id\", alias = \"token\", value_name = \"HASHED_NAME\")]\n        token: Option<String>,\n        #[command(flatten)]\n        target: AuthTarget,\n    },\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(Subcommand): derive requires a separately checked capability","span":{"start":99,"end":109},"details":{"construct":"derive(Subcommand)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":28},"tokens":["#","[","derive","(","Debug",",","Subcommand",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1708,"end":1709,"unit":"utf16","byteStart":1708,"byteEnd":1709},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"use clap::Subcommand;\n\nuse super::AuthTarget;\n\n/// What to ask of the request log.\n#[derive(Debug, Subcommand)]\npub enum LogsOp {\n    /// Shape of the log: exchanges, records, statuses, time span, size.\n    Summary {\n        /// Restrict to one token's log directory, by its hashed name.\n        ///\n        /// Named `--token-id` because `--token` means a credential in `with`,\n        /// `server use` and `clients setup`, and one flag name meaning two\n        /// things is what makes a CLI unusable from memory (issue #314). The\n        /// old spelling is still accepted.\n        #[arg(long = \"token-id\", alias = \"token\", value_name = \"HASHED_NAME\")]\n        token: Option<String>,\n        /// Emit JSON, for a monitoring check rather than a human.\n        #[arg(long)]\n        json: bool,\n        #[command(flatten)]\n        target: AuthTarget,\n    },\n    /// Anomalies worth a name, with the correlation ids to inspect.\n    ///\n    /// Exits non-zero when any are found, so it works as a health gate.\n    Anomalies {\n        /// Restrict to one token's log directory, by its hashed name.\n        #[arg(long = \"token-id\", alias = \"token\", value_name = \"HASHED_NAME\")]\n        token: Option<String>,\n        /// Emit JSON, for a monitoring check rather than a human.\n        #[arg(long)]\n        json: bool,\n        #[command(flatten)]\n        target: AuthTarget,\n    },\n    /// One exchange, decoded and in order.\n    Show {\n        correlation_id: String,\n        /// Restrict to one token's log directory, by its hashed name.\n        #[arg(long = \"token-id\", alias = \"token\", value_name = \"HASHED_NAME\")]\n        token: Option<String>,\n        #[command(flatten)]\n        target: AuthTarget,\n    },\n}\n","sourceEncoding":{"utf16CodeUnits":1709,"utf8Bytes":1709,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1709,0,1709,-1],["token","identifier",0,3,0,3,0],["trivia","whitespace",3,4,3,4,0],["token","identifier",4,8,4,8,0],["token","punct",8,10,8,10,0],["token","identifier",10,20,10,20,0],["token","punct",20,21,20,21,0],["trivia","whitespace",21,23,21,23,0],["token","identifier",23,26,23,26,0],["trivia","whitespace",26,27,26,27,0],["token","identifier",27,32,27,32,0],["token","punct",32,34,32,34,0],["token","identifier",34,44,34,44,0],["token","punct",44,45,44,45,0],["trivia","whitespace",45,47,45,47,0],["trivia","comment",47,82,47,82,0],["trivia","whitespace",82,83,82,83,0],["token","punct",83,84,83,84,0],["group","bracket",84,111,84,111,0],["token","delimiter",84,85,84,85,18],["token","identifier",85,91,85,91,18],["group","paren",91,110,91,110,18],["token","delimiter",91,92,91,92,21],["token","identifier",92,97,92,97,21],["token","punct",97,98,97,98,21],["trivia","whitespace",98,99,98,99,21],["token","identifier",99,109,99,109,21],["token","delimiter",109,110,109,110,21],["token","d