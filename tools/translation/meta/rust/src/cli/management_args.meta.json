opback\", env = \"MANAGEMENT_LOCKOUT_EXEMPT_LOOPBACK\", global = true, num_args = 0..=1, default_value_t = true, default_missing_value = \"true\", value_parser = parse_truthy)]\n    pub exempt_loopback: bool,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(clap): derive requires a separately checked capability","span":{"start":213,"end":217},"details":{"construct":"derive(clap)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":35},"tokens":["#","[","derive","(","clap","::","Args",",","Debug",",","Clone",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1417,"end":1419,"unit":"utf16","byteStart":1417,"byteEnd":1419},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"ManagementArgs","span":{"start":1419,"end":1798,"unit":"utf16","byteStart":1419,"byteEnd":1798},"sha256":"f4d8430e52a70a3733f39cccf6bdf3516841ea38819e8b358c643c89616ac64c","source":"impl ManagementArgs {\n    /// Resolved management access configuration.\n    #[must_use]\n    pub const fn config(&self) -> ManagementConfig {\n        ManagementConfig {\n            allow_remote: self.allow_remote,\n            lockout_failures: self.lockout_failures,\n            lockout_secs: self.lockout_secs,\n            exempt_loopback: self.exempt_loopback,\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":1419,"end":1798},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1798,"end":1800,"unit":"utf16","byteStart":1798,"byteEnd":1800},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"Default","span":{"start":1800,"end":2145,"unit":"utf16","byteStart":1800,"byteEnd":2145},"sha256":"9c9f03d1ca1c3860c5ce562e63b985a36effc79abeaad04107542e01078fba93","source":"impl Default for ManagementArgs {\n    fn default() -> Self {\n        let config = ManagementConfig::default();\n        Self {\n            allow_remote: config.allow_remote,\n            lockout_failures: config.lockout_failures,\n            lockout_secs: config.lockout_secs,\n            exempt_loopback: config.exempt_loopback,\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":1800,"end":2145},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2145,"end":2146,"unit":"utf16","byteStart":2145,"byteEnd":2146},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Flags for management access policy and failed-authentication lockout.\nuse super::value_parsers::parse_truthy;\nuse crate::management_config::ManagementConfig;\n\n/// Explicit management access settings.\n#[derive(clap::Args, Debug, Clone)]\npub struct ManagementArgs {\n    /// Allow remote management on combined listeners (admin listeners are explicit).\n    #[arg(long = \"management-allow-remote\", env = \"MANAGEMENT_ALLOW_REMOTE\", global = true, num_args = 0..=1, default_value_t = false, default_missing_value = \"true\", value_parser = parse_truthy)]\n    pub allow_remote: bool,\n    /// Consecutive authentication failures before an IP ban; 0 disables lockout.\n    #[arg(\n        long = \"management-lockout-failures\",\n        env = \"MANAGEMENT_LOCKOUT_FAILURES\",\n        global = true,\n        default_value_t = 5\n    )]\n    pub lockout_failures: u32,\n    /// Ban duration in seconds; 0 disables lockout.\n    #[arg(\n        long = \"management-lockout-secs\",\n        env = \"MANAGEMENT_LOCKOUT_SECS\",\n        global = true,\n        default_value_t = 1800\n    )]\n    pub lockout_secs: u64,\n    /// Exempt loopback clients from lockout so local recovery stays available.\n    #[arg(long = \"management-lockout-exempt-loopback\", env = \"MANAGEMENT_LOCKOUT_EXEMPT_LOOPBACK\", global = true, num_args = 0..=1, default_value_t = true, default_missing_value = \"true\", value_parser = parse_truthy)]\n    pub exempt_loopback: bool,\n}\n\nimpl ManagementArgs {\n    /// Resolved management access configuration.\n    #[must_use]\n    pub const fn config(&self) -> ManagementConfig {\n        ManagementConfig {\n            allow_remote: self.allow_remote,\n            lockout_failures: self.lockout_failures,\n            lockout_secs: self.lockout_secs,\n            exempt_loopback: self.exempt_loopback,\n        }\n    }\n}\n\nimpl Default for ManagementArgs {\n    fn default() -> Self {\n        let config = ManagementConfig::default();\n        Self {\n            allow_remote: config.allow_remote,\n            lockout_failures: config.lockout_failures,\n            lockout_secs: config.lockout_secs,\n            exempt_loopback: config.exempt_loopback,\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2146,"utf8Bytes":2146,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2146,0,2146,-1],["trivia","comment",0,73,0,73,0],["trivia","whitespace",73,74,73,74,0],["token","identifier",74,77,74,77,0],["trivia","whitespace",77,78,77,78,0],["token","identifier",78,83,78,83,0],["token","punct",83,85,83,85,0],["token","identifier",85,98,85,98,0],["token","punct",98,100,98,100,0],["token","identifier",100,112,100,112,0],["token","punct",112,113,112,113,0],["trivia","whitespace",113,114,1