rate","span":{"start":116,"end":191,"unit":"utf16","byteStart":116,"byteEnd":191},"sha256":"89b4a121ee2c7c050f163baf3f5b4ea2824abff5be2df90ae342b8701c52063f","source":"use crate::emergency_auth::{DEFAULT_DURATION_MINUTES, EmergencyAuthConfig};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":116,"end":191},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":191,"end":331,"unit":"utf16","byteStart":191,"byteEnd":331},"sha256":"45bdce8a3b6d9ad3702bf4ee6f73999a6df9bb011376cfe04bcd066aaa833647","source":"\n\n/// `--emergency-*` switches. Every one is off or at its safe default unless\n/// given; none is read from a persisted deployment setting.\n","status":"preserved","diagnostic":null},{"term":"struct","name":"EmergencyArgs","span":{"start":331,"end":1752,"unit":"utf16","byteStart":331,"byteEnd":1752},"sha256":"1a34b965905fa4c83d4681a89d254b2d60363bd4d572d0bddac8f837e79ec1ff","source":"#[derive(clap::Args, Debug, Clone, Default)]\npub struct EmergencyArgs {\n    /// EMERGENCY ONLY: accept any non-empty client token on client routes\n    /// for a bounded time. Off by default; management routes keep normal\n    /// admin authentication, no token record is read, written, rotated or\n    /// revived, and every bypassed request is logged and counted. See\n    /// `docs/security/emergency-auth.md`.\n    #[arg(\n        long,\n        env = \"EMERGENCY_ACCEPT_ANY_TOKEN\",\n        hide_env_values = true,\n        num_args = 0..=1,\n        default_value_t = false,\n        default_missing_value = \"true\",\n        value_parser = parse_truthy\n    )]\n    pub emergency_accept_any_token: bool,\n\n    /// Acknowledge that emergency any-token mode is served on a non-loopback\n    /// listener. Without it the router refuses to start in emergency mode\n    /// unless every listener is bound to loopback.\n    #[arg(\n        long,\n        env = \"EMERGENCY_ALLOW_NON_LOOPBACK\",\n        num_args = 0..=1,\n        default_value_t = false,\n        default_missing_value = \"true\",\n        value_parser = parse_truthy\n    )]\n    pub emergency_allow_non_loopback: bool,\n\n    /// Minutes after which emergency any-token mode switches itself off\n    /// (1..=1440).\n    #[arg(\n        long,\n        env = \"EMERGENCY_DURATION_MINUTES\",\n        default_value_t = DEFAULT_DURATION_MINUTES\n    )]\n    pub emergency_duration_minutes: u64,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(clap): derive requires a separately checked capability","span":{"start":340,"end":344},"details":{"construct":"derive(clap)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":44},"tokens":["#","[","derive","(","clap","::","Args",",","Debug",",","Clone",",","Default",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1752,"end":1754,"unit":"utf16","byteStart":1752,"byteEnd":1754},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"EmergencyArgs","span":{"start":1754,"end":2114,"unit":"utf16","byteStart":1754,"byteEnd":2114},"sha256":"421d584139b58b26d099351935fd605e13b01472b1303676112257d784b94fbf","source":"impl EmergencyArgs {\n    /// The resolved configuration.\n    #[must_use]\n    pub const fn config(&self) -> EmergencyAuthConfig {\n        EmergencyAuthConfig {\n            enabled: self.emergency_accept_any_token,\n            allow_non_loopback: self.emergency_allow_non_loopback,\n            duration_minutes: self.emergency_duration_minutes,\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":1754,"end":2114},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2114,"end":2115,"unit":"utf16","byteStart":2114,"byteEnd":2115},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Flags for the explicit, bounded emergency any-token mode (issue #645).\n\nuse super::value_parsers::parse_truthy;\nuse crate::emergency_auth::{DEFAULT_DURATION_MINUTES, EmergencyAuthConfig};\n\n/// `--emergency-*` switches. Every one is off or at its safe default unless\n/// given; none is read from a persisted deployment setting.\n#[derive(clap::Args, Debug, Clone, Default)]\npub struct EmergencyArgs {\n    /// EMERGENCY ONLY: accept any non-empty client token on client routes\n    /// for a bounded time. Off by default; management routes keep normal\n    /// admin authentication, no token record is read, written, rotated or\n    /// revived, and every bypassed request is logged and counted. See\n    /// `docs/security/emergency-auth.md`.\n    #[arg(\n        long,\n        env = \"EMERGENCY_ACCEPT_ANY_TOKEN\",\n        hide_env_values = true,\n        num_args = 0..=1,\n        default_value_t = false,\n        default_missing_value = \"true\",\n        value_parser = parse_truthy\n    )]\n    pub emergency_accept_any_token: bool,\n\n    /// Acknowledge that emergency any-token mode is served on a non-loopback\n    /// listener. Without it the router refuses to start in emergency mode\n    /// unless every listener is bound to loopback.\n    #[arg(\n        long,\n        env = \"EMERGENCY_ALLOW_NON_LOOPBACK\",\n        num_args = 0..=1,\n        default_value_t = false,\n        default_missing_value = \"true\",\n        value_parser = parse_truthy\n    )]\n    pub emergency_allow_non_loopback: bool,\n\n    /// Minutes a