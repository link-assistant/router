:"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":5,"preserved":6},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":697,"unit":"utf16","byteStart":0,"byteEnd":703},"sha256":"3d1107d5d8f479486427d44411efe3eae7df1738c0260cc1d934ae08bab88c0b","source":"//! `router configure <client>` — the one name for permanent client setup.\n//!\n//! Pointing a client at the router permanently is the first thing an operator\n//! does after standing a deployment up, and it had no single name. Two\n//! commands wrote the same file and disagreed on almost everything else: the\n//! address (`clients setup` used this CLI's own `--host`/`--port` default even\n//! with a server selected), the credential (`with --global` stored none and\n//! told the user to go set an environment variable), how to reverse it, and\n//! which clients it worked for. `configure` exists in the codebase — it is\n//! what both paths call — but was not a name a user could type (issue #296).\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"clap","span":{"start":697,"end":712,"unit":"utf16","byteStart":703,"byteEnd":718},"sha256":"e68c51c24cbc1fcfadc817a98bfbfc9d2695fdb578296d821e2cad5f21621d51","source":"use clap::Args;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":697,"end":712},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":712,"end":714,"unit":"utf16","byteStart":718,"byteEnd":720},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"use","name":"super","span":{"start":714,"end":736,"unit":"utf16","byteStart":720,"byteEnd":742},"sha256":"50252d3616cc3455671fee996c874882ed0420b24e9024428d88b75c0dd5232a","source":"use super::AuthTarget;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":714,"end":736},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":736,"end":737,"unit":"utf16","byteStart":742,"byteEnd":743},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"crate","span":{"start":737,"end":768,"unit":"utf16","byteStart":743,"byteEnd":774},"sha256":"83beba6977e0b10c07a52b0391204f352664501bd7cfa93226c34b799fddf4f0","source":"use crate::clients::ClientKind;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":737,"end":768},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":768,"end":816,"unit":"utf16","byteStart":774,"byteEnd":822},"sha256":"43bd368dd3e9d097d707ccb5410420f9dcdb3e3f615f884fca4551c4111d9b48","source":"\n\n/// Point a client at the router permanently.\n","status":"preserved","diagnostic":null},{"term":"struct","name":"ConfigureArgs","span":{"start":816,"end":2441,"unit":"utf16","byteStart":822,"byteEnd":2449},"sha256":"5f96389a9ea928021443bae41719d6bd6551ac62a86ddce3989306497ef5e59e","source":"#[derive(Clone, Debug, Args)]\npub struct ConfigureArgs {\n    /// Client to configure. Omit when `--all` is given.\n    #[arg(value_enum, required_unless_present = \"all\")]\n    pub client: Option<ClientKind>,\n    /// Configure every client this machine has that can be configured.\n    ///\n    /// Clients whose vendor gates prevent it are skipped and named in the\n    /// summary rather than failing the run — a workstation being pointed at a\n    /// deployment wants the ones that work.\n    #[arg(long, conflicts_with = \"client\")]\n    pub all: bool,\n    /// Restore the exact configuration saved by a previous `configure`.\n    ///\n    /// The restore is hash-verified: an edit made after `configure` is\n    /// preserved rather than overwritten.\n    #[arg(long)]\n    pub undo: bool,\n    #[command(flatten)]\n    pub target: AuthTarget,\n    /// Existing router token to configure instead of minting one.\n    ///\n    /// Prefer `--token-stdin` or `LINK_ASSISTANT_ROUTER_TOKEN` over argv,\n    /// which is visible in shell history and process listings.\n    #[arg(long, hide_env_values = true, conflicts_with = \"token_stdin\")]\n    pub token: Option<String>,\n    /// Read an existing router token as one line from standard input.\n    #[arg(long, conflicts_with = \"token\")]\n    pub token_stdin: bool,\n    /// Lifetime of an automatically minted token, in hours.\n    ///\n    /// A year by default, because this is the permanent path: a credential\n    /// that lapses next week makes \"configured\" mean \"configured until\n    /// Tuesday\". Re-run `configure` to renew it.\n    #[arg(long, default_value_t = 8760)]\n    pub ttl_hours: i64,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(Args): derive requires a separately checked capability","span":{"start":839,"end":843},"details":{"construct":"derive(Args)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":29},"tokens":["#","[","derive","(","Clone",",","Debug",",","Args",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2441,"end":2443,"unit":"utf16","byteStart":2449,"byteEnd":2451},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"ConfigureArgs","span":{"start":2443,"end":2676,"unit":"utf16","byteStart":2451,"byteEnd":2684},"sha256":"11579e0f9b349ff48810d9b063783c6c216cbaabed013be8367ccb9b19c73153","source":"impl ConfigureArgs {\n    /// The clients this invocation acts on.\n    #[must_use]\n    pub fn clients(&self) -> Vec<ClientKind> {\n        self.client\n            .map_or_else(|| ClientKind::ALL.to_vec(), |client| vec![client])\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":2443,"end":2676},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2676,"end":2677,"unit":"utf16","byteStart":2684,"byteEnd":2685},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! `router configure <client>` — the one name for permanent client setup.\n//!\n//! Pointing a client at the router permanently is the first thing an operator\n//! does after standing a deployment up, and it had no single name. Two\n//! commands wrote the same file and disagreed on almost everything else: the\n//! address (`clients setup` used this CLI's own `--host`/`--port` default even\n//! with a server selected), the credential (`with --global` stored none and\n//! told the user to go set an environment variable), how to reverse it, and\n//! which clients it worked for. `configure` exists in the codebase — it is\n//! what both paths call — but was not a name a user could type (issue #296).\n\nuse clap::Args;\n\nuse super::AuthTarget;\nuse crate::clients::ClientKind;\n\n/// Point a client at the router permanently.\n#[derive(Clone, Debug, Args)]\npub struct ConfigureArgs {\n    /// Client to configure. Omit when `--all` is given.\n    #[arg(value_enum, required_unless_present = \"all\")]\n    pub client: Option<ClientKind>,\n    /// Configure every client this machine has that can be configured.\n    ///\n    /// Clients whose vendor gates prevent it are skipped and named in the\n    /// summary rather than failing the run — a workstation being pointed at a\n    /// deployment wants the ones that work.\n    #[arg(long, conflicts_with = \"client\")]\n    pub all: bool,\n    /// Restore the exact configuration saved by a previous `configure`.\n    ///\n    /// The restore is hash-verified: an edit made after `configure` is\n    /// preserved rather than overwritten.\n    #[arg(long)]\n    pub undo: bool,\n    #[command(flatten)]\n    pub target: AuthTarget,\n    /// Existing router token to configure instead of minting one.\n    ///\n    /// Prefer `--token-stdin` or `LINK_ASSISTANT_ROUTER_TOKEN` over argv,\n    /// which is visible in shell history and process listings.\n    #[arg(long, hide_env_values = true, conflicts_with = \"token_stdin\")]\n    pub token: Option<String>,\n    /// Read an existing router token as one line from standard input.\n    #[arg(long, conflicts_with = \"token\")]\n    pub token_stdin: bool,\n    /// Lifetime of an automatically minted token, in hours.\n    ///\n    /// A year by default, because this is the permanent path: a credential\n    /// that lapses n