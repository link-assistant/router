,"byteEnd":285},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"use","name":"crate","span":{"start":285,"end":333,"unit":"utf16","byteStart":285,"byteEnd":333},"sha256":"6822548f9a011d0eae25eea69e27854f88c131ca04702e8b690a1b3aaed00655","source":"use crate::config::{ConfigError, parse_u64_env};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":285,"end":333},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":333,"end":717,"unit":"utf16","byteStart":333,"byteEnd":717},"sha256":"58fd22db4af436c37bab7dccb224d3188ee45a17c8aa1c22ac0ffe4f6a1fbde0","source":"\n\n/// Build the admin UI configuration from environment variables.\n///\n/// The listener is enabled only when `ADMIN_PORT` names a non-zero port, so\n/// upgrading an existing deployment gains no new surface.\n///\n/// # Errors\n///\n/// Returns [`ConfigError::InvalidPort`] for an unparseable `ADMIN_PORT` and\n/// [`ConfigError::InvalidAddress`] when host and port do not form an address.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"admin_ui_from_env","span":{"start":717,"end":1336,"unit":"utf16","byteStart":717,"byteEnd":1336},"sha256":"e016b75baa420c68755c594b3c57b6734778ade5455f40955b27529467356858","source":"pub fn admin_ui_from_env() -> crate::translation_core::Outcome<crate::admin::AdminUiConfig, ConfigError> {\n    let port = crate::operation_context::var(\"ADMIN_PORT\")\n        .ok()\n        .filter(|value| !value.trim().is_empty())\n        .map(|value| value.trim().parse::<u16>())\n        .transpose()\n        .map_err(|_| ConfigError::InvalidPort)?;\n    let host =\n        crate::operation_context::var(\"ADMIN_HOST\").unwrap_or_else(|_| \"127.0.0.1\".to_string());\n    let ttl = parse_u64_env(\n        \"ADMIN_CLAIM_TTL_SECS\",\n        crate::admin::DEFAULT_CANDIDATE_TTL_SECS,\n    );\n    admin_ui_config(port, &host, ttl)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":717,"end":1336,"unit":"utf16","byteStart":717,"byteEnd":1336}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1336,"end":1533,"unit":"utf16","byteStart":1336,"byteEnd":1533},"sha256":"4464b94e47e3c3a3ce18fd920ff737106f2f610e1fc5bb24141db37a8c5017da","source":"\n\n/// Assemble an [`crate::admin::AdminUiConfig`] from explicit parts.\n///\n/// # Errors\n///\n/// Returns [`ConfigError::InvalidAddress`] when `host` and `port` do not parse\n/// as a socket address.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"admin_ui_config","span":{"start":1533,"end":2275,"unit":"utf16","byteStart":1533,"byteEnd":2275},"sha256":"20bfd8280ee7d6bc1f4e8fcead2bb3582b65b76d0cc5cc40d47d2d749756120c","source":"pub fn admin_ui_config(\n    port: crate::translation_core::Maybe<u16>,\n    host: &crate::translation_core::Str,\n    candidate_ttl_secs: u64,\n) -> crate::translation_core::Outcome<crate::admin::AdminUiConfig, ConfigError> {\n    let default = crate::admin::AdminUiConfig::default();\n    let enabled = port.is_some_and(|value| value != 0);\n    let listen_addr = match port.filter(|value| *value != 0) {\n        Some(value) => crate::translation_core::format!(\"{host}:{value}\")\n            .parse()\n            .map_err(|_| ConfigError::InvalidAddress)?,\n        None => default.listen_addr,\n    };\n    Ok(crate::admin::AdminUiConfig {\n        enabled,\n        listen_addr,\n        candidate_ttl: Duration::from_secs(candidate_ttl_secs),\n    })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1533,"end":2275,"unit":"utf16","byteStart":1533,"byteEnd":2275}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2275,"end":2276,"unit":"utf16","byteStart":2275,"byteEnd":2276},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Configuration for the opt-in admin UI listener.\n//!\n//! Split out of [`crate::config`] to keep that module within the repository's\n//! per-file line budget; the constructors are re-exported there, so callers can\n//! keep using `config::admin_ui_config`.\n\nuse std::time::Duration;\n\nuse crate::config::{ConfigError, parse_u64_env};\n\n/// Build the admin UI configuration from environment variables.\n///\n/// The listener is enabled only when `ADMIN_PORT` names a non-zero port, so\n/// upgrading an existing deployment gains no new surface.\n///\n/// # Errors\n///\n/// Returns [`ConfigError::InvalidPort`] for an unparseable `ADMIN_PORT` and\n/// [`ConfigError::InvalidAddress`] when host and port do not form an address.\npub fn admin_ui_from_env() -> crate::translation_core::Outcome<crate::admin::AdminUiConfig, ConfigError> {\n    let port = crate::operation_context::var(\"ADMIN_PORT\")\n        .ok()\n        .filter(|value| !value.trim().is_empty())\n        .map(|value| value.trim().parse::<u16>())\n        .transpose()\n        .map_err(|_| ConfigError::InvalidPort)?;\n    let host =\n        crate::operation_context::var(\"ADMIN_HOST\").unwrap_or_else(|_| \"127.0.0.1\".to_string());\n    let ttl = parse_u64_env(\n        \"ADMIN_CLAIM_TTL_SECS\",\n        crate::admin::DEFAULT_CANDIDATE_TTL_SECS,\n    );\n    admin_ui_config(port, &host, ttl)\n}\n\n/// Assemble an [`crate::admin::AdminUiConfig`] from explicit parts.\n///\n/// # Errors\n///\n/// Returns [`ConfigError::InvalidAddress`] when `host` and `port` do not parse\n/// as a socket address.\npub fn admin_ui_config(\n    port: crate::translation_core::Maybe<u16>,\n    host: &crate::translation_core::Str,\n    candidate_ttl_secs: u64,\n) -> crate::translation_core::Outcome<crate::admin::AdminUiConfig, ConfigError> {\n    let default = crate::admin::AdminUiConfig::default();\n    let enabled = port.is_some_and(|value| value != 0);\n    let listen_addr = match port.filter(|value| *value != 0) {\n        Some(value) => crate::translation_core::format!(\"{host}:{value}\")\n            .parse()\n            .map_err(|_| ConfigError::InvalidAddress)?,\n        None => default.listen_addr,\n    };\n    Ok(crate::admin::AdminUiConfig {\n        enabled,\n        listen_addr,\n        candidate_ttl: Duration::from_secs(candidate_ttl_secs),\n    })\n}\n","sourceEncoding":{"utf16CodeUnits":2276,"utf8Bytes":2276,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2276,0,2276,-1],["trivia","comment",0,51,0,51,0],["trivia","whitespace",51,52,51,52,0],["trivia","comment",52,55,52,55,0],["trivia","whitespace",55,56,55,56,0],["trivia","comment",56,134,56,134,0],["trivia","whitespace",134,135,134,135,0],["trivia","comment",135,215,135,215,0],["trivia","whitespace",215,216,215,216,0],["trivia","comment",216,257,216,257,0],["trivia","whitespace",257,259,257,259,0],["token","identifier",259,262,259,262,0],["trivia","whitespace",262,263,262,263,0],["token","identifier",263,266,263,266,0],["token","punct",266,268,266,268,0],["token","identifier",268,272,268,272,0],["token","punct",272,274,272,274,0],["token","identifier",274,282,274,282,0],["token","punct",282,283,282,283,0],["trivia","whitespace",283,285,283,285,0],["token","identifier",285,288,285,288,0],["trivia","whitespace",288,289,288,289,0],["token","identifier",289,294,289,294,0],["token","punct",294,296,294,296,0],["token","identifier",296,302,296,302,