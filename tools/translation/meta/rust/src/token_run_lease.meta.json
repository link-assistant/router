l, integer and machine integer is a BigInt; machine-integer results are range-checked and throw RangeError where Rust would panic"}],"assumptions":[],"mappings":[{"kind":"function","source":"rp_746f6b656e2e72756e5f6c656173652e52554e5f4c454153455f54544c5f5345434f4e4453","target":"rp_746f6b656e2e72756e5f6c656173652e52554e5f4c454153455f54544c5f5345434f4e4453","sourceSpan":{"start":4011867,"end":4011872}},{"kind":"function","source":"RUN_LEASE_TTL_SECONDS","target":"rp_746f6b656e2e72756e5f6c656173652e52554e5f4c454153455f54544c5f5345434f4e4453","sourceSpan":{"start":4011867,"end":4011872}}],"params":[],"returns":{"kind":"fixed","bits":64,"signed":true,"rustPrimitiveName":"i64","rustSourceType":true},"project":{"entry":"rust/src/lib.rs","declaration":"token.run_lease.RUN_LEASE_TTL_SECONDS"}}},{"term":"trivia","name":null,"span":{"start":265,"end":267,"unit":"utf16","byteStart":265,"byteEnd":267},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"TokenManager","span":{"start":267,"end":1854,"unit":"utf16","byteStart":267,"byteEnd":1854},"sha256":"f5aa259c0b469ed58414fe7b4162041aab8a398826deb938d1533b2c3c4b240e","source":"impl TokenManager {\n    /// Issue an ephemeral, model-pinned token with an explicit liveness lease.\n    pub fn issue_ephemeral_with_model_policy_and_run_lease(\n        &self,\n        request: &IssueRequest<'_>,\n        model_policy: &ModelAccessPolicy,\n    ) -> Result<String, jsonwebtoken::errors::Error> {\n        self.issue_with_id_and_model_policy(\n            request,\n            true,\n            model_policy,\n            Some(RUN_LEASE_TTL_SECONDS),\n        )\n        .map(|(token, _)| token)\n    }\n\n    /// Extend an existing lease; an authenticated wrapper may recover after a\n    /// server outage, but a legacy record with no lease is never promoted.\n    pub fn renew_run_lease(&self, token_id: &str) -> Result<i64, TokenError> {\n        // An emergency-bypassed wrapper keeps its heartbeat answered without\n        // any record being created or extended (issue #645).\n        if crate::emergency_auth::is_synthetic_id(token_id) {\n            return Ok(crate::operation_context::now()\n                .timestamp()\n                .saturating_add(RUN_LEASE_TTL_SECONDS));\n        }\n        self.store\n            .renew_run_lease(\n                token_id,\n                crate::operation_context::now().timestamp(),\n                RUN_LEASE_TTL_SECONDS,\n            )\n            .map_err(|error| TokenError::Storage(error.to_string()))?\n            .ok_or_else(|| {\n                TokenError::Invalid(\n                    \"run lease is absent, revoked, expired as a token, or not ephemeral\"\n                        .to_string(),\n                )\n            })\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":267,"end":1854},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1854,"end":1855,"unit":"utf16","byteStart":1854,"byteEnd":1855},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Renewable wrapper-process leases used by safe local deployment inventory.\n\nuse super::{IssueRequest, ModelAccessPolicy, TokenError, TokenManager};\n\n/// How long a wrapper stays provably live without another heartbeat.\npub const RUN_LEASE_TTL_SECONDS: i64 = 120;\n\nimpl TokenManager {\n    /// Issue an ephemeral, model-pinned token with an explicit liveness lease.\n    pub fn issue_ephemeral_with_model_policy_and_run_lease(\n        &self,\n        request: &IssueRequest<'_>,\n        model_policy: &ModelAccessPolicy,\n    ) -> Result<String, jsonwebtoken::errors::Error> {\n        self.issue_with_id_and_model_policy(\n            request,\n            true,\n            model_policy,\n            Some(RUN_LEASE_TTL_SECONDS),\n        )\n        .map(|(token, _)| token)\n    }\n\n    /// Extend an existing lease; an authenticated wrapper may recover after a\n    /// server outage, but a legacy record with no lease is never promoted.\n    pub fn renew_run_lease(&self, token_id: &str) -> Result<i64, TokenError> {\n        // An emergency-bypassed wrapper keeps its heartbeat answered without\n        // any record being created or extended (issue #645).\n        if crate::emergency_auth::is_synthetic_id(token_id) {\n            return Ok(crate::operation_context::now()\n                .timestamp()\n                .saturating_add(RUN_LEASE_TTL_SECONDS));\n        }\n        self.store\n            .renew_run_lease(\n                token_id,\n                crate::operation_context::now().timestamp(),\n                RUN_LEASE_TTL_SECONDS,\n            )\n            .map_err(|error| TokenError::Storage(error.to_string()))?\n            .ok_or_else(|| {\n                TokenError::Invalid(\n                    \"run lease is absent, revoked, expired as a token, or not ephemeral\"\n                        .to_string(),\n                )\n            })\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1855,"utf8Bytes":1855,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1855,0,1855,-1],["trivia","comment",0,77,0,77,0],["trivia","whitespace",77,79,77,79,0],["token","identifier",79,82,79,82,0],["trivia","whitespace",82,83,82,83,0],["token","identifier",83,88,83,88,0],["token","punct",88,90,88,90,0],["group","brace",90,149,90,149,0],["token","delimiter",90,91,90,91,7],["token","identifier",91,103,91,103,7],["token","punct",103,104,103,104,7],["trivia","whitespace