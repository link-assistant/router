ive requires a separately checked capability","span":{"start":199,"end":209},"details":{"construct":"derive(LinoParser)"}},"comment":false},{"term":"trivia","name":null,"span":{"start":734,"end":736,"unit":"utf16","byteStart":734,"byteEnd":736},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":736,"end":1700,"unit":"utf16","byteStart":736,"byteEnd":1700},"sha256":"dde7c6466189bccf04fea89ebda5d9f78990a6a01d3782176cd7d6b996496362","source":"#[tokio::main]\nasync fn main() -> ExitCode {\n    lino_arguments::init();\n    let arguments =\n        link_assistant_router::cli::protect_client_arguments(std::env::args_os().collect(), false);\n    let boundary = arguments\n        .iter()\n        .position(|argument| argument == \"--\")\n        .unwrap_or(arguments.len());\n    if arguments[..boundary]\n        .iter()\n        .any(|argument| argument == \"--json\")\n    {\n        let nested = std::iter::once(\"router\".into())\n            .chain(std::iter::once(\"with\".into()))\n            .chain(arguments.into_iter().skip(1))\n            .collect();\n        return link_assistant_router::operations::run_arguments(nested).await;\n    }\n    let args = <Args as lino_arguments::Parser>::parse_from(arguments);\n    let data_dir = args\n        .data_dir\n        .unwrap_or_else(link_assistant_router::config::default_data_dir);\n    link_assistant_router::logging::run_launcher(&args.with, &data_dir, args.verbose).await\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":736,"end":1700},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1700,"end":1701,"unit":"utf16","byteStart":1700,"byteEnd":1701},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concret