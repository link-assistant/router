span":{"start":203,"end":717,"unit":"utf16","byteStart":203,"byteEnd":717},"sha256":"03f7d8d5f7395fe310ab5ccbd61a6a3f270560bdc67d7239b4e278d879c245f5","source":"#[test]\nfn two_runs_of_the_same_client_share_one_profile() {\n    let profiles = tempfile::tempdir().expect(\"profile root\");\n    let root = Some(profiles.path());\n    let first = persistent_profile(ClientKind::Codex, root).expect(\"first profile\");\n    let second = persistent_profile(ClientKind::Codex, root).expect(\"second profile\");\n    assert_eq!(first, second);\n    assert!(first.is_dir());\n    assert_ne!(\n        first,\n        persistent_profile(ClientKind::GeminiCli, root).expect(\"another client\")\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":203,"end":209},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":717,"end":719,"unit":"utf16","byteStart":717,"byteEnd":719},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"registry_order_matches_client_discriminants","span":{"start":719,"end":876,"unit":"utf16","byteStart":719,"byteEnd":876},"sha256":"babb654efd1e0d75ba0fb0c866abac43e234b23508705ae01ccec0d15b68d14b","source":"#[test]\nfn registry_order_matches_client_discriminants() {\n    for client in ClientKind::ALL {\n        assert_eq!(client.integration().kind, client);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":719,"end":725},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":876,"end":1106,"unit":"utf16","byteStart":876,"byteEnd":1108},"sha256":"0dda6310b90ab8075eb72f166362374a9a4bab7dc4eae91b31933f32f3455891","source":"\n\n/// The default label names the client and a run, never the directory the\n/// command was run in — a deployment was accumulating a list of every project\n/// its users work in, visible to anyone who can list tokens (issue #316).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_default_label_carries_no_directory_name","span":{"start":1106,"end":1862,"unit":"utf16","byteStart":1108,"byteEnd":1864},"sha256":"daf417594301427c6721d60f461954f78e2846026ad1c3d4834dc80b8f2fbac6","source":"#[test]\nfn the_default_label_carries_no_directory_name() {\n    let label = format!(\"with-{}-{}\", ClientKind::ClaudeCode, super::run_suffix());\n\n    assert!(label.starts_with(\"with-claude-\"), \"{label}\");\n    let cwd = crate::operation_context::current_dir().expect(\"cwd\");\n    let name = cwd\n        .file_name()\n        .expect(\"directory name\")\n        .to_string_lossy()\n        .into_owned();\n    assert!(\n        !label.contains(&name),\n        \"the working directory's name must not reach the router: {label} contains {name}\"\n    );\n    assert_eq!(super::run_suffix().len(), 4, \"a fixed-width run suffix\");\n    assert_eq!(\n        super::run_suffix(),\n        super::run_suffix(),\n        \"stable within one process, so one run has one label\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1106,"end":1112},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1862,"end":1863,"unit":"utf16","byteStart":1864,"byteEnd":1865},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Persistent-profile and privacy tests for temporary client launches.\n\nuse super::*;\n\n/// The same client twice gets the same directory, which is what makes a\n/// session resumable through the router.\n#[test]\nfn two_runs_of_the_same_client_share_one_profile() {\n    let profiles = tempfile::tempdir().expect(\"profile root\");\n    let root = Some(profiles.path());\n    let first = persistent_profile(ClientKind::Codex, root).expect(\"first profile\");\n    let second = persistent_profile(ClientKind::Codex, root).expect(\"second profile\");\n    assert_eq!(first, second);\n    assert!(first.is_dir());\n    assert_ne!(\n        first,\n        persistent_profile(ClientKind::GeminiCli, root).expect(\"another client\")\n    );\n}\n\n#[test]\nfn registry_order_matches_client_discriminants() {\n    for client in ClientKind::ALL {\n        assert_eq!(client.integration().kind, client);\n    }\n}\n\n/// The default label names the client and a run, never the directory the\n/// command was run in — a deployment was accumulating a list of every project\n/// its users work in, visible to anyone who can list tokens (issue #316).\n#[test]\nfn the_default_label_carries_no_directory_name() {\n    let label = format!(\"with-{}-{}\", ClientKind::ClaudeCode, super::run_suffix());\n\n    assert!(label.starts_with(\"with-claude-\"), \"{label}\");\n    let cwd = crate::operation_context::current_dir().expect(\"cwd\");\n    let name = cwd\n        .file_name()\n        .expect(\"directory name\")\n        .to_string_lossy()\n        .into_owned();\n    assert!(\n        !label.contains(&name),\n        \"the working directory's name must not reach the router: {label} contains {name}\"\n    );\n    assert_eq!(super::run_suffix().len(), 4, \"a fixed-width run suffix\");\n    assert_eq!(\n        super::run_suffix(),\n        super::run_suffix(),\n        \"stable within one process, so one run has one label\"\n    );\n}\n","sourceEncoding":{"utf16CodeUnits":1863,"utf8Bytes":1865,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","f