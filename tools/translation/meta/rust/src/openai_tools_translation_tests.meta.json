ize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":1,"preserved":2},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":156,"unit":"utf16","byteStart":0,"byteEnd":156},"sha256":"6669768f0588af9bb0b545ff663833f7872e63beb3d59cae8b31fd2ecf13f805","source":"//! Pure native oracle shared with the automated translation regression.\n//! Issue #759 runs Rust only in CI after every same-SHA JavaScript stage passes.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"fn","name":"tool_choice_matches_shared_translation_edge_cases_without_mutation","span":{"start":156,"end":963,"unit":"utf16","byteStart":156,"byteEnd":963},"sha256":"bbcdd721fca2714e5f50c7a43d253c6e4433912c25a3a3376317c21a579af356","source":"#[test]\nfn tool_choice_matches_shared_translation_edge_cases_without_mutation() {\n    let cases: serde_json::Value = serde_json::from_str(include_str!(\n        \"../fixtures/translation/openai-tool-choice.json\"\n    ))\n    .expect(\"valid shared tool-choice fixtures\");\n    let cases = cases.as_array().expect(\"array of shared cases\");\n    assert_eq!(cases.len(), 24);\n    for case in cases {\n        let name = case[\"name\"].as_str().expect(\"case name\");\n        let input = case.get(\"input\").expect(\"case input\");\n        let expected = case.get(\"expected\").expect(\"case expected result\");\n        let before = input.clone();\n        let actual = crate::openai::translate_tool_choice(input);\n        assert_eq!(&actual, expected, \"{name}\");\n        assert_eq!(input, &before, \"input changed: {name}\");\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":156,"end":162},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":963,"end":964,"unit":"utf16","byteStart":963,"byteEnd":964},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Pure native oracle shared with the automated translation regression.\n//! Issue #759 runs Rust only in CI after every same-SHA JavaScript stage passes.\n\n#[test]\nfn tool_choice_matches_shared_translation_edge_cases_without_mutation() {\n    let cases: serde_json::Value = serde_json::from_str(include_str!(\n        \"../fixtures/translation/openai-tool-choice.json\"\n    ))\n    .expect(\"valid shared tool-choice fixtures\");\n    let cases = cases.as_array().expect(\"array of shared cases\");\n    assert_eq!(cases.len(), 24);\n    for case in cases {\n        let name = case[\"name\"].as_str().expect(\"case name\");\n        let input = case.get(\"input\").expect(\"case input\");\n        let expected = case.get(\"expected\").expect(\"case expected result\");\n        let before = input.clone();\n        let actual = crate::openai::translate_tool_choice(input);\n        assert_eq!(&actual, expected, \"{name}\");\n        assert_eq!(input, &before, \"input changed: {name}\");\n    }\n}\n","sourceEncoding":