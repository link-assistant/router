t<()> {\n    let mut options = OpenOptions::new();\n    options.create(true).append(true);\n    #[cfg(unix)]\n    {\n        use std::os::unix::fs::OpenOptionsExt as _;\n        options.mode(0o600);\n    }\n    let mut file = options.open(path)?;\n    set_owner_only(&file)?;\n    file.write_all(contents)\n}\n\npub fn write_owner_only(path: &Path, contents: &[u8]) -> std::io::Result<()> {\n    let mut options = OpenOptions::new();\n    options.create(true).write(true).truncate(true);\n    #[cfg(unix)]\n    {\n        use std::os::unix::fs::OpenOptionsExt as _;\n        options.mode(0o600);\n    }\n    let mut file = options.open(path)?;\n    set_owner_only(&file)?;\n    file.write_all(contents)\n}\n\n#[cfg(unix)]\nfn set_owner_only(file: &fs::File) -> std::io::Result<()> {\n    use std::os::unix::fs::PermissionsExt as _;\n\n    file.set_permissions(fs::Permissions::from_mode(0o600))\n}\n\n#[cfg(not(unix))]\nfn set_owner_only(_file: &fs::File) -> std::io::Result<()> {\n    Ok(())\n}\n","sourceEncoding":{"utf16CodeUnits":1908,"utf8Bytes":1908,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1908,0,1908,-1],["trivia","comment",0,65,0,65,0],["trivia","whitespace",65,66,65,66,0],["trivia","comment",66,69,66,69,0],["trivia","whitespace",69,70,69,70,0],["trivia","comment",70,143,70,143,0],["trivia","whitespace",143,144,143,144,0],["trivia","comment",144,221,144,221,0],["trivia","whitespace",221,222,221,222,0],["trivia","comment",222,293,222,293,0],["trivia","whitespace",293,294,293,294,0],["trivia","comment",294,373,294,373,0],["trivia","whitespace",373,375,373,375,0],["token","identifier",375,378,375,378,0],["trivia","whitespace",378,379,378,379,0],["token","identifier",379,382,379,382,0],["token","punct",382,384,382,384,0],["token","identifier",384,386,384,386,0],["token","punct",386,388,386,388,0],["group","brace",388,407,388,407,0],["token","delimiter",388,389,388,389,19],["token