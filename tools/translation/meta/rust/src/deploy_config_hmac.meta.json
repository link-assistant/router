TEXT","span":{"start":670,"end":761,"unit":"utf16","byteStart":670,"byteEnd":761},"sha256":"7c008b0df5fb80582c0724aecc3c18b5e28b110422c755f08c7399137c63a5b3","source":"const VALUE_CONTEXT: &[u8] = b\"link-assistant-router/deploy/provider-key-fingerprint/v1\\0\";","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":670,"end":761,"unit":"utf16","byteStart":670,"byteEnd":761}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":761,"end":821,"unit":"utf16","byteStart":761,"byteEnd":821},"sha256":"0a0d4ecbd5a33cdce3d2282fe0b13a6243d3b0d2d09476a471f7e6d996a4d4d2","source":"\n\n/// HMAC-SHA256 of `message` keyed by `key`, hex encoded.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"hmac_sha256_hex","span":{"start":821,"end":1229,"unit":"utf16","byteStart":821,"byteEnd":1229},"sha256":"1689c016e52ac28501ba9214583f20c868b35f5a44aab6f97a77d4bc6a398f7a","source":"#[must_use]\npub fn hmac_sha256_hex(key: &[u8], message: &[u8]) -> String {\n    let signature =\n        jsonwebtoken::crypto::sign(message, &EncodingKey::from_secret(key), Algorithm::HS256)\n            .expect(\"HMAC-SHA256 accepts any key\");\n    let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD\n        .decode(signature)\n        .expect(\"jsonwebtoken returns base64url\");\n    hex::encode(bytes)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":821,"end":1229,"unit":"utf16","byteStart":821,"byteEnd":1229}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1229,"end":1231,"unit":"utf16","byteStart":1229,"byteEnd":1231},"sha256":"75a11