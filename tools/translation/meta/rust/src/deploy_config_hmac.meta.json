e(value.as_bytes());\n        message.push(0);\n    }\n    Some(truncated(token_secret, &message))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1677,"end":2248,"unit":"utf16","byteStart":1677,"byteEnd":2248}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2248,"end":2316,"unit":"utf16","byteStart":2248,"byteEnd":2316},"sha256":"4e5a7efc8ab9d5e9d92ee5922358e123b1986521834fa37c248848c1b184c57a","source":"\n\n/// Fingerprint of one provider key, reported instead of the key.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"value_fingerprint","span":{"start":2316,"end":2532,"unit":"utf16","byteStart":2316,"byteEnd":2532},"sha256":"3f866a5695933f3008c9fe3be78e66bc1a42449c407a6daa0f4b025bafe677ed","source":"#[must_use]\npub fn value_fingerprint(token_secret: &str, value: &str) -> String {\n    let mut message = VALUE_CONTEXT.to_vec();\n    message.extend_from_slice(value.as_bytes());\n    truncated(token_secret, &message)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2316,"end":2532,"unit":"utf16","byteStart":2316,"byteEnd":2532}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2532,"end":2533,"unit":"utf16","byteStart":2532,"byteEnd":2533},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Keyed fingerprints for deploy settings that must never be printed.\n//!\n//! A runtime environment value or a provider key changes the launch\n//! specification, so a deployment must notice the change and reconcile, yet\n//! neither may appear in a container label, a log or the JSON report. Both\n//! are identified by HMAC-SHA256 keyed by the deployment's `TOKEN_SECRET`,\n//! truncated to 128 bits: equal inputs give equal fingerprints, and nobody\n//! without the signing secret can test a guess against one.\n\nuse base64::Engine as _;\nuse jsonwebtoken::{Algorithm, EncodingKey};\n\nconst ENV_CONTEXT: &[u8] = b\"link-assistant-router/deploy/runtime-env-fingerprint/v1\\0\";\nconst VALUE_CONTEXT: &[u8] = b\"link-assistant-router/deploy/provider-key-fingerprint/v1\\0\";\n\n/// HMAC-SHA256 of `message` keyed by `key`, hex encoded.\n#[must_use]\npub fn hmac_sha256_hex(key: &[u8], message: &[u8]) -> String {\n    let signature =\n        jsonwebtoken::crypto::sign(message, &EncodingKey::from_secret(key), Algorithm::HS256)\n            .expect(\"HMAC-SHA256 accepts any key\");\n    let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD\n        .decode(signature)\n        .expect(\"jsonwebtoken returns base64url\");\n    hex::encode(bytes)\n}\n\nfn truncated(key: &str, message: &[u8]) -> String {\n    let digest = hmac_sha256_hex(key.as_bytes(), message);\n    format!(\"hmac-sha256:{}\", &digest[..32])\n}\n\n/// Fingerprint of a runtime environment, `None` when it is empty.\n///\n/// Order-independent: the entries are sorted by name first. `None` for an\n/// empty environment keeps the launch specification of a deployment without\n/// passthrough exactly what it was before passthrough existed.\n#[must_use]\npub fn env_fingerprint(token_secret: &str, entries: &[(String, String)]) -> Option<String> {\n    if entries.is_empty() {\n        return None;\n    }\n    let mut sorted: Vec<&(String, String)> = entries.iter().collect();\n    sorted.sort_by(|left, right| left.0.cmp(&right.0));\n    let mut message = ENV_CONTEXT.to_vec();\n    for (name, value) in sorted {\n        message.extend_from_slice(name.as_bytes());\n        message.push(0);\n        message.extend_from_slice(value.as_bytes());\n        message.push(0);\n    }\n    Some(truncated(token_secret, &message))\n}\n\n/// Fingerprint of one provider key, reported instead of the key.\n#[must_use]\npub fn value_fingerprint(token_secret: &str, value: &str) -> String {\n    let mut message = VALUE_CONTEXT.to_vec();\n    message.extend_from_slice(value.as_bytes());\n    truncated(token_secret, &message)\n}\n","sourceEncoding":{"utf16CodeUnits":2533,"utf8Bytes":2533,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2533,0,2533,-1],["trivia","comment",0,70,0,70,0],["trivia","whitespace",70,71,70,71,0],["trivia","comment",71,74,71,74,0],["trivia","whitespace",74,75,74,75,0],["trivia","comment",75,143,75,143,0],["trivia","whitespace",143,144,143,144,0],["trivia","comment",144,220,144,220,0],["trivia","whitespace",220,221,220,221,0],["trivia","comment",221,296,221,296,0],["trivia","whitespace",296,297,296,297,0],["trivia","comment",297,372,297,372,0],["trivia","whitespace",372,373,372,373,0],["trivia","comment",373,448,373,448,0],["trivia","whitespace",448,449,448,449,0],["trivia","comment",449,509,449,509,0],["trivia","whitespace",509,511,509,511,0],["token","identifier",511,514,511,514,0],["trivia","whitespace",514,515,514,515,0],["token","identifier",515,521,515,521,0],["token","punct",521,523,521,523,0],["token","identifier",523,529,523,529,0],["trivia","whitespace",529,530,529,530,0],["token","identifier",530,532,530,532,0],["trivia","whitespace",532,533,532,533,0],["token","identifier",533,534,533,534,0],["token","punct",534,535,534,535,0],["trivia","whitespace",535,536,535,536,0],["token","identifier",536,539,536,539,0],["trivia","whitespace",539,540,539,540,0],["token","id