"utf16","byteStart":570,"byteEnd":1234},"sha256":"955d2e6455009ac30e313311a97192dceee1e7f83f17924d6a50b3287d8171ee","source":"#[must_use]\npub fn run_in(data_dir: &std::path::Path, op: &crate::cli::TlsOp) -> ExitCode {\n    use crate::cli::TlsOp;\n    let result = match op {\n        TlsOp::Ca { .. } => {\n            crate::tls::read_generated_certificate(data_dir).map(|pem| print!(\"{pem}\"))\n        }\n        TlsOp::Generate { dns, .. } => {\n            crate::tls::ensure_generated(data_dir, &crate::tls::generated_subject_names(dns))\n                .map(|(cert, _)| println!(\"{}\", cert.display()))\n        }\n    };\n    match result {\n        Ok(()) => ExitCode::SUCCESS,\n        Err(message) => {\n            eprintln!(\"error: {message}\");\n            ExitCode::from(1)\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":568,"end":1232,"unit":"utf16","byteStart":570,"byteEnd":1234}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1232,"end":1233,"unit":"utf16","byteStart":1234,"byteEnd":1235},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! `router tls` — manage the certificate a self-signed deployment serves.\n//!\n//! Split from `main.rs` to keep that file within the repository's 1000-line\n//! limit.\n\nuse std::process::ExitCode;\n\nuse crate::config::Config;\n\n/// Manage the self-signed certificate a private deployment serves.\n#[must_use]\npub fn run(config: &Config, op: &crate::cli::TlsOp) -> ExitCode {\n    run_in(std::path::Path::new(&config.data_dir), op)\n}\n\n/// The same command against an explicit data directory, so the behaviour can\n/// be exercised without constructing a whole configuration.\n#[must_use]\npub fn run_in(data_dir: &std::path::Path, op: &crate::cli::TlsOp) -> ExitCode {\n    use crate::cli::TlsOp;\n    let result = match op {\n        TlsOp::Ca { .. } => {\n            crate::tls::read_generated_certificate(data_dir).map(|pem| print!(\"{pem}\"))\n        }\n        TlsOp::Generate { dns, .. } => {\n            crate::tls::ensure_generated(data_dir, &crate::tls::generated_subject_names(dns))\n                .map(|(cert, _)| println!(\"{}\", cert.display()))\n        }\n    };\n    match result {\n        Ok(()) => ExitCode::SUCCESS,\n        Err(message) => {\n            eprintln!(\"error: {message}\");\n            ExitCode::from(1)\n        }\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":1233,"utf8Bytes":1235,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1233,0,1235,-1],["trivia","comment",0,74,0,76,0],["trivia","whitespace",74,75,76,77,0],["trivia","comment",75,78,77,80,0],["trivia","whitespace",78,79,80,81,0],["trivia","comment",79,155,81,157,0],["trivia","whitespace",155,156,157,158,0],["trivia","comment",156,166,158,168,0],["trivia","whitespace",166,168,168,170,0],["token","identifier",168,171,170,173,0],["trivia","whitespace",171,172,173,174,0],["token","identifier",172,175,174,177,0],["token","punct",175,177,177,179,0],["token","identifier",177,184,179,186,0],["token","punct",184,186,186,188,0],["token","identifier",186,194,188,196,0],["token","punct",194,195,196,197,0],["trivia","whitespace",195,197,197,199,0],["token","identifier",197,200,199,202,0],["trivia","whitespace",200,201,202,203,0],["token","identifier",201,206,203,208,0],["token","punct",206,208,208,210,0],["token","identifier",208,214,210,216,0],["token","punct",214,216,216,218,0],["token","identifier",21