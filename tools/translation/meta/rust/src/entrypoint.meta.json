igInt; machine-integer results are range-checked and throw RangeError where Rust would panic"}],"assumptions":[],"mappings":[{"kind":"function","source":"rp_656e747279706f696e742e535441434b5f4259544553","target":"rp_656e747279706f696e742e535441434b5f4259544553","sourceSpan":{"start":1715304,"end":1715309}},{"kind":"function","source":"STACK_BYTES","target":"rp_656e747279706f696e742e535441434b5f4259544553","sourceSpan":{"start":1715304,"end":1715309}}],"params":[],"returns":{"kind":"fixed","bits":64,"signed":false,"rustPrimitiveName":"usize","rustSourceType":true},"project":{"entry":"rust/src/lib.rs","declaration":"entrypoint.STACK_BYTES"}}},{"term":"trivia","name":null,"span":{"start":721,"end":925,"unit":"utf16","byteStart":723,"byteEnd":927},"sha256":"db598d62d89dadca7df3bf5676e1e345d315cb218796976f6b9eeddd4c4b94d9","source":"\n\n/// Run `entry` to completion on a thread with a generous stack.\n///\n/// # Panics\n///\n/// Propagates a panic from the entry point, so a failure surfaces exactly as\n/// it would have on the main thread.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"run_on_a_deep_stack","span":{"start":925,"end":1637,"unit":"utf16","byteStart":927,"byteEnd":1639},"sha256":"c1bca8454b0c853103b00565492ebe84b28756f30b604b5c7ea6bad2b9662da2","source":"#[must_use]\npub fn run_on_a_deep_stack<F, Fut>(entry: F) -> ExitCode\nwhere\n    F: FnOnce() -> Fut + Send + 'static,\n    Fut: Future<Output = ExitCode>,\n{\n    let worker = std::thread::Builder::new()\n        .name(\"router-main\".to_string())\n        .stack_size(STACK_BYTES)\n        .spawn(move || {\n            tokio::runtime::Builder::new_multi_thread()\n                .enable_all()\n                .thread_stack_size(STACK_BYTES)\n                .build()\n                .expect(\"build the tokio runtime\")\n                .block_on(entry())\n        })\n        .expect(\"spawn the entry thread\");\n    match worker.join() {\n        Ok(code) => code,\n        Err(panic) => std::panic::resume_unwind(panic),\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":925,"end":1637,"unit":"utf16","byteStart":927,"byteEnd":1639}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1637,"end":1639,"unit":"utf16","byteStart":1639,"byteEnd":1641},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":1639,"end":1694,"unit":"utf16","byteStart":1641,"byteEnd":1696},"sha256":"4e5702503a21913b8be8a13d86f63c7440be78be320f46711a83db6517955fa0","source":"#[cfg(test)]\n#[path = \"entrypoint_tests.rs\"]\nmod tests;","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":1639,"end":1694},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}},{"name":"path","span":{"start":13,"end":44},"tokens":["#","[","path","=","\"entrypoint_tests.rs\"","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1694,"end":1695,"unit":"utf16","byteStart":1696,"byteEnd":1697},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Running the asynchronous entry point on a stack this crate controls.\n//!\n//! `#[tokio::main]` drives the future on the process main thread, whose size\n//! the linker fixes — 1 MB on Windows. A debug build of the router's entry\n//! future exceeded that, so every subcommand died before doing any work, while\n//! the same binary was fine on Linux and macOS with their 8 MB defaults.\n//!\n//! A thread this crate spawns carries a stack it chooses, which removes the\n//! platform difference rather than trimming the future until it happens to fit.\n\nuse std::future::Future;\nuse std::process::ExitCode;\n\n/// Stack for the thread the entry point runs on, and for runtime workers.\nconst STACK_BYTES: usize = 16 * 1024 * 1024;\n\n/// Run `entry` to completion on a thread with a generous stack.\n///\n/// # Panics\n///\n/// Propagates a panic from the entry point, so a failure surfaces exactly as\n/// it would have on the main thread.\n#[must_use]\npub fn run_on_a_deep_stack<F, Fut>(entry: F) -> ExitCode\nwhere\n    F: FnOnce() -> Fut + Send + 'static,\n    Fut: Future<Output = ExitCode>,\n{\n    let worker = std::thread::Builder::new()\n        .name(\"router-main\".to_string())\n        .stack_size(STACK_BYTES)\n        .spawn(move || {\n            tokio::runtime::Builder::new_multi_thread()\n                .enable_all()\n                .thread_stack_size(STACK_BYTES)\n                .build()\n                .expect(\"build the tokio runtime\")\n                .block_on(entry())\n        })\n        .expect(\"spawn the entry thread\");\n    match worker.join() {\n        Ok(code) => code,\n        Err(panic) => std::panic::resume_unwind(panic),\n    }\n}\n\n#[cfg(test)]\n#[path = \"entrypoint_tests.rs\"]\nmod tests;\n","sourceEncoding":{"utf16CodeUnits":1695,"utf8Bytes":1697,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1695,0,1697,-1],["trivia","comment",0,72,0,72,0],["trivia","whitespace",72,73,72,73,0],["trivia","comment",73,76,73,76,0],["trivia","whitespace",76,77,76,77,0],["trivia","comment",77,154,77,15