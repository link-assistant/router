bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":3,"preserved":4},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":42,"unit":"utf16","byteStart":0,"byteEnd":42},"sha256":"122656cccd553fc6822686da7081caeba8d4c806df6b18a2cb531185506a0658","source":"//! Unit tests for [`crate::env_paths`].\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":42,"end":55,"unit":"utf16","byteStart":42,"byteEnd":55},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":42,"end":55},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":55,"end":398,"unit":"utf16","byteStart":55,"byteEnd":402},"sha256":"40241696b79133615b46d0f61b5add3ffd890d98559ce961e3b71de4cb2c3be7","source":"\n\n/// A set-but-empty variable is unset, not configured.\n///\n/// `var_os` returns `Some(\"\")` for it, which was taken as a root: the config\n/// root became the empty string, every state path turned relative, and the\n/// router wrote `server.json` — holding a live `la_sk_` token — into whatever\n/// directory the command ran from (issue #340).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_empty_variable_reads_as_unset","span":{"start":398,"end":1057,"unit":"utf16","byteStart":402,"byteEnd":1061},"sha256":"4dbe98cc74cb58e63428ec20e7ba3b3e1a75d58540600f5fdfd61afe9ef10374","source":"#[test]\nfn an_empty_variable_reads_as_unset() {\n    let value = |text: &str| Some(std::ffi::OsString::from(text));\n\n    assert_eq!(\n        from_value(value(\"/tmp/configured\")),\n        Some(PathBuf::from(\"/tmp/configured\")),\n        \"a real value is still read\"\n    );\n    assert_eq!(\n        from_value(value(\"\")),\n        None,\n        \"an empty value must fall through to the next candidate\"\n    );\n    assert_eq!(from_value(None), None, \"an unset value is unset\");\n    // The point of the fix: empty and absent are now indistinguishable, so an\n    // `or_else` chain behaves the same either way.\n    assert_eq!(from_value(value(\"\")), from_value(None));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":398,"end":404},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1057,"end":1307,"unit":"utf16","byteStart":1061,"byteEnd":1313},"sha256":"d2da5dcbb35fc2d704e4e9b13a77ef75edebf3f6e95008bbda03e3471c531508","source":"\n\n/// A relative root is refused rather than used.\n///\n/// Whatever combination of variables produced it, a root that is not absolute\n/// is a broken environment — and failing loudly beats writing a credential\n/// into the process working directory.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_relative_root_is_refused_rather_than_written_to","span":{"start":1307,"end":2452,"unit":"utf16","byteStart":1313,"byteEnd":2458},"sha256":"e47fd931e961a0495d03ca9a7afe52f5ec97dce475fc2d2617af9061809d1aef","source":"#[test]\nfn a_relative_root_is_refused_rather_than_written_to() {\n    // What counts as absolute is platform-specific: a leading slash is enough\n    // on unix, while Windows wants a drive or a UNC prefix.\n    let rooted = if cfg!(windows) {\n        r\"C:\\ProgramData\\router\"\n    } else {\n        \"/var/lib/router\"\n    };\n    let absolute =\n        require_absolute(PathBuf::from(rooted), \"the state directory\").expect(\"a rooted path\");\n    assert_eq!(absolute, PathBuf::from(rooted));\n\n    // Relative under either set of rules. `/var/lib/router` is deliberately\n    // absent: it is absolute on unix and relative on Windows, so it belongs to\n    // neither list.\n    for relative in [\"\", \"link-assistant-router\", \".config\", \"./state\", \"../up\"] {\n        let refused = require_absolute(PathBuf::from(relative), \"the state directory\")\n            .expect_err(\"a relative root must be refused\");\n        assert!(\n            refused.contains(\"relative\"),\n            \"the refusal must say why: {refused}\"\n        );\n        assert!(\n            refused.contains(\"XDG_CONFIG_HOME\"),\n            \"and name where to look: {refused}\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1307,"end":1313},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2452,"end":2453,"unit":"utf16","byteStart":2458,"byteEnd":2459},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Unit tests for [`crate::env_paths`].\n\nuse super::*;\n\n/// A set-but-empty variable is unset, not configured.\n///\n/// `var_os` returns `Some(\"\")` for it, which was taken as a root: the config\n/// root became the empty string, every state path turned relative, and the\n/// router wrote `server.json` — holding a live `la_sk_` token — into whatever\n/// directory the command ran from (issue #340).\n#[test]\nfn an_empty_variable_reads_as_unset() {\n    let value = |text: &str| Some(std::ffi::OsString::from(text));\n\n    assert_eq!(\n        from_value(value(\"/tmp/configured\")),\n        Some(PathBuf::from(\"/tmp/configured\")),\n        \"a real value is still read\"\n    );\n    assert_eq!(\n        from_value(value(\"\")),\n        None,\n        \"an empty value must fall through to the next candidate\"\n    );\n    assert_eq!(from_value(None), None, \"an unset value is unset\");\n    // The point of the fix: empty and absent are now indistinguishable, so an\n    // `or_else` chain behaves the same either way.\n    assert_eq!(from_value(value(\"\")), from_value(None));\n}\n\n/// A relative root is refused rather than used.\n///\n/// Whatever combination of variables produced it, a root that is not absolute\n/// is a broken environment — and failing loudly beats writing a credential\n/// into the process working directory.\n#[test]\nfn a_relative_root_is_refused_rather_than_written_to() {\n    // What counts as absolute is platform-specific: a leading slash is enough\n    // on unix, while Windows wants a drive or a UNC prefix.\n    let rooted = if cfg!(windows) {\n        r\"C:\\ProgramData\\router\"\n    } else {\n        \"/var/lib/router\"\n    };\n    let absolute =\n        require_absolute(PathBuf::from(rooted), \"the state directory\").expect(\"a rooted path\");\n    assert_eq!(absolute, PathBuf::from(rooted));\n\n    // Relative under either set of rules. `/var/lib/router` is deliberately\n    // absent: it is absolute on unix and relative on Windows, so it belongs to\n    // neither list.\n    for relative in [\"\", \"link-assistant-router\", \".config\", \"./state\", \"../up\"] {\n        let refused = require_absolute(PathBuf::from(relative), \