iguration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":385,"end":528,"unit":"utf16","byteStart":385,"byteEnd":530},"sha256":"0794add5573029a087ddfad3c9d615e74f1b833bb109b2da46e382b95bf0526c","source":"\n\n/// `GET /api/management/emergency-auth` — whether the mode is on, when it\n/// lapses, and how many requests it admitted, by bypassed check.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"emergency_status","span":{"start":528,"end":727,"unit":"utf16","byteStart":530,"byteEnd":729},"sha256":"4afe397e3e76acb9e1ba48192cbd761e92f64861475ce508bd8539a6ee75f512","source":"pub async fn emergency_status(State(state): State<AppState>) -> Response {\n    (\n        StatusCode::OK,\n        axum::Json(state.token_manager.emergency().status()),\n    )\n        .into_response()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":528,"end":727,"unit":"utf16","byteStart":530,"byteEnd":729}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":727,"end":995,"unit":"utf16","byteStart":729,"byteEnd":999},"sha256":"7742e9a4d3efe4d3dfb09fde2189de23629f778d54a209c1f8d65f7abc0ca97e","source":"\n\n/// `POST /api/management/emergency-auth/disable` — turn the mode off at once.\n///\n/// Normal checks apply to the very next request. There is deliberately no\n/// matching `enable` endpoint: turning the mode on needs operator access to\n/// the process configuration.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"emergency_disable","span":{"start":995,"end":1495,"unit":"utf16","byteStart":999,"byteEnd":1499},"sha256":"bd288d51a4e8550892d33c837f1116ec3beadd5bc51517056fdf26cb42bf7d01","source":"pub async fn emergency_disable(State(state): State<AppState>) -> Response {\n    let was_active = state.token_manager.emergency().disable();\n    if was_active {\n        tracing::warn!(\"Emergency any-token mode disabled through the management API\");\n    }\n    (\n        StatusCode::OK,\n        axum::Json(serde_json::json!({\n            \"disabled\": true,\n            \"was_active\": was_active,\n            \"status\": state.token_manager.emergency().status(),\n        })),\n    )\n        .into_response()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":995,"end":1495,"unit":"utf16","byteStart":999,"byteEnd":1499}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1495,"end":1662,"unit":"utf16","byteStart":1499,"byteEnd":1668},"sha256":"8fac7f2a080834539e40b52538918d1f63577b52dbdbc6435f70a8a82ea81b95","source":"\n\n/// `GET /api/management/auth/diagnostics` — token authentication failures by\n/// reason plus the most recent ones, identified by fingerprint and token id\n/// only.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"auth_diagnostics","span":{"start":1662,"end":2009,"unit":"utf16","byteStart":1668,"byteEnd":2015},"sha256":"f911800c5ded6a4b2582d7b5198b66985e71ad9d517850ecc157fdba53753b54","source":"pub async fn auth_diagnostics(State(state): State<AppState>) -> Response {\n    (\n        StatusCode::OK,\n        axum::Json(crate::translation_core::json!({\n            \"diagnostics\": state.token_manager.diagnostics().snapshot(),\n            \"emergency_auth\": state.token_manager.emergency().status(),\n        })),\n    )\n        .into_response()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1662,"end":2009,"unit":"utf16","byteStart":1668,"byteEnd":2015}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2009,"end":2123,"unit":"utf16","byteStart":2015,"byteEnd":2129},"sha256":"4c7409d0a3ea1969d09191a832ae285cd7a5539a7fbfc7bdf182e2a5ef5ed51b","source":"\n\n/// Value of the [`crate::emergency_auth::HEALTH_HEADER`] liveness header, or\n/// `None` while the mode is off.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"health_header","span":{"start":2123,"end":2382,"unit":"utf16","byteStart":2129,"byteEnd":2388},"sha256":"685aa6b9facc69ca3407f4eff4732f95f029d777d3f21da97efa521f009bcaa5","source":"#[must_use]\npub fn health_header(state: &AppState) -> crate::translation_core::Maybe<String> {\n    state\n        .token_manager\n        .emergency()\n        .active_until()\n        .map(|until| crate::translation_core::format!(\"active; expires_at={until}\"))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2123,"end":2382,"unit":"utf16","byteStart":2129,"byteEnd":2388}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2382,"end":2383,"unit":"utf16","byteStart":2388,"byteEnd":2389},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Admin-protected endpoints for the emergency any-token mode (issue #645)\n//! and the token authentication diagnostics (issue #644).\n//!\n//! Every handler here is mounted behind `authenticate_admin_route`, which the\n//! emergency mode never relaxes.\n\nuse axum::extract::State;\nuse axum::http::StatusCode;\nuse axum::response::{IntoResponse, Response};\n\nuse crate::app_state::AppState;\n\n/// `GET /api/management/emergency-auth` — whether the mode is on, when it\n/// lapses, and how many requests it admitted, by bypassed check.\npub async fn emergency_status(State(state): State<AppState>) -> Response {\n    (\n        StatusCode::OK,\n        axum::Json(state.token_manager.emergency().status()),\n    )\n        .into_response()\n}\n\n/// `POST /api/management/emergency-auth/disable` — turn the mode off at once.\n///\n/// Normal checks apply to the very next request. There is deliberately no\n/// matching `enable` endpoint: turning the mode on needs operator access to\n/// the process configuration.\npub async fn emergency_disable(State(state): State<AppState>) -> Response {\n    let was_active = state.token_manager.emergency().disable();\n    if was_active {\n        tracing::warn!(\"Emergency any-token mode disabled through the management API\");\n    }\n    (\n        StatusCode::OK,\n        axum::Json(serde_json::json!({\n            \"disabled\": true,\n            \"was_active\": was_active,\n            \"status\": state.token_manager.emergency().status(),\n        })),\n    )\n        .into_response()\n}\n\n/// `GET /api/management/auth/diagnostics` — token authentication failures by\n/// reason plus the most recent ones, identified by fingerprint and token id\n/// only.\npub async fn auth_diagnostics(State(state): State<AppState>) -> Response {\n    (\n        StatusCode::OK,\n        axum::Json(crate::translation_core::json!({\n            \"diagnostics\": state.token_manager.diagnostics().snapshot(),\n            \"emergency_auth\": state.token_manager.emergency().status(),\n        })),\n    )\n        .into_response()\n}\n\n/// Value of the [`crate::emergency_auth::HEALTH_HEADER`] liveness header, or\n/// `None` while the mode is off.\n#[must_use]\npub fn health_header(state: &AppState) -> crate::translation_core::Maybe<String> {\n    state\n        .token_manager\n        .emergency()\n        .active_until()\n        .map(|until| crate::translation_core::format!(\"active; expires_at={until}\"))\n}\n","sourceEncoding":{"utf16CodeUnits":2383,"utf8Bytes":2389,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2383,0,2389,-1],["trivia","comment",0,75,0,75,0],["trivia","whitespace",75,76,75,76,0],["trivia","comment",76,134,76,134,0],["trivia","whitespace",134,135,134,135,0],["trivia","comment",135,138,135,138,0],["trivia","whitespace",138,139,138,139,0],["trivia","comment",139,217,139,217,0],["trivia","whitespace",217,218,217,218,0],["trivia","comment",218,251,218,251,0],["trivia","whitespace",251,253,251,253,0],["token","identifier",253,256,253,256,0],["trivia","whitespace",256,257,256,257,0],["token","identifier",257,261,257,261,0],["token","punct",261,263,261,263,0],["token","identifier",263,270,263,270,0],["token","punct",270,272,270,272,0],["token","identifier",272,277,272,277,0],["token","punct",277,278,277,278,0],["trivia","whitespace",278,279,278,279,0],["token","identifier",279,282,279,282,0],["trivia","whitespace",282,283,282,283,0],["token","identifier",283,287,283,287,0],["token","punct",287,289,287,289,0],["token","identifier",289,293,289,293,0],["token","punct",293,295,293,295,0],["token","identifier",295,305,295,305,0],["token","punct",305,306,305,306,0],["trivia","whitespace",306,307,306,307,0],["token","identifier",307,310,307,310,0],["trivia","whitespace",310,311,310,311,0],["token","identifier",311,315,311,315,0],["token","punct",315,317,315,317,0],["token","identifier",317,325,317,325,0],["token","punct",325,327,325,327,0],["group","brace",327,351,327,351,0],["token","delimiter",327,328,327,328,35],["token","identifier",328,340,328,340,35],["token","punct",340,341,340,341,35],["trivia","whitespace",341,342,341,342,35],["token","identifier",342,350,342,350,35],["token","delimiter",350,351,350,351,35],["token","punct",351,352,351,352,0],["trivia","whitespace",352,354,352,354,0],["token","identifier",354,357,354,357,0],["trivia","whitespace"