 body_fields: &[&str],\n) {\n    tracing::debug!(\n        \"{provider} token exchange: {}\",\n        exchange_shape(token_url, content_type, headers, body_fields)\n    );\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1078,"end":1394,"unit":"utf16","byteStart":1080,"byteEnd":1396}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1394,"end":1468,"unit":"utf16","byteStart":1396,"byteEnd":1470},"sha256":"bd51828712547c38296c2148888be38b26782d192a6915c70d78895aa183d8e5","source":"\n\n/// Render one exchange as method, URL, headers and body field *names*.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"exchange_shape","span":{"start":1468,"end":1937,"unit":"utf16","byteStart":1470,"byteEnd":1939},"sha256":"16e717d2e0bffba6b2999f2799fcbff4bcb087aeedd84e9ce2672a969a415650","source":"fn exchange_shape(\n    token_url: &str,\n    content_type: &str,\n    headers: &[(String, String)],\n    body_fields: &[&str],\n) -> String {\n    let mut sent = vec![format!(\"content-type: {content_type}\")];\n    sent.extend(\n        headers\n            .iter()\n            .map(|(name, value)| format!(\"{name}: {value}\")),\n    );\n    format!(\n        \"POST {token_url} [{}] body fields [{}] (values omitted)\",\n        sent.join(\", \"),\n        body_fields.join(\", \")\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1468,"end":1937,"unit":"utf16","byteStart":1470,"byteEnd":1939}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1937,"end":2270,"unit":"utf16","byteStart":1939,"byteEnd":2272},"sha256":"3b5f5df52c7f965e3a9097cdbf6a4b6f9ed17c4d7ed918df05cb8bc14257a3b8","source":"\n\n/// The exchange the router itself would send for `provider`, without sending it.\n///\n/// Built from the same configuration `refresh_at` uses, so a fallback record\n/// can be compared against what the vendor's own client does: if the two send\n/// different headers, the journal shows it without further debugging (issue\n/// #239).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"direct_exchange_shape","span":{"start":2270,"end":2848,"unit":"utf16","byteStart":2272,"byteEnd":2850},"sha256":"8c7010d36efaf44b882f472702215b563ee9411ad7eefe4936b17a8e34337386","source":"#[must_use]\npub fn direct_exchange_shape(provider: SubscriptionProvider) -> String {\n    let config = refresh_config(provider);\n    let headers = super::refresh_headers(provider);\n    let content_type = match config.style {\n        BodyStyle::Json => \"application/json\",\n        BodyStyle::Form => \"application/x-www-form-urlencoded\",\n    };\n    let mut fields = vec![\"grant_type\", \"refresh_token\", \"client_id\"];\n    if provider == SubscriptionProvider::Gemini {\n        fields.push(\"client_secret\");\n    }\n    exchange_shape(config.token_url, content_type, &headers, &fields)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2270,"end":2848,"unit":"utf16","byteStart":2272,"byteEnd":2850}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2848,"end":3108,"unit":"utf16","byteStart":2850,"byteEnd":3110},"sha256":"f4f23481b94bab3b4935941a64d3931b7eb6c48c6447c1719fbd25f434ed59a3","source":"\n\n/// Record which fields a successful token response carried.\n///\n/// Field names only: whether `refresh_token` came back at all is the difference\n/// between a rotating and a non-rotating vendor, and that is exactly what a\n/// later diagnosis needs to know.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"journal_response","span":{"start":3108,"end":3496,"unit":"utf16","byteStart":3110,"byteEnd":3498},"sha256":"e9bb3e2900dabd616297802d6ecceb172c9060403fcdf57d0026a2e29d00c8bf","source":"pub(super) fn journal_response(\n    provider: SubscriptionProvider,\n    status: u16,\n    document: &serde_json::Value,\n) {\n    let fields = document.as_object().map_or_else(\n        || String::from(\"<not an object>\"),\n        |map| map.keys().cloned().collect::<Vec<_>>().join(\", \"),\n    );\n    tracing::debug!(\"{provider} token exchange answered HTTP {status} with fields [{fields}]\");\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":3108,"end":3496,"unit":"utf16","byteStart":3110,"byteEnd":3498}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3496,"end":3497,"unit":"utf16","byteStart":3498,"byteEnd":3499},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! The protocol journal: what a token exchange looked like, never what it carried.\n//!\n//! These OAuth endpoints are undocumented, change without notice, and attest\n//! their clients — so a refresh that works in one particular shape and fails in\n//! another is a thing an operator must be able to see from the log alone,\n//! without a packet capture (issue #239).\n//!\n//! Everything here records *shape*: method, URL, header names with their\n//! non-secret values, and body field names. Values are the secrets and are\n//! never written.\n\nuse super::{BodyStyle, refresh_config};\nuse crate::subscription::SubscriptionProvider;\n\n/// Record the *shape* of an outbound token exchange, never its contents.\n///\n/// These OAuth endpoints are undocumented and attest their clients, so when a\n/// refresh only succeeds in one particular shape an operator needs to be able\n/// to reproduce that shape from the log alone. Header names with their\n/// (non-secret) values and body field *names* are enough to do that; the field\n/// values are the secrets and are never written (issue #239).\npub(super) fn journal_request(\n    provider: SubscriptionProvider,\n    token_url: &str,\n    content_type: &str,\n    headers: &[(String, String)],\n    body_fields: &[&str],\n) {\n    tracing::debug!(\n        \"{provider} token exchange: {}\",\n        exchange_shape(token_url, content_type, headers, body_fields)\n    );\n}\n\n/// Render one exchange as method, URL, headers and body field *names*.\nfn exchange_shape(\n    token_url: &str,\n    content_type: &str,\n    headers: &[(String, String)],\n    body_fields: &[&str],\n) -> String {\n    let mut sent = vec![format!(\"content-type: {content_type}\")];\n    sent.extend(\n        headers\n            .iter()\n            .map(|(name, value)| format!(\"{name}: {value}\")),\n    );\n    format!(\n        \"POST {token_url} [{}] body fields [{}] (values omitted)\",\n        sent.join(\", \"),\n        body_fields.join(\", \")\n    )\n}\n\n/// The exchange the router itself would send for `provider`, without sending it.\n///\n/// Built from the same configuration `refresh_at` uses, so a fallback record\n/// can be compared against what the vendor's own client does: if the two send\n/// different headers, the journal shows it without further debugging (issue\n/// #239).\n#[must_use]\npub fn direct_exchange_shape(provider: SubscriptionProvider) -> String {\n    let config = refresh_config(provider);\n    let headers = super::refresh_headers(provider);\n    let content_type = match config.style {\n        BodyStyle::Json => \"application/json\",\n        BodyStyle::Form => \"application/x-www-form-urlencoded\",\n    };\n    let mut fields = vec![\"grant_type\", \"refresh_token\", \"client_id\"];\n    if provider == SubscriptionProvider::Gemini {\n        fields.push(\"client_secret\");\n    }\n    exchange_shape(config.token_url, content_type, &headers, &fields)\n}\n\n/// Record which fields a successful token response carried.\n///\n/// Field names only: whether `refresh_token` came back at all is the difference\n/// between a rotating and a non-rotating vendor, and that is exactly what a\n/// later diagnosis needs to know.\npub(super) fn journal_response(\n    provider: SubscriptionProvider,\n    status: u16,\n    document: &serde_json::Value,\n) {\n    let fields = document.as_object().map_or_else(\n        || String::from(\"<not an object>\"),\n        |map| map.keys().cloned().collect::<Vec<_>>().join(\", \"),\n    );\n    tracing::debug!(\"{provider} token exchange answered HTTP {status} with fields [{fields}]\");\n}\n","sourceEncoding":{"utf16CodeUnits":3497,"utf8Bytes":3499,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,3497,0,3499,-1],["trivia","comment",0,83,0,83,0],["trivia","whitespace",83,84,83,84,0],["trivia","comment",84,87,84,87,0],["trivia","whitespace",87,88,87,88,0],["trivia","comment",88,165,88,165,0],["trivia","whitespace",165,166,165,166,0],["trivia","comment",166,246,166,248,0],["trivia","whitespace",246,247,248,249,0],["trivia","comment",247,321,249,323,0],["trivia","whitespace",321,322,323,324,0],["trivia","comment",322,364,324,366,0],["trivia","whitespace",364,365,366,367,0],["trivia","comment",365,368,367,370,0],["trivia","whitespace",368,369,370,371,0],["trivia","comment",369,442,371,444,0],["trivia","whitespace",442,443,444,445,0],["trivia","comment",443,518,445,520,0],["trivia","whitespace",518,519,520,521,0],["trivia","comment",519,537,521,539,0],["trivia","whitespace",537,539,539,541,0],["token