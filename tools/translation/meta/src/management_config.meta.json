":"draft item impl: no supported library declaration emission","span":{"start":790,"end":1899},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1899,"end":1901,"unit":"utf16","byteStart":1899,"byteEnd":1901},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"integer","span":{"start":1901,"end":2169,"unit":"utf16","byteStart":1901,"byteEnd":2169},"sha256":"09f693504aecbf516e7c5a6e3f06bd13b1a25faedbc96f887ab67cc1e4fb865d","source":"fn integer<T: std::str::FromStr>(name: &str, default: T) -> Result<T, String> {\n    crate::operation_context::var(name).map_or(Ok(default), |value| {\n        value\n            .parse()\n            .map_err(|_| format!(\"{name} must be a non-negative integer\"))\n    })\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"generic function: generic signatures require monomorphization","span":{"start":1901,"end":1912},"details":{"construct":"generic function"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2169,"end":2171,"unit":"utf16","byteStart":2169,"byteEnd":2171},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"boolean","span":{"start":2171,"end":2546,"unit":"utf16","byteStart":2171,"byteEnd":2546},"sha256":"5d85b55d032c38caeef2c1e18641a34507dbe629bfe4cce322de8900dd6251dc","source":"fn boolean(name: &str, default: bool) -> Result<bool, String> {\n    crate::operation_context::var(name).map_or(Ok(default), |value| {\n        match value.to_ascii_lowercase().as_str() {\n            \"true\" | \"1\" | \"yes\" | \"on\" => Ok(true),\n            \"false\" | \"0\" | \"no\" | \"off\" => Ok(false),\n            _ => Err(format!(\"{name} must be true or false\")),\n        }\n    })\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown name crate.operation_context.var","span":{"start":2239,"end":2274},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2546,"end":2612,"unit":"utf16","byteStart":2546,"byteEnd":2612},"sha256":"a938ff18843bd2db198f70d7d3f0d3aa37b3cfb27b8707b268ca3a148455f527","source":"\n\n/// Published examples are unsafe even if intentionally copied.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"is_example_secret","span":{"start":2612,"end":3290,"unit":"utf16","byteStart":2612,"byteEnd":3290},"sha256":"bd9310efc1ed76f336b15c29024ab3298073aa45779a9bc0396bccd3ca3d6d99","source":"#[must_use]\npub fn is_example_secret(secret: &str) -> bool {\n    matches!(\n        secret.trim(),\n        \"your-secure-secret-here\"\n            | \"your-secure-secret\"\n            | \"your-router-token-secret\"\n            | \"your-secret-key\"\n            | \"your-secret\"\n            | \"your-admin-key\"\n            | \"your-admin-secret\"\n            | \"your-admin-key-here\"\n            | \"your-token-admin-key\"\n            | \"a-long-random-secret\"\n            | \"example-shared-signing-secret\"\n            | \"test-secret\"\n            | \"change-me\"\n            | \"changeme\"\n            | \"replace-me\"\n            | \"admin-secret\"\n    ) || crate::token_secret::is_placeholder(secret)\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"operator |: bitwise operators are outside the portable core","span":{"start":2756,"end":2757},"details":{"construct":"operator |"}},"comment":false},{"term":"trivia","name":null,"span":{"start":3290,"end":3292,"unit":"utf16","byteStart":3290,"byteEnd":3292},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":3292,"end":3354,"unit":"utf16","byteStart":3292,"byteEnd":3354},"sha256":"c8104bf522033e00d7e50621a19246643ca8de4db9cc8b72229348e47963f81e","source":"#[cfg(test)]\n#[path = \"management_co