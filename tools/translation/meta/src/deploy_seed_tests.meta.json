thing_is_written() {\n    let home = tempfile::tempdir().unwrap();\n    let error = prepare(SeedProvider::Codex, home.path(), \"far\", SECRET).unwrap_err();\n    assert!(error.starts_with(\"--seed-credential codex\"), \"{error}\");\n    // The vendor reader takes its transaction lock; no credential is written.\n    let written: Vec<_> = walk(home.path())\n        .into_iter()\n        .filter(|path| path.extension().is_none_or(|extension| extension != \"lock\"))\n        .collect();\n    assert!(written.is_empty(), \"{written:?}\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":3932,"end":3938},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":4501,"end":4503,"unit":"utf16","byteStart":4501,"byteEnd":4503},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"walk","span":{"start":4503,"end":4866,"unit":"utf16","byteStart":4503,"byteEnd":4866},"sha256":"a596d83f49933ced445d0b42a7ac7fae860516f3a18f24b30537e729146273a3","source":"fn walk(dir: &std::path::Path) -> Vec<std::path::PathBuf> {\n    std::fs::read_dir(dir)\n        .into_iter()\n        .flatten()\n        .flatten()\n        .flat_map(|entry| {\n            let path = entry.path();\n            if path.is_dir() {\n                walk(&path)\n            } else {\n                vec![path]\n            }\n        })\n        .collect()\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"std::fs::read_dir: the standard library is outside the portable core","span":{"start":4567,"end":4598},"details":{"construct":"std::fs::read_dir"}},"comment":false},{"term":"trivia","name":null,"span":{"start":4866,"end":4867,"unit":"utf16","byteStart":4866,"byteEnd":4867},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","sou