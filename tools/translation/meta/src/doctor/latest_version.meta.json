de_json.error.Category.Eof","sourceSpan":{"start":147,"end":147}}],"params":[],"returns":{"kind":"string"}}},{"term":"trivia","name":null,"span":{"start":242,"end":323,"unit":"utf16","byteStart":242,"byteEnd":323},"sha256":"51c1b072237f6c8020b123f5a383db3e9c38d20ec496a0679bbe242586f2bf0f","source":"\n\n/// Check the latest stable GitHub release without sending Router credentials.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"latest_version","span":{"start":323,"end":442,"unit":"utf16","byteStart":323,"byteEnd":442},"sha256":"7b67af1dc6a063fa2dabfdcc2e6b43d4cf0823f893fece1c69cae856599995e9","source":"pub async fn latest_version(client: &reqwest::Client) -> Result<Value, String> {\n    fetch(client, RELEASE_API).await\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown type crate.Value","span":{"start":387,"end":392},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":442,"end":444,"unit":"utf16","byteStart":442,"byteEnd":444},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"fetch","span":{"start":444,"end":1915,"unit":"utf16","byteStart":444,"byteEnd":1915},"sha256":"b7e0a48d2adfa523e6a485f8519a98c6493b9112ff3d6137a5150bfe82e3351b","source":"async fn fetch(client: &reqwest::Client, endpoint: &str) -> Result<Value, String> {\n    let response = client\n        .get(endpoint)\n        .header(\n            \"user-agent\",\n            format!(\"link-assistant-router/{}\", crate::VERSION),\n        )\n        .header(\"accept\", \"application/vnd.github+json\")\n        .timeout(std::time::Duration::from_secs(10))\n        .send()\n        .await\n        .and_then(reqwest::Response::error_for_status)\n        .map_err(|e| e.to_string())?;\n    let mut stream = response.bytes_stream();\n    let mut body = Vec::new();\n    while let Some(chunk) = stream.next().await {\n        let chunk = chunk.map_err(|e| e.to_string())?;\n        if body.len().saturating_add(chunk.len()) > 64 * 1024 {\n            return Err(\"release response exceeds limit\".into());\n        }\n        body.extend_from_slice(&chunk);\n    }\n    let release: Value = serde_json::from_slice(&body).map_err(|e| e.to_string())?;\n    let tag = release[\"tag_name\"].as_str().ok_or(\"release tag missing\")?;\n    let latest = tag.strip_prefix('v').unwrap_or(tag);\n    let latest_parts = parts(latest).ok_or(\"invalid stable release version\")?;\n    let current_parts = parts(crate::VERSION).ok_or(\"invalid current version\")?;\n    Ok(\n        json!({\"current_version\": crate::VERSION, \"latest_version\": latest,\n        \"update_available\": latest_parts > current_parts,\n        \"release_url\": format!(\"https://github.com/link-assistant/router/releases/tag/{tag}\")}),\n    )\n}","status":"carried","diagnostic":{"kind":"syntax","message":"expected { in block but found \"Some\"","span":{"start":1020,"end":1024},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1915,"end":1917,"unit":"utf16","byteStart":1915,"byteEnd":1917},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parts","span":{"start":1917,"end":2117,"unit":"utf16","byteStart":1917,"byteEnd":2117},"sha256":"41b708b365d578214eaeecaa19f113dae14d0d167fcfc6829f6b8208cb4aa26b","source":"fn parts(version: &str) -> Option<[u64; 3]> {\n    let parts = version\n        .split('.')\n        .map(str::parse)\n        .collect::<Result<Vec<u64>, _>>()\n        .ok()?;\n    parts.try_into().ok()\n}","status":"carried","diagnostic":{"kind":"syntax","message":"expected ] in immutable slice but found \";\"","span":{"start":1955,"end":1956},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2117,"end":2119,"unit":"utf16","byteStart":2117,"byteEnd":2119},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":2119,"end":3386,"unit":"utf16","byteStart":2119,"byteEnd":3386},"sha256":"ecfabf68b9af314a768c9c27e7516bd3fe00014c938ff78bda3e4c101e72d77c","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n    #[tokio::test]\n    async fn version_check_uses_http_status_and_validates_the_release_tag() {\n        for (status, body, expected) in [\n            (200, r#\"{\"tag_name\":\"v999.0.0\"}\"#, true),\n            (200, r#\"{\"tag_name\":\"v0.1.0\"}\"#, true),\n            (200, r#\"{\"tag_name\":\"invalid\"}\"#, false),\n            (502, \"failed\", false),\n        ] {\n            let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n            let url = format!(\"http://{}\", listener.local_addr().unwrap());\n            let app = axum::Router::new().route(\n                \"/\",\n                axum::routing::get(move || async move {\n                    (axum::http::StatusCode::from_u16(status).unwrap(), body)\n                }),\n            );\n            let server = tokio::spawn(async move {\n                axum::serve(listener, app).await.unwrap();\n            });\n            let result = fetch(&reqwest::Client::new(), &url).await;\n            assert_eq!(result.is_ok(), expected, \"{result:?}\");\n            if let Ok(result) = result {\n                assert_eq!(result[\"update_available\"], body.contains(\"999\"));\n            }\n            server.abort();\n            let _ = server.await;\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item mod: no supported library declaration emission","span":{"start":2119,"end":3386},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":3386,"end":3387,"unit":"utf16","byteStart":3386,"byteEnd":3387},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
