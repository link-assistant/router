ct":{"entry":"src/lib.rs","declaration":"thinking.policy.keys"}}},{"term":"trivia","name":null,"span":{"start":1159,"end":1316,"unit":"utf16","byteStart":1159,"byteEnd":1316},"sha256":"32b8c9ebb7904faf08fb9bff037a2e0b519275db60ec38cbfdad2dddfc1bb948","source":"\n\n/// Capture before the first account can clamp or drop controls, even if its\n/// catalog is unknown. Later attempts must not replace this original intent.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"remember","span":{"start":1316,"end":1983,"unit":"utf16","byteStart":1316,"byteEnd":1983},"sha256":"df1103a957de7830637c763564781b1f7a6b0180ef16655dc08088954ef5d7ce","source":"pub(super) fn remember(\n    body: &Value,\n    protocol: ThinkingProtocol,\n    origin: ThinkingProtocol,\n    from_suffix: bool,\n) {\n    if let Some(scope) = crate::account_policy_scope::current() {\n        scope\n            .thinking\n            .lock()\n            .unwrap_or_else(std::sync::PoisonError::into_inner)\n            .get_or_insert_with(|| RetryControls {\n                fields: keys(protocol)\n                    .iter()\n                    .filter_map(|key| body.get(*key).map(|value| ((*key).into(), value.clone())))\n                    .collect(),\n                protocol,\n                origin,\n                from_suffix,\n            });\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1316,"end":1983,"unit":"utf16","byteStart":1316,"byteEnd":1983}},"comment":false},{"term":"trivia","name":null,"span":{"start":1983,"end":2138,"unit":"utf16","byteStart":1983,"byteEnd":2138},"sha256":"8259196ed62ac31cfd3736cf7ecaf36b92f98f66100c1791490b424e66f62123","source":"\n\n/// Restore target controls after account-bound history is stripped, then use\n/// the newly selected account's exact capability evidence before sending.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"revalidate","span":{"start":2138,"end":3877,"unit":"utf16","byteStart":2138,"byteEnd":3877},"sha256":"e662a49b1d6e3d20dbfdec21f6b21e560fd60518f7d496a6710addde6236c18e","source":"pub fn revalidate(\n    scope: &crate::account_policy_scope::PolicyRequest,\n    selected: &crate::accounts::SelectedSubscriptionAccount,\n    body: &mut Value,\n    model: &str,\n) -> Result<(), String> {\n    let controls = scope\n        .thinking\n        .lock()\n        .unwrap_or_else(std::sync::PoisonError::into_inner)\n        .clone();\n    let Some(controls) = controls else {\n        return Ok(());\n    };\n    let body = if matches!(\n        controls.protocol,\n        ThinkingProtocol::Gemini | ThinkingProtocol::Vertex\n    ) && body.get(\"request\").is_some_and(Value::is_object)\n    {\n        body.get_mut(\"request\").expect(\"Code Assist request object\")\n    } else {\n        body\n    };\n    if let Some(object) = body.as_object_mut() {\n        for key in keys(controls.protocol) {\n            match controls.fields.get(*key) {\n                Some(value) => {\n                    object.insert((*key).into(), value.clone());\n                }\n                None => {\n                    object.remove(*key);\n                }\n            }\n        }\n    }\n    let provider = scope\n        .state\n        .account_router\n        .as_ref()\n        .expect(\"policy pool\")\n        .provider();\n    let base = if provider == crate::subscription::SubscriptionProvider::Claude {\n        scope.state.upstream_base_url.clone()\n    } else {\n        scope\n            .state\n            .subscription_base_url\n            .clone()\n            .unwrap_or_else(|| selected.token.base_url(provider))\n    };\n    super::apply_for_account(\n        &scope.state,\n        body,\n        model,\n        provider,\n        &selected.name,\n        &base,\n        controls.protocol,\n        controls.origin,\n        controls.from_suffix,\n    )?;\n    Ok(())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2138,"end":3877,"unit":"utf16","byteStart":2138,"byteEnd":3877}},"comment":false},{"term":"trivia","name":null,"span":{"start":3877,"end":3878,"unit":"utf16","byteStart":3877,"byteEnd":3878},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
