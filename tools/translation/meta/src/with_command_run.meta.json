"start":113,"end":133,"unit":"utf16","byteStart":113,"byteEnd":133},"sha256":"2313d4fc18464e0ab2c43c3895c30ebc21b7498b3f436ed7dfcc9406e0f9acad","source":"use std::path::Path;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":113,"end":133},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":133,"end":134,"unit":"utf16","byteStart":133,"byteEnd":134},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"std","span":{"start":134,"end":161,"unit":"utf16","byteStart":134,"byteEnd":161},"sha256":"b792067eeecdbab706cc5e0dbf69403393e8e2e9e41bc382e15b742224b1cbbe","source":"use std::process::ExitCode;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":134,"end":161},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":161,"end":163,"unit":"utf16","byteStart":161,"byteEnd":163},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"use","name":"super","span":{"start":163,"end":218,"unit":"utf16","byteStart":163,"byteEnd":218},"sha256":"7e59589fc00aa3758d54ab50514f179dae2317a3dbfbdcfeb6749c73c012cbc6","source":"use super::{AnyError, ClientKind, WithArgs, run_inner};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":163,"end":218},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":218,"end":294,"unit":"utf16","byteStart":218,"byteEnd":294},"sha256":"6fb467a9f80d9f9c3925ad7d3e285ea07a283eae557a6ab6b93832cdde3b76df","source":"\n\n/// Execute one wrapper invocation and preserve the client's exit status.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"run","span":{"start":294,"end":602,"unit":"utf16","byteStart":294,"byteEnd":602},"sha256":"b3dba2fcb9126e912235f894b35ee290e0b067d9e15a4071212e7f9d0dfef179","source":"pub async fn run(args: &WithArgs) -> ExitCode {\n    let verbose = crate::operation_context::var(\"VERBOSE\").is_ok_and(|value| {\n        matches!(\n            value.trim().to_ascii_lowercase().as_str(),\n            \"1\" | \"true\" | \"yes\" | \"on\"\n        )\n    });\n    run_with_logging(args, None, verbose).await\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":294,"end":602,"unit":"utf16","byteStart":294,"byteEnd":602}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":602,"end":831,"unit":"utf16","byteStart":602,"byteEnd":831},"sha256":"e8a051fb36e9cd0008d105ef32df56acc5fefc3fd67755f1344304d61bc25d4e","source":"\n\n/// Execute a wrapper with a selected diagnostic state root and verbosity.\n///\n/// Claude launches persist diagnostics under `data_dir/launcher`; `None` uses\n/// the same `DATA_DIR`/`HOME` default as the other Router commands.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"run_with_logging","span":{"start":831,"end":1454,"unit":"utf16","byteStart":831,"byteEnd":1454},"sha256":"0c97a36ba03bf28fd48b29b8bf06aabf0ec1f5188a72833bc5c4524b6046a603","source":"pub async fn run_with_logging(args: &WithArgs, data_dir: Option<&Path>, verbose: bool) -> ExitCode {\n    if args.client == ClientKind::ClaudeCode\n        && !args.global\n        && !args.undo\n        && !crate::launcher_log::is_active()\n    {\n        let work = Box::pin(run_inner(args));\n        return crate::launcher_log::run(args, data_dir, verbose, work).await;\n    }\n    match run_inner(args).await {\n        Ok(code) => code,\n        Err(error) => {\n            crate::launcher_log::record(\"launch_failed\", &error.to_string());\n            eprintln!(\"error: {error}\");\n            ExitCode::from(1)\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":831,"end":1454,"unit":"utf16","byteStart":831,"byteEnd":1454}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1454,"end":1456,"unit":"utf16","byteStart":1454,"byteEnd":1456},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"confirm_claude_profile_reset","span":{"start":1456,"end":2280,"unit":"utf16","byteStart":1456,"byteEnd":2280},"sha256":"2ef1b91744f54e9dbf9a18ad722c0b9b69076ca577907187cdccb747a3bbc539","source":"pub(super) fn confirm_claude_profile_reset(yes: bool) -> Result<(), AnyError> {\n    if yes {\n        return Ok(());\n    }\n    if !std::io::stdin().is_terminal() {\n        return Err(\n            \"Claude profile reset requires interactive confirmation; rerun with --yes before the client name\"\n                .into(),\n        );\n    }\n    crate::operation_output::write_passthrough(\n        true,\n        format_args!(\"Reset the Router-owned Claude profile and keep a recoverable backup? [y/N] \"),\n    );\n    std::io::stderr().flush()?;\n    let mut response = String::new();\n    std::io::stdin().read_line(&mut response)?;\n    if matches!(response.trim().to_ascii_lowercase().as_str(), \"y\" | \"yes\") {\n        Ok(())\n    } else {\n        Err(\"Claude profile reset cancelled; the previous profile is unchanged\".into())\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1456,"end":2280,"unit":"utf16","byteStart":1456,"byteEnd":2280}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2280,"end":2282,"unit":"utf16","byteStart":2280,"byteEnd":2282},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"exit_code","span":{"start":2282,"end":2772,"unit":"utf16","byteStart":2282,"byteEnd":2772},"sha256":"f7fe80550667d424629d5534da522f6057a33c11c3b33d6fa7ff0ed7d38f1654","source":"pub(super) fn exit_code(status: std::process::ExitStatus) -> ExitCode {\n    if let Some(code) = status.code() {\n        return ExitCode::from(u8::try_from(code).unwrap_or(1));\n    }\n    #[cfg(unix)]\n    {\n        use std::os::unix::process::ExitStatusExt as _;\n        ExitCode::from(\n            status\n                .signal()\n                .and_then(|signal| u8::try_from(128 + signal).ok())\n                .unwrap_or(1),\n        )\n    }\n    #[cfg(not(unix))]\n    ExitCode::from(1)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2282,"end":2772,"unit":"utf16","byteStart":2282,"byteEnd":2772}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2772,"end":2773,"unit":"utf16","byteStart":2772,"byteEnd":2773},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
