th: &Path, entry: Entry) -> Result<(), String> {\n    let mut deployments: Vec<Entry> = read(path)\n        .into_iter()\n        .filter(|existing| existing.root != entry.root)\n        .collect();\n    deployments.push(entry);\n    write(path, deployments)\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown type Path","span":{"start":3269,"end":3273},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":3518,"end":3635,"unit":"utf16","byteStart":3518,"byteEnd":3635},"sha256":"f2487a03899d53092b194926362e35325d75a180f79a5a7d17e941a1104b35f9","source":"\n\n/// Forget `root`, after its deployment was removed.\n///\n/// # Errors\n///\n/// When the registry cannot be written.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"unregister","span":{"start":3635,"end":3976,"unit":"utf16","byteStart":3635,"byteEnd":3976},"sha256":"d91da437d61953212d28d003b8d45aa2464bbe91d8dd49635f2a05450c63bf48","source":"pub fn unregister(path: &Path, root: &Path) -> Result<(), String> {\n    let deployments = read(path);\n    if !deployments.iter().any(|entry| entry.root == root) {\n        return Ok(());\n    }\n    write(\n        path,\n        deployments\n            .into_iter()\n            .filter(|entry| entry.root != root)\n            .collect(),\n    )\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown type Path","span":{"start":3660,"end":3664},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":3976,"end":4117,"unit":"utf16","byteStart":3976,"byteEnd":4117},"sha256":"33ca94f537d27f2434edc8b1aae19e498d45ba66e7bc3f245f8a6d5c7fb4c18b","source":"\n\n/// What doctor should inspect: the data directory of every registered root\n/// that still exists, and a note for every one it cannot see.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"doctor_targets","span":{"start":4117,"end":4748,"unit":"utf16","byteStart":4117,"byteEnd":4748},"sha256":"e8135a57fae45afdf9d7fbf0d3f8e8dc73a9d25576fb141c685b212485648d4a","source":"#[must_use]\npub fn doctor_targets(path: &Path) -> (Vec<PathBuf>, String) {\n    let mut directories = Vec::new();\n    let mut notes = String::new();\n    for entry in read(path) {\n        if entry.root.is_dir() {\n            directories.push(entry.data_dir());\n        } else {\n            let _ = writeln!(\n                notes,\n                \"deployment registry    : could not see {} ({} on port {}); it was moved or \\\n                 removed without `router deploy --down`\",\n                entry.root.display(),\n                entry.mode,\n                entry.port\n            );\n        }\n    }\n    (directories, notes)\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"tuple type: tuples are outside the portable core","span":{"start":4167,"end":4168},"details":{"construct":"tuple type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":4748,"end":4750,"unit":"utf16","byteStart":4748,"byteEnd":4750},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":4750,"end":6748,"unit":"utf16","byteStart":4750,"byteEnd":6748},"sha256":"8a25372c877f19acbb7ccf63903279d783577236c11dcd1901a446ad3deafbe7","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn entry(root: &Path, port: u16) -> Entry {\n        Entry {\n            root: root.to_path_buf(),\n            mode: \"host\".to_string(),\n            port,\n            instance: None,\n            registered_at: 1,\n        }\n    }\n\n    #[test]\n    fn a_root_is_registered_once_and_forgotten_on_down() {\n        let directory = tempfile::tempdir().unwrap();\n        let registry = directory.path().join(\"nested\").join(FILE);\n        let root = directory.path().join(\"custom\");\n        std::fs::create_dir_all(&root).unwrap();\n\n        register(&registry, entry(&root, 8080)).unwrap();\n        register(&registry, entry(&root, 9090)).unwrap();\n        let entries = read(&registry);\n        assert_eq!(entries.len(), 1);\n        assert_eq!(entries[0].port, 9090);\n\n        let (directories, notes) = doctor_targets(&registry);\n        assert_eq!(directories, vec![root.join(\"data\")]);\n        assert!(notes.is_empty());\n\n        unregister(&registry, &root).unwrap();\n        assert!(read(&registry).is_empty());\n    }\n\n    #[test]\n    fn a_missing_root_is_named_rather_than_silently_skipped() {\n        let directory = tempfile::tempdir().unwrap();\n        let registry = directory.path().join(FILE);\n        let gone = directory.path().join(\"gone\");\n        register(&registry, entry(&gone, 8080)).unwrap();\n\n        let (directories, notes) = doctor_targets(&registry);\n        assert!(directories.is_empty());\n        assert!(notes.contains(\"could not see\"), \"{notes}\");\n        assert!(notes.contains(&gone.display().to_string()), \"{notes}\");\n    }\n\n    #[test]\n    fn a_corrupt_registry_reads_as_empty_and_is_rewritten() {\n        let directory = tempfile::tempdir().unwrap();\n        let registry = directory.path().join(FILE);\n        std::fs::write(&registry, \"not json\").unwrap();\n        assert!(read(&registry).is_empty());\n        register(&registry, entry(directory.path(), 1)).unwrap();\n        assert_eq!(read(&registry).len(), 1);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item mod: no supported library declaration emission","span":{"start":4750,"end":6748},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":6748,"end":6749,"unit":"utf16","byteStart":6748,"byteEnd":6749},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
