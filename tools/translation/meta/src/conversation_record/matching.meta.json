db3e015122dcc81762bd44db8c99587b40eaad420fa947472ff57c53","source":"\n\n/// Render a value for a mismatch report, abbreviated but never elided entirely.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"render","span":{"start":5863,"end":6327,"unit":"utf16","byteStart":5869,"byteEnd":6335},"sha256":"77e50cbc0b69db5dcdc60d8cfcbbc35b2a748075659f0399a8f666a2c35abfa6","source":"fn render(value: Option<&Value>) -> String {\n    let Some(value) = value else {\n        return \"nothing\".to_string();\n    };\n    let text = match value {\n        Value::String(text) => text.clone(),\n        other => other.to_string(),\n    };\n    if text.chars().count() <= RENDERED_LIMIT {\n        return format!(\"{text:?}\");\n    }\n    let head: String = text.chars().take(RENDERED_LIMIT).collect();\n    format!(\"{head:?}… ({} characters)\", text.chars().count())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":5863,"end":6327,"unit":"utf16","byteStart":5869,"byteEnd":6335}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":6327,"end":6328,"unit":"utf16","byteStart":6335,"byteEnd":6336},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
