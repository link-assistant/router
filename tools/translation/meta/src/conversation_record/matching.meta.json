rceType":true,"rustOwnership":{"kind":"borrowed","source":"str"},"rustBorrowLifetime":{"kind":"elided","source":"borrowed-str-type","span":{"start":1269347,"end":1269351},"tokens":[{"kind":"punct","value":"&","span":{"start":1269347,"end":1269348}},{"kind":"identifier","value":"str","span":{"start":1269348,"end":1269351}}]}},"patternOwnershipRefusal":"shared source reference","rustSourceType":true,"rustOwnership":{"kind":"borrowed","source":"slice"},"rustReference":{"kind":"shared","pointee":{"kind":"array","element":{"kind":"string","rustSourceType":true,"rustOwnership":{"kind":"borrowed","source":"str"},"rustBorrowLifetime":{"kind":"elided","source":"borrowed-str-type","span":{"start":1269347,"end":1269351},"tokens":[{"kind":"punct","value":"&","span":{"start":1269347,"end":1269348}},{"kind":"identifier","value":"str","span":{"start":1269348,"end":1269351}}]}},"rustSourceType":true,"rustOwnership":{"kind":"borrowed","source":"slice"}},"span":{"start":1269345,"end":1269352},"tokens":[{"value":"&","kind":"punct","span":{"start":1269345,"end":1269346}},{"value":"[","kind":"punct","span":{"start":1269346,"end":1269347}},{"value":"&","kind":"punct","span":{"start":1269347,"end":1269348}},{"value":"str","kind":"identifier","span":{"start":1269348,"end":1269351}},{"value":"]","kind":"punct","span":{"start":1269351,"end":1269352}}]}},"project":{"entry":"src/lib.rs","declaration":"conversation_record.matching.COMPARED_FIELDS"}}},{"term":"trivia","name":null,"span":{"start":1587,"end":1639,"unit":"utf16","byteStart":1589,"byteEnd":1641},"sha256":"4cdf2a7691289c1199473fb6b90690c52119f1c0063d2fcca712a6d6774bb40a","source":"\n\n/// Whether a header name takes part in matching.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"header_is_compared","span":{"start":1639,"end":1767,"unit":"utf16","byteStart":1641,"byteEnd":1769},"sha256":"4bffb0b9c8f427be39929adff8bb2b3dc1188ee1ed438ba95e70fc2a6b0f9d92","source":"#[must_use]\npub fn header_is_compared(name: &str) -> bool {\n    !IGNORED_HEADERS.contains(&name.to_ascii_lowercase().as_str())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1639,"end":1767,"unit":"utf16","byteStart":1641,"byteEnd":1769}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1767,"end":2069,"unit":"utf16","byteStart":1769,"byteEnd":2075},"sha256":"40bea39239935cac3b054d4a1afcd56a56d41d6c9bc2171a2520abda074de82d","source":"\n\n/// The first way `incoming` differs from `recorded`, described in English.\n///\n/// `None` means the two requests match. The description names a path into the\n/// body — `body.messages[1].content[0].text` — so the turn that failed points\n/// at the field that moved rather than at the whole request.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"describe_difference","span":{"start":2069,"end":2755,"unit":"utf16","byteStart":2075,"byteEnd":2761},"sha256":"85bd78d16ad828e6c0fa49e4c7220247d4fe79d932d2e061ce080d3f1c80e0b7","source":"#[must_use]\npub fn describe_difference(recorded: &Value, incoming: &Value) -> Option<String> {\n    for field in COMPARED_FIELDS {\n        let expected = recorded.get(*field);\n        let actual = incoming.get(*field);\n        if expected != actual {\n            return Some(format!(\n                \"{field}: recorded {}, received {}\",\n                render(expected),\n                render(actual)\n            ));\n        }\n    }\n    if let Some(difference) = header_difference(recorded, incoming) {\n        return Some(difference);\n    }\n    compare(\n        \"body\",\n        recorded.get(\"body\").unwrap_or(&Value::Null),\n        incoming.get(\"body\").unwrap_or(&Value::Null),\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2069,"end":2755,"unit":"utf16","byteStart":2075,"byteEnd":2761}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2755,"end":2801,"unit":"utf16","byteStart":2761,"byteEnd":2807},"sha256":"49c940186324a8193f91c5eaf335f80f0a190a96ad7f8a0317da4a39fb380bc0","source":"\n\n/// The first compared header that differs.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"header_difference","span":{"start":2801,"end":3931,"unit":"utf16","byteStart":2807,"byteEnd":3937},"sha256":"e40597ff35b402471b70c60f61881e951ce78409fb801f086402ea58a61dec9b","source":"fn header_difference(recorded: &Value, incoming: &Value) -> Option<String> {\n    let expected = recorded.get(\"headers\").and_then(Value::as_object)?;\n    let actual = incoming.get(\"headers\").and_then(Value::as_object);\n    for (name, value) in expected {\n        if !header_is_compared(name) {\n            continue;\n        }\n        let received = actual.and_then(|actual| actual.get(name));\n        if received != Some(value) {\n            return Some(format!(\n                \"header {name}: recorded {}, received {}\",\n                render(Some(value)),\n                render(received)\n            ));\n        }\n    }\n    // A header the client added is as much a divergence as one it dropped: an\n    // extra beta flag changes what the upstream is being asked for.\n    let actual = actual?;\n    actual\n        .iter()\n        .filter(|(name, _)| header_is_compared(name))\n        .find(|(name, _)| !expected.contains_key(name.as_str()))\n        .map(|(name, value)| {\n            format!(\n                \"header {name}: absent from the recording, received {}\",\n                render(Some(value))\n            )\n        })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2801,"end":3931,"unit":"utf16","byteStart":2807,"byteEnd":3937}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3931,"end":4010,"unit":"utf16","byteStart":3937,"byteEnd":4016},"sha256":"b55334a4bad099f5c90f6d3d0c6b3edaf7fd42aa918aa4119847c3ea0c7790c1","source":"\n\n/// Walk two values in parallel and describe the first divergence at `path`.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"compare","span":{"start":4010,"end":5550,"unit":"utf16","byteStart":4016,"byteEnd":5556},"sha256":"1fd49684a672d6d21b6c48e738ddd90a79b1eb9ab9b88504709985d4be6a9041","source":"fn compare(path: &str, recorded: &Value, incoming: &Value) -> Option<String> {\n    match (recorded, incoming) {\n        (Value::Object(expected), Value::Object(actual)) => {\n            for (key, value) in expected {\n                let Some(received) = actual.get(key) else {\n                    return Some(format!(\"{path}.{key} is missing from the request\"));\n                };\n                if let Some(difference) = compare(&format!(\"{path}.{key}\"), value, received) {\n                    return Some(difference);\n                }\n            }\n            actual\n                .keys()\n                .find(|key| !expected.contains_key(key.as_str()))\n                .map(|key| format!(\"{path}.{key} is not in the recording\"))\n        }\n        (Value::Array(expected), Value::Array(actual)) => {\n            if expected.len() != actual.len() {\n                return Some(format!(\n                    \"{path} has {} element(s), the recording has {}\",\n                    actual.len(),\n                    expected.len()\n                ));\n            }\n            expected\n                .iter()\n                .zip(actual)\n                .enumerate()\n                .find_map(|(index, (expected, actual))| {\n                    compare(&format!(\"{path}[{index}]\"), expected, actual)\n                })\n        }\n        _ if recorded == incoming => None,\n        _ => Some(format!(\n            \"{path}: recorded {}, received {}\",\n            render(Some(recorded)),\n            render(Some(incoming))\n        )),\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":4010,"end":5550,"unit":"utf16","byteStart":4016,"byteEnd":5556}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":5550,"end":5746,"unit":"utf16","byteStart":5556,"byteEnd":5752},"sha256":"c53e01b89b16ee8392bb7f6f976ed261247e0e5036c8d5690696b4acac3e9a76","source":"\n\n/// How long a value may be before a report abbreviates it.\n///\n/// A mismatch report goes to a test log and a terminal; a full system prompt\n/// pasted into it buries the one field that moved.\n","status":"preserved","diagnostic":null},{"term":"const","name":"RENDERED_LIMIT","span":{"start":5746,"end":5780,"unit":"utf16","byteStart":5752,"byteEnd":5786},"sha256":"a58ca1d10e6e56e7d77c5200b201ed8f861309ebd00ab96f6012709f2212c001","source":"const RENDERED_LIMIT: usize = 120;","status":"executable","diagnostic":null,"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]},"semantic":{"checkedIR":{"k":"fn","name":"rp_636f6e766572736174696f6e5f7265636f72642e6d61746368696e672e52454e44455245445f4c494d4954","params":[],"ret":{"kind":"fixed","bits":64,"signed":false,"rustPrimitiveName":"usize","rustSourceType":true},"body":{"k":"lit","type":{"kind":"fixed","bits":64,"signed":false,"rustPrimitiveName":"usize","rustSourceType":true},"value":"120","span":{"start":1273563,"end":1273566}},"constant":true,"span":{"start":1273533,"end":1273538},"fullName":"r