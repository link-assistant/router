fference(recorded: &Value, incoming: &Value) -> Option<String> {\n    for field in COMPARED_FIELDS {\n        let expected = recorded.get(*field);\n        let actual = incoming.get(*field);\n        if expected != actual {\n            return Some(format!(\n                \"{field}: recorded {}, received {}\",\n                render(expected),\n                render(actual)\n            ));\n        }\n    }\n    if let Some(difference) = header_difference(recorded, incoming) {\n        return Some(difference);\n    }\n    compare(\n        \"body\",\n        recorded.get(\"body\").unwrap_or(&Value::Null),\n        incoming.get(\"body\").unwrap_or(&Value::Null),\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2069,"end":2755,"unit":"utf16","byteStart":2075,"byteEnd":2761}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2755,"end":2801,"unit":"utf16","byteStart":2761,"byteEnd":2807},"sha256":"49c940186324a8193f91c5eaf335f80f0a190a96ad7f8a0317da4a39fb380bc0","source":"\n\n/// The first compared header that differs.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"header_difference","span":{"start":2801,"end":3931,"unit":"utf16","byteStart":2807,"byteEnd":3937},"sha256":"e40597ff35b402471b70c60f61881e951ce78409fb801f086402ea58a61dec9b","source":"fn header_difference(recorded: &Value, incoming: &Value) -> Option<String> {\n    let expected = recorded.get(\"headers\").and_then(Value::as_object)?;\n    let actual = incoming.get(\"headers\").and_then(Value::as_object);\n    for (name, value) in expected {\n        if !header_is_compared(name) {\n            continue;\n        }\n        let received = actual.and_then(|actual| actual.get(name));\n        if received != Some(value) {\n            return Some(format!(\n                \"header {name}: recorded {}, received {}\",\n                render(Some(value)),\n                render(received)\n            ));\n        }\n    }\n    // A header the client added is as much a divergence as one it dropped: an\n    // extra beta flag changes what the upstream is being asked for.\n    let actual = actual?;\n    actual\n        .iter()\n        .filter(|(name, _)| header_is_compared(name))\n        .find(|(name, _)| !expected.contains_key(name.as_str()))\n        .map(|(name, value)| {\n            format!(\n                \"header {name}: absent from the recording, received {}\",\n                render(Some(value))\n            )\n        })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2801,"end":3931,"unit":"utf16","byteStart":2807,"byteEnd":3937}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3931,"end":4010,"unit":"utf16","byteStart":3937,"byteEnd":4016},"sha256":"b55334a4bad099f5c90f6d3d0c6b3edaf7fd42aa918aa4119847c3ea0c7790c1","source":"\n\n/// Walk two values in parallel and describe the first divergence at `path`.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"compare","span":{"start":4010,"end":5550,"unit":"utf16","byteStart":4016,"byteEnd":5556},"sha256":"1fd49684a672d6d21b6c48e738ddd90a79b1eb9ab9b88504709985d4be6a9041","source":"fn compare(path: &str, recorded: &Value, incoming: &Value) -> Option<String> {\n    match (recorded, incoming) {\n        (Value::Object(expected), Value::Object(actual)) => {\n            for (key, value) in expected {\n                let Some(received) = actual.get(key) else {\n                    return Some(format!(\"{path}.{key} is missing from the request\"));\n                };\n                if let Some(difference) = compare(&format!(\"{path}.{key}\"), value, received) {\n                    return Some(difference);\n                }\n            }\n            actual\n                .keys()\n                .find(|key| !expected.contains_key(key.as_str()))\n                .map(|key| format!(\"{path}.{key} is not in the recording\"))\n        }\n        (Value::Array(expected), Value::Array(actual)) => {\n            if expected.len() != actual.len() {\n                return Some(format!(\n                    \"{path} has {} element(s), the recording has {}\",\n                    actual.len(),\n                    expected.len()\n                ));\n            }\n            expected\n                .iter()\n                .zip(actual)\n                .enumerate()\n                .find_map(|(index, (expected, actual))| {\n                    compare(&format!(\"{path}[{index}]\"), expected, actual)\n                })\n        }\n        _ if recorded == incoming => None,\n        _ => Some(format!(\n            \"{path}: recorded {}, received {}\",\n            render(Some(recorded)),\n            render(Some(incoming))\n        )),\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":4010,"end":5550,"unit":"utf16","byteStart":4016,"byteEnd":5556}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":5550,"end":5746,"unit":"utf16","byteStart":5556,"byteEnd":5752},"sha256":"c53e01b89b16ee8392bb7f6f976ed261247e0e5036c8d5690696b4acac3e9a76","source":"\n\n/// How long a value may be before a report abbreviates it.\n///\n/// A mismatch report goes to a test log and a terminal; a full system prompt\n/// pasted into it buries the one field that moved.\n","status":"preserved","diagnostic":null},{"term":"const","name":"RENDERED_LIMIT","span":{"start":5746,"end":5780,"unit":"utf16","byteStart":5752,"byteEnd":5786},"sha256":"a58ca1d10e6e56e7d77c5200b201ed8f861309ebd00ab96f6012709f2212c001","source":"const RENDERED_LIMIT: usize = 120;","status":"executable","diagnostic":null,"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]},"semantic":{"checkedIR":{"k":"fn","name":"rp_636f6e766572736174696f6e5f7265636f72642e6d61746368696e672e52454e44455245445f4c494d4954","params":[],"ret":{"kind":"fixed","bits":64,"signed":false,"rustPrimitiveName":"usize","rustSourceType":true},"body":{"k":"lit","type":{"kind":"fixed","bits":64,"signed":false,"rustPrimitiveName":"usize","rustSourceType":true},"value":"120","span":{"start":1273563,"end":1273566}},"span":{"start":1273533,"end":1273538},"constant":true,"fullName":"rp_636f6e766572736174696f6e5f7265636f72642e6d61746368696e672e52454e44455245445f4c494d4954","modulePath":[],"recursive":false,"decreasing":null,"sourceLifetimeProof":{"schemaVersion":1,"profile":"source-shared-elision-v1","params":[],"outputs":[],"span":{"start":1273533,"end":1273538},"returnOrigins":[],"returnLeaves":[],"explicitReturnLeaves":[]},"generated":"router-project-flattened"},"dataTypes":[],"encodings":[{"id":"numbers","statement":"every natural, integer and machine integer is a BigInt; machine-integer results are range-checked and throw RangeError where Rust would panic"}],"assumptions":[],"mappings":[{"kind":"function","source":"rp_636f6e766572736174696f6e5f7265636f72642e6d61746368696e672e52454e44455245445f4c494d4954","target":"rp_636f6e766572736174696f6e5f7265636f72642e6d61746368696e672e52454e44455245445f4c494d4954","sourceSpan":{"start":1273533,"end":1273538}},{"kind":"function","source":"RENDERED_LIMIT","target":"rp_636f6e766572736174696f6e5f7265636f72642e6d61746368696e672e52454e44455245445f4c494d4954","sourceSpan":{"start":1273533,"end":1273538}}],"params":[],"returns":{"kind":"fixed","bits":64,"signed":false,"rustPrimitiveName":"usize","rustSourceType":true},"project":{"entry":"src/lib.rs","declaration":"conversation_record.m