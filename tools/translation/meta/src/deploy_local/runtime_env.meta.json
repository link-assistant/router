` for every variable and the fingerprint label before the\n/// image reference (the last two `docker run` arguments: image and `serve`).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"insert","span":{"start":2322,"end":2856,"unit":"utf16","byteStart":2322,"byteEnd":2856},"sha256":"5fa9d350bc41e022dc4d05c07739c403eda8367528fdad28fad091ff7b8ac046","source":"pub(super) fn insert(arguments: &mut Vec<String>, settings: &LocalSettings, token_secret: &str) {\n    let mut extra = Vec::new();\n    for (name, _) in &settings.env {\n        extra.extend([\"-e\".to_string(), name.clone()]);\n    }\n    if let Some(fingerprint) = env_fingerprint(token_secret, &settings.env) {\n        extra.extend([\n            \"--label\".to_string(),\n            format!(\"{LABEL_KEY}.{LABEL_SUFFIX}={fingerprint}\"),\n        ]);\n    }\n    let at = arguments.len().saturating_sub(2);\n    arguments.splice(at..at, extra);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"mutable reference: mutation is outside the portable core","span":{"start":2354,"end":2355},"details":{"construct":"mutable reference"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2856,"end":2921,"unit":"utf16","byteStart":2856,"byteEnd":2921},"sha256":"2d1578d267752f7e41b6c76615b85865b09094c8b9430a582137f3f93ee0b266","source":"\n\n/// Name/value pairs for the `docker run` process environment.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"environment","span":{"start":2921,"end":3276,"unit":"utf16","byteStart":2921,"byteEnd":3276},"sha256":"818d2ed705c89f586bbbbb5d8de4048ebd6bc975a9086b6319de64be9470e98b","source":"pub(super) fn environment<'a>(\n    settings: &'a LocalSettings,\n    token_secret: &'a str,\n) -> Vec<(&'a str, &'a str)> {\n    let mut environment = vec![(\"TOKEN_SECRET\", token_secret)];\n    environment.extend(\n        settings\n            .env\n            .iter()\n            .map(|(name, value)| (name.as_str(), value.as_str())),\n    