c<(String, String)>,\n    /// Limits for the client token deploy issues.\n    pub tokens: TokenPolicy,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(Default): only derives that add no behaviour are portable","span":{"start":980,"end":987},"details":{"construct":"derive(Default)"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1203,"end":1205,"unit":"utf16","byteStart":1203,"byteEnd":1205},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"static","name":"SETTINGS","span":{"start":1205,"end":1264,"unit":"utf16","byteStart":1205,"byteEnd":1264},"sha256":"1605aa816293c837ffae7fcdca0e9cafa93c15342561838c9d9a2a50e799449d","source":"static SETTINGS: OnceLock<LocalSettings> = OnceLock::new();","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item static: no supported library declaration emission","span":{"start":1205,"end":1264},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1264,"end":1333,"unit":"utf16","byteStart":1264,"byteEnd":1333},"sha256":"103039546d7c4f7b21fc50ab1084384c7eeeff83f06505e174ddd7adc9057176","source":"\n\n/// Choose this process's local settings. Later calls are ignored.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"configure","span":{"start":1333,"end":1632,"unit":"utf16","byteStart":1333,"byteEnd":1632},"sha256":"6a2197a9e64aecf249535ff859c732cc36a019810ad989cf682c70cab257a7a6","source":"pub fn configure(settings: LocalSettings) {\n    if let Some(context) = crate::operation_context::current() {\n        *context\n            .deployment_settings\n            .lock()\n            .expect(\"deployment settings lock\") = settings;\n    } else {\n        let _ = SETTINGS.set(settings);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"if let: use an exhaustive match for supported algebraic values","span":{"start":1381,"end":13