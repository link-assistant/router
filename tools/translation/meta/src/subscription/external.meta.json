:{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":644,"end":1107,"unit":"utf16","byteStart":644,"byteEnd":1107}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1107,"end":1109,"unit":"utf16","byteStart":1107,"byteEnd":1109},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"mark_external_refresh_owner","span":{"start":1109,"end":1567,"unit":"utf16","byteStart":1109,"byteEnd":1567},"sha256":"d6a133c336dc8d53417f536bbf92bc529c804327f9f03271e7d7d3afab19db87","source":"pub fn mark_external_refresh_owner(document: &str) -> Result<String, String> {\n    let mut value: serde_json::Value = serde_json::from_str(document)\n        .map_err(|_| \"external credential document is not valid JSON\".to_string())?;\n    metadata_mut(&mut value)?.insert(REFRESH_OWNER_KEY.into(), EXTERNAL_REFRESH_OWNER.into());\n    serde_json::to_string_pretty(&value)\n        .map_err(|_| \"external credential ownership could not be encoded\".to_string())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1109,"end":1567,"unit":"utf16","byteStart":1109,"byteEnd":1567}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1567,"end":1569,"unit":"utf16","byteStart":1567,"byteEnd":1569},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"mark_promotion_receipt","span":{"start":1569,"end":2030,"unit":"utf16","byteStart":1569,"byteEnd":2030},"sha256":"83fa8ad21c285bfb4f17f1865b3f32ab7ebc8a90375a2989140fcc4fccaf5786","source":"pub fn mark_promotion_receipt(document: &str, transaction_id: &str) -> Result<String, String> {\n    let mut value: serde_json::Value = serde_json::from_str(document)\n        .map_err(|_| \"credential document is not valid JSON\".to_string())?;\n    metadata_mut(&mut value)?.insert(PROMOTION_RECEIPT_KEY.into(), transaction_id.into());\n    serde_json::to_string_pretty(&value)\n        .map_err(|_| \"credential promotion receipt could not be encoded\".to_string())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1569,"end":2030,"unit":"utf16","byteStart":1569,"byteEnd":2030}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2030,"end":2032,"unit":"utf16","byteStart":2030,"byteEnd":2032},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"reference_external_credential","span":{"start":2032,"end":2687,"unit":"utf16","byteStart":2032,"byteEnd":2687},"sha256":"434263180cfe8e889f52da6145688de4a7cd95d754a31eebb4c46fec944a1794","source":"pub fn reference_external_credential(\n    source: &Path,\n    transaction_id: &str,\n) -> Result<String, String> {\n    let source = std::fs::canonicalize(source)\n        .map_err(|_| \"the external credential source is not a readable file\".to_string())?;\n    if !source.is_file() {\n        return Err(\"the external credential source is not a readable file\".to_string());\n    }\n    serde_json::to_string_pretty(&serde_json::json!({\n        ROUTER_METADATA_KEY: {\n            CREDENTIAL_SOURCE_KEY: source,\n            PROMOTION_RECEIPT_KEY: transaction_id,\n        }\n    }))\n    .map_err(|_| \"external credential reference could not be encoded\".to_string())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2032,"end":2687,"unit":"utf16","byteStart":2032,"byteEnd":2687}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2687,"end":2689,"unit":"utf16","byteStart":2687,"byteEnd":2689},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"has_promotion_receipt","span":{"start":2689,"end":3133,"unit":"utf16","byteStart":2689,"byteEnd":3133},"sha256":"51e61c5e81fa9d8491a1da7fe8e57181d3985b47ae8c03f751ddc706b8804c48","source":"#[must_use]\npub fn has_promotion_receipt(document: &str, transaction_id: &str) -> bool {\n    serde_json::from_str::<serde_json::Value>(document)\n        .ok()\n        .and_then(|value| {\n            value\n                .pointer(&format!(\"/{ROUTER_METADATA_KEY}/{PROMOTION_RECEIPT_KEY}\"))\n                .and_then(serde_json::Value::as_str)\n                .map(str::to_string)\n        })\n        .as_deref()\n        == Some(transaction_id)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2689,"end":3133,"unit":"utf16","byteStart":2689,"byteEnd":3133}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3133,"end":3135,"unit":"utf16","byteStart":3133,"byteEnd":3135},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"external_source","span":{"start":3135,"end":3404,"unit":"utf16","byteStart":3135,"byteEnd":3404},"sha256":"c7a0633342b8ce98f766cb7ef221968a186fdc8976607795a808a2c1cc3fc135","source":"fn external_source(value: &serde_json::Value) -> Option<PathBuf> {\n    value\n        .point