et worker = std::thread::Builder::new()\n        .name(\"router-main\".to_string())\n        .stack_size(STACK_BYTES)\n        .spawn(move || {\n            tokio::runtime::Builder::new_multi_thread()\n                .enable_all()\n                .thread_stack_size(STACK_BYTES)\n                .build()\n                .expect(\"build the tokio runtime\")\n                .block_on(entry())\n        })\n        .expect(\"spawn the entry thread\");\n    match worker.join() {\n        Ok(code) => code,\n        Err(panic) => std::panic::resume_unwind(panic),\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"generic function: generic signatures require monomorphization","span":{"start":941,"end":964},"details":{"construct":"generic function"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1637,"end":1639,"unit":"utf16","byteStart":1639,"byteEnd":1641},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":1639,"end":1694,"unit":"utf16","byteStart":1641,"byteEnd":1696},"sha256":"4e5702503a21913b8be8a13d86f63c7440be78be320f46711a83db6517955fa0","source":"#[cfg(test)]\n#[path = \"entrypoint_tests.rs\"]\nmod tests;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item mod: no supported library declaration emission","span":{"start":1639,"end":1694},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1694,"end":1695,"unit":"utf16","byteStart":1696,"byteEnd":1697},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
