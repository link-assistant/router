oke*, Vertex *:rawPredict)\n    // are forwarded as-is to the upstream\n    path.to_string()\n}","status":"executable","diagnostic":null,"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]},"semantic":{"checkedIR":{"k":"fn","name":"rp_70726f78792e757073747265616d5f706174682e7265736f6c76655f757073747265616d5f70617468","params":[{"name":"path","type":{"kind":"string","rustSourceType":true,"rustOwnership":{"kind":"borrowed","source":"str"},"rustBorrowLifetime":{"kind":"elided","source":"borrowed-str-type","span":{"start":2566382,"end":2566386},"tokens":[{"kind":"punct","value":"&","span":{"start":2566382,"end":2566383}},{"kind":"identifier","value":"str","span":{"start":2566383,"end":2566386}}]}},"guard":null,"default":null}],"ret":{"kind":"string","patternOwnershipRefusal":"ownership-bearing String type","rustSourceType":true,"rustOwnership":{"kind":"owned","source":"String"}},"body":{"k":"let","name":"ml_pattern_3","value":{"k":"let","name":"ml_text_1","value":{"k":"var","name":"path","type":{"kind":"string","rustSourceType":true,"rustOwnership":{"kind":"borrowed","source":"str"},"rustBorrowLifetime":{"kind":"elided","source":"borrowed-str-type","span":{"start":2566382,"end":2566386},"tokens":[{"kind":"punct","value":"&","span":{"start":2566382,"end":2566383}},{"kind":"identifier","value":"str","span":{"start":2566383,"end":2566386}}]}},"span":{"start":2566424,"end":2566428}},"body":{"k":"let","name":"ml_text_2","value":{"k":"lit","type":{"kind":"string","rustOwnership":{"kind":"borrowed","source":"str"},"rustBorrowLifetime":{"kind":"static","source":"string-literal","span":{"start":2566442,"end":2566467}}},"value":"/api/services/anthropic","span":{"start":2566442,"end":2566467}},"body":{"k":"routerTextPattern","op":"strip_prefix","value":{"k":"var","name":"ml_text_1","type":{"kind":"string","rustSourceType":true,"rustOwnership":{"kind":"