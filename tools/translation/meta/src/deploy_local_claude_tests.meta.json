 method but found \"0\"","span":{"start":1680,"end":1681},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1876,"end":1878,"unit":"utf16","byteStart":1876,"byteEnd":1878},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"backend_launches","span":{"start":1878,"end":2299,"unit":"utf16","byteStart":1878,"byteEnd":2299},"sha256":"021e58acd88d91cb15f541285d5b2e0fc64519706bab9bf52a89e94a0bf8ea67","source":"fn backend_launches(runner: &FakeRunner) -> Vec<Vec<String>> {\n    runner\n        .0\n        .lock()\n        .unwrap()\n        .commands\n        .iter()\n        .filter(|command| {\n            command.first().map(String::as_str) == Some(\"run\")\n                && command\n                    .iter()\n                    .any(|argument| argument.ends_with(\".role=backend\"))\n        })\n        .cloned()\n        .collect()\n}","status":"carried","diagnostic":{"kind":"syntax","message":"expected identifier in field or method but found \"0\"","span":{"start":1961,"end":1962},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2299,"end":2301,"unit":"utf16","byteStart":2299,"byteEnd":2301},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"share_mounts_the_host_login_and_an_update_without_the_flag_keeps_it","span":{"start":2301,"end":4043,"unit":"utf16","byteStart":2301,"byteEnd":4043},"sha256":"b45c217af980f77e630c0cd35b2e3243daa2d522de9d0345104010750e0f2d72","source":"#[test]\nfn share_mounts_the_host_login_and_an_update_without_the_flag_keeps_it() {\n    let root = tempfile::tempdir().unwrap();\n    let home = PathBuf::from(\"/home/operator/.claude\");\n    let runner = FakeRunner::default();\n\n    let (code, asked) = deploy(\n        &runner,\n        root.path(),\n        \"router:1.0.0\",\n        Some(ClaudeCredentials::Share),\n        &home,\n    );\n    assert_eq!(code, ExitCode::SUCCESS);\n    assert_eq!(asked, Some(ClaudeCredentials::Share));\n    let first = backend(&runner);\n    assert_eq!(\n        first.mounts.get(\"/data/claude\").map(String::as_str),\n        Some(\"/home/operator/.claude\")\n    );\n    assert_eq!(\n        first.labels.get(&format!(\"{LABEL_KEY}.{LABEL_SUFFIX}\")),\n        Some(&\"shared:/home/operator/.claude\".to_string())\n    );\n    let launch = backend_launches(&runner).pop().unwrap().join(\" \");\n    assert!(launch.contains(\"--user 1000:1000\"), \"{launch}\");\n    assert!(!launch.contains(\":/data/claude:ro\"), \"{launch}\");\n\n    // A routine image update omits the flag: the shared login must survive.\n    let (code, asked) = deploy(&runner, root.path(), \"router:2.0.0\", None, &home);\n    assert_eq!(code, ExitCode::SUCCESS);\n    assert_eq!(asked, Some(ClaudeCredentials::Share));\n    let second = backend(&runner);\n    assert_eq!(second.image_ref, \"router:2.0.0\");\n    assert_eq!(\n        second.mounts.get(\"/data/claude\").map(String::as_str),\n        Some(\"/home/operator/.claude\")\n    );\n\n    // Rerunning the same specification is still an exact no-op.\n    let launches = backend_launches(&runner).len();\n    let (code, _) = deploy(&runner, root.path(), \"router:2.0.0\", None, &home);\n    assert_eq!(code, ExitCode::SUCCESS);\n    assert_eq!(backend_launches(&runner).len(), launches);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2301,"end":2307},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":4043,"end":4045,"unit":"utf16","byteStart":4043,"byteEnd":4045},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"switching_mode_replaces_the_backend_instead_of_claiming_convergence","span":{"start":4045,"end":5320,"unit":"utf16","byteStart":4045,"byteEnd":5320},"sha256":"e073f01c190d121702cdb1afcc33f55ff91e2372faa53235df141ac985e5e20a","source":"#[test]\nfn switching_mode_replaces_the_backend_instead_of_claiming_convergence() {\n    let root = tempfile::tempdir().unwrap();\n    let home = PathBuf::from(\"/home/operator/.claude\");\n    let runner = FakeRunner::default();\n\n    let (code, asked) = deploy(&runner, root.path(), \"router:1.0.0\", None, &home);\n    assert_eq!(code, ExitCode::SUCCESS);\n    assert_eq!(asked, Some(ClaudeCredentials::Isolated));\n    let isolated = backend(&runner);\n    assert_eq!(\n        isolated.mounts.get(\"/data/claude\"),\n        Some(&root.path().join(\"credentials\").display().to_string())\n    );\n\n    let (code, _) = deploy(\n        &runner,\n        root.path(),\n        \"router:1.0.0\",\n        Some(ClaudeCredentials::Share),\n        &home,\n    );\n    assert_eq!(code, ExitCode::SUCCESS);\n    assert_eq!(backend_launches(&runner).len(), 2);\n    assert_eq!(\n        backend(&runner)\n            .mounts\n            .get(\"/data/claude\")\n            .map(String::as_str),\n        Some(\"/home/operator/.claude\")\n    );\n\n    let (code, _) = deploy_accepting(\n        &runner,\n        root.path(),\n        \"router:1.0.0\",\n        Some(ClaudeCredentials::Isolated),\n        &home,\n        true,\n    );\n    assert_eq!(code, ExitCode::SUCCESS);\n    assert_eq!(backend_launches(&runner).len(), 3);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":4045,"end":4051},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":5320,"end":5322,"unit":"utf16","byteStart":5320,"byteEnd":5322},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_refused_share_changes_nothing_and_says_why","span":{"start":5322,"end":6219,"unit":"utf16","byteStart":5322,"byteEnd":6219},"sha256":"49e8547b0169a64f3181c2ded24e4e78e3b59c02ca2839739c3cb45cc372c1fa","source":"#[test]\nfn a_refused_share_changes_nothing_and_says_why() {\n    let root = tempfile::tempdir().unwrap();\n    let runner = FakeRunner::default();\n    let mut args = deploy_args();\n    args.claude_credentials = Some(ClaudeCredentials::Share);\n\n    let code = run_assessed(\n        &args,\n        root.path(),\n        \"router:1.0.0\",\n        SECRET,\n        Docker::with_runner(runner.clone()),\n        &|_, _| Provision::Refused(\"the login is in the macOS Keychain\".to_string()),\n        &crate::deploy_local::host_runtime::System::fixture(),\n    );\n\n    assert_eq!(code, ExitCode::from(2));\n    let world = runner.0.lock().unwrap();\n    assert!(world.containers.is_empty());\n    assert!(\n        world\n            .commands\n            .iter()\n            .all(|command| command.first().map(String::as_str) != Some(\"run\"))\n    );\n    drop(world);\n    assert!(!root.path().join(\"state\").exists());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":5322,"end":5328},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":6219,"end":6220,"unit":"utf16","byteStart":6219,"byteEnd":6220},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
