g":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":6,"preserved":6},"items":[{"term":"use","name":"super","span":{"start":0,"end":13,"unit":"utf16","byteStart":0,"byteEnd":13},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":0,"end":13},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":13,"end":15,"unit":"utf16","byteStart":13,"byteEnd":15},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"RunCredential","span":{"start":15,"end":507,"unit":"utf16","byteStart":15,"byteEnd":507},"sha256":"e6943d1452f68065b38ddcb00109d6537c6017d6e787138561f8b7cc0037d56a","source":"impl RunCredential {\n    /// The durable record id retained so a persistent credential remains\n    /// revocable later (issue #190).\n    #[must_use]\n    pub fn id(&self) -> Option<String> {\n        token_subject(&self.token).ok()\n    }\n\n    /// Whether this command minted the credential. Supplied tokens may be\n    /// shared with other machines and must not be revoked implicitly (#296).\n    #[must_use]\n    pub const fn was_minted(&self) -> bool {\n        self.revocation.is_some()\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":15,"end":507},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":507,"end":509,"unit":"utf16","byteStart":507,"byteEnd":509},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"token_subject","span":{"start":509,"end":755,"unit":"utf16","byteStart":509,"byteEnd":755},"sha256":"ab200ba2161d776a79765ebc0b299c0f44c222192c2538d9ace41f9d816ca9aa","source":"pub fn token_subject(token: &str) -> Result<String, AnyError> {\n    token_claim(token)?\n        .get(\"sub\")\n        .and_then(Value::as_str)\n        .map(str::to_string)\n        .ok_or_else(|| \"router run token has no subject to revoke\".into())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":509,"end":755,"unit":"utf16","byteStart":509,"byteEnd":755}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":755,"end":757,"unit":"utf16","byteStart":755,"byteEnd":757},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"token_client_binding","span":{"start":757,"end":1146,"unit":"utf16","byteStart":757,"byteEnd":1146},"sha256":"030ba542e2040cb3705b66e6bc4914892d0cab7cedcbb859715b2b85063da3a3","source":"pub fn token_client_binding(token: &str) -> Result<(Option<String>, Option<String>), AnyError> {\n    let claims = token_claim(token)?;\n    Ok((\n        claims\n            .get(\"client_kind\")\n            .and_then(Value::as_str)\n            .map(str::to_string),\n        claims\n            .get(\"principal_id\")\n            .and_then(Value::as_str)\n            .map(str::to_string),\n    ))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":757,"end":1146,"unit":"utf16","byteStart":757,"byteEnd":1146}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1146,"end":1148,"unit":"utf16","byteStart":1146,"byteEnd":1148},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"exact_token_binding","span":{"start":1148,"end":1687,"unit":"utf16","byteStart":1148,"byteEnd":1687},"sha256":"bae1f77ae2b7adab811f6f59675bd233a853211496862981f5035ed65b1f2dcd","source":"pub(super) fn exact_token_binding(token: &str, client: ClientKind) -> Result<String, AnyError> {\n    let (bound, principal) = token_client_binding(token)?;\n    if bound.as_deref() != Some(client.canonical_name()) {\n        return Err(format!(\n            \"the supplied token must carry the exact `{}` client binding\",\n            client.canonical_name()\n        )\n        .into());\n    }\n    principal\n        .filter(|value| !value.trim().is_empty())\n        .ok_or_else(|| \"the supplied token must carry a subscriber principal\".into())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1148,"end":1687,"unit":"utf16","byteStart":1148,"byteEnd":1687}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1687,"end":1689,"unit":"utf16","byteStart":1687,"byteEnd":1689},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"token_claim","span":{"start":1689,"end":2109,"unit":"utf16","byteStart":1689,"byteEnd":2109},"sha256":"5c0b99175bc083c81a749493dc017061bc4a1899ff4292e1fc6dffc9c59e01cd","source":"fn token_claim(token: &str) -> Result<Value, AnyError> {\n    let payload = token\n        .split('.')\n        .nth(1)\n        .ok_or(\"router returned a token without a JWT payload\")?;\n    let decoded = base64::engine::general_purpose::URL_SAFE_NO_PAD\n        .decode(payload)\n        .map_err(|error| format!(\"router returned an invalid JWT payload: {error}\"))?;\n    serde_json::from_slice(&decoded).map_err(Into::into)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1689,"end":2109,"unit":"utf16","byteStart":1689,"byteEnd":2109}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2109,"end":2110,"unit":"utf16","byteStart":2109,"byteEnd":2110},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
