":0,"byteEnd":1024},"sha256":"578d887120b21ce4cde3644d4a94a2cb0e1f25deff3b1fd497b4b4685456b4d6","source":"//! Where a subscription credential lives, so every refresh path can re-read it,\n//! lock it, and write a rotated refresh token back.\n//!\n//! Refresh-token rotation turns a credential file into shared mutable state.\n//! The vendor CLI, another router process, and this process each hold a link in\n//! the same chain, and only the newest link is redeemable — redeeming an older\n//! one answers `invalid_grant`. A refresh whose result stays in memory\n//! therefore loses more than an optimisation: it leaves a spent link on disk for\n//! the next process start to replay, and it cannot tell a *revoked* credential\n//! from one another holder has merely rotated past (issue #239).\n//!\n//! Abstracting the file behind a trait keeps [`crate::refresh`] free of any\n//! particular vendor layout and lets tests drive the same recovery ladder\n//! against an in-memory store.\n//!\n//! Secrets, account identifiers, credential paths, and path-bearing read errors\n//! are never logged here. Refresh diagnostics name only the provider.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"std","span":{"start":1022,"end":1053,"unit":"utf16","byteStart":1024,"byteEnd":1055},"sha256":"e1e51b43f469af3148886c5204e1627f2eade5316def3c108916793567541ded","source":"use std::path::{Path, PathBuf};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":1022,"end":1053},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1053,"end":1055,"unit":"utf16","byteStart":1055,"byteEnd":1057},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"use","name":"crate","span":{"start":1055,"end":1120,"unit":"utf16","byteStart":1057,"byteEnd":1122},"sha256":"0b1f661c81d770c1b89d6b0