\n    };\n    let number = |key: &str| record.get(key).and_then(Value::as_u64);\n    let used_over_max = |used: &str, max: &str| {\n        let used = number(used).unwrap_or(0);\n        number(max).map_or_else(|| format!(\"{used}/-\"), |max| format!(\"{used}/{max}\"))\n    };\n\n    let scope = record\n        .get(\"scope\")\n        .and_then(Value::as_str)\n        .filter(|scope| !scope.is_empty())\n        .unwrap_or(\"client\");\n    let rpm = number(\"rate_limit_per_minute\").map_or_else(|| \"-\".to_string(), |v| v.to_string());\n    let revoked = record\n        .get(\"revoked\")\n        .and_then(Value::as_bool)\n        .unwrap_or(false);\n\n    format!(\n        \"{:<36}  {:<10}  {:<10}  {:<8}  {:<13}  {:<15}  {:<9}  {:<8}  {scope:<6}  {}\",\n        text(\"id\"),\n        number(\"issued_at\").unwrap_or(0),\n        number(\"expires_at\").unwrap_or(0),\n        revoked,\n        used_over_max(\"used_requests\", \"max_requests\"),\n        used_over_max(\"used_tokens\", \"max_tokens\"),\n        number(\"reserved_tokens\").unwrap_or(0),\n        rpm,\n        text(\"label\"),\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1322,"end":2583,"unit":"utf16","byteStart":1324,"byteEnd":2585}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2583,"end":2585,"unit":"utf16","byteStart":2585,"byteEnd":2587},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":2585,"end":2642,"unit":"utf16","byteStart":2587,"byteEnd":2644},"sha256":"b2c26ac9595258dd4e514b3d7e32016af87cc7fed6841abbd920071f8b8f3114","source":"#[cfg(test)]\n#[path = \"token_report_tests.rs\"]