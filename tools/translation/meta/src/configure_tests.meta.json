,"assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":8,"preserved":9},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":102,"unit":"utf16","byteStart":0,"byteEnd":102},"sha256":"a0414ef8fddbf250d0aa8e0390c134a03e20b0765b9741d586f603f7d78ef2e4","source":"//! Tests for the decisions `router configure` makes before it touches the\n//! network (issue #296).\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":102,"end":115,"unit":"utf16","byteStart":102,"byteEnd":115},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":102,"end":115},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":115,"end":116,"unit":"utf16","byteStart":115,"byteEnd":116},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"crate","span":{"start":116,"end":143,"unit":"utf16","byteStart":116,"byteEnd":143},"sha256":"a415c4ea375229c7de5527b18aa8e27e8f7250717de0570dfa8c21435b59450e","source":"use crate::cli::AuthTarget;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":116,"end":143},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":143,"end":145,"unit":"utf16","byteStart":143,"byteEnd":145},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"args","span":{"start":145,"end":408,"unit":"utf16","byteStart":145,"byteEnd":408},"sha256":"3e0fc228a61254bab3191bdc4fe1e8563add79eedbf90f44142bd6926dbd6ce7","source":"fn args(client: Option<ClientKind>) -> ConfigureArgs {\n    ConfigureArgs {\n        client,\n        all: client.is_none(),\n        undo: false,\n        target: AuthTarget::default(),\n        token: None,\n        token_stdin: false,\n        ttl_hours: 8760,\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed Option generic: the standard prelude type requires actual resolution","span":{"start":161,"end":179},"details":{"construct":"shadowed Option generic"}},"comment":false},{"term":"trivia","name":null,"span":{"start":408,"end":636,"unit":"utf16","byteStart":408,"byteEnd":636},"sha256":"fe595586182bfa94009165c50457ddb9e7fa985b572c7d084e84565bbfec10e3","source":"\n\n/// A client the router can never point at by writing a file is named and\n/// skipped, not attempted. Reversal makes the same check, because `--undo`\n/// used to report success for a configuration that could not exist (#303).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"clients_that_cannot_be_configured_by_file_are_named","span":{"start":636,"end":1286,"unit":"utf16","byteStart":636,"byteEnd":1286},"sha256":"4acf1ea7a6fa6e589a1fa99f97adb138b754feec797546519c5339ae3d97b199","source":"#[test]\nfn clients_that_cannot_be_configured_by_file_are_named() {\n    for client in [ClientKind::Cursor, ClientKind::GeminiCli] {\n        let reason = unconfigurable(client).expect(\"must be reported as unconfigurable\");\n        assert!(!reason.is_empty(), \"{client} must say why, not just refuse\");\n    }\n    // Everything else is configurable, so a skip list cannot silently grow.\n    for client in ClientKind::ALL {\n        if matches!(client, ClientKind::Cursor | ClientKind::GeminiCli) {\n            continue;\n        }\n        assert!(\n            unconfigurable(client).is_none(),\n            \"{client} must be configurable\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":636,"end":642},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1286,"end":1483,"unit":"utf16","byteStart":1286,"byteEnd":1483},"sha256":"b27ba44cf3abcc71153066732aa03461ffb8903ac6c10eb89c0bced6292b493b","source":"\n\n/// Grok CLI has no persistent base-URL setting, so the credential file is the\n/// whole configuration. `with --global` refused it outright and withheld the\n/// half that does work (issue #296).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"only_the_environment_only_client_skips_the_config_file","span":{"start":1483,"end":1866,"unit":"utf16","byteStart":1483,"byteEnd":1866},"sha256":"d22b1d45e98256dbb4b0a26cb6842702ceb2157698d04c87cc66b15acee2b65e","source":"#[test]\nfn only_the_environment_only_client_skips_the_config_file() {\n    assert!(environment_only(ClientKind::GrokCli));\n    for client in ClientKind::ALL {\n        if client == ClientKind::GrokCli {\n            continue;\n        }\n        assert!(\n            !environment_only(client),\n            \"{client} is configured by a file, not only by the environment\"\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1483,"end":1489},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1866,"end":1932,"unit":"utf16","byteStart":1866,"byteEnd":1932},"sha256":"e7865e3294007c3977e57e61088eab2b3960f0808aeefcbf82b9570c7c80490b","source":"\n\n/// A bare name acts on that client; `--all` acts on every one.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_named_client_is_the_only_one_acted_on","span":{"start":1932,"end":2162,"unit":"utf16","byteStart":1932,"byteEnd":2162},"sha256":"29466d72e50a20cbe59fba0154aa26656584a142e8bde69ca91dd766f338d729","source":"#[test]\nfn a_named_client_is_the_only_one_acted_on() {\n    assert_eq!(\n        args(Some(ClientKind::ClaudeCode)).clients(),\n        [ClientKind::ClaudeCode]\n    );\n    assert_eq!(args(None).clients(), ClientKind::ALL.to_vec());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1932,"end":1938},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2162,"end":2360,"unit":"utf16","byteStart":2162,"byteEnd":2362},"sha256":"eb1a29918da33d7c79f1f3c15a3485bb7c7002488dfd5b89a335fbcee881d654","source":"\n\n/// Undo removes local files and has to keep working offline, so it never\n/// resolves a target — it asks only what is already to hand, and an explicit\n/// `--token` wins over anything persisted.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_explicit_token_is_the_admin_credential_for_undo","span":{"start":2360,"end":2672,"unit":"utf16","byteStart":2362,"byteEnd":2674},"sha256":"a8d6e34384ce81ed5c9d052782c7a08cc591fb04062a18cb2c9eec938a5959c4","source":"#[test]\nfn an_explicit_token_is_the_admin_credential_for_undo() {\n    let mut with_token = args(Some(ClientKind::ClaudeCode));\n    with_token.token = Some(\"la_sk_explicit\".into());\n    assert_eq!(\n        admin_token_for(&with_token, \"https://router.example\"),\n        Some(\"la_sk_explicit\".to_string())\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2360,"end":2366},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2672,"end":2828,"unit":"utf16","byteStart":2674,"byteEnd":2830},"sha256":"687076f41d5f0824302f1628534a328b73735bf5f79f6eddc9e80ff1460ef719","source":"\n\n/// The default TTL is a year: this is the permanent path, and a credential\n/// that lapses next week makes \"configured\" mean \"configured until Tuesday\".\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_default_credential_outlives_the_week","span":{"start":2828,"end":2953,"unit":"utf16","byteStart":2830,"byteEnd":2955},"sha256":"ca6d4de80a45b25239eb79e1cf420e32f36f83abbdfdc10f06949698d01c4c9e","source":"#[test]\nfn the_default_credential_outlives_the_week() {\n    assert_eq!(args(Some(ClientKind::ClaudeCode)).ttl_hours, 8760);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2828,"end":2834},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2953,"end":2954,"unit":"utf16","byteStart":2955,"byteEnd":2956},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
