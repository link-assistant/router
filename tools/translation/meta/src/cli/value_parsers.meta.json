 's' => 1,\n        'm' => 60,\n        'h' => 3600,\n        'd' => 86_400,\n        _ => 0,\n    };\n    match amount.parse::<u64>() {\n        Ok(amount) if scale > 0 => {\n            Ok(crate::account_limits::now_unix().saturating_add(amount.saturating_mul(scale)))\n        }\n        _ => Err(format!(\n            \"expected Unix seconds, an RFC 3339 time or a delay like 90m, 6h, 2d; got '{value}'\"\n        )),\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"if let: write a match","span":{"start":950,"end":953},"details":{"construct":"if let"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1787,"end":1788,"unit":"utf16","byteStart":1787,"byteEnd":1788},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
