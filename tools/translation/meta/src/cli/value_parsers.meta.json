ource":"serde_json.Error.JsonError","target":"serde_json.Error_.JsonError","sourceSpan":{"start":310,"end":310}},{"kind":"data","source":"serde_json.error.Category","target":"serde_json.error.Category","sourceSpan":{"start":310,"end":310}},{"kind":"constructor","source":"serde_json.error.Category.Io","target":"serde_json.error.Category.Io","sourceSpan":{"start":310,"end":310}},{"kind":"constructor","source":"serde_json.error.Category.Syntax","target":"serde_json.error.Category.Syntax","sourceSpan":{"start":310,"end":310}},{"kind":"constructor","source":"serde_json.error.Category.Data","target":"serde_json.error.Category.Data","sourceSpan":{"start":310,"end":310}},{"kind":"constructor","source":"serde_json.error.Category.Eof","target":"serde_json.error.Category.Eof","sourceSpan":{"start":310,"end":310}}],"params":[{"name":"value","type":{"kind":"string"},"guard":null,"default":null}],"returns":{"kind":"data","name":"RouterResult_4_bool_6_string"}}},{"term":"trivia","name":null,"span":{"start":651,"end":852,"unit":"utf16","byteStart":651,"byteEnd":852},"sha256":"e20cb77348cd817b6bfe20679e626fa59efa4dbcab055b29bf9e2b341953df2f","source":"\n\n/// Parse when an account pause lifts into Unix seconds (issue #677).\n///\n/// Accepts Unix seconds, an RFC 3339 time, or a delay from now written as a\n/// number with an `s`, `m`, `h` or `d` suffix.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_until","span":{"start":852,"end":1787,"unit":"utf16","byteStart":852,"byteEnd":1787},"sha256":"722781b1a6f93f61c0aae863a3b99ccd304d9b8d20d5e1802702c287fd4a72e4","source":"pub(super) fn parse_until(value: &str) -> Result<u64, String> {\n    let value = value.trim();\n    if let Ok(unix) = value.parse::<u64>() {\n        return Ok(unix);\n    }\n    if let Ok(time) = chrono::DateTime::parse_from_rfc3339(value) {\n        return u64::try_from(time.timestamp())\n            .map_err(|_| format!(\"'{value}' is before the Unix epoch\"));\n    }\n    let unit = value.chars().next_back().unwrap_or('?');\n    let amount = value.strip_suffix(unit).unwrap_or_default();\n    let scale = match unit {\n        's' => 1,\n        'm' => 60,\n        'h' => 3600,\n        'd' => 86_400,\n        _ => 0,\n    };\n    match amount.parse::<u64>() {\n        Ok(amount) if scale > 0 => {\n            Ok(crate::account_limits::now_unix().saturating_add(amount.saturating_mul(scale)))\n        }\n        _ => Err(format!(\n            \"expected Unix seconds, an RFC 3339 time or a delay like 90m, 6h, 2d; got '{value}'\"\n        )),\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"if let: use an exhaustive match for supported algebraic values","span":{"start":950,"end":956},"details":{"construct":"if let"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1787,"end":1788,"unit":"utf16","byteStart":1787,"byteEnd":1788},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
