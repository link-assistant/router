        .filter_map(|manifest| {\n            let platform = manifest.get(\"platform\")?;\n            let os = platform.get(\"os\")?.as_str()?;\n            let architecture = platform.get(\"architecture\")?.as_str()?;\n            Some(format!(\"{os}/{architecture}\"))\n        })\n        // BuildKit publishes provenance attestations as unknown/unknown entries.\n        // They are expected metadata, not runnable architectures.\n        .filter(|platform| platform != ATTESTATION_PLATFORM)\n        .collect();\n\n    Ok(platforms)\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"type BTreeSet<…>: generic types are outside the portable core","span":{"start":549,"end":557},"details":{"construct":"type BTreeSet<…>"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1450,"end":1452,"unit":"utf16","byteStart":1450,"byteEnd":1452},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"verify_index","span":{"start":1452,"end":2111,"unit":"utf16","byteStart":1452,"byteEnd":2111},"sha256":"072afa5881e8f7b852d671f784d41f0026e47bb29d6533fbee671f1cbfddb2f8","source":"fn verify_index(image: &str, raw_manifest: &str) -> Result<(), String> {\n    let platforms = platforms_from_index(raw_manifest)?;\n    let missing: Vec<_> = REQUIRED_PLATFORMS\n        .iter()\n        .filter(|required| !platforms.contains(**required))\n        .copied()\n        .collect();\n\n    if missing.is_empty() {\n        println!(\n            \"Verified {image}: {}\",\n            REQUIRED_PLATFORMS.join(\", \")\n        );\n        Ok(())\n    } else {\n        Err(format!(\n            \"{image} is missing runnable platform(s): {}; found: {}\",\n            missing.join(\", \"),\n            platforms.into_iter().collect::<Vec<_>>().join(\", \")\n        ))\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed Result generic: the standard prelude type requires actual resolution","span":{"start":1504,"end":1523},"details":{"construct":"shadowed Result generic"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2111,"end":2113,"unit":"utf16","byteStart":2111,"byteEnd":2113},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"inspect_image","span":{"start":2113,"end":2699,"unit":"utf16","byteStart":2113,"byteEnd":2699},"sha256":"e8594ed01db584be0e7f92fcc37c784fe4f21bfeb9766194a8a6b147279f0300","source":"fn inspect_image(image: &str) -> Result<String, String> {\n    let output = Command::new(\"docker\")\n        .args([\"buildx\", \"imagetools\", \"inspect\", image, \"--raw\"])\n        .output()\n        .map_err(|error| format!(\"failed to run docker for {image}: {error}\"))?;\n\n    if !output.status.success() {\n        return Err(format!(\n            \"failed to inspect {image}: {}\",\n            String::from_utf8_lossy(&output.stderr).trim()\n        ));\n    }\n\n    String::from_utf8(output.stdout)\n        .map_err(|error| format!(\"docker returned non-UTF-8 manifest data for {image}: {error}\"))\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed Result generic: the standard prelude type requires actual resolution","span":{"start":2146,"end":2169},"details":{"construct":"shadowed Result generic"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2699,"end":2701,"unit":"utf16","byteStart":2699,"byteEnd":2701},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":2701,"end":3228,"unit":"utf16","byteStart":2701,"byteEnd":3228},"sha256":"8f06325165a6b0f4f1e6a8c62429ea4ddbdf2983fea5614afdfe30132d2b3fd3","source":"fn main() {\n    let images: Vec<_> = env::args().skip(1).collect();\n    if images.is_empty() {\n        eprintln!(\"Usage: check-docker-platforms.rs <image> [<image> ...]\");\n        process::exit(2);\n    }\n\n    let mut failed = false;\n    for image in images {\n        let result = inspect_image(&image).and_then(|manifest| verify_index(&image, &manifest));\n        if let Err(error) = result {\n            eprintln!(\"Error: {error}\");\n            failed = true;\n        }\n    }\n\n    if failed {\n        process::exit(1);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":2701,"end":3228},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":3228,"end":3230,"unit":"utf16","byteStart":3228,"byteEnd":3230},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":3230,"end":4493,"unit":"utf16","byteStart":3230,"byteEnd":4493},"sha256":"211e9b250146a9dff551d51914ffaa945ed7f2bc3c2c455806c7de22c738cafd","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    const MULTI_ARCH_INDEX: &str = r#\"{\n      \"manifests\": [\n        {\"platform\": {\"os\": \"linux\", \"architecture\": \"amd64\"}},\n        {\"platform\": {\"os\": \"linux\", \"architecture\": \"arm64\", \"variant\": \"v8\"}},\n        {\"platform\": {\"os\": \"unknown\", \"architecture\": \"unknown\"}}\n      ]\n    }\"#;\n\n    #[test]\n    fn accepts_required_platforms_and_ignores_attestations() {\n        assert!(verify_index(\"example/image:tag\", MULTI_ARCH_INDEX).is_ok());\n    }\n\n    #[test]\n    fn rejects_an_index_without_arm64() {\n        let manifest = r#\"{\n          \"manifests\": [\n            {\"platform\": {\"os\": \"linux\", \"architecture\": \"amd64\"}},\n            {\"platform\": {\"os\": \"unknown\", \"architecture\": \"unknown\"}}\n          ]\n        }\"#;\n\n        let error = verify_index(\"example/image:tag\", manifest).unwrap_err();\n        assert!(error.contains(\"linux/arm64\"));\n        assert!(!error.contains(\"missing runnable platform(s): unknown/unknown\"));\n    }\n\n    #[test]\n    fn rejects_a_single_platform_manifest() {\n        let manifest = r#\"{\"config\": {\"digest\": \"sha256:abc\"}}\"#;\n        let error = verify_index(\"example/image:tag\", manifest).unwrap_err();\n        assert!(error.contains(\"not a multi-platform manifest list\"));\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item mod: no supported library declaration emission","span":{"start":3230,"end":4493},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":4493,"end":4494,"unit":"utf16","byteStart":4493,"byteEnd":4494},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
