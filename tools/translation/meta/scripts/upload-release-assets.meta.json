76887315b8c057d5721640991167c2b6f30a51eeafef0f","source":"fn run(command: &mut Command) -> Result<Vec<u8>, String> {\n    let output = bounded_process::output(command, Duration::from_secs(120))\n        .map_err(|error| error.to_string())?;\n    if !output.status.success() {\n        // gh's own stderr names the cause (auth, missing release, rate limit).\n        return Err(format!(\n            \"release asset operation failed ({}); existing bytes were not overwritten: {}\",\n            output.status,\n            String::from_utf8_lossy(&output.stderr).trim()\n        ));\n    }\n    Ok(output.stdout)\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"mutable reference: mutation is outside the portable core","span":{"start":654,"end":658},"details":{"construct":"mutable reference"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1180,"end":1182,"unit":"utf16","byteStart":1180,"byteEnd":1182},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":1182,"end":2509,"unit":"utf16","byteStart":1182,"byteEnd":2509},"sha256":"b13caaa2e55c4e9121a1e342ca3b0488e8a8d9a6c951c5e9c7d1d8e6eb3fc9ba","source":"fn main() {\n    let version = std::env::var(\"RELEASE_VERSION\").expect(\"RELEASE_VERSION\");\n    let repository = std::env::var(\"GITHUB_REPOSITORY\").expect(\"GITHUB_REPOSITORY\");\n    let tag = format!(\"v{version}\");\n    let release =\n        run(Command::new(\"gh\").args([\"api\", &format!(\"repos/{repository}/releases/tags/{tag}\")]))\n            .expect(\"release identity\");\n    let release: Value = serde_json::from_slice(&release).expect(\"release JSON\");\n    let published = release[\"assets\"]\n        .as_array()\n        .expect(\"assets\")\n        .iter()\n        .map(|asset| asset[\"name\"].as_str().expect(\"asset name\").to_owned())\n        .collect();\n    let local = std::fs::read_dir(\"dist\")\n        .expect(\"dist\")\n        .map(|entry| {\n            entry\n                .expect(\"asset\")\n                .file_name()\n                .to_string_lossy()\n                .into_owned()\n        })\n        .collect();\n    for name in missing(&local, &published) {\n        run(Command::new(\"gh\").args([\n            \"release\",\n            \"upload\",\n            &tag,\n            \"--repo\",\n            &repository,\n            &format!(\"dist/{name}\"),\n        ]))\n        .expect(\"missing-only asset upload\");\n    }\n    println!(\n        \"Existing release assets retained; checksum and provenance validation remains required.\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":1182,"end":2509},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2509,"end":2511,"unit":"utf16","byteStart":2509,"byteEnd":2511},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":2511,"end":2914,"unit":"utf16","byteStart":2511,"byteEnd":2914},"sha256":"cb5d1d0e556059a9632732028da1371af9d6ef3e549625118bbfa8ef9712fa6d","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn partial_retries_keep_existing_assets_and_fill_only_missing_names() {\n        let local = [\"binary\".into(), \"checksums\".into()].into_iter().collect();\n        let existing = [\"binary\".into()].into_iter().collect();\n        assert_eq!(missing(&local, &existing), vec![\"checksums\"]);\n        assert!(missing(&local, &local).is_empty());\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item mod: no supported library declaration emission","span":{"start":2511,"end":2914},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2914,"end":2915,"unit":"utf16","byteStar