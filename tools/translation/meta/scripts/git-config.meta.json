,"source":"fn run_command(cmd: &str, args: &[&str]) -> Result<(), String> {\n    let output = Command::new(cmd)\n        .args(args)\n        .output()\n        .map_err(|e| format!(\"Failed to execute {}: {}\", cmd, e))?;\n\n    if !output.status.success() {\n        let stderr = String::from_utf8_lossy(&output.stderr);\n        return Err(format!(\"Command failed: {}\", stderr));\n    }\n\n    Ok(())\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":1022,"end":1026},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1383,"end":1385,"unit":"utf16","byteStart":1383,"byteEnd":1385},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":1385,"end":1952,"unit":"utf16","byteStart":1385,"byteEnd":1952},"sha256":"57ddfb174e353cbd685e57d8352f731cb99abfe6407a91cc214a47bb4e6da59b","source":"fn main() {\n    let name = get_arg(\"name\", \"github-actions[bot]\");\n    let email = get_arg(\"email\", \"github-actions[bot]@users.noreply.github.com\");\n\n    println!(\"Configuring git user: {} <{}>\", name, email);\n\n    if let Err(e) = run_command(\"git\", &[\"config\", \"user.name\", &name]) {\n        eprintln!(\"Error configuring git name: {}\", e);\n        exit(1);\n    }\n\n    if let Err(e) = run_command(\"git\", &[\"config\", \"user.email\", &email]) {\n        eprintln!(\"Error configuring git email: {}\", e);\n        exit(1);\n    }\n\n    println!(\"Git configuration complete\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":1385,"end":1952},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1952,"end":1953,"unit":"utf16","byteStart":1952,"byteEnd":1953},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"#!/usr/bin/env rust-script\n//! Configure git user for CI/CD pipeline\n//!\n//! This script sets up the git user name and email for automated commits.\n//! It's used by the CI/CD pipeline before making commits.\n//!\n//! Usage: rust-script scripts/git-config.rs [--name <name>] [--email <email>]\n//!\n//! Environment variables:\n//!   - GIT_USER_NAME: Git user name (default: github-actions[bot])\n//!   - GIT_USER_EMAIL: Git user email (default: github-actions[bot]@users.noreply.github.com)\n\nuse std::env;\nuse std::process::{Command, exit};\n\nfn get_arg(name: &str, default: &str) -> String {\n    let args: Vec<String> = env::args().collect();\n    let flag = format!(\"--{}\", name);\n\n    if let Some(idx) = args.iter().position(|a| a == &flag) {\n        if let Some(value) = args.get(idx + 1) {\n            return value.clone();\n        }\n    }\n\n    // Check environment variable\n    let env_name = format!(\"GIT_USER_{}\", name.to_uppercase());\n    env::var(&env_name).unwrap_or_else(|_| default.to_string())\n}\n\nfn run_command(cmd: &str, args: &[&str]) -> Result<(), String> {\n    let output = Command::new(cmd)\n        .args(args)\n        .output()\n        .map_err(|e| format!(\"Failed to execute {}: {}\", cmd, e))?;\n\n    if !output.status.success() {\n        let stderr = String::from_utf8_lossy(&output.stderr);\n        return Err(format!(\"Command failed: {}\", stderr));\n    }\n\n    Ok(())\n}\n\nfn main() {\n    let name = get_arg(\"name\", \"github-actions[bot]\");\n    let email = get_arg(\"email\", \"github-actions[bot]@users.noreply.github.com\");\n\n    println!(\"Configuring git user: {} <{}>\", name, email);\n\n    if let Err(e) = run_command(\"git\", &[\"c