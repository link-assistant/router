ns(\"unauthorized\") {\n                            errors.push(error);\n                        }\n                    }\n                    errors\n                })\n            })\n            .collect();\n        for worker in workers {\n            failures.extend(worker.join().unwrap());\n        }\n    });\n    for failure in &failures {\n        eprintln!(\"{failure}\");\n    }\n    println!(\n        \"{} incorrect errors in 1024 bounded image preflights\",\n        failures.len()\n    );\n    assert!(failures.is_empty());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":353,"end":1918},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1918,"end":1919,"unit":"utf16","byteStart":1918,"byteEnd":1919},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! Finite reproduction of parallel freshly-written vendor executable races.\n//!\n//! Compile against the existing Router and tempfile rlibs (see README.md).\n//! Run with a 512 MiB address-space and 2 MiB per-thread stack limit.\nuse link_assistant_router::{deploy_image, operation_context::OperationContext};\nuse std::os::unix::fs::PermissionsExt as _;\n\nfn main() {\n    let mut failures = Vec::new();\n    std::thread::scope(|scope| {\n        let workers: Vec<_> = (0..8)\n            .map(|_| {\n                scope.spawn(|| {\n                    let mut errors = Vec::new();\n                    for _ in 0..128 {\n                        let directory = tempfile::tempdir().unwrap();\n                        let script = directory.path().join(\"docker\");\n                        std::fs::write(&script, \"#!/bin/sh\\necho unauthorized >&2; exit 1\\n\")\n                            .unwrap();\n                        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o700))\n                            .unwrap();\n                        let mut context = OperationContext::isolated(directory.path());\n                        context.set_env(\"PATH\", directory.path());\n                        let error = context\n                            .scope(|| deploy_image::ensure_default(\"fixture:1.16.0\", \"1.16.0\"))\n                            .unwrap_err();\n                        if !error.contains(\"unauthorized\") {\n                            errors.push(error);\n                        }\n                    }\n                    errors\n                })\n            })\n            .collect();\n        for worker in workers {\n            failures.extend(worker.join().unwrap());\n        }\n    });\n    for failure in &failures {\n        eprintln!(\"{failure}\");\n    }\n    println!(\n        \"{} incorrect errors in 1024 bounded image preflights\",\n        failures.len()\n    );\n    assert!(failures.is_empty());\n}\n","sourceEncoding":{"utf16CodeUnits":1919,"utf8Bytes":1919,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,1919,0,1919,-1],["trivia","comment",0,76,0,76,0],["trivia","whitespace",76,77,76,77,0],["trivia","comment",77,80,77,80,0],["trivia","whitespace",80,81,80,81,0],["trivia","comment",81,156,81,156,0],["trivia","whitespace",156,157,156,157,0],["trivia","comment",157,227,157,227,0],["trivia","whitespace",227,228,227,228,0],["token","identifier",228,231,228,231,0],["trivia","whitespace",231,232,231,232,0],["token","identifier",232,253,232,253,0],["token","punct",253,255,253,255,0],["group","brace",255,306,255,306,0],["token","delimiter",255,256,255,256,13],["token","identifier",256,268,256,268,13],["token","punct",268,269,268,269,13],["trivia","whitespace",269,270,269,270,13],["token","identifier",270,287,27