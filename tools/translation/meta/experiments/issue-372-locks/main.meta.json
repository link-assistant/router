sume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":3},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":745,"unit":"utf16","byteStart":0,"byteEnd":745},"sha256":"ce85eb7f4e0dec9ccd466042bf68261c51bb9b128ed280be40bd600f122b3c45","source":"//! What `std::fs::File`'s Rust 1.89 advisory locks do that `fs2` did.\n//!\n//! The router locks through `fs2` today and tells contention apart from a\n//! broken lock by comparing raw OS errors, because `fs2` reports contention\n//! with the platform's own error. `std` has a dedicated `TryLockError::\n//! WouldBlock` variant instead. Two questions before the swap:\n//!\n//! 1. Do two *separately opened* handles to one file contend inside a single\n//!    process, so a contention test needs no second process?\n//! 2. Is a contended `try_lock` reported as `TryLockError::WouldBlock` rather\n//!    than as an `io::Error` needing platform-specific classification?\n//!\n//! Run with: `cargo run --manifest-path experiments/issue-372-locks/Cargo.toml`\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"std","span":{"start":745,"end":792,"unit":"utf16","byteStart":745,"byteEnd":792},"sha256":"6383e3750942ab0c9182eb035afdf1c1f50ad8b3a8e95d37e392833587016fd4","source":"use std::fs::{File, OpenOptions, TryLockError};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":745,"end":792},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":792,"end":794,"unit":"utf16","byteStart":792,"byteEnd":794},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":794,"end":2049,"unit":"utf16","byteStart":794,"byteEnd":2049},"sha256":"42dd859922cd805ba28aacc6ab81512186bc70194d2a65669be1b1c03bccf5b8","source":"fn main() {\n    let directory = std::env::temp_dir().join(\"issue-372-std-locks\");\n    let _ = std::fs::remove_dir_all(&directory);\n    std::fs::create_dir_all(&directory).expect(\"create the directory\");\n    let path = directory.join(\"credential.lock\");\n\n    let open = || {\n        OpenOptions::new()\n            .read(true)\n            .write(true)\n            .create(true)\n            .truncate(false)\n            .open(&path)\n            .expect(\"open the lock file\")\n    };\n\n    let holder: File = open();\n    holder.lock().expect(\"take the exclusive lock\");\n\n    let waiter = open();\n    match waiter.try_lock() {\n        Ok(()) => println!(\"1+2. a second handle took the lock: no contention in-process\"),\n        Err(TryLockError::WouldBlock) => {\n            println!(\"1. two handles in one process contend\");\n            println!(\"2. contention is reported as TryLockError::WouldBlock\");\n        }\n        Err(TryLockError::Error(error)) => println!(\"2. contention surfaced as io::Error: {error}\"),\n    }\n\n    holder.unlock().expect(\"release the lock\");\n    match waiter.try_lock() {\n        Ok(()) => println!(\"3. the lock is free once the holder releases it\"),\n        Err(error) => println!(\"3. still refused after unlock: {error:?}\"),\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":794,"end":2049},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2049,"end":2050,"unit":"utf16","byteStart":2049,"byteEnd":2050},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}],"concreteSyntaxMeta":{"schema":"meta-language-concrete-syntax-v1","representationLevel":"concrete-syntax","language":"Rust","source":"//! What `std::fs::File`'s Rust 1.89 advisory locks do that `fs2` did.\n//!\n//! The router locks through `fs2` today and tells contention apart from a\n//! broken lock by comparing raw OS errors, because `fs2` reports contention\n//! with the platform's own error. `std` has a dedicated `TryLockError::\n//! WouldBlock` variant instead. Two questions before the swap:\n//!\n//! 1. Do two *separately opened* handles to one file contend inside a single\n//!    process, so a contention test needs no second process?\n//! 2. Is a contended `try_lock` reported as `TryLockError::WouldBlock` rather\n//!    than as an `io::Error` needing platform-specific classification?\n//!\n//! Run with: `cargo run --manifest-path experiments/issue-372-locks/Cargo.toml`\n\nuse std::fs::{File, OpenOptions, TryLockError};\n\nfn main() {\n    let directory = std::env::temp_dir().join(\"issue-372-std-locks\");\n    let _ = std::fs::remove_dir_all(&directory);\n    std::fs::create_dir_all(&directory).expect(\"create the directory\");\n    let path = directory.join(\"credential.lock\");\n\n    let open = || {\n        OpenOptions::new()\n            .read(true)\n            .write(true)\n            .create(true)\n            .truncate(false)\n            .open(&path)\n            .expect(\"open the lock file\")\n    };\n\n    let holder: File = open();\n    holder.lock().expect(\"take the exclusive lock\");\n\n    let waiter = open();\n    match waiter.try_lock() {\n        Ok(()) => println!(\"1+2. a second handle took the lock: no contention in-process\"),\n        Err(TryLockError::WouldBlock) => {\n            println!(\"1. two handles in one process contend\");\n            println!(\"2. contention is reported as TryLockError::WouldBlock\");\n        }\n        Err(TryLockError::Error(error)) => println!(\"2. contention surfaced as io::Error: {error}\"),\n    }\n\n    holder.unlock().expect(\"release the lock\");\n    match waiter.try_lock() {\n        Ok(()) => println!(\"3. the lock is free once the holder releases it\"),\n        Err(error) => println!(\"3. still refused after unlock: {error:?}\"),\n    }\n}\n","sourceEncoding":{"utf16CodeUnits":2050,"utf8Bytes":2050,"wellFormedUnicode":true,"utf8BytePreservation":true,"utf8Mapping":"unicode-scalar-boundaries"},"status":"lexical","nodes":[["root","file",0,2050,0,2050,-1],["trivia","comment",0,70,0,70,0],["trivia","whitespace",70,71,70,71,0],["trivia","comment",71,74,71,74,0],["trivia","whitespace",74,75,74,75,0],["trivia","comment",75,149,75,149,0],["trivia","whitespace",149,150,149,150,0],["trivia","comment",150,226,150,226,0],["trivia","whitespace",226,227,226,227,0],["trivia","comment",227,299,227,299,0],["trivia","whitespace",299,300,299,300,0],["trivia","comment",300,363,300,363,0],["trivia","whitespace",363,364,363,364,0],["trivia","comment",364,367,364,367,0],["trivia","whitespace",367,368,367,368,0],["trivia","comment",368,445,368,445,0],["trivia","whitespace",445,446,445,446,0],["trivia","comment",446,507,446,507,0],["trivia","whitespace",507,508,507,508,0],["trivia","comment",508,586,508,586,0],["trivia","whitespace",586,587,586,587,0],["trivia","comment",587,658,587,658,0],["trivia","whitespace",658,659,658,659,0],["trivia","comment",659,662,659,662,0],["trivia","whitespace",662,663,662,663,0],["trivia","comment",663,743,663,743,0],["trivia","whitespace",743,745,743,745,0],["token","identifier",7