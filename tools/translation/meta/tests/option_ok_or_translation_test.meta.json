"byteStart":175,"byteEnd":233},"sha256":"f63a2af742ffeafa11e52a15930637485ae6c09bcbe8fb760d0656860c2d8815","source":"use link_assistant_router::activitypub::validate_activity;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":175,"end":233},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":233,"end":234,"unit":"utf16","byteStart":233,"byteEnd":234},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"serde_json","span":{"start":234,"end":255,"unit":"utf16","byteStart":234,"byteEnd":255},"sha256":"7d6dd5506bdcf9e1a553d6bdd07049f0a0164c1409cd13be95d8803696583439","source":"use serde_json::json;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":234,"end":255},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":255,"end":257,"unit":"utf16","byteStart":255,"byteEnd":257},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"activity_validation_preserves_exact_required_field_errors","span":{"start":257,"end":1209,"unit":"utf16","byteStart":257,"byteEnd":1212},"sha256":"e5327964dfd3ef4de07ff2257f899aace0e1d58f9a4c02a6e211fe581243d56a","source":"#[test]\nfn activity_validation_preserves_exact_required_field_errors() {\n    for (activity, expected) in [\n        (json!({}), Err(\"activity id is required\")),\n        (json!({\"id\": \"\"}), Err(\"activity id is required\")),\n        (json!({\"id\": \"1\"}), Err(\"activity type is required\")),\n        (\n            json!({\"id\": \"1\", \"type\": false}),\n            Err(\"activity type is required\"),\n        ),\n        (\n            json!({\"id\": \"1\", \"type\": \"Create\"}),\n            Err(\"activity must include actor or attributedTo\"),\n        ),\n        (\n            json!({\"id\": \"1\", \"type\": \"Create\", \"actor\": false}),\n            Err(\"activity must include actor or attributedTo\"),\n        ),\n        (json!({\"id\": \"1\", \"type\": \"Create\", \"actor\": \"\"}), Ok(())),\n        (\n            json!({\"id\": \"Ω😀\\u{0}\", \"type\": \"Create\", \"attributedTo\": \"actor\"}),\n            Ok(()),\n        ),\n    ] {\n        assert_eq!(validate_activity(&activity), expected);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":257,"end":263},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1209,"end":1211,"unit":"utf16","byteStart":1212,"byteEnd":1214},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"ok_or_evaluates_receiver_then_error_once_even_for_some","span":{"start":1211,"end":2010,"unit":"utf16","byteStart":1214,"byteEnd":2019},"sha256":"c1e9b0540e5f3c68c025ff75a174a7da234e342731c455aeb6f61fdb1b3e3020","source":"#[test]\nfn ok_or_evaluates_receiver_then_error_once_even_for_some() {\n    for value in [Some(0_u64), Some(u64::MAX), None] {\n        let calls = RefCell::new(Vec::new());\n        let receive = || {\n            calls.borrow_mut().push(\"receiver\");\n            value\n        };\n        let failure = || {\n            calls.borrow_mut().push(\"error\");\n            \"missing Ω😀\"\n        };\n        let actual = receive().ok_or(failure());\n        #[allow(\n            clippy::manual_ok_or,\n            reason = \"independent match oracle for the eager method\"\n        )]\n        let expected = match value {\n            Some(number) => Ok(number),\n            None => Err(\"missing Ω😀\"),\n        };\n        assert_eq!(actual, expected);\n        assert_eq!(*calls.borrow(), [\"receiver\", \"error\"]);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1211,"end":1217},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2010,"end":2012,"unit":"utf16","byteStart":2019,"byteEnd":2021},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"ok_or_does_not_defer_or_replace_the_eager_panic_payload","span":{"start":2012,"end":2353,"unit":"utf16","byteStart":2021,"byteEnd":2362},"sha256":"fc2d3f4f27f381693548cd461d98c3c89f53dbf7cf11d0ea33f84edb5fb3dc9b","source":"#[test]\nfn ok_or_does_not_defer_or_replace_the_eager_panic_payload() {\n    fn failure() -> bool {\n        std::panic::panic_any(205_usize)\n    }\n    for value in [Some(1_u8), None] {\n        let caught = std::panic::catch_unwind(|| value.ok_or(failure()));\n        assert_eq!(caught.unwrap_err().downcast_ref::<usize>(), Some(&205));\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2012,"end":2018},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2353,"end":2354,"unit":"utf16","byteStart":2362,"byteEnd":2363},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
