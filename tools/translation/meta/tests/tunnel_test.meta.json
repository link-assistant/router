:"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"run","span":{"start":85,"end":420,"unit":"utf16","byteStart":85,"byteEnd":420},"sha256":"ff265226765453156113bf959d4d80bfbbcf1dd530f80a385b14c3f76197a88e","source":"fn run(environment: &[(&str, &str)]) -> std::process::Output {\n    let mut command = Command::new(\"sh\");\n    command\n        .arg(ENTRYPOINT)\n        .env_clear()\n        .env(\"PATH\", \"/usr/bin:/bin\");\n    for (name, value) in environment {\n        command.env(name, value);\n    }\n    command.output().expect(\"run tunnel entrypoint\")\n}","status":"carried","diagnostic":{"kind":"syntax","message":"expected identifier in iteration binding but found \"(\"","span":{"start":295,"end":296},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":420,"end":422,"unit":"utf16","byteStart":420,"byteEnd":422},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"tunnel_entrypoint_names_each_missing_required_variable","span":{"start":422,"end":1266,"unit":"utf16","byteStart":422,"byteEnd":1266},"sha256":"f21bb530a05ebf0f30a3a7fc30237d488c177475e939c0189dee512c63e23f13","source":"#[test]\nfn tunnel_entrypoint_names_each_missing_required_variable() {\n    let complete = [\n        (\"TUNNEL_SSH_HOST\", \"far.example\"),\n        (\"TUNNEL_SSH_USER\", \"router\"),\n        (\"TUNNEL_REMOTE_PORT\", \"18080\"),\n        (\"TUNNEL_SSH_KEY\", \"/dev/null\"),\n        (\"TUNNEL_KNOWN_HOSTS\", \"/etc/hosts\"),\n    ];\n    for missing in complete.map(|(name, _)| name) {\n        let environment = complete\n            .iter()\n            .copied()\n            .filter(|(name, _)| *name != missing)\n            .collect::<Vec<_>>();\n        let output = run(&environment);\n        assert!(!output.status.success(), \"missing {missing} must fail\");\n        assert!(\n            String::from_utf8_lossy(&output.stderr).contains(missing),\n            \"diagnostic must name {missing}: {}\",\n            String::from_utf8_lossy(&output.stderr)\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":422,"end":428},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1266,"end":1268,"unit":"utf16","byteStart":1266,"byteEnd":1268},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"tunnel_entrypoint_builds_a_restart_safe_reverse_forward","span":{"start":1268,"end":2083,"unit":"utf16","byteStart":1268,"byteEnd":2083},"sha256":"43b2d799721e12b6343b971a52dbf5b444155c95709bb61c9d6e046b74204694","source":"#[test]\nfn tunnel_entrypoint_builds_a_restart_safe_reverse_forward() {\n    let output = run(&[\n        (\"TUNNEL_SSH_HOST\", \"far.example\"),\n        (\"TUNNEL_SSH_USER\", \"router\"),\n        (\"TUNNEL_REMOTE_PORT\", \"18080\"),\n        (\"TUNNEL_SSH_KEY\", \"/dev/null\"),\n        (\"TUNNEL_KNOWN_HOSTS\", \"/etc/hosts\"),\n        (\"AUTOSSH_BIN\", \"echo\"),\n    ]);\n    assert!(output.status.success());\n    let command = String::from_utf8_lossy(&output.stdout);\n    assert!(command.contains(\"ExitOnForwardFailure=yes\"));\n    assert!(command.contains(\"StrictHostKeyChecking=yes\"));\n    assert!(command.contains(\"UserKnownHostsFile=/etc/hosts\"));\n    assert!(command.contains(\"ServerAliveInterval=30\"));\n    assert!(command.contains(\"127.0.0.1:18080:link-assistant-router:8080\"));\n    assert!(command.contains(\"router@far.example\"));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1268,"end":1274},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2083,"end":2215,"unit":"utf16","byteStart":2083,"byteEnd":2215},"sha256":"ba31e5c6892eb257c1b2bdd5cae5de63317a2b16c8d15c29c789f6d9b3c1d6b8","source":"\n\n/// Issue #682: forward mode reaches a remote Router from this machine on\n/// loopback only, with the far side's host key pinned.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"tunnel_forward_mode_binds_loopback_only_and_pins_the_host_key","span":{"start":2215,"end":3325,"unit":"utf16","byteStart":2215,"byteEnd":3325},"sha256":"8fe61a5ade7ac02da644edfec33383f4230fb095a60002a287940be3ab4ebe7b","source":"#[test]\nfn tunnel_forward_mode_binds_loopback_only_and_pins_the_host_key() {\n    let output = run(&[\n        (\"TUNNEL_MODE\", \"forward\"),\n        (\"TUNNEL_SSH_HOST\", \"far.example\"),\n        (\"TUNNEL_SSH_USER\", \"router\"),\n        (\"TUNNEL_LOCAL_PORT\", \"18080\"),\n        (\"TUNNEL_TARGET_PORT\", \"8080\"),\n        (\"TUNNEL_SSH_KEY\", \"/dev/null\"),\n        (\"TUNNEL_KNOWN_HOSTS\", \"/etc/hosts\"),\n        (\"AUTOSSH_BIN\", \"echo\"),\n    ]);\n    assert!(\n        output.status.success(),\n        \"{}\",\n        String::from_utf8_lossy(&output.stderr)\n    );\n    let command = String::from_utf8_lossy(&output.stdout);\n    assert!(\n        command.contains(\"-L 127.0.0.1:18080:127.0.0.1:8080\"),\n        \"{command}\"\n    );\n    assert!(!command.contains(\"-R \"), \"{command}\");\n    assert!(!command.contains(\"0.0.0.0\"), \"{command}\");\n    assert!(!command.contains(\"GatewayPorts=yes\"), \"{command}\");\n    assert!(command.contains(\"StrictHostKeyChecking=yes\"), \"{command}\");\n    assert!(!command.contains(\"accept-new\"), \"{command}\");\n    assert!(\n        command.contains(\"UserKnownHostsFile=/etc/hosts\"),\n        \"{command}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2215,"end":2221},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":3325,"end":3327,"unit":"utf16","byteStart":3325,"byteEnd":3327},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"tunnel_forward_mode_needs_a_local_port_and_refuses_unknown_modes","span":{"start":3327,"end":4162,"unit":"utf16","byteStart":3327,"byteEnd":4162},"sha256":"8b6c542fc302b21709ed6337dc527efb2d8e5dbe02ea2044122228c5aa2089c3","source":"#[test]\nfn tunnel_forward_mode_needs_a_local_port_and_refuses_unknown_modes() {\n    let base = [\n        (\"TUNNEL_SSH_HOST\", \"far.example\"),\n        (\"TUNNEL_SSH_USER\", \"router\"),\n        (\"TUNNEL_SSH_KEY\", \"/dev/null\"),\n        (\"TUNNEL_KNOWN_HOSTS\", \"/etc/hosts\"),\n        (\"AUTOSSH_BIN\", \"echo\"),\n    ];\n    let mut forward = base.to_vec();\n    forward.push((\"TUNNEL_MODE\", \"forward\"));\n    let output = run(&forward);\n    assert!(!output.status.success());\n    assert!(String::from_utf8_lossy(&output.stderr).contains(\"TUNNEL_LOCAL_PORT\"));\n\n    let mut sideways = base.to_vec();\n    sideways.push((\"TUNNEL_MODE\", \"sideways\"));\n    sideways.push((\"TUNNEL_REMOTE_PORT\", \"18080\"));\n    let output = run(&sideways);\n    assert!(!output.status.success());\n    assert!(String::from_utf8_lossy(&output.stderr).contains(\"TUNNEL_MODE\"));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":3327,"end":3333},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":4162,"end":4292,"unit":"utf16","byteStart":4162,"byteEnd":4292},"sha256":"14ca79dbccd9e26115f6110b8da271520778d170716933e658f1b6f9bff86731","source":"\n\n/// A bind-mounted key with a loose mode is used through a private copy;\n/// a key that is already private is used where it is.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"tunnel_copies_a_loosely_permissioned_key_to_a_private_file","span":{"start":4292,"end":5894,"unit":"utf16","byteStart":4292,"byteEnd":5894},"sha256":"62a164d5fd4504b6a1ac0b9d12be26b54d89376286f77043fa5c4a21f52512b0","source":"#[cfg(unix)]\n#[test]\nfn tunnel_copies_a_loosely_permissioned_key_to_a_private_file() {\n    use std::os::unix::fs::PermissionsExt as _;\n    let directory = tempfile::tempdir().unwrap();\n    let key = directory.path().join(\"key\");\n    std::fs::write(&key, \"not-a-real-key\\n\").unwrap();\n    let key_text = key.display().to_string();\n    let tmp = directory.path().join(\"tmp\");\n    std::fs::create_dir(&tmp).unwrap();\n    let tmp_text = tmp.display().to_string();\n    let identity = |mode: u32| {\n        std::fs::set_permissions(&key, std::fs::Permissions::from_mode(mode)).unwrap();\n        let output = run(&[\n            (\"TUNNEL_SSH_HOST\", \"far.example\"),\n            (\"TUNNEL_SSH_USER\", \"router\"),\n            (\"TUNNEL_REMOTE_PORT\", \"18080\"),\n            (\"TUNNEL_SSH_KEY\", &key_text),\n            (\"TUNNEL_KNOWN_HOSTS\", \"/etc/hosts\"),\n            (\"TMPDIR\", &tmp_text),\n            (\"AUTOSSH_BIN\", \"echo\"),\n        ]);\n        assert!(output.status.success(), \"{output:?}\");\n        let command = String::from_utf8_lossy(&output.stdout).into_owned();\n        let mut words = command.split_whitespace();\n        words.find(|word| *word == \"-i\");\n        std::path::PathBuf::from(words.next().expect(\"an identity\"))\n    };\n\n    let copied = identity(0o644);\n    assert_ne!(copied, key);\n    assert!(copied.starts_with(&tmp), \"{}\", copied.display());\n    let mode = std::fs::metadata(&copied).unwrap().permissions().mode() & 0o777;\n    assert_eq!(mode, 0o600);\n    assert_eq!(\n        std::fs::read_to_string(&copied).unwrap(),\n        \"not-a-real-key\\n\"\n    );\n\n    assert_eq!(identity(0o600), key);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[cfg]: attributes that change compilation are outside the portable core","span":{"start":4292,"end":4297},"details":{"construct":"#[cfg]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":5894,"end":5895,"unit":"utf16","byteStart":5894,"byteEnd":5895},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
