,"name":"account_usage_and_exhaustion_observations_use_the_scoped_clock","span":{"start":622,"end":1364,"unit":"utf16","byteStart":622,"byteEnd":1364},"sha256":"39678ffe4c0d736e289fc12834dbdc7b14896d3dd3224ab70540cf1123de0348","source":"#[test]\nfn account_usage_and_exhaustion_observations_use_the_scoped_clock() {\n    let home = tempfile::tempdir().unwrap();\n    clock(home.path(), ISSUED).scope(|| {\n        assert_eq!(account_limits::now_unix(), ISSUED.cast_unsigned());\n        let exhaustion = zai_upstream_error::classify(\n            br#\"{\"error\":{\"code\":\"1113\",\"message\":\"fixture exhaustion\"}}\"#,\n        )\n        .unwrap();\n        assert_eq!(exhaustion.observed_unix(), ISSUED.cast_unsigned());\n    });\n    clock(home.path(), -1).scope(|| {\n        assert_eq!(account_limits::now_unix(), 0);\n        assert_eq!(\n            zai_upstream_error::classify(br#\"{\"code\":1113}\"#)\n                .unwrap()\n                .observed_unix(),\n            0\n        );\n    });\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":622,"end":628},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1364,"end":1366,"unit":"utf16","byteStart":1364,"byteEnd":1366},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"administrator_candidate_expires_at_the_exact_injected_boundary","span":{"start":1366,"end":2004,"unit":"utf16","byteStart":1366,"byteEnd":2004},"sha256":"1a4b462d8165e9e9380738431912916ead233965b390a473f7d9384b9fda9667","source":"#[test]\nfn administrator_candidate_expires_at_the_exact_injected_boundary() {\n    let home = tempfile::tempdir().unwrap();\n    let admin = AdminClaim::in_memory(None, Duration::from_secs(60));\n    let candidate = clock(home.path(), ISSUED).scope(|| admin.begin()).