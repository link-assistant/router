(rule chunk normal (seq (optional (ref hash_bang_line)) (repeat0 (ref statement)) (optional (ref return_statement))) (concept grammar.chunk))
(rule hash_bang_line token (seq (literal %23) (repeat0 (class negated (char %0A)))) (concept grammar.hash-bang-line))
(rule statement_block_body silent (choice unordered (seq (repeat1 (ref statement)) (optional (ref return_statement))) (seq (repeat0 (ref statement)) (ref return_statement))) (concept grammar.statement-block-body) (source-names (tree-sitter _block)))
(rule statement silent (precedence -1 none (choice unordered (ref empty_statement) (ref assignment_statement) (ref function_call) (ref label_statement) (ref break_statement) (ref go_to_statement) (ref do_statement) (ref while_statement) (ref repeat_statement) (ref if_statement) (ref for_statement) (ref declaration))) (concept grammar.statement))
(rule return_statement normal (seq (token (seq (literal return) (not (ref word_characters)))) (optional (alias expression_list (ref expression_list_body))) (optional (literal %3B))) (concept grammar.return-statement))
