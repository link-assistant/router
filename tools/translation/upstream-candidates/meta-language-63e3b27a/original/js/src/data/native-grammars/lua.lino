(rule word_characters token (seq (class negated (category Cc) (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B) (char %2B) (char -) (char %2A) (char %2F) (char %25) (char %5E) (char %23) (char %26) (char %7E) (char %7C) (char %3C) (char %3E) (char %3D) (char %28) (char %29) (char %7B) (char %7D) (char %5B) (char %5D) (char %3B) (char %3A) (char %2C) (char .) (char %5C) (char %27) (char %22) (range 0 9)) (repeat0 (class negated (category Cc) (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B) (char %2B) (char -) (char %2A) (char %2F) (char %25) (char %5E) (char %23) (char %26) (char %7E) (char %7C) (char %3C) (char %3E) (char %3D) (char %28) (char %29) (char %7B) (char %7D) (char %5B) (char %5D) (char %3B) (char %3A) (char %2C) (char .) (char %5C) (char %27) (char %22)))) (concept grammar.word-characters))
