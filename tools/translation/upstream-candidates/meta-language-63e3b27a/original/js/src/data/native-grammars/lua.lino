(rule for_statement normal (seq (token (seq (literal for) (not (ref word_characters)))) (capture labeled clause (choice unordered (ref for_generic_clause) (ref for_numeric_clause))) (token (seq (literal do) (not (ref word_characters)))) (capture labeled body (optional (alias block (ref statement_block_body)))) (token (seq (literal end) (not (ref word_characters))))) (concept grammar.for-statement))
