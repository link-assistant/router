(grammar (start source_file) (matching longest) (settling tokens precedence dynamic ambiguity))
(scanner bracket_argument (tokens bracket_argument_opening bracket_argument_content bracket_argument_closing) (operations (if (valid bracket_argument_opening) (then (while (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))))) (consume (literal %5B)) (while (next (literal %3D)) (do (consume (literal %3D)) (push delimiters (integer 1)))) (consume (literal %5B)) (emit bracket_argument_opening))) (if (valid bracket_argument_content) (then (while (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))))) (while (not atEnd) (do (if (next (literal %5D)) (then mark (consume (literal %5D)) (while (next (literal %3D)) (do (consume (literal %3D)) (push candidate (integer 1)))) (if (all (equal (depth candidate) (depth delimiters)) (next (literal %5D))) (then (while (greater (depth candidate) (integer 0)) (do (pop candidate))) (emit bracket_argument_content))) (while (greater (depth candidate) (integer 0)) (do (pop candidate)))) (else advance)))) mark (emit bracket_argument_content))) (if (valid bracket_argument_closing) (then (consume (literal %5D)) (while (next (literal %3D)) (do (consume (literal %3D)) (push candidate (integer 1)))) (if (not (equal (depth candidate) (depth delimiters))) (then fail)) (consume (literal %5D)) (while (greater (depth candidate) (integer 0)) (do (pop candidate))) (while (greater (depth delimiters) (integer 0)) (do (pop delimiters))) (emit bracket_argument_closing))) fail))
(scanner bracket_comment (tokens bracket_comment_opening bracket_comment_content bracket_comment_closing) (operations (if (valid bracket_comment_opening) (then (while (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))))) (consume (literal %23%5B)) (while (next (literal %3D)) (do (consume (literal %3D)) (push delimiters (integer 1)))) (consume (literal %5B)) (emit bracket_comment_opening))) (if (valid bracket_comment_content) (then (while (next (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0B) (char %0C) (char %0D))))) (while (not atEnd) (do (if (next (literal %5D)) (then mark (consume (literal %5D)) (while (next (literal %3D)) (do (consume (literal %3D)) (push candidate (integer 1)))) (if (all (equal (depth candidate) (depth delimiters)) (next (literal %5D))) (then (while (greater (depth candidate) (integer 0)) (do (pop candidate))) (emit bracket_comment_content))) (while (greater (depth candidate) (integer 0)) (do (pop candidate)))) (else advance)))) mark (emit bracket_comment_content))) (if (valid bracket_comment_closing) (then (consume (literal %5D)) (while (next (literal %3D)) (do (consume (literal %3D)) (push candidate (integer 1)))) (if (not (equal (depth candidate) (depth delimiters))) (then fail)) (consume (literal %5D)) (while (greater (depth candidate) (integer 0)) (do (pop candidate))) (while (greater (depth delimiters) (integer 0)) (do (pop delimiters))) (emit bracket_comment_closing))) fail))
(kind bracket_argument_opening (source-names (tree-sitter bracket_argument_open)))
(kind bracket_argument_closing (source-names (tree-sitter bracket_argument_close)))
(kind bracket_comment_opening (source-names (tree-sitter bracket_comment_open)))
(kind bracket_comment_closing (source-names (tree-sitter bracket_comment_close)))
(rule source_file normal (repeat0 (ref untrimmed_command_invocation)) (concept grammar.source-file))
(rule escape_sequence normal (choice unordered (ref escape_identity) (ref encoded_escape_sequence) (ref escape_semicolon)) (concept grammar.escape-sequence))
(rule escape_identity token (seq (literal %5C) (class negated (range A Z) (range a z) (range 0 9) (char %3B))) (concept grammar.escape-identity) (source-names (tree-sitter _escape_identity)))
(rule encoded_escape_sequence silent (choice unordered (literal %5Ct) (literal %5Cr) (literal %5Cn)) (concept grammar.encoded-escape-sequence) (source-names (tree-sitter _escape_encoded)))
(rule escape_semicolon silent (choice unordered (literal %3B) (literal %5C%3B)) (concept grammar.escape-semicolon) (source-names (tree-sitter _escape_semicolon)))
(rule variable normal (precedence 0 left (repeat1 (choice unordered (alias unnamed_token (token (class plain (range a z) (range A Z) (range 0 9) (char %2F) (char _) (char .) (char %2B) (char -)))) (ref escape_sequence) (ref variable_reference)))) (concept grammar.variable))
(rule variable_reference normal (choice unordered (ref normal_variable) (ref environment_variable) (ref cache_variable)) (concept grammar.variable-reference) (source-names (tree-sitter variable_ref)))
(rule normal_variable normal (seq (literal %24) (literal %7B) (ref variable) (literal %7D)) (concept grammar.normal-variable) (source-names (tree-sitter normal_var)))
(rule environment_variable normal (seq (literal %24) (literal ENV) (literal %7B) (ref variable) (literal %7D)) (concept grammar.environment-variable) (source-names (tree-sitter env_var)))
(rule cache_variable normal (seq (literal %24) (literal CACHE) (literal %7B) (ref variable) (literal %7D)) (concept grammar.cache-variable) (source-names (tree-sitter cache_var)))
(rule bracket_argument normal (seq (ref bracket_argument_opening) (ref bracket_argument_content) (ref bracket_argument_closing)) (concept grammar.bracket-argument))
(rule bracket_comment normal (seq (ref bracket_comment_opening) (ref bracket_comment_content) (ref bracket_comment_closing)) (concept grammar.bracket-comment))
(rule command_argument_value normal (choice unordered (ref bracket_argument) (ref quoted_argument) (ref unquoted_argument)) (concept grammar.command-argument-value) (source-names (tree-sitter argument)))
(rule untrimmed_argument silent (choice unordered (seq (not (token (seq (repeat0 (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))) (literal %5B) (repeat0 (literal %3D)) (literal %5B)))) (alias unnamed_token (token (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))))) (ref bracket_comment) (ref line_comment) (ref command_argument_value) (ref parenthesized_argument)) (concept grammar.untrimmed-argument) (source-names (tree-sitter _untrimmed_argument)))
(rule parenthesized_argument silent (seq (literal %28) (repeat0 (ref untrimmed_argument)) (literal %29)) (concept grammar.parenthesized-argument) (source-names (tree-sitter _paren_argument)))
(rule quoted_argument normal (seq (literal %22) (optional (ref quoted_element)) (literal %22)) (concept grammar.quoted-argument))
(rule quoted_element normal (repeat1 (choice unordered (ref variable_reference) (ref quoted_text) (ref escape_sequence))) (concept grammar.quoted-element))
(rule quoted_text silent (precedence 0 left (repeat1 (choice unordered (seq (not (token (seq (literal %24) (optional (choice unordered (literal ENV) (literal CACHE))) (literal %7B)))) (literal %24)) (seq (not (token (seq (literal %24) (optional (choice unordered (literal ENV) (literal CACHE))) (literal %7B)))) (alias unnamed_token (token (class negated (char %5C) (char %22)))))))) (concept grammar.quoted-text) (source-names (tree-sitter _quoted_text)))
(rule unquoted_argument normal (precedence 1 right (seq (not (token (seq (literal %5B) (repeat0 (literal %3D)) (literal %5B)))) (precedence 0 right (repeat1 (choice unordered (ref variable_reference) (ref unquoted_argument_text) (ref escape_sequence)))))) (concept grammar.unquoted-argument))
(rule unquoted_argument_text silent (precedence 0 left (repeat1 (choice unordered (seq (not (token (seq (literal %24) (optional (choice unordered (literal ENV) (literal CACHE))) (literal %7B)))) (literal %24)) (seq (not (token (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))) (seq (not (token (seq (literal %24) (optional (choice unordered (literal ENV) (literal CACHE))) (literal %7B)))) (alias unnamed_token (token (class negated (char %28) (char %29) (char %23) (char %22) (char %5C))))))))) (concept grammar.unquoted-argument-text) (source-names (tree-sitter _unquoted_text)))
(rule body normal (precedence 0 right (repeat1 (ref untrimmed_command_invocation))) (concept grammar.body))
(rule argument_list normal (repeat1 (ref untrimmed_argument)) (concept grammar.argument-list))
(rule conditional_opening_command normal (seq (ref conditional_keyword) (repeat0 (alias unnamed_token (token (class plain (char %09) (char %20))))) (literal %28) (ref argument_list) (literal %29)) (concept grammar.conditional-opening-command) (source-names (tree-sitter if_command)))
