(rule if_condition normal (seq (ref conditional_opening_command) (repeat0 (choice unordered (ref body) (ref alternative_condition_opening_command) (ref alternative_opening_command))) (ref end_if_command)) (concept grammar.if-condition))
(rule iteration_opening_command normal (seq (ref iteration_keyword) (repeat0 (alias unnamed_token (token (class plain (char %09) (char %20))))) (literal %28) (ref argument_list) (literal %29)) (concept grammar.iteration-opening-command) (source-names (tree-sitter foreach_command)))
