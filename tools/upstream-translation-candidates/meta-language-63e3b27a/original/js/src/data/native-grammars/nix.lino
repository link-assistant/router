(grammar (start source_code) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))
(extra (ref comment))
(scanner string_fragment (tokens string_fragment) (operations (if (not (valid string_fragment)) (then fail)) (if (some atEnd (next (literal %22)) (next (literal %5C)) (next (literal %24%7B))) (then fail)) (while (not (some atEnd (next (literal %22)) (next (literal %5C)) (next (literal %24%7B)))) (do (if (some (next (literal %00))) (then fail)) (if (next (literal %24)) (then (consume (literal %24)) (if (not (some atEnd (next (literal %22)) (next (literal %5C)) (next (literal %7B)))) (then advance))) (else advance)))) (if atEnd (then fail)) (emit string_fragment)))
(scanner indented_string_fragment (tokens indented_string_fragment) (operations (if (not (valid indented_string_fragment)) (then fail)) (if (some atEnd (next (literal %27%27)) (next (literal %24%7B))) (then fail)) (while (not (some atEnd (next (literal %27%27)) (next (literal %24%7B)))) (do (if (some (next (literal %00))) (then fail)) (if (next (literal %24)) (then (consume (literal %24)) (if (not (some atEnd (next (literal %27)) (next (literal %7B)))) (then advance))) (else advance)))) (if atEnd (then fail)) (emit indented_string_fragment)))
(kind indented_string_fragment (source-names (tree-sitter _indented_string_fragment)))
(rule source_code normal (optional (capture labeled expression (ref expression))) (concept grammar.source-code))
(rule expression silent (ref expression_function_expression) (concept grammar.expression) (source-names (tree-sitter _expression)))
(rule keyword token (choice unordered (literal if) (literal then) (literal else) (literal let) (literal inherit) (literal in) (literal rec) (literal with) (literal assert)) (concept grammar.keyword))
(rule identifier token (seq (class plain (range a z) (range A Z) (char _)) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char _) (char %27) (char -)))) (concept grammar.identifier))
(rule variable_expression normal (capture labeled name (ref identifier)) (concept grammar.variable-expression))
(rule integer_literal_expression token (repeat1 (class plain (range 0 9))) (concept grammar.integer-literal-expression) (source-names (tree-sitter integer_expression)))
(rule float_expression token (seq (choice unordered (seq (class plain (range 1 9)) (repeat0 (class plain (range 0 9))) (literal .) (repeat0 (class plain (range 0 9)))) (seq (optional (literal 0)) (literal .) (repeat1 (class plain (range 0 9))))) (optional (seq (class plain (char E) (char e)) (optional (class plain (char %2B) (char -))) (repeat1 (class plain (range 0 9)))))) (concept grammar.float-expression))
(rule path_expression normal (seq (alias path_fragment (ref path_initial_fragment)) (repeat0 (choice unordered (dynamicPrecedence 1 (alias path_fragment (immediateToken (ref path_fragment)))) (alias interpolation (ref immediate_interpolation))))) (concept grammar.path-expression))
(rule home_path_initial_fragment token (seq (literal %7E%2F) (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char .) (char _) (char -) (char %2B) (char %2F)))) (concept grammar.home-path-initial-fragment) (source-names (tree-sitter _hpath_start)))
(rule home_path_expression normal (seq (alias path_fragment (ref home_path_initial_fragment)) (repeat0 (choice unordered (dynamicPrecedence 1 (alias path_fragment (immediateToken (ref path_fragment)))) (alias interpolation (ref immediate_interpolation))))) (concept grammar.home-path-expression) (source-names (tree-sitter hpath_expression)))
(rule search_path_expression token (seq (literal %3C) (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char .) (char _) (char -) (char %2B))) (repeat0 (seq (literal %2F) (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char .) (char _) (char -) (char %2B))))) (literal %3E)) (concept grammar.search-path-expression) (source-names (tree-sitter spath_expression)))
(rule resource_identifier_expression token (seq (class plain (range a z) (range A Z)) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char %2B) (char -) (char .))) (literal %3A) (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char %25) (char %2F) (char %3F) (char %3A) (char %40) (char %26) (char %3D) (char %2B) (char %24) (char %2C) (char -) (char _) (char .) (char %21) (char %7E) (char %2A) (char %27)))) (concept grammar.resource-identifier-expression) (source-names (tree-sitter uri_expression)))
(rule expression_function_expression silent (choice unordered (ref anonymous_function_expression) (ref assert_expression) (ref with_expression) (ref let_expression) (ref conditional_expression_body)) (concept grammar.expression-function-expression) (source-names (tree-sitter _expr_function_expression)))
(rule anonymous_function_expression normal (choice unordered (seq (capture labeled universal (ref identifier)) (literal %3A) (capture labeled body (ref expression_function_expression))) (seq (capture labeled formals (ref formal_parameter_list)) (literal %3A) (capture labeled body (ref expression_function_expression))) (seq (capture labeled formals (ref formal_parameter_list)) (literal %40) (capture labeled universal (ref identifier)) (literal %3A) (capture labeled body (ref expression_function_expression))) (seq (capture labeled universal (ref identifier)) (literal %40) (capture labeled formals (ref formal_parameter_list)) (literal %3A) (capture labeled body (ref expression_function_expression)))) (concept grammar.anonymous-function-expression) (source-names (tree-sitter function_expression)))
(rule formal_parameter_list normal (choice unordered (seq (literal %7B) (literal %7D)) (seq (literal %7B) (seq (capture labeled formal (ref formal_parameter)) (repeat0 (seq (literal %2C) (capture labeled formal (ref formal_parameter))))) (literal %7D)) (seq (literal %7B) (seq (capture labeled formal (ref formal_parameter)) (repeat0 (seq (literal %2C) (capture labeled formal (ref formal_parameter))))) (optional (seq (literal %2C) (optional (capture labeled ellipses (ref ellipses))))) (literal %7D)) (seq (literal %7B) (capture labeled ellipses (ref ellipses)) (literal %7D))) (concept grammar.formal-parameter-list) (source-names (tree-sitter formals)))
(rule formal_parameter normal (seq (capture labeled name (ref identifier)) (optional (seq (literal %3F) (capture labeled default (ref expression))))) (concept grammar.formal-parameter) (source-names (tree-sitter formal)))
(rule ellipses token (literal ...) (concept grammar.ellipses))
(rule assert_expression normal (seq (token (seq (literal assert) (not (ref word_characters)))) (capture labeled condition (ref expression)) (literal %3B) (capture labeled body (ref expression_function_expression))) (concept grammar.assert-expression))
(rule with_expression normal (seq (token (seq (literal with) (not (ref word_characters)))) (capture labeled environment (ref expression)) (literal %3B) (capture labeled body (ref expression_function_expression))) (concept grammar.with-expression))
(rule let_expression normal (seq (token (seq (literal let) (not (ref word_characters)))) (optional (ref binding_set)) (token (seq (literal in) (not (ref word_characters)))) (capture labeled body (ref expression_function_expression))) (concept grammar.let-expression))
(rule conditional_expression_body silent (choice unordered (ref if_expression) (ref expression_operator)) (concept grammar.conditional-expression-body) (source-names (tree-sitter _expr_if)))
(rule if_expression normal (seq (token (seq (literal if) (not (ref word_characters)))) (capture labeled condition (ref expression)) (token (seq (literal then) (not (ref word_characters)))) (capture labeled consequence (ref expression)) (token (seq (literal else) (not (ref word_characters)))) (capture labeled alternative (ref expression))) (concept grammar.if-expression))
(rule expression_operator silent (choice unordered (ref has_attribute_expression) (ref unary_expression) (ref binary_expression) (ref expression_apply_expression)) (concept grammar.expression-operator) (source-names (tree-sitter _expr_op)))
(rule has_attribute_expression normal (precedence 11 none (seq (capture labeled expression (ref expression_operator)) (capture labeled operator (literal %3F)) (capture labeled attrpath (ref attribute_path)))) (concept grammar.has-attribute-expression) (source-names (tree-sitter has_attr_expression)))
(rule unary_expression normal (choice unordered (precedence 7 none (seq (capture labeled operator (literal %21)) (capture labeled argument (ref expression_operator)))) (precedence 12 none (seq (capture labeled operator (literal -)) (capture labeled argument (ref expression_operator))))) (concept grammar.unary-expression))
(rule binary_expression normal (choice unordered (precedence 4 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %3D%3D)) (capture labeled right (ref expression_operator)))) (precedence 4 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %21%3D)) (capture labeled right (ref expression_operator)))) (precedence 5 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %3C)) (capture labeled right (ref expression_operator)))) (precedence 5 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %3C%3D)) (capture labeled right (ref expression_operator)))) (precedence 5 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %3E)) (capture labeled right (ref expression_operator)))) (precedence 5 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %3E%3D)) (capture labeled right (ref expression_operator)))) (precedence 3 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %26%26)) (capture labeled right (ref expression_operator)))) (precedence 2 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %7C%7C)) (capture labeled right (ref expression_operator)))) (precedence 8 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %2B)) (capture labeled right (ref expression_operator)))) (precedence 8 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal -)) (capture labeled right (ref expression_operator)))) (precedence 9 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %2A)) (capture labeled right (ref expression_operator)))) (precedence 9 left (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %2F)) (capture labeled right (ref expression_operator)))) (precedence 1 right (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal -%3E)) (capture labeled right (ref expression_operator)))) (precedence 6 right (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %2F%2F)) (capture labeled right (ref expression_operator)))) (precedence 10 right (seq (capture labeled left (ref expression_operator)) (capture labeled operator (literal %2B%2B)) (capture labeled right (ref expression_operator))))) (concept grammar.binary-expression))
(rule expression_apply_expression silent (choice unordered (ref apply_expression) (ref expression_select_expression)) (concept grammar.expression-apply-expression) (source-names (tree-sitter _expr_apply_expression)))
(rule apply_expression normal (seq (capture labeled function (ref expression_apply_expression)) (capture labeled argument (ref expression_select_expression))) (concept grammar.apply-expression))
(rule expression_select_expression silent (choice unordered (ref select_expression) (ref expression_simple)) (concept grammar.expression-select-expression) (source-names (tree-sitter _expr_select_expression)))
(rule select_expression normal (choice unordered (seq (capture labeled expression (ref expression_simple)) (literal .) (capture labeled attrpath (ref attribute_path))) (seq (capture labeled expression (ref expression_simple)) (literal .) (capture labeled attrpath (ref attribute_path)) (literal or) (capture labeled default (ref expression_select_expression)))) (concept grammar.select-expression))
(rule expression_simple silent (choice unordered (ref variable_expression) (ref integer_literal_expression) (ref float_expression) (ref string_expression) (ref indented_string_expression) (ref path_expression) (ref home_path_expression) (ref search_path_expression) (ref resource_identifier_expression) (ref parenthesized_expression) (ref attribute_set_expression) (ref local_attribute_set_expression) (ref recursive_attribute_set_expression) (ref list_expression)) (concept grammar.expression-simple) (source-names (tree-sitter _expr_simple)))
(rule parenthesized_expression normal (seq (literal %28) (capture labeled expression (ref expression)) (literal %29)) (concept grammar.parenthesized-expression))
(rule attribute_set_expression normal (seq (literal %7B) (optional (ref binding_set)) (literal %7D)) (concept grammar.attribute-set-expression) (source-names (tree-sitter attrset_expression)))
(rule local_attribute_set_expression normal (seq (token (seq (literal let) (not (ref word_characters)))) (literal %7B) (optional (ref binding_set)) (literal %7D)) (concept grammar.local-attribute-set-expression) (source-names (tree-sitter let_attrset_expression)))
(rule recursive_attribute_set_expression normal (seq (token (seq (literal rec) (not (ref word_characters)))) (literal %7B) (optional (ref binding_set)) (literal %7D)) (concept grammar.recursive-attribute-set-expression) (source-names (tree-sitter rec_attrset_expression)))
(rule string_expression normal (seq (literal %22) (repeat0 (choice unordered (alias string_fragment (immediateToken (ref string_fragment))) (ref interpolation) (choice unordered (ref escape_sequence) (seq (alias dollar_escape (immediateToken (ref dollar_escape))) (alias string_fragment (literal %24)))))) (literal %22)) (concept grammar.string-expression))
(rule escape_sequence silent (alias escape_sequence (immediateToken (seq (literal %5C) (choice unordered (class negated (char %24)) (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))))) (concept grammar.escape-sequence))
(rule indented_string_expression normal (seq (literal %27%27) (repeat0 (choice unordered (alias string_fragment (immediateToken (ref indented_string_fragment))) (ref interpolation) (choice unordered (alias escape_sequence (immediateToken (choice unordered (literal %27%27%27) (seq (literal %27%27%5C) (choice unordered (class negated (char %24)) (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))))))) (seq (alias dollar_escape (immediateToken (ref indented_dollar_escape))) (alias string_fragment (literal %24)))))) (literal %27%27)) (concept grammar.indented-string-expression))
(rule indented_escape_sequence silent (alias unnamed_token (immediateToken (choice unordered (literal %27%27%27) (seq (literal %27%27%5C) (choice unordered (class negated (char %24)) (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))))))) (concept grammar.indented-escape-sequence) (source-names (tree-sitter _indented_escape_sequence)))
(rule binding_set normal (repeat1 (capture labeled binding (choice unordered (ref attribute_binding) (ref attribute_inheritance_clause) (ref attribute_inheritance_source_clause)))) (concept grammar.binding-set))
(rule attribute_binding normal (seq (capture labeled attrpath (ref attribute_path)) (literal %3D) (capture labeled expression (ref expression)) (literal %3B)) (concept grammar.attribute-binding) (source-names (tree-sitter binding)))
(rule attribute_inheritance_clause normal (seq (token (seq (literal inherit) (not (ref word_characters)))) (capture labeled attrs (ref inherited_attribute_list)) (literal %3B)) (concept grammar.attribute-inheritance-clause) (source-names (tree-sitter inherit)))
(rule attribute_inheritance_source_clause normal (seq (token (seq (literal inherit) (not (ref word_characters)))) (literal %28) (capture labeled expression (ref expression)) (literal %29) (capture labeled attrs (ref inherited_attribute_list)) (literal %3B)) (concept grammar.attribute-inheritance-source-clause) (source-names (tree-sitter inherit_from)))
(rule attribute_path normal (seq (capture labeled attr (choice unordered (ref identifier) (ref string_expression) (ref interpolation))) (repeat0 (seq (literal .) (capture labeled attr (choice unordered (ref identifier) (ref string_expression) (ref interpolation)))))) (concept grammar.attribute-path) (source-names (tree-sitter attrpath)))
(rule inherited_attribute_list normal (repeat1 (capture labeled attr (choice unordered (ref identifier) (ref string_expression) (ref interpolation)))) (concept grammar.inherited-attribute-list) (source-names (tree-sitter inherited_attrs)))
(rule immediate_interpolation silent (seq (immediateToken (literal %24%7B)) (capture labeled expression (ref expression)) (literal %7D)) (concept grammar.immediate-interpolation) (source-names (tree-sitter _immediate_interpolation)))
(rule interpolation normal (seq (literal %24%7B) (capture labeled expression (ref expression)) (literal %7D)) (concept grammar.interpolation))
(rule list_expression normal (seq (literal %5B) (repeat0 (capture labeled element (ref expression_select_expression))) (literal %5D)) (concept grammar.list-expression))
(rule comment token (choice unordered (seq (literal %23) (repeat0 (class negated (char %0A)))) (seq (literal %2F%2A) (seq (repeat0 (class negated (char %2A))) (repeat1 (literal %2A)) (repeat0 (seq (class negated (char %2F) (char %2A)) (repeat0 (class negated (char %2A))) (repeat1 (literal %2A))))) (literal %2F))) (concept grammar.comment))
(rule word_characters token (choice unordered (literal if) (literal then) (literal else) (literal let) (literal inherit) (literal in) (literal rec) (literal with) (literal assert)) (concept grammar.word-characters))
(rule path_initial_plain_fragment token (seq (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (literal %2F) (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char -)) (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -)))) (concept grammar.path-initial-plain-fragment))
(rule path_initial_interpolation_fragment token (seq (seq (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (literal %2F) (repeat0 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -)))) (and (literal %24))) (concept grammar.path-initial-interpolation-fragment))
(rule path_fragment token (repeat1 (class plain (range 0 9) (range A Z) (range a z) (char %2B) (char _) (char .) (char %2F) (char -))) (concept grammar.path-fragment))
(rule dollar_escape token (seq (literal %5C) (and (literal %24))) (concept grammar.dollar-escape))
(rule indented_dollar_escape token (seq (seq (literal %27%27) (optional (literal %5C))) (and (literal %24))) (concept grammar.indented-dollar-escape) (source-names (tree-sitter _indented_dollar_escape)))
(rule path_initial_fragment token (choice unordered (ref path_initial_plain_fragment) (ref path_initial_interpolation_fragment)) (concept grammar.path-initial-fragment) (source-names (tree-sitter _path_start)))
