(grammar (start document))
(extra (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C)))
(extra (ref comment))
(rule document normal (seq (optional (alias byte_order_mark (immediateToken (literal %EF%BB%BF)))) (repeat0 (ref value))) (concept grammar.document))
(rule value silent (choice unordered (ref object) (ref array) (ref number) (ref string) (ref true) (ref false) (ref null)) (concept grammar.value) (source-names (tree-sitter _value)))
(rule object normal (seq (literal %7B) (optional (seq (ref pair) (repeat0 (seq (literal %2C) (ref pair))))) (literal %7D)) (concept grammar.object))
(rule pair normal (seq (capture labeled key (ref string)) (literal %3A) (capture labeled value (ref value))) (concept grammar.member))
(rule array normal (seq (literal %5B) (optional (seq (ref value) (repeat0 (seq (literal %2C) (ref value))))) (literal %5D)) (concept grammar.list))
(rule string normal (seq (literal %22) (repeat0 (choice unordered (alias string_content (immediateToken (repeat1 (class negated (char %5C) (char %22) (char %0A))))) (alias escape_sequence (immediateToken (seq (literal %5C) (class plain (char %22) (char %5C) (char %2F) (char b) (char f) (char n) (char r) (char t) (char u))))))) (immediateToken (literal %22))) (concept grammar.string))
(rule number token (seq (optional (literal -)) (choice unordered (literal 0) (seq (range 1 9) (repeat0 (range 0 9)))) (optional (seq (literal .) (repeat0 (range 0 9)))) (optional (seq (class plain (char e) (char E)) (optional (class plain (char %2B) (char -))) (repeat1 (range 0 9))))) (concept grammar.number))
(rule true token (literal true) (concept grammar.true-value))
(rule false token (literal false) (concept grammar.false-value))
(rule null token (literal null) (concept grammar.null))
(rule comment token (choice unordered (seq (literal %2F%2F) (repeat0 (class negated (char %0A)))) (seq (literal %2F%2A) (repeat0 (choice unordered (class negated (char %2A)) (seq (literal %2A) (not (literal %2F))))) (literal %2A%2F))) (concept grammar.comment))
