(rule document normal (precedence 2 none (seq (optional (ref whitespace)) (optional (ref prolog)) (capture labeled root (ref markup_element)) (repeat0 (ref miscellaneous_item)))) (concept grammar.document))
(rule prolog normal (choice unordered (seq (ref extensible_markup_language_declaration) (repeat0 (ref miscellaneous_item))) (seq (optional (ref extensible_markup_language_declaration)) (repeat0 (ref miscellaneous_item)) (ref document_type_declaration) (repeat0 (ref miscellaneous_item))) (repeat1 (ref miscellaneous_item))) (concept grammar.prolog))
