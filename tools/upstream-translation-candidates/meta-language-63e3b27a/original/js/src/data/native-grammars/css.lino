(grammar (start style_sheet) (matching longest) (settling tokens precedence dynamic ambiguity))
(extra (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))
(extra (ref comment))
(extra (ref js_comment))
(scanner descendant_selection (tokens descendant_operator) (operations (if (not (valid descendant_operator)) (then fail)) (if (some (expected (ref error_recovery))) (then fail)) (if (not (next (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C)))) (then fail)) (while (next (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C))))) mark (if (next (class plain (char %23) (char .) (char %5B) (char -) (char %2A) (range a z) (range A Z) (range 0 9))) (then (emit descendant_operator))) (consume (literal %3A)) (if (next (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C))) (then fail)) (while (not atEnd) (do (if (some (next (literal %3B)) (next (literal %7D))) (then fail)) (if (all (next (literal %7B))) (then (emit descendant_operator))) advance)) fail))
(scanner pseudo_class_selection (tokens pseudo_class_selector_colon) (operations (if (not (valid pseudo_class_selector_colon)) (then fail)) (if (some (expected (ref error_recovery))) (then fail)) (while (next (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C))) (do (skip (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0B) (char %0C))))) (consume (literal %3A)) (if (some (next (literal %3A))) (then fail)) mark (while (not atEnd) (do (if (some (next (literal %3B)) (next (literal %7D))) (then fail)) advance (if (all (next (literal %7B)) (equal (depth comment) (integer 0))) (then (emit pseudo_class_selector_colon))) (if (all (equal (depth comment) (integer 0)) (next (literal %2F))) (then advance (if (next (literal %2A)) (then (push comment (integer 1))))) (else (if (all (greater (depth comment) (integer 0)) (next (literal %2A))) (then advance (if (next (literal %2F)) (then (pop comment))))))))) (while (greater (depth comment) (integer 0)) (do (pop comment))) (emit pseudo_class_selector_colon)))
(scanner rejection_guard (tokens error_recovery) (operations fail))
(kind key_frames_name (source-names (tree-sitter keyframes_name)))
(kind identifier_name (source-names (tree-sitter id_name)))
(kind descendant_operator (source-names (tree-sitter _descendant_operator)))
(kind pseudo_class_selector_colon (source-names (tree-sitter _pseudo_class_selector_colon)))
(kind error_recovery (source-names (tree-sitter __error_recovery)))
(rule style_sheet normal (repeat0 (ref top_level_item)) (concept grammar.style-sheet) (source-names (tree-sitter stylesheet)))
(rule top_level_item silent (choice unordered (ref declaration) (ref rule_set) (ref import_statement) (ref medium_statement) (ref character_set_statement) (ref namespace_statement) (ref key_frames_statement) (ref supports_statement) (ref scope_statement) (ref at_rule)) (concept grammar.top-level-item) (source-names (tree-sitter _top_level_item)))
(rule import_statement normal (seq (literal %40import) (ref value) (optional (seq (ref selection_query) (repeat0 (seq (literal %2C) (ref selection_query))))) (literal %3B)) (concept grammar.import-statement))
(rule medium_statement normal (seq (literal %40media) (seq (ref selection_query) (repeat0 (seq (literal %2C) (ref selection_query)))) (ref block)) (concept grammar.medium-statement) (source-names (tree-sitter media_statement)))
(rule character_set_statement normal (seq (literal %40charset) (ref value) (literal %3B)) (concept grammar.character-set-statement) (source-names (tree-sitter charset_statement)))
(rule namespace_statement normal (seq (literal %40namespace) (optional (alias namespace_name (ref identifier))) (choice unordered (ref string_value) (ref call_expression)) (literal %3B)) (concept grammar.namespace-statement))
(rule key_frames_statement normal (seq (choice unordered (literal %40keyframes) (alias at_keyword (token (seq (literal %40) (repeat1 (class plain (char -) (range a z))) (literal keyframes))))) (alias key_frames_name (ref identifier)) (ref key_frame_block_list)) (concept grammar.key-frames-statement) (source-names (tree-sitter keyframes_statement)))
(rule key_frame_block_list normal (seq (literal %7B) (repeat0 (ref key_frame_block)) (literal %7D)) (concept grammar.key-frame-block-list) (source-names (tree-sitter keyframe_block_list)))
(rule key_frame_block normal (seq (seq (choice unordered (ref initial_key_frame) (ref final_key_frame) (ref integer_value)) (repeat0 (seq (literal %2C) (choice unordered (ref initial_key_frame) (ref final_key_frame) (ref integer_value))))) (ref block)) (concept grammar.key-frame-block) (source-names (tree-sitter keyframe_block)))
(rule initial_key_frame token (literal from) (concept grammar.initial-key-frame) (source-names (tree-sitter from)))
(rule final_key_frame normal (literal to) (concept grammar.final-key-frame) (source-names (tree-sitter to)))
(rule supports_statement normal (seq (literal %40supports) (ref selection_query) (ref block)) (concept grammar.supports-statement))
(rule scope_statement normal (seq (literal %40scope) (optional (seq (literal %28) (ref selector) (literal %29) (optional (seq (literal to) (literal %28) (ref selector) (literal %29))))) (ref block)) (concept grammar.scope-statement))
(rule post_processing_style_statement normal (precedence -1 none (seq (ref at_keyword) (repeat0 (choice unordered (ref value) (ref important_value))) (literal %3B))) (concept grammar.post-processing-style-statement) (source-names (tree-sitter postcss_statement)))
(rule at_rule normal (seq (ref at_keyword) (optional (seq (ref selection_query) (repeat0 (seq (literal %2C) (ref selection_query))))) (choice unordered (literal %3B) (ref block))) (concept grammar.at-rule))
(rule rule_set normal (seq (ref selector_list) (ref block)) (concept grammar.rule-set))
(rule selector_list normal (seq (ref selector) (repeat0 (seq (literal %2C) (ref selector)))) (concept grammar.selector-list) (source-names (tree-sitter selectors)))
(rule block normal (seq (literal %7B) (repeat0 (ref block_item)) (optional (alias declaration (ref last_declaration))) (literal %7D)) (concept grammar.block))
(rule block_item silent (choice unordered (ref declaration) (ref rule_set) (ref import_statement) (ref medium_statement) (ref character_set_statement) (ref namespace_statement) (ref key_frames_statement) (ref supports_statement) (ref scope_statement) (ref post_processing_style_statement) (ref at_rule)) (concept grammar.block-item) (source-names (tree-sitter _block_item)))
(rule selector silent (choice unordered (ref universal_selector) (alias tag_name (ref identifier)) (ref class_selector) (ref nesting_selector) (ref pseudo_class_selector) (ref pseudo_element_selector) (ref identifier_selector) (ref attribute_selector) (ref string_value) (ref child_selector) (ref descendant_selector) (ref sibling_selector) (ref adjacent_sibling_selector) (ref namespace_selector)) (concept grammar.selector) (source-names (tree-sitter _selector)))
(rule nesting_selector token (literal %26) (concept grammar.nesting-selector))
(rule universal_selector normal (literal %2A) (concept grammar.universal-selector))
(rule class_selector normal (precedence 1 none (seq (optional (ref selector)) (literal .) (ref class_name))) (concept grammar.class-selector))
(rule pseudo_class_selector normal (seq (optional (ref selector)) (alias %27%3A (ref pseudo_class_selector_colon)) (choice unordered (seq (alias class_name (choice unordered (literal has) (literal not) (literal is) (literal where) (literal host) (literal host-context))) (alias argument_list (ref pseudo_class_with_selector_arguments))) (ref nth_child_pseudo_class_selector) (seq (ref class_name) (optional (alias argument_list (ref pseudo_class_arguments)))) (alias class_name (literal host)))) (concept grammar.pseudo-class-selector))
(rule nth_child_pseudo_class_selector silent (seq (alias class_name (choice unordered (literal nth-child) (literal nth-last-child))) (alias argument_list (ref pseudo_class_nth_child_arguments))) (concept grammar.nth-child-pseudo-class-selector) (source-names (tree-sitter _nth_child_pseudo_class_selector)))
(rule pseudo_element_selector normal (seq (optional (ref selector)) (literal %3A%3A) (alias tag_name (ref identifier)) (optional (alias argument_list (ref pseudo_element_arguments)))) (concept grammar.pseudo-element-selector))
(rule identifier_selector normal (seq (optional (ref selector)) (literal %23) (alias identifier_name (ref identifier))) (concept grammar.identifier-selector) (source-names (tree-sitter id_selector)))
(rule attribute_selector normal (seq (optional (ref selector)) (token (lexicalPrecedence 1 (literal %5B))) (alias attribute_name (choice unordered (ref identifier) (ref namespace_selector))) (optional (seq (choice unordered (literal %3D) (literal %7E%3D) (literal %5E%3D) (literal %7C%3D) (literal %2A%3D) (literal %24%3D)) (ref value))) (literal %5D)) (concept grammar.attribute-selector))
(rule child_selector normal (precedence 0 left (seq (optional (ref selector)) (literal %3E) (ref selector))) (concept grammar.child-selector))
(rule descendant_selector normal (precedence 0 left (seq (ref selector) (alias unnamed_token (immediateToken (ref descendant_operator))) (ref selector))) (concept grammar.descendant-selector))
(rule sibling_selector normal (precedence 0 left (seq (optional (ref selector)) (literal %7E) (ref selector))) (concept grammar.sibling-selector))
(rule adjacent_sibling_selector normal (precedence 0 left (seq (optional (ref selector)) (literal %2B) (ref selector))) (concept grammar.adjacent-sibling-selector))
(rule namespace_selector normal (precedence 0 left (seq (optional (ref selector)) (literal %7C) (ref selector))) (concept grammar.namespace-selector))
(rule pseudo_class_arguments normal (seq (immediateToken (literal %28)) (optional (seq (choice unordered (dynamicPrecedence 1 (ref selector)) (repeat1 (ref value))) (repeat0 (seq (literal %2C) (choice unordered (dynamicPrecedence 1 (ref selector)) (repeat1 (ref value))))))) (literal %29)) (concept grammar.pseudo-class-arguments))
(rule pseudo_class_with_selector_arguments normal (seq (immediateToken (literal %28)) (optional (seq (ref selector) (repeat0 (seq (literal %2C) (ref selector))))) (literal %29)) (concept grammar.pseudo-class-with-selector-arguments))
(rule pseudo_class_nth_child_arguments normal (precedence -1 none (seq (immediateToken (literal %28)) (choice unordered (alias plain_value (literal even)) (alias plain_value (literal odd)) (ref integer_value) (alias plain_value (ref nth_functional_notation))) (optional (seq (literal of) (ref selector))) (literal %29))) (concept grammar.pseudo-class-nth-child-arguments))
(rule nth_functional_notation token (seq (optional (literal -)) (repeat0 (class plain (range 0 9))) (literal n) (repeat0 (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))) (optional (seq (literal %2B) (repeat0 (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B))) (repeat1 (class plain (range 0 9)))))) (concept grammar.nth-functional-notation) (source-names (tree-sitter _nth_functional_notation)))
(rule pseudo_element_arguments normal (seq (immediateToken (literal %28)) (optional (seq (choice unordered (dynamicPrecedence 1 (ref selector)) (repeat1 (ref value))) (repeat0 (seq (literal %2C) (choice unordered (dynamicPrecedence 1 (ref selector)) (repeat1 (ref value))))))) (literal %29)) (concept grammar.pseudo-element-arguments))
(rule declaration normal (seq (alias property_name (ref identifier)) (literal %3A) (ref value) (repeat0 (seq (optional (literal %2C)) (ref value))) (optional (ref importance_modifier)) (literal %3B)) (concept grammar.declaration))
(rule last_declaration normal (precedence 1 none (seq (alias property_name (ref identifier)) (literal %3A) (ref value) (repeat0 (seq (optional (literal %2C)) (ref value))) (optional (ref importance_modifier)))) (concept grammar.last-declaration))
(rule importance_modifier token (literal %21important) (concept grammar.importance-modifier) (source-names (tree-sitter important)))
(rule selection_query silent (choice unordered (alias keyword_query (ref identifier)) (ref feature_query) (ref binary_query) (ref unary_query) (ref selector_query) (ref parenthesized_query)) (concept grammar.selection-query) (source-names (tree-sitter _query)))
(rule feature_query normal (seq (literal %28) (alias feature_name (ref identifier)) (literal %3A) (repeat1 (ref value)) (literal %29)) (concept grammar.feature-query))
(rule parenthesized_query normal (seq (literal %28) (ref selection_query) (literal %29)) (concept grammar.parenthesized-query))
(rule binary_query normal (precedence 0 left (seq (ref selection_query) (choice unordered (literal and) (literal or)) (ref selection_query))) (concept grammar.binary-query))
(rule unary_query normal (precedence 1 none (seq (choice unordered (literal not) (literal only)) (ref selection_query))) (concept grammar.unary-query))
(rule selector_query normal (seq (literal selector) (literal %28) (ref selector) (literal %29)) (concept grammar.selector-query))
(rule value silent (precedence -1 none (choice unordered (alias plain_value (ref identifier)) (ref plain_value) (ref color_value) (ref integer_value) (ref float_value) (ref string_value) (ref grid_value) (ref binary_expression) (ref parenthesized_value) (ref call_expression) (ref importance_modifier))) (concept grammar.value) (source-names (tree-sitter _value)))
(rule parenthesized_value normal (seq (literal %28) (ref value) (literal %29)) (concept grammar.parenthesized-value))
(rule color_value normal (seq (literal %23) (alias unnamed_token (immediateToken (repeat 3 8 (class plain (range 0 9) (range a f) (range A F)))))) (concept grammar.color-value))
(rule string_value normal (choice unordered (seq (literal %27) (repeat0 (choice unordered (alias string_content (token (repeat1 (class negated (char %5C) (char %27) (char %0A))))) (ref escape_sequence))) (literal %27)) (seq (literal %22) (repeat0 (choice unordered (alias string_content (token (repeat1 (class negated (char %5C) (char %22) (char %0A))))) (ref escape_sequence))) (literal %22))) (concept grammar.string-value))
(rule escape_sequence token (seq (literal %5C) (choice unordered (seq (repeat 1 6 (class plain (range 0 9) (range a f) (range A F))) (optional (class plain (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B)))) (class negated (range 0 9) (range a f) (range A F) (char %0A) (char %0D)))) (concept grammar.escape-sequence))
(rule integer_value normal (seq (alias unnamed_token (token (seq (optional (choice unordered (literal %2B) (literal -))) (repeat1 (class plain (range 0 9)))))) (optional (ref unit))) (concept grammar.integer-value))
(rule float_value normal (seq (alias unnamed_token (token (seq (optional (choice unordered (literal %2B) (literal -))) (repeat0 (class plain (range 0 9))) (choice unordered (seq (literal .) (repeat1 (class plain (range 0 9)))) (seq (class plain (char e) (char E)) (optional (literal -)) (repeat1 (class plain (range 0 9)))) (seq (literal .) (repeat1 (class plain (range 0 9))) (class plain (char e) (char E)) (optional (literal -)) (repeat1 (class plain (range 0 9)))))))) (optional (ref unit))) (concept grammar.float-value))
(rule unit silent (alias unit (immediateToken (repeat1 (class plain (range a z) (range A Z) (char %25))))) (concept grammar.unit))
(rule grid_value normal (seq (literal %5B) (seq (ref value) (repeat0 (seq (literal %2C) (ref value)))) (literal %5D)) (concept grammar.grid-value))
(rule call_expression normal (dynamicPrecedence 1 (seq (alias function_name (ref identifier)) (ref argument_list))) (concept grammar.call-expression))
(rule binary_expression normal (precedence 0 left (seq (ref value) (choice unordered (literal %2B) (literal -) (literal %2A) (literal %2F)) (ref value))) (concept grammar.binary-expression))
(rule argument_list normal (seq (immediateToken (literal %28)) (optional (seq (repeat1 (ref value)) (repeat0 (seq (choice unordered (literal %2C) (literal %3B)) (repeat1 (ref value)))))) (literal %29)) (concept grammar.argument-list) (source-names (tree-sitter arguments)))
(rule class_name normal (seq (choice unordered (ref identifier) (ref escape_sequence)) (repeat0 (choice unordered (alias identifier (token (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char -) (char _) (range %C2%A0 %C3%BF))))) (ref escape_sequence)))) (concept grammar.class-name))
(rule identifier token (seq (choice unordered (literal --) (seq (optional (literal -)) (class plain (range a z) (range A Z) (char _) (range %C2%A0 %C3%BF)))) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char -) (char _) (range %C2%A0 %C3%BF)))) (concept grammar.identifier))
(rule at_keyword token (seq (literal %40) (repeat1 (class plain (range a z) (range A Z) (char -) (char _)))) (concept grammar.at-keyword))
(rule js_comment token (lexicalPrecedence -1 (seq (literal %2F%2F) (repeat0 (class negated (char %0A))))) (concept grammar.js-comment))
(rule comment token (seq (literal %2F%2A) (seq (repeat0 (class negated (char %2A))) (repeat1 (literal %2A)) (repeat0 (seq (class negated (char %2F) (char %2A)) (repeat0 (class negated (char %2A))) (repeat1 (literal %2A))))) (literal %2F)) (concept grammar.comment))
(rule plain_value token (seq (repeat0 (choice unordered (class plain (char -) (char _)) (seq (literal %2F) (class negated (char %2A) (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B) (char %2C) (char %3B) (char %21) (char %7B) (char %7D) (char %28) (char %29) (char %5B) (char %5D))))) (class plain (range a z) (range A Z)) (repeat0 (choice unordered (class negated (char %2F) (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B) (char %2C) (char %3B) (char %21) (char %7B) (char %7D) (char %28) (char %29) (char %5B) (char %5D)) (seq (literal %2F) (class negated (char %2A) (char %20) (char %09) (char %0A) (char %0D) (char %0C) (char %0B) (char %2C) (char %3B) (char %21) (char %7B) (char %7D) (char %28) (char %29) (char %5B) (char %5D)))))) (concept grammar.plain-value))
(rule important_value token (seq (literal %21) (class plain (range a z) (range A Z)) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char -) (char _)))) (concept grammar.important-value))
