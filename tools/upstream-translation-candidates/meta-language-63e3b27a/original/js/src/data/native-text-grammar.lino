(grammar (start text_document) (matching peg))
(rule text_document normal (choice ordered (repeat1 (seq (and any) (ref text_line))) (ref text_line)) (concept grammar.text-document) (source-names (native%3Anative-text text_document)))
(rule text_line normal (seq (immediateToken (repeat0 (seq (not (literal %0A)) any))) (choice ordered (literal %0A) (not any))) (concept grammar.text-line) (source-names (native%3Anative-text line)))
(rule natural_language_document normal (repeat0 (ref natural_language_sentence)) (concept grammar.natural-language-document) (source-names (native%3Anative-text natural_language_document)))
(rule natural_language_sentence normal (seq (and any) (immediateToken (repeat0 (seq (not (class plain (char .) (char %21) (char %3F) (char %E0%A5%A4) (char %E3%80%82) (char %D8%9F) (char %DB%94) (char %EF%BC%81) (char %EF%BC%9F))) any))) (choice ordered (immediateToken (seq (repeat1 (class plain (char .) (char %21) (char %3F) (char %E0%A5%A4) (char %E3%80%82) (char %D8%9F) (char %DB%94) (char %EF%BC%81) (char %EF%BC%9F))) (repeat0 (class plain (category Pe) (category Pf) (char %22) (char %27))) (repeat0 (class plain (category Z) (char %C2%85) (range %09 %0D))))) (not any))) (concept grammar.natural-language-sentence) (source-names (native%3Anative-text sentence)))
(rule lexical_document normal (repeat0 (choice ordered (ref whitespace) (ref lexical_word) (ref rejected_control) (ref lexical_punctuation))) (concept grammar.lexical-document) (source-names (native%3Anative-text lexical_document)))
(rule whitespace token (repeat1 (class plain (category Z) (char %C2%85) (range %09 %0D))) (concept grammar.whitespace) (source-names (native%3Anative-text whitespace)))
(rule lexical_word token (repeat1 (class plain (category L) (category N) (category M) (char _) (char %27) (char -))) (concept grammar.lexical-word) (source-names (native%3Anative-text word)))
(rule rejected_control token (repeat1 (class plain (range %00 %08) (range %0E %1F) (range %7F %C2%84) (range %C2%86 %C2%9F))) (concept grammar.rejected-control) (source-names (native%3Anative-text ERROR)))
(rule lexical_punctuation token (repeat1 (class negated (category Z) (char %C2%85) (range %09 %0D) (category L) (category N) (category M) (char _) (char %27) (char -) (range %00 %08) (range %0E %1F) (range %7F %C2%84) (range %C2%86 %C2%9F))) (concept grammar.lexical-punctuation) (source-names (native%3Anative-text punctuation)))
(rule balanced_parenthesis_sequence normal (repeat0 (choice ordered (seq (literal %28) (ref balanced_parenthesis_sequence) (literal %29)) (immediateToken (repeat1 (seq (not (choice ordered (literal %28) (literal %29))) any))))) (concept grammar.balanced-parenthesis-sequence) (source-names (native%3Anative-text balanced_parenthesis_sequence)))
