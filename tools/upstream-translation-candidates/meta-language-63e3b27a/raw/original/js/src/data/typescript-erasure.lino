(erasure-rule type_annotation span)
(erasure-rule type_parameters span)
(erasure-rule type_arguments span)
(erasure-rule interface_declaration declaration)
(erasure-rule type_alias_declaration declaration)
(erasure-rule ambient_declaration declaration)
(erasure-rule as_expression suffix)
(erasure-rule satisfies_expression suffix)
(erasure-rule non_null_expression suffix)
(erasure-rule type_assertion prefix)
(refusal-rule enum_declaration)
(refusal-rule internal_module)
(refusal-rule import_require_clause)
(refusal-rule accessibility_modifier)
(refusal-rule decorator)
