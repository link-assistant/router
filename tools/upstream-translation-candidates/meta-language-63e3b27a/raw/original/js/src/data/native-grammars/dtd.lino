(grammar (start external_subset) (matching longest) (settling tokens precedence dynamic ambiguity))
(conflict attribute_list_declaration attribute_definition)
(scanner processing_instruction_content (tokens processing_instruction_content) (operations (if (valid processing_instruction_content) (then (while (not (some atEnd (next (literal %3F%3E)) (next (literal %0A)) (next (literal %3F)))) (do advance)) (if atEnd (then fail)) (if (not (next (seq (literal %3F%3E) (repeat0 (literal %20)) (literal %0A)))) (then fail)) (emit processing_instruction_content))) fail))
(scanner comment (tokens comment) (operations (if (not (valid comment)) (then fail)) (consume (literal %3C%21--)) (push levels (integer 1)) (while (greater (depth levels) (integer 0)) (do (if atEnd (then fail)) (if (next (literal --)) (then (consume (literal --)) (pop levels)) (else advance)))) (consume (literal %3E)) (emit comment)))
(kind uniform_resource_identifier (source-names (tree-sitter URI)))
(kind processing_instruction_content (source-names (tree-sitter _pi_content)))
(kind comment (source-names (tree-sitter Comment)))
(rule external_subset normal (seq (optional (ref text_declaration)) (repeat1 (ref external_subset_declaration))) (concept grammar.external-subset) (source-names (tree-sitter extSubset)))
(rule text_declaration normal (seq (literal %3C%3F) (token (seq (literal xml) (not (ref word_characters)))) (ref version_information) (optional (ref encoding_declaration)) (optional (ref whitespace)) (literal %3F%3E)) (concept grammar.text-declaration) (source-names (tree-sitter TextDecl)))
(rule external_subset_declaration silent (choice unordered (ref markup_declaration) (ref conditional_section) (ref declaration_separator)) (concept grammar.external-subset-declaration) (source-names (tree-sitter _extSubsetDecl)))
(rule conditional_section normal (seq (literal %3C%21%5B) (optional (ref whitespace)) (choice unordered (token (seq (literal IGNORE) (not (ref word_characters)))) (token (seq (literal INCLUDE) (not (ref word_characters)))) (ref parameter_entity_reference)) (optional (ref whitespace)) (literal %5B) (repeat0 (ref external_subset_declaration)) (literal %5D%5D%3E)) (concept grammar.conditional-section) (source-names (tree-sitter conditionalSect)))
(rule markup_declaration silent (choice unordered (ref element_declaration) (ref attribute_list_declaration) (ref entity_declaration) (ref notation_declaration) (ref processing_instruction) (alias comment (immediateToken (ref comment)))) (concept grammar.markup-declaration) (source-names (tree-sitter _markupdecl)))
(rule declaration_separator silent (choice unordered (ref parameter_entity_reference) (ref whitespace)) (concept grammar.declaration-separator) (source-names (tree-sitter _DeclSep)))
(rule element_declaration normal (seq (literal %3C%21) (token (seq (literal ELEMENT) (not (ref word_characters)))) (ref whitespace) (choice unordered (ref name) (ref parameter_entity_reference)) (ref whitespace) (ref content_specification) (optional (ref whitespace)) (literal %3E)) (concept grammar.element-declaration) (source-names (tree-sitter elementdecl)))
(rule content_specification normal (choice unordered (token (seq (literal EMPTY) (not (ref word_characters)))) (token (seq (literal ANY) (not (ref word_characters)))) (ref mixed_content) (ref child_content) (ref parameter_entity_reference)) (concept grammar.content-specification) (source-names (tree-sitter contentspec)))
(rule mixed_content normal (choice unordered (seq (literal %28) (optional (ref whitespace)) (choice unordered (literal %23PCDATA) (ref parameter_entity_reference)) (repeat0 (seq (optional (ref whitespace)) (literal %7C) (optional (ref whitespace)) (choice unordered (ref name) (ref parameter_entity_reference)))) (optional (ref whitespace)) (repeat0 (seq (ref parameter_entity_reference) (optional (ref whitespace)))) (literal %29) (literal %2A)) (precedence -1 none (seq (literal %28) (optional (ref whitespace)) (choice unordered (literal %23PCDATA) (ref parameter_entity_reference)) (optional (ref whitespace)) (repeat0 (seq (ref parameter_entity_reference) (optional (ref whitespace)))) (literal %29)))) (concept grammar.mixed-content) (source-names (tree-sitter Mixed)))
(rule child_content normal (precedence 1 none (seq (ref choice) (optional (choice unordered (literal %3F) (literal %2A) (literal %2B))))) (concept grammar.child-content) (source-names (tree-sitter children)))
(rule content_particle silent (precedence 0 left (seq (choice unordered (ref name) (ref choice) (ref parameter_entity_reference)) (optional (choice unordered (literal %3F) (literal %2A) (literal %2B))))) (concept grammar.content-particle) (source-names (tree-sitter _cp)))
(rule choice silent (seq (literal %28) (optional (ref whitespace)) (ref content_particle) (repeat0 (seq (optional (ref whitespace)) (choice unordered (literal %7C) (literal %2C)) (optional (ref whitespace)) (ref content_particle))) (repeat0 (seq (optional (ref whitespace)) (ref parameter_entity_reference))) (optional (ref whitespace)) (literal %29)) (concept grammar.choice) (source-names (tree-sitter _choice)))
(rule attribute_list_declaration normal (seq (literal %3C%21) (token (seq (literal ATTLIST) (not (ref word_characters)))) (ref whitespace) (choice unordered (ref name) (ref parameter_entity_reference)) (repeat0 (choice unordered (ref attribute_definition) (seq (ref whitespace) (ref parameter_entity_reference)))) (optional (ref whitespace)) (literal %3E)) (concept grammar.attribute-list-declaration) (source-names (tree-sitter AttlistDecl)))
(rule attribute_definition normal (precedence 0 right (seq (ref whitespace) (choice unordered (ref name) (ref parameter_entity_reference)) (ref whitespace) (ref attribute_type) (optional (seq (ref whitespace) (ref default_declaration))))) (concept grammar.attribute-definition) (source-names (tree-sitter AttDef)))
(rule attribute_type silent (choice unordered (ref string_type) (ref token_sequence_type) (ref enumerated_type) (ref parameter_entity_reference)) (concept grammar.attribute-type) (source-names (tree-sitter _AttType)))
(rule string_type token (seq (literal CDATA) (not (ref word_characters))) (concept grammar.string-type) (source-names (tree-sitter StringType)))
(rule token_sequence_type token (seq (choice unordered (literal ID) (literal IDREF) (literal IDREFS) (literal ENTITY) (literal ENTITIES) (literal NMTOKEN) (literal NMTOKENS)) (not (ref word_characters))) (concept grammar.token-sequence-type) (source-names (tree-sitter TokenizedType)))
(rule enumerated_type silent (choice unordered (ref notation_type) (ref enumeration)) (concept grammar.enumerated-type) (source-names (tree-sitter _EnumeratedType)))
(rule notation_type normal (seq (token (seq (literal NOTATION) (not (ref word_characters)))) (ref whitespace) (literal %28) (optional (ref whitespace)) (choice unordered (ref name) (ref parameter_entity_reference)) (repeat0 (seq (optional (ref whitespace)) (literal %7C) (optional (ref whitespace)))) (choice unordered (ref name) (ref parameter_entity_reference)) (optional (ref whitespace)) (literal %29)) (concept grammar.notation-type) (source-names (tree-sitter NotationType)))
(rule enumeration normal (seq (literal %28) (optional (ref whitespace)) (ref name_token) (repeat0 (seq (optional (ref whitespace)) (literal %7C) (optional (ref whitespace)) (ref name_token))) (optional (ref whitespace)) (literal %29)) (concept grammar.enumeration) (source-names (tree-sitter Enumeration)))
(rule default_declaration normal (choice unordered (literal %23REQUIRED) (literal %23IMPLIED) (seq (optional (seq (literal %23FIXED) (ref whitespace))) (ref attribute_value)) (ref parameter_entity_reference)) (concept grammar.default-declaration) (source-names (tree-sitter DefaultDecl)))
(rule entity_declaration silent (choice unordered (ref general_entity_declaration) (ref parameter_entity_declaration)) (concept grammar.entity-declaration) (source-names (tree-sitter _EntityDecl)))
(rule general_entity_declaration normal (seq (literal %3C%21) (token (seq (literal ENTITY) (not (ref word_characters)))) (ref whitespace) (choice unordered (ref name) (ref parameter_entity_reference)) (ref whitespace) (choice unordered (ref entity_value) (seq (ref external_resource_identifier) (optional (ref notation_data_declaration)))) (optional (ref whitespace)) (literal %3E)) (concept grammar.general-entity-declaration) (source-names (tree-sitter GEDecl)))
(rule parameter_entity_declaration normal (seq (literal %3C%21) (token (seq (literal ENTITY) (not (ref word_characters)))) (ref whitespace) (literal %25) (ref whitespace) (ref name) (ref whitespace) (choice unordered (ref entity_value) (ref external_resource_identifier)) (optional (ref whitespace)) (literal %3E)) (concept grammar.parameter-entity-declaration) (source-names (tree-sitter PEDecl)))
(rule entity_value normal (choice unordered (seq (literal %22) (capture labeled content (repeat0 (choice unordered (alias unnamed_token (token (class negated (char %3C) (char %25) (char %26) (char %22)))) (ref parameter_entity_reference) (ref entity_or_character_reference)))) (literal %22)) (seq (literal %27) (capture labeled content (repeat0 (choice unordered (alias unnamed_token (token (class negated (char %3C) (char %25) (char %26) (char %27)))) (ref parameter_entity_reference) (ref entity_or_character_reference)))) (literal %27))) (concept grammar.entity-value) (source-names (tree-sitter EntityValue)))
(rule notation_data_declaration normal (seq (ref whitespace) (token (seq (literal NDATA) (not (ref word_characters)))) (ref whitespace) (choice unordered (ref name) (ref parameter_entity_reference))) (concept grammar.notation-data-declaration) (source-names (tree-sitter NDataDecl)))
(rule notation_declaration normal (seq (literal %3C%21) (token (seq (literal NOTATION) (not (ref word_characters)))) (ref whitespace) (choice unordered (ref name) (ref parameter_entity_reference)) (ref whitespace) (choice unordered (ref external_resource_identifier) (ref public_identifier)) (optional (ref whitespace)) (literal %3E)) (concept grammar.notation-declaration) (source-names (tree-sitter NotationDecl)))
(rule parameter_entity_reference normal (seq (literal %25) (ref name) (literal %3B)) (concept grammar.parameter-entity-reference) (source-names (tree-sitter PEReference)))
(rule whitespace token (repeat1 (class plain (char %20) (char %09) (char %0D) (char %0A))) (concept grammar.whitespace) (source-names (tree-sitter _S)))
(rule name token (seq (class plain (range a z) (range A Z) (char _)) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char _) (char %3A) (char .) (char %C2%B7) (char -)))) (concept grammar.name) (source-names (tree-sitter Name)))
(rule name_token token (repeat1 (class plain (range a z) (range A Z) (range 0 9) (char _) (char %3A) (char .) (char %C2%B7) (char -))) (concept grammar.name-token) (source-names (tree-sitter Nmtoken)))
(rule entity_or_character_reference silent (choice unordered (ref entity_reference) (ref character_code_reference)) (concept grammar.entity-or-character-reference) (source-names (tree-sitter _Reference)))
(rule entity_reference normal (seq (literal %26) (ref name) (literal %3B)) (concept grammar.entity-reference) (source-names (tree-sitter EntityRef)))
(rule character_code_reference normal (choice unordered (seq (literal %26%23) (alias unnamed_token (token (repeat1 (class plain (range 0 9))))) (literal %3B)) (seq (literal %26%23x) (alias unnamed_token (token (repeat1 (class plain (range 0 9) (range a f) (range A F))))) (literal %3B))) (concept grammar.character-code-reference) (source-names (tree-sitter CharRef)))
(rule attribute_value normal (choice unordered (seq (literal %22) (capture labeled content (repeat0 (choice unordered (alias unnamed_token (token (class negated (char %3C) (char %26) (char %22)))) (ref entity_or_character_reference)))) (literal %22)) (seq (literal %27) (capture labeled content (repeat0 (choice unordered (alias unnamed_token (token (class negated (char %3C) (char %26) (char %27)))) (ref entity_or_character_reference)))) (literal %27))) (concept grammar.attribute-value) (source-names (tree-sitter AttValue)))
(rule external_resource_identifier normal (choice unordered (seq (token (seq (literal SYSTEM) (not (ref word_characters)))) (ref whitespace) (ref system_literal)) (seq (token (seq (literal PUBLIC) (not (ref word_characters)))) (ref whitespace) (ref public_identifier_literal) (ref whitespace) (ref system_literal))) (concept grammar.external-resource-identifier) (source-names (tree-sitter ExternalID)))
(rule public_identifier normal (precedence 0 right (seq (choice unordered (token (seq (literal PUBLIC) (not (ref word_characters)))) (ref parameter_entity_reference)) (ref whitespace) (ref public_identifier_literal))) (concept grammar.public-identifier) (source-names (tree-sitter PublicID)))
(rule system_literal normal (choice unordered (seq (literal %22) (alias uniform_resource_identifier (token (repeat0 (class negated (char %22))))) (literal %22)) (seq (literal %27) (alias uniform_resource_identifier (token (repeat0 (class negated (char %27))))) (literal %27))) (concept grammar.system-literal) (source-names (tree-sitter SystemLiteral)))
(rule public_identifier_literal normal (choice unordered (seq (literal %22) (alias unnamed_token (token (repeat0 (class plain (char %20) (char %0D) (char %0A) (range a z) (range A Z) (range 0 9) (char -) (char %27) (char %28) (char %29) (char %2B) (char %2C) (char .) (char %2F) (char %3A) (char %3D) (char %3F) (char %3B) (char %21) (char %2A) (char %23) (char %40) (char %24) (char _) (char %25))))) (literal %22)) (seq (literal %27) (alias unnamed_token (token (repeat0 (class plain (char %20) (char %0D) (char %0A) (range a z) (range A Z) (range 0 9) (char -) (char %28) (char %29) (char %2B) (char %2C) (char .) (char %2F) (char %3A) (char %3D) (char %3F) (char %3B) (char %21) (char %2A) (char %23) (char %40) (char %24) (char _) (char %25))))) (literal %27))) (concept grammar.public-identifier-literal) (source-names (tree-sitter PubidLiteral)))
(rule version_information silent (seq (ref whitespace) (token (seq (literal version) (not (ref word_characters)))) (ref equals_sign) (choice unordered (seq (literal %27) (ref version_number) (literal %27)) (seq (literal %22) (ref version_number) (literal %22)))) (concept grammar.version-information) (source-names (tree-sitter _VersionInfo)))
(rule version_number token (seq (literal 1.) (repeat1 (class plain (range 0 9)))) (concept grammar.version-number) (source-names (tree-sitter VersionNum)))
(rule encoding_declaration silent (seq (ref whitespace) (token (seq (literal encoding) (not (ref word_characters)))) (ref equals_sign) (choice unordered (seq (literal %27) (ref encoding_name) (literal %27)) (seq (literal %22) (ref encoding_name) (literal %22)))) (concept grammar.encoding-declaration) (source-names (tree-sitter _EncodingDecl)))
(rule encoding_name token (seq (class plain (range A Z) (range a z)) (repeat0 (class plain (range A Z) (range a z) (range 0 9) (char .) (char _) (char -)))) (concept grammar.encoding-name) (source-names (tree-sitter EncName)))
(rule processing_instruction normal (seq (literal %3C%3F) (alias processing_instruction_target (immediateToken (ref processing_instruction_target))) (optional (seq (ref whitespace) (alias unnamed_token (immediateToken (ref processing_instruction_content))))) (literal %3F%3E)) (concept grammar.processing-instruction) (source-names (tree-sitter PI)))
(rule equals_sign silent (seq (optional (ref whitespace)) (literal %3D) (optional (ref whitespace))) (concept grammar.equals-sign) (source-names (tree-sitter _Eq)))
(rule word_characters token (seq (class plain (range a z) (range A Z) (char _)) (repeat0 (class plain (range a z) (range A Z) (range 0 9) (char _) (char %3A) (char .) (char %C2%B7) (char -)))) (concept grammar.word-characters))
(rule processing_instruction_target token (predicate (seq (class plain (category L) (char _) (char %3A)) (repeat0 (class plain (category L) (category N) (char _) (char %3A) (char .) (char %C2%B7) (char -)))) (not (some (equal matched (text xml)) (equal matched (text xmL)) (equal matched (text xMl)) (equal matched (text xML)) (equal matched (text Xml)) (equal matched (text XmL)) (equal matched (text XMl)) (equal matched (text XML))))) (concept grammar.processing-instruction-target) (source-names (tree-sitter PITarget)))
