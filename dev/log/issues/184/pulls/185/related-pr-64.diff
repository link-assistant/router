/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a2ca8a714b47a6d50c87d53cf750f55c1aa054a1","url":"https://api.github.com/repos/link-foundation/rust-ai-driven-development-pipeline-template/commits/a2ca8a714b47a6d50c87d53cf750f55c1aa054a1","html_url":"https://github.com/link-foundation/rust-ai-driven-development-pipeline-template/commit/a2ca8a714b47a6d50c87d53cf750f55c1aa054a1"}]},{"sha":"6e78c907f4ce823fc3177c27d497226f3a34565e","node_id":"C_kwDOQvQFhtoAKDZlNzhjOTA3ZjRjZTgyM2ZjMzE3N2MyN2Q0OTcyMjZmM2EzNDU2NWU","commit":{"author":{"name":"konard","email":"drakonard@gmail.com","date":"2026-06-09T18:13:40Z"},"committer":{"name":"konard","email":"drakonard@gmail.com","date":"2026-06-09T18:13:40Z"},"message":"fix: rebase before staging the version bump in version-and-commit.rs\n\ngit rebase refuses to run with a dirty index, so staging the version\nbump before fetch+rebase caused the release job to abort with\n\"cannot rebase: Your index contains uncommitted changes\" whenever a\nconcurrent release advanced the remote branch.\n\nMove the fetch+rebase block to run before any file modification, while\nthe working tree is still clean, then apply the bump and stage+commit.\nThis mirrors the JS template ordering and makes the version computed\nfrom the most recent branch state.\n\nAdds a regression test that reproduces both orderings against a real\ntemporary repo: the buggy order fails with the exact CI error, the\nfixed order succeeds.\n\nFixes #67","tree":{"sha":"5c8f022cecba93b210641a451f54e0eaaa855aff","url":"https://api.github.com/repos/link-foundation/rust-ai-driven-development-pipeline-template/git/trees/5c8f022cecba93b210641a451f54e0eaaa855aff"},"url":"https://api.github.com/repos/link-foundation/rust-ai-driven-development-pipeline-template/git/commits/6e78c907f4ce823fc3177c27d497226f3a34565e","comment_count":0,"verification":{"verified":f