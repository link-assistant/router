16:09:52Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"},{"__typename":"CheckRun","completedAt":"2026-08-08T16:11:06Z","conclusion":"SUCCESS","detailsUrl":"https://github.com/link-assistant/router/actions/runs/31266200597/job/93124804548","name":"Test (macos-latest)","startedAt":"2026-08-08T16:09:52Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"},{"__typename":"CheckRun","completedAt":"2026-08-08T16:12:29Z","conclusion":"SUCCESS","detailsUrl":"https://github.com/link-assistant/router/actions/runs/31266200597/job/93124804540","name":"Test (windows-latest)","startedAt":"2026-08-08T16:09:51Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"},{"__typename":"CheckRun","completedAt":"2026-08-08T16:14:47Z","conclusion":"SUCCESS","detailsUrl":"https://github.com/link-assistant/router/actions/runs/31266200597/job/93125086367","name":"Build Package","startedAt":"2026-08-08T16:12:31Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"},{"__typename":"CheckRun","completedAt":"2026-08-08T16:15:40Z","conclusion":"SUCCESS","detailsUrl":"https://github.com/link-assistant/router/actions/runs/31266200597/job/93125086368","name":"Build Docker Image","startedAt":"2026-08-08T16:12:31Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"},{"__typename":"CheckRun","completedAt":"2026-08-08T16:15:41Z","conclusion":"SKIPPED","detailsUrl":"https://github.com/link-assistant/router/actions/runs/31266200597/job/93125419678","name":"Auto Release","startedAt":"2026-08-08T16:15:41Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"},{"__typename":"CheckRun","completedAt":"2026-08-08T16:15:41Z","conclusion":"SKIPPED","detailsUrl":"https://github.com/link-assistant/router/actions/runs/31266200597/job/93125419654","name":"Instant Release","startedAt":"2026-08-08T16:15:41Z","status":"COMPLETED","workflowName":"CI/CD Pipeline"}],"title":"fix: recognize claude.com login URLs","updatedAt":"2026-08-08T16:19:02Z","url":"https://github.com/link-assistant/router/pull/62"}
