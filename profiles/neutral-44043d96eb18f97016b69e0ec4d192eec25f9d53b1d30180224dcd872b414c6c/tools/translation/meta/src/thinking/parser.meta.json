igInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":7,"preserved":7},"items":[{"term":"use","name":"super","span":{"start":0,"end":57,"unit":"utf16","byteStart":0,"byteEnd":57},"sha256":"eead51a3e0a8bea625fa075b8e6a3c0394bef7e51d6b89351686018d3eac3c5e","source":"use super::{ThinkingConfig, ThinkingLevel, ThinkingMode};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":0,"end":57},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":57,"end":148,"unit":"utf16","byteStart":57,"byteEnd":148},"sha256":"f95ddcac74236407e68d24970170a1931c1898aa0f6262ca914ee0505f346742","source":"\n\n/// Syntactic suffix extraction, matching the upstream last-opening-parenthesis grammar.\n","status":"preserved","diagnostic":null},{"term":"struct","name":"SuffixResult","span":{"start":148,"end":290,"unit":"utf16","byteStart":148,"byteEnd":290},"sha256":"7eccfa0d0d58f9b6a354f9a6fc9c3167863ecf9f4042736e264a8990b948dcc6","source":"#[derive(Clone, Copy, Debug, Eq, PartialEq)]\npub struct SuffixResult<'a> {\n    pub model_name: &'a str,\n    pub raw_suffix: Option<&'a str>,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"generic struct: generic layouts require monomorphization","span":{"start":193,"end":217},"details":{"construct":"generic struct"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":44},"tokens":["#","[","derive","(","Clone",",","Copy",",","Debug",",","Eq",",","PartialEq",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":290,"end":292,"unit":"utf16","byteStart":290,"byteEnd":292},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"SuffixResult","span":{"start":292,"end":968,"unit":"utf16","byteStart":292,"byteEnd":968},"sha256":"d55a8054d6b7f458f06db8433327aa5b43079e731d999bf661c9a74313a6d322","source":"impl SuffixResult<'_> {\n    /// Interpret recognized suffixes. Invalid text and u32 overflow are ignored.\n    #[must_use]\n    pub fn config(self) -> Option<ThinkingConfig> {\n        let raw = self.raw_suffix?;\n        let mode = parse_special_suffix(raw)\n            .or_else(|| parse_level_suffix(raw).map(ThinkingMode::Level))\n            .or_else(|| {\n                parse_numeric_suffix(raw).map(|budget| {\n                    if budget == 0 {\n                        ThinkingMode::Off\n                    } else {\n                        ThinkingMode::Budget(budget)\n                    }\n                })\n            })?;\n        Some(ThinkingConfig { mode })\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":292,"end":968},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":968,"end":1035,"unit":"utf16","byteStart":968,"byteEnd":1035},"sha256":"228f3d984a1796f2195ef4d9993ede233c54dbee8b8c946149e4d6b90ec3a7d6","source":"\n\n/// Extract a trailing suffix without interpreting its contents.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_suffix","span":{"start":1035,"end":1433,"unit":"utf16","byteStart":1035,"byteEnd":1433},"sha256":"b8b431e99db9c03e6a96b21808911552a10860afe19d8f45de1a555741a9b4d8","source":"#[must_use]\npub fn parse_suffix(model: &str) -> SuffixResult<'_> {\n    if let Some(open) = model.rfind('(')\n        && model.ends_with(')')\n    {\n        SuffixResult {\n            model_name: &model[..open],\n            raw_suffix: Some(&model[open + 1..model.len() - 1]),\n        }\n    } else {\n        SuffixResult {\n            model_name: model,\n            raw_suffix: None,\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1035,"end":1433,"unit":"utf16","byteStart":1035,"byteEnd":1433}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1433,"end":1521,"unit":"utf16","byteStart":1433,"byteEnd":1521},"sha256":"40af1f9a37c3d97db18d3c7b9bcea44f7d4f8751b7969371a67fee1e7b2fbcf0","source":"\n\n/// Parse a nonnegative u32 budget; leading zeros, plus and signed zero are accepted.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_numeric_suffix","span":{"start":1521,"end":1789,"unit":"utf16","byteStart":1521,"byteEnd":1789},"sha256":"bf667bd5f8f2701e7dcf4e943ab19a1c4b5390ce6997ce774dda00107afecea7","source":"#[must_use]\npub fn parse_numeric_suffix(raw: &str) -> Option<u32> {\n    if raw\n        .strip_prefix('-')\n        .is_some_and(|digits| !digits.is_empty() && digits.bytes().all(|digit| digit == b'0'))\n    {\n        Some(0)\n    } else {\n        raw.parse().ok()\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1521,"end":1789,"unit":"utf16","byteStart":1521,"byteEnd":1789}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1789,"end":1865,"unit":"utf16","byteStart":1789,"byteEnd":1865},"sha256":"bfa7183ea0ca2d3145698b7faf01331a2fe0a02f785c8a3f4b90955c87169996","source":"\n\n/// Parse case-insensitive none/auto, including -1 as automatic thinking.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_special_suffix","span":{"start":1865,"end":2108,"unit":"utf16","byteStart":1865,"byteEnd":2108},"sha256":"61b8e1c875db24d4f5e50a54b6007ba44217139832f3ab1eea6051b4b77273c5","source":"#[must_use]\npub fn parse_special_suffix(raw: &str) -> Option<ThinkingMode> {\n    match raw.to_ascii_lowercase().as_str() {\n        \"none\" => Some(ThinkingMode::Off),\n        \"auto\" | \"-1\" => Some(ThinkingMode::Auto),\n        _ => None,\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1865,"end":2108,"unit":"utf16","byteStart":1865,"byteEnd":2108}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2108,"end":2190,"unit":"utf16","byteStart":2108,"byteEnd":2190},"sha256":"d0185f805838738d224072d61f142e96ce7caf9150e4603bf58a784377f0e3c1","source":"\n\n/// Parse one of minimal, low, medium, high, xhigh and max, case-insensitively.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_level_suffix","span":{"start":2190,"end":2616,"unit":"utf16","byteStart":2190,"byteEnd":2616},"sha256":"9eee92382738bb009eb02a149d813efa226a131dd7aa720a643065473c503cf7","source":"#[must_use]\npub fn parse_level_suffix(raw: &str) -> Option<ThinkingLevel> {\n    match raw.to_ascii_lowercase().as_str() {\n        \"minimal\" => Some(ThinkingLevel::Minimal),\n        \"low\" => Some(ThinkingLevel::Low),\n        \"medium\" => Some(ThinkingLevel::Medium),\n        \"high\" => Some(ThinkingLevel::High),\n        \"xhigh\" => Some(ThinkingLevel::XHigh),\n        \"max\" => Some(ThinkingLevel::Max),\n        _ => None,\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2190,"end":2616,"unit":"utf16","byteStart":2190,"byteEnd":2616}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2616,"end":2617,"unit":"utf16","byteStart":2616,"byteEnd":2617},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
