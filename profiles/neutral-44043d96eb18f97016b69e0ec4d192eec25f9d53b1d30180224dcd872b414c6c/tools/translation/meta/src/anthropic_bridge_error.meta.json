ng":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":2,"preserved":2},"items":[{"term":"use","name":"super","span":{"start":0,"end":61,"unit":"utf16","byteStart":0,"byteEnd":61},"sha256":"cc6b24d2e152445fb58e7d1460c84876a02d41e4d43a35a65dbcc598a7d009eb","source":"use super::{IntoResponse, Response, StatusCode, Value, json};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":0,"end":61},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":61,"end":63,"unit":"utf16","byteStart":61,"byteEnd":63},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"anthropic_error","span":{"start":63,"end":956,"unit":"utf16","byteStart":63,"byteEnd":956},"sha256":"dd79ffc24b69877d76d146d6d0633a308fa9c0ec9ff752682f813be304dcaf49","source":"pub(super) fn anthropic_error(status: StatusCode, body: &[u8]) -> Response {\n    let text = serde_json::from_slice::<Value>(body).map_or_else(\n        |_| String::from_utf8_lossy(body).to_string(),\n        |value| {\n            value\n                .get(\"error\")\n                .and_then(|e| e.get(\"message\"))\n                .and_then(Value::as_str)\n                .map_or_else(|| value.to_string(), String::from)\n        },\n    );\n    let error_type = match status {\n        StatusCode::UNAUTHORIZED | StatusCode::FORBIDDEN => \"authentication_error\",\n        StatusCode::TOO_MANY_REQUESTS => \"rate_limit_error\",\n        StatusCode::BAD_REQUEST => \"invalid_request_error\",\n        _ => \"api_error\",\n    };\n    (\n        status,\n        axum::Json(json!({\n            \"type\": \"error\",\n            \"error\": {\"type\": error_type, \"message\": text},\n        })),\n    )\n        .into_response()\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":63,"end":956,"unit":"utf16","byteStart":63,"byteEnd":956}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":956,"end":957,"unit":"utf16","byteStart":956,"byteEnd":957},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
