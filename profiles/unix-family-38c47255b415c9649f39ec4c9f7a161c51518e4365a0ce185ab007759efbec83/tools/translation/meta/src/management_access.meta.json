bde6dd571e8ac4856","source":"#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]\npub struct ManagementBan {\n    /// Canonical socket peer address.\n    pub client_ip: IpAddr,\n    /// Wall-clock expiry for diagnostics; enforcement uses monotonic time.\n    pub expires_at: u64,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(serde): derive requires a separately checked capability","span":{"start":457,"end":462},"details":{"construct":"derive(serde)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":61},"tokens":["#","[","derive","(","Debug",",","Clone",",","serde","::","Serialize",",","serde","::","Deserialize",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":691,"end":693,"unit":"utf16","byteStart":691,"byteEnd":693},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"struct","name":"Attempt","span":{"start":693,"end":827,"unit":"utf16","byteStart":693,"byteEnd":827},"sha256":"e0162524455e8abd1ab9aed43052f861aae1fd4fe4dae22a260d05eae5efd0ce","source":"#[derive(Debug)]\nstruct Attempt {\n    failures: u32,\n    last_failure: Instant,\n    banned_at: Option<Instant>,\n    expires_at: u64,\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown type crate.ml_unresolved_source_import.Instant","span":{"start":764,"end":771},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":16},"tokens":["#","[","derive","(","Debug",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":827,"end":829,"unit":"utf16","byteStart":827,"byteEnd":829},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"Attempt","span":{"start":829,"end":1469,"unit":"utf16","byteStart":829,"byteEnd":1469},"sha256":"5e9aa09e2eb87b281803b8b3f2d77c210e9104b83af599229e4c249bc64bff60","source":"impl Attempt {\n    fn remaining(&self, now: Instant, window: Duration) -> Option<u64> {\n        let elapsed = now.saturating_duration_since(self.banned_at?);\n        let remaining = window.checked_sub(elapsed)?;\n        (!remaining.is_zero()).then(|| {\n            remaining\n                .as_secs()\n                .saturating_add(u64::from(remaining.subsec_nanos() > 0))\n        })\n    }\n\n    fn expired(&self, now: Instant, window: Duration) -> bool {\n        self.banned_at.map_or_else(\n            || now.saturating_duration_since(self.last_failure) >= window,\n            |_| self.remaining(now, window).is_none(),\n        )\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":829,"end":1469},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1469,"end":1542,"unit":"utf16","byteStart":1469,"byteEnd":1542},"sha256":"940c0c2bc30cddcfb60c1b3c9194e45a18df49eb11536e92ddd8d9d805075a26","source":"\n\n/// Consecutive failures and bans shared by every management listener.\n","status":"preserved","diagnostic":null},{"term":"struct","name":"ManagementAccess","span":{"start":1542,"end":1709,"unit":"utf16","byteStart":1542,"byteEnd":1709},"sha256":"3b81011d8a6bcbf8c7e2f5fea6a0bc95774fbedb170b2de05d8b6a4ad56ba672","source":"#[derive(Debug)]\npub struct ManagementAccess {\n    config: OnceLock<ManagementConfig>,\n    attempts: Mutex<BTreeMap<IpAddr, Attempt>>,\n    snapshot: Option<PathBuf>,\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"type OnceLock<…>: generic types are outside the portable core","span":{"start":1601,"end":1609},"details":{"construct":"type OnceLock<…>"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":16},"tokens":["#","[","derive","(","Debug",")","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1709,"end":1711,"unit":"utf16","byteStart":1709,"byteEnd":1711},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"impl","name":"ManagementAccess","span":{"start":1711,"end":8078,"unit":"utf16","byteStart":1711,"byteEnd":8078},"sha256":"68ee98968d447afe93056a9ed0958aee3c7f3176e8de987ff60f4e9468c5b342","source":"impl ManagementAccess {\n    /// Initialize inert state; reading an admin claim never changes diagnostics.\n    #[must_use]\n    pub fn new(data_dir: &Path) -> Self {\n        Self {\n            config: OnceLock::new(),\n            attempts: Mutex::new(BTreeMap::new()),\n            snapshot: Some(data_dir.join(SNAPSHOT)),\n        }\n    }\n\n    /// An in-memory tracker with no diagnostic file writes.\n    #[must_use]\n    pub const fn in_memory() -> Self {\n        Self {\n            config: OnceLock::new(),\n            attempts: Mutex::new(BTreeMap::new()),\n            snapshot: None,\n        }\n    }\n\n    /// Select the instance's policy once, before serving its listeners.\n    pub fn configure(&self, config: ManagementConfig) {\n        if self.config.set(config).is_ok() {\n            self.save(&BTreeMap::new());\n        }\n    }\n\n    /// Current policy, defaulting to local-only management and local recovery.\n    #[must_use]\n    pub fn config(&self) -> ManagementConfig {\n        self.config.get().copied().unwrap_or_default()\n    }\n\n    fn exempt(&self, ip: IpAddr) -> bool {\n        let config = self.config();\n        config.lockout_failures == 0\n            || config.lockout_secs == 0\n            || (config.exempt_loopback && ip.is_loopback())\n    }\n\n    /// Remaining ban seconds, or a capacity backoff for a new untracked IP.\n    pub fn check(&self, ip: IpAddr) -> Option<u64> {\n        self.check_at(normalize_ip(ip), Instant::now())\n    }\n\n    fn check_at(&self, ip: IpAddr, now: Instant) -> Option<u64> {\n        if self.exempt(ip) {\n            return None;\n        }\n        let window = Duration::from_secs(self.config().lockout_secs);\n        let mut attempts = self\n            .attempts\n            .lock()\n            .unwrap_or_else(std::sync::PoisonError::into_inner);\n        if attempts\n            .get(&ip)\n            .is_some_and(|entry| entry.expired(now, window))\n        {\n            let was_banned = attempts\n                .remove(&ip)\n                .is_some_and(|entry| entry.banned_at.is_some());\n            if was_banned {\n                self.save(&attempts);\n            }\n        }\n        if let Some(entry) = attempts.get(&ip) {\n            return entry.remaining(now, window);\n        }\n        if attempts.len() >= MAX_CLIENTS {\n            let previous_len = attempts.len();\n            attempts.retain(|_, entry| !entry.expired(now, window));\n            if attempts.len() != previous_len {\n                self.save(&attempts);\n            }\n            if attempts.len() >= MAX_CLIENTS {\n                return Some(1);\n            }\n        }\n        None\n    }\n\n    /// Record a failed credential. Returns a newly-created ban for auditing.\n    pub fn failure(&self, ip: IpAddr) -> Option<ManagementBan> {\n        self.failure_at(normalize_ip(ip), Instant::now())\n    }\n\n    fn failure_at(&self, ip: IpAddr, now: Instant) -> Option<ManagementBan> {\n        if self.exempt(ip) {\n            return None;\n        }\n        let config = self.config();\n        let window = Duration::from_secs(config.lockout_secs);\n        let mut attempts = self\n            .attempts\n            .lock()\n            .unwrap_or_else(std::sync::PoisonError::into_inner);\n        if !attempts.contains_key(&ip) && attempts.len() >= MAX_CLIENTS {\n            return None;\n        }\n        let entry = attempts.entry(ip).or_insert(Attempt {\n            failures: 0,\n            last_failure: now,\n            banned_at: None,\n            expires_at: 0,\n        });\n        if entry.expired(now, window) {\n            entry.failures = 0;\n            entry.banned_at = None;\n        }\n        if entry.banned_at.is_some() {\n            return None;\n        }\n        entry.failures = entry.failures.saturating_add(1);\n        entry.last_failure = now;\n        if entry.failures < config.lockout_failures {\n            return None;\n        }\n        entry.banned_at = Some(now);\n        entry.expires_at = unix_now().saturating_add(config.lockout_secs);\n        let ban = ManagementBan {\n            client_ip: ip,\n            expires_at: entry.expires_at,\n        };\n        self.save(&attempts);\n        drop(attempts);\n        Some(ban)\n    }\n\n    /// Successful authentication clears failures, never an active ban.\n    pub fn success(&self, ip: IpAddr) {\n        let mut attempts = self\n            .attempts\n            .lock()\n            .unwrap_or_else(std::sync::PoisonError::into_inner);\n        let ip = normalize_ip(ip);\n        if attempts\n            .get(&ip)\n            .is_some_and(|entry| entry.banned_at.is_none())\n        {\n            attempts.remove(&ip);\n        }\n    }\n\n    /// Snapshot currently active bans from the authoritative in-memory state.\n    pub fn active_bans(&self) -> Vec<ManagementBan> {\n        let mut attempts = self\n            .attempts\n            .lock()\n            .unwrap_or_else(std::sync::PoisonError::into_inner);\n        let now = Instant::now();\n        let window = Duration::from_secs(self.config().lockout_secs);\n        attempts.retain(|_, entry| !entry.expired(now, window));\n        let bans = Self::bans(&attempts);\n        drop(attempts);\n        bans\n    }\n\n    fn bans(attempts: &BTreeMap<IpAddr, Attempt>) -> Vec<ManagementBan> {\n        attempts\n            .iter()\n            .filter(|(_, entry)| entry.banned_at.is_some())\n            .map(|(&client_ip, entry)| ManagementBan {\n                client_ip,\n                expires_at: entry.expires_at,\n            })\n            .collect()\n    }\n\n    fn save(&self, attempts: &BTreeMap<IpAddr, Attempt>) {\n        let Some(snapshot) = &self.snapshot else {\n            return;\n        };\n        let bans = Self::bans(attempts);\n        let result = if bans.is_empty() {\n            std::fs::remove_file(snapshot).or_else(|error| {\n                if error.kind() == std::io::ErrorKind::NotFound {\n                    Ok(())\n                } else {\n                    Err(error)\n                }\n            })\n        } else {\n            crate::lino_json::encode(&bans)\n                .map_err(std::io::Error::other)\n                .and_then(|text| {\n                    crate::durable_file::atomic_write_owner_only(snapshot, text.as_bytes())\n                })\n        };\n        if let Err(error) = result {\n            tracing::warn!(\"could not write management ban diagnostics: {error}\");\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item impl: no supported library declaration emission","span":{"start":1711,"end":8078},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":8078,"end":8156,"unit":"utf16","byteStart":8078,"byteEnd":8156},"sha256":"fa88ad9712b9d2b928c520bbc942a6040301fa97311b041e573276023159b1a5","source":"\n\n/// Normalize IPv4-mapped IPv6 so one client cannot gain a second identity.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"normalize_ip","span":{"start":8156,"end":8350,"unit":"utf16","byteStart":8156,"byteEnd":8350},"sha256":"53345b33a159bfebbf73b3696fbc5c5150e05e6b2851e27e533077e4b976e204","source":"#[must_use]\npub fn normalize_ip(ip: IpAddr) -> IpAddr {\n    match i