nd":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":5805,"end":6051,"unit":"utf16","byteStart":5805,"byteEnd":6051}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":6051,"end":6053,"unit":"utf16","byteStart":6051,"byteEnd":6053},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"require_string","span":{"start":6053,"end":6438,"unit":"utf16","byteStart":6053,"byteEnd":6438},"sha256":"3035d244a59027a0e631ae13903af34c3a75eceb969c4c22806f6fb8bd86db0e","source":"fn require_string<'a>(activity: &'a Value, field: &'static str) -> Result<&'a str, &'static str> {\n    activity\n        .get(field)\n        .and_then(Value::as_str)\n        .filter(|s| !s.is_empty())\n        .ok_or(match field {\n            \"id\" => \"activity id is required\",\n            \"type\" => \"activity type is required\",\n            _ => \"required field is missing\",\n        })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":6053,"end":6438,"unit":"utf16","byteStart":6053,"byteEnd":6438}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":6438,"end":6440,"unit":"utf16","byteStart":6438,"byteEnd":6440},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":6440,"end":8841,"unit":"utf16","byteStart":6440,"byteEnd":8841},"sha256":"9c684296520d931e3ff29b509df2426c3a206264b57637f14b23065d8d0f880e","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    const BASE: &str = \"https://router.example\";\n    const KEY: &str = \"-----BEGIN PUBLIC KEY-----\\nabc\\n-----END PUBLIC KEY-----\";\n\n    #[test]\n    fn actor_contains_required_activitypub_and_forgefed_metadata() {\n        let doc = actor_document(BASE, KEY);\n\n        assert_eq!(\n            doc[\"id\"],\n            \"https://router.example/api/services/activitypub/actor/code\"\n        );\n        assert_eq!(doc[\"type\"], \"Service\");\n        assert_eq!(\n            doc[\"inbox\"],\n            \"https://router.example/api/services/activitypub/inbox/code\"\n        );\n        assert_eq!(\n            doc[\"outbox\"],\n            \"https://router.example/api/services/activitypub/outbox/code\"\n        );\n        assert_eq!(\n            doc[\"followers\"],\n            \"https://router.example/api/services/activitypub/actors/code/followers\"\n        );\n        assert_eq!(doc[\"publicKey\"][\"owner\"], doc[\"id\"]);\n        assert_eq!(doc[\"publicKey\"][\"publicKeyPem\"], KEY);\n        assert!(\n            doc[\"@context\"]\n                .as_array()\n                .expect(\"context array\")\n                .iter()\n                .any(|item| item == \"https://forgefed.org/ns\")\n        );\n        assert!(doc[\"aliases\"].as_array().expect(\"aliases\").len() >= 2);\n    }\n\n    #[test]\n    fn follow_activity_targets_problemsets_actor() {\n        let activity = follow_problemsets_activity(BASE);\n\n        assert_eq!(activity[\"type\"], \"Follow\");\n        assert_eq!(\n            activity[\"actor\"],\n            \"https://router.example/api/services/activitypub/actor/code\"\n        );\n        assert_eq!(\n            activity[\"object\"],\n            \"https://problemsets.lefine.pro/actor/code\"\n        );\n        assert_eq!(\n            activity[\"to\"][0],\n            \"https://problemsets.lefine.pro/actor/code\"\n        );\n    }\n\n    #[test]\n    fn inbound_activity_requires_core_fields() {\n        let valid = json!({\n            \"id\": \"https://remote.example/activity/1\",\n            \"type\": \"Create\",\n            \"actor\": \"https://remote.example/actor\"\n        });\n        assert!(validate_activity(&valid).is_ok());\n\n        let invalid = json!({\n            \"id\": \"https://remote.example/activity/1\",\n            \"type\": \"Create\"\n        });\n        assert_eq!(\n            validate_activity(&invalid),\n            Err(\"activity must include actor or attributedTo\")\n        );\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":6440,"end":8841},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":8841,"end":8842,"unit":"utf16","byteStart":8841,"byteEnd":8842},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
