an":{"start":505,"end":2003,"unit":"utf16","byteStart":505,"byteEnd":2003},"sha256":"81fc994fc619dcd1dcd4346e65649d60f60fd63e291124a5c1446a3cbd1d8f0c","source":"pub async fn gate(\n    State((state, admin_listener)): State<(AppState, bool)>,\n    mut request: Request,\n    next: Next,\n) -> Response {\n    let path = request.uri().path();\n    if path != \"/api/management\" && !path.starts_with(\"/api/management/\") {\n        return next.run(request).await;\n    }\n    let Some(ConnectInfo(peer)) = request.extensions().get::<ConnectInfo<SocketAddr>>() else {\n        return error_response(\n            StatusCode::FORBIDDEN,\n            \"permission_error\",\n            \"management requires socket peer metadata\",\n        );\n    };\n    let ip = normalize_ip(peer.ip());\n    let access = state.admin.management_access();\n    if !admin_listener && !access.config().allow_remote && !ip.is_loopback() {\n        return error_response(\n            StatusCode::FORBIDDEN,\n            \"permission_error\",\n            \"remote management requires MANAGEMENT_ALLOW_REMOTE / --management-allow-remote or the admin listener\",\n        );\n    }\n    if let Some(retry_after) = access.check(ip) {\n        return banned(retry_after);\n    }\n    let confirm = path == \"/api/management/admin/bootstrap/confirm\";\n    request.extensions_mut().insert(ManagementPeer(ip));\n    let response = next.run(request).await;\n    if confirm {\n        if response.status() == StatusCode::UNAUTHORIZED {\n            return failed(&state, ip, \"/api/management/admin/bootstrap/confirm\");\n        }\n        if response.status().is_success() {\n            access.success(ip);\n        }\n    }\n    response\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":505,"end":2003,"unit":"utf16","byteStart":505,"byteEnd":2003}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2003,"end":2081,"unit":"utf16","byteStart":2003,"byteEnd":2081},"sha256":"3149898f6c90c1b53f1d7ca9af5f847dae17f46d144a37e2c09ecc8aacf8a519","source":"\n\n/// Authenticate protected management routes and update the shared counter.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"authenticate","span":{"start":2081,"end":2801,"unit":"utf16","byteStart":2081,"byteEnd":2801},"sha256":"5322d9592d13ffda35b80522814b75d2c25c3b70f94070773a7b70c9e0319cbd","source":"pub async fn authenticate(State(state): State<AppState>, request: Request, next: Next) -> Response {\n    let ip = request\n        .extensions()\n        .get::<ManagementPeer>()\n        .map(|peer| peer.0);\n    if !crate::proxy::is_admin_authorised(&state, request.headers()) {\n        return ip.map_or_else(\n            || {\n                error_response(\n                    StatusCode::UNAUTHORIZED,\n                    \"authentication_error\",\n                    \"admin Bearer key required\",\n                )\n            },\n            |ip| failed(&state, ip, request.uri().path()),\n        );\n    }\n    if let Some(ip) = ip {\n        state.admin.management_access().success(ip);\n    }\n    next.run(request).await\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2081,"end":2801,"unit":"utf16","byteStart":2081,"byteEnd":2801}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2801,"end":2803,"unit":"utf16","byteStart":2801,"byteEnd":2803},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"failed","span":{"start":2803,"end":3366,"unit":"utf16","byteStart":2803,"byteEnd":3366},"sha256":"d4b58b971ed98863b765539fdc8210420a888ef3a43a60d2574d5db027f4f699","source":"fn failed(state: &AppState, ip: IpAddr, path: &str) -> Response {\n    let access = state.admin.management_access();\n    if let Some(ban) = access.failure(ip) {\n        tracing::warn!(client_ip = %ban.client_ip, expires_at = ban.expires_at, \"management authentication IP banned\");\n        state.audit.record_management_ban(&ban, path);\n    }\n    if let Some(retry_after) = access.check(ip) {\n        return banned(retry_after);\n    }\n    error_response(\n        StatusCode::UNAUTHORIZED,\n        \"authentication_error\",\n        \"admin Bearer key required\",\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2803,"end":3366,"unit":"utf16","byteStart":2803,"byteEnd":3366}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3366,"end":3368,"unit":"utf16","byteStart":3366,"byteEnd":3368},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"banned","span":{"start":3368,"end":3770,"unit":"utf16","byteStart":3368,"byteEnd":3770},"sha256":"64a3aaba597803608d3fab4bc052c13390d2a8decf7e2eb0c6d9b459a652026f","source":"fn banned(retry_after: u64) -> Response {\n    let mut response = error_response(\n        StatusCode::TOO_MANY_REQUESTS,\n        \"rate_limit_error\",\n        \"management authentication temporarily locked for this client IP\",\n    );\n    response.headers_mut().insert(\n        \"retry-after\",\n        HeaderValue::from_str(&retry_after.to_string()).expect(\"integer is a valid header\"),\n    );\n    response\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":3368,"end":3770,"unit":"utf16","byteStart":3368,"byteEnd":3770}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3770,"end":3771,"unit":"utf16","byteStart":3770,"byteEnd":3771},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
