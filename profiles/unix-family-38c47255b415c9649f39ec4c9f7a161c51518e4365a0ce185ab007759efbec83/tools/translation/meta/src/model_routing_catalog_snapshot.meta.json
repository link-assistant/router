no supported library declaration emission","span":{"start":430,"end":995},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":995,"end":1238,"unit":"utf16","byteStart":995,"byteEnd":1238},"sha256":"782090ac256a418a3efc21c5da00e7e8bab46eb9f265f276e7df02dbda7f64a9","source":"\n\n/// Add every configured-but-unusable subscription to `degraded_providers`.\n///\n/// Reported with a fixed public reason, so a client can distinguish degradation\n/// without receiving a credential path or upstream response body (issue #318).\n","status":"preserved","diagnostic":null},{"term":"fn","name":"merge_configured_degradation","span":{"start":1238,"end":2731,"unit":"utf16","byteStart":1238,"byteEnd":2731},"sha256":"b7626074483e4660336bb5fbfd5e749b87cfebd9f810e5ba4991cf1c3578d2ae","source":"pub(super) fn merge_configured_degradation(health: &[ProviderHealthReport], catalog: &mut Value) {\n    let mut degraded = catalog\n        .get(\"degraded_providers\")\n        .and_then(Value::as_array)\n        .cloned()\n        .unwrap_or_default();\n    let mut starting = catalog\n        .get(\"starting_providers\")\n        .and_then(Value::as_array)\n        .cloned()\n        .unwrap_or_default();\n    for entry in health\n        .iter()\n        .filter(|entry| entry.state == ProviderHealthState::Starting)\n    {\n        let name = Value::from(entry.provider.as_str());\n        if !starting.contains(&name) {\n            starting.push(name);\n        }\n    }\n    let mut reasons = serde_json::Map::new();\n    for entry in health.iter().filter(|entry| entry.is_degraded()) {\n        let name = Value::from(entry.provider.as_str());\n        if !degraded.contains(&name) {\n            degraded.push(name);\n        }\n        // The summary, not the reason: service model catalogs answer client tokens,\n        // and a credential path is not a client's business.\n        if let Some(summary) = entry.summary {\n            reasons.insert(entry.provider.as_str().to_string(), Value::from(summary));\n        }\n    }\n    if let Some(object) = catalog.as_object_mut() {\n        object.insert(\"degraded_providers\".into(), Value::Array(degraded));\n        object.insert(\"degraded_reasons\".into(), Value::Object(reasons));\n        object.insert(\"starting_providers\".into(), Value::Array(starting));\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1238,"end":2731,"unit":"utf16","byteStart":1238,"byteEnd":2731}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2731,"end":2732,"unit":"utf16","byteStart":2731,"byteEnd":2732},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
