 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":5,"preserved":6},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":92,"unit":"utf16","byteStart":0,"byteEnd":92},"sha256":"607f74487e0643368c3b48b5b11341667fa0b63ae8b21a3c5e36b9fe352c1b36","source":"//! A repaint can contain a complete exact model on screen without writing it contiguously.\n","status":"preserved","diagnostic":null,"comment":true},{"term":"opaque","name":null,"span":{"start":92,"end":105,"unit":"utf16","byteStart":92,"byteEnd":105},"sha256":"fd53a6e6818666d4971c853bcb20e26ff6211823191477ae9946fb69967e4786","source":"#![cfg(unix)]","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item opaque: no supported library declaration emission","span":{"start":92,"end":105},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":105,"end":106,"unit":"utf16","byteStart":105,"byteEnd":106},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"link_assistant_router","span":{"start":106,"end":155,"unit":"utf16","byteStart":106,"byteEnd":155},"sha256":"90422a260a852dcf63d6d5d7ab4e37bb712d75343d77cf6b15829ff4d40375b4","source":"use link_assistant_router::login_pty::PtySession;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":106,"end":155},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":155,"end":156,"unit":"utf16","byteStart":155,"byteEnd":156},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"portable_pty","span":{"start":156,"end":189,"unit":"utf16","byteStart":156,"byteEnd":189},"sha256":"dbd111d4ae93983ca5e08d0ce47c81cdaf9490ae1cc34c8a9e244800e94b72e8","source":"use portable_pty::CommandBuilder;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":156,"end":189},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":189,"end":190,"unit":"utf16","byteStart":189,"byteEnd":190},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"std","span":{"start":190,"end":214,"unit":"utf16","byteStart":190,"byteEnd":214},"sha256":"6ddd16fc08d6d321b57de50496eb1f749d9f92b7bd5eaf606e986a325b8fb032","source":"use std::time::Duration;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":190,"end":214},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":214,"end":216,"unit":"utf16","byteStart":214,"byteEnd":216},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"cursor_repaint_preserves_the_exact_model_and_removes_stale_text","span":{"start":216,"end":983,"unit":"utf16","byteStart":216,"byteEnd":983},"sha256":"3a1decc4898e5cee9311bd028934b9ac661dd02508414f05b6268634a6c7edbe","source":"#[test]\nfn cursor_repaint_preserves_the_exact_model_and_removes_stale_text() {\n    let mut command = CommandBuilder::new(\"sh\");\n    // Paint a partial row, move back to replace its suffix, then clear stale rows.\n    command.args([\"-c\", r\"printf 'Select model\\r\\nfuture-claude-xxxxx\\033[2;15Hnative\\r\\nobsolete\\033[3;1H\\033[2K'; sleep 1\"]);\n    let session = PtySession::spawn(command).unwrap();\n    let screen = session\n        .wait_for_screen(\n            |text| text.contains(\"future-claude-native\"),\n            Duration::from_millis(50),\n            Duration::from_secs(3),\n        )\n        .unwrap();\n    assert!(screen.contains(\"Select model\"));\n    assert!(!screen.contains(\"obsolete\"));\n    assert!(!session.transcript().contains(\"future-claude-native\"));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":216,"end":222},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":983,"end":984,"unit":"utf16","byteStart":983,"byteEnd":984},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
