yteEnd":990},"sha256":"36c0852d1b3ad4ee771c3f8940d00b9482899facd1040a21486dc91139f8e0e0","source":"use link_assistant_router::subscription::{SubscriptionProvider, SubscriptionReader};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":906,"end":990},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":990,"end":992,"unit":"utf16","byteStart":990,"byteEnd":992},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"const","name":"SEEDED_ACCESS_TOKEN","span":{"start":992,"end":1058,"unit":"utf16","byteStart":992,"byteEnd":1058},"sha256":"e80f87022fafe1e26c8b77370911b77e734bc4748b351f7c15c7b26ada934b37","source":"const SEEDED_ACCESS_TOKEN: &str = \"keychain-ci-fake-access-token\";","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":1019,"end":1023},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1058,"end":1059,"unit":"utf16","byteStart":1058,"byteEnd":1059},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"const","name":"STALE_FILE_TOKEN","span":{"start":1059,"end":1119,"unit":"utf16","byteStart":1059,"byteEnd":1119},"sha256":"7bc10ef3ae9fc8f779c96e60e55deab4e3e45aac4b8dd5d16ff2fb96f13ac678","source":"const STALE_FILE_TOKEN: &str = \"file-ci-stale-access-token\";","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":1083,"end":1087},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1119,"end":1120,"unit":"utf16","byteStart":1119,"byteEnd":1120},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"const","name":"SCOPED_DIR","span":{"start":1120,"end":1171,"unit":"utf16","byteStart":1120,"byteEnd":1171},"sha256":"e0ec289cbd1de821aeb01fb4483a995e7160258b8b809f45fc7f126b3ebcc9c2","source":"const SCOPED_DIR: &str = \"/tmp/router-keychain-ci\";","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":1138,"end":1142},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1171,"end":1307,"unit":"utf16","byteStart":1171,"byteEnd":1307},"sha256":"8ef7123428505e53cd0445c33ffee3b9ca8243c90c81d0df4330059004c2b9cc","source":"\n\n/// Whether the seeded throwaway keychain is in place. A skip is announced\n/// and counted like every other gated test, never silent.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"seeded","span":{"start":1307,"end":1634,"unit":"utf16","byteStart":1307,"byteEnd":1634},"sha256":"582352bfa1d9fa6a829cb83ed67d432edee3852f0e85a0ac7f2aee865a506174","source":"fn seeded() -> bool {\n    if !cfg!(target_os = \"macos\") {\n        common::tiers::unavailable(\n            Tier::Integration,\n            &common::tiers::current_test(),\n            \"the Keychain exists only on macOS\",\n        );\n        return false;\n    }\n    common::tiers::opt_in(Tier::Integration, \"ROUTER_TEST_KEYCHAIN\")\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"macro cfg!: requires actual source macro expansion and binding resolution","span":{"start":1337,"end":1341},"details":{"construct":"macro cfg!"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1634,"end":1636,"unit":"utf16","byteStart":1634,"byteEnd":1636},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_seeded_claude_entry_is_found_and_read","span":{"start":1636,"end":2329,"unit":"utf16","byteStart":1636,"byteEnd":2329},"sha256":"b04007cffb9296ad18f7ddf5b89d6e93eaa51704188470fcb60afdb234655fb0","source":"#[test]\nfn the_seeded_claude_entry_is_found_and_read() {\n    if !seeded() {\n        return;\n    }\n    assert_eq!(\n        platform_keychain::service_name(SubscriptionProvider::Claude),\n        Some(\"Claude Code-credentials\")\n    );\n    assert!(platform_keychain::has_entry(\"Claude Code-credentials\"));\n    let raw = platform_keychain::lookup(SubscriptionProvider::Claude)\n        .expect(\"the seeded Claude Code entry is readable\");\n    assert!(\n        raw.contains(SEEDED_ACCESS_TOKEN),\n        \"unexpected entry: {}\",\n        raw.len()\n    );\n    // Providers without a vendor keychain entry never consult it.\n    assert!(platform_keychain::lookup(SubscriptionProvider::Codex).is_none());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1636,"end":1642},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2329,"end":2331,"unit":"utf16","byteStart":2329,"byteEnd":2331},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_config_directory_scoped_entry_is_found_by_its_hashed_name","span":{"start":2331,"end":2779,"unit":"utf16","byteStart":2331,"byteEnd":2779},"sha256":"cc0b764d8255c77865bb225becec18e4ee38b1b3881c1415851b10c561a1514b","source":"#[test]\nfn a_config_directory_scoped_entry_is_found_by_its_hashed_name() {\n    if !seeded() {\n        return;\n    }\n    let scoped = platform_keychain::claude_service_for(Some(std::ffi::OsStr::new(SCOPED_DIR)));\n    assert_ne!(scoped, \"Claude Code-credentials\");\n    assert!(platform_keychain::has_entry(&scoped), \"{scoped} not found\");\n    assert!(!platform_keychain::has_entry(\n        \"link-assistant-router-nonexistent-service-a8f3c1\"\n    ));\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2331,"end":2337},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2779,"end":2781,"unit":"utf16","byteStart":2779,"byteEnd":2781},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_live_keychain_credential_beats_a_stale_file","span":{"start":2781,"end":3391,"unit":"utf16","byteStart":2781,"byteEnd":3391},"sha256":"d3570dc3a9f2355f7a5863f37c6419d555e456daa0f0555636cb623560c1436f","source":"#[test]\nfn the_live_keychain_credential_beats_a_stale_file() {\n    if !seeded() {\n        return;\n    }\n    let home = std::env::var(\"HOME\").expect(\"HOME is set\");\n    let reader = SubscriptionReader::from_user_home(SubscriptionProvider::Claude, &home);\n    let (token, origin) = reader.read_token_from().expect(\"a Claude credential\");\n    assert_eq!(\n        origin,\n        Origin::Keychain,\n        \"the newer Keychain entry must win\"\n    );\n    assert_eq!(token.access_token, SEEDED_ACCESS_TOKEN);\n    assert_ne!(token.access_token, STALE_FILE_TOKEN);\n    assert!(reader.has_platform_store_credential());\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2781,"end":2787},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":3391,"end":3392,"unit":"utf16","byteStart":3391,"byteEnd":3392},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
