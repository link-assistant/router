and_then(reqwest::Response::error_for_status)\n        .map_err(|e| e.to_string())?;\n    let mut stream = response.bytes_stream();\n    let mut body = Vec::new();\n    while let Some(chunk) = stream.next().await {\n        let chunk = chunk.map_err(|e| e.to_string())?;\n        if body.len().saturating_add(chunk.len()) > 64 * 1024 {\n            return Err(\"release response exceeds limit\".into());\n        }\n        body.extend_from_slice(&chunk);\n    }\n    let release: Value = serde_json::from_slice(&body).map_err(|e| e.to_string())?;\n    let tag = release[\"tag_name\"].as_str().ok_or(\"release tag missing\")?;\n    let latest = tag.strip_prefix('v').unwrap_or(tag);\n    let latest_parts = parts(latest).ok_or(\"invalid stable release version\")?;\n    let current_parts = parts(crate::VERSION).ok_or(\"invalid current version\")?;\n    Ok(\n        json!({\"current_version\": crate::VERSION, \"latest_version\": latest,\n        \"update_available\": latest_parts > current_parts,\n        \"release_url\": format!(\"https://github.com/link-assistant/router/releases/tag/{tag}\")}),\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":444,"end":1915,"unit":"utf16","byteStart":444,"byteEnd":1915}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1915,"end":1917,"unit":"utf16","byteStart":1915,"byteEnd":1917},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parts","span":{"start":1917,"end":2117,"unit":"utf16","byteStart":1917,"byteEnd":2117},"sha256":"41b708b365d578214eaeecaa19f113dae14d0d167fcfc6829f6b8208cb4aa26b","source":"fn parts(version: &str) -> Option<[u64; 3]> {\n    let parts = version\n        .split('.')\n        .map(str::parse)\n        .collect::<Result<Vec<u64>, 