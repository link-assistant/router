AME_OPTIONS, \"DENY\"),\n    (header::X_CONTENT_TYPE_OPTIONS, \"nosniff\"),\n    (header::REFERRER_POLICY, \"no-referrer\"),\n];","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1822,"end":2072,"unit":"utf16","byteStart":1828,"byteEnd":2078}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2072,"end":2275,"unit":"utf16","byteStart":2078,"byteEnd":2281},"sha256":"e34d01d5eadb5967ab9b0328ae0e7c566036423423d93b002bf7c7afcf5c25f1","source":"\n\n/// Middleware that hardens every admin response.\n///\n/// Existing headers are overwritten: nothing downstream has a reason to set a\n/// weaker policy, and silently keeping one would defeat the point.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"apply","span":{"start":2275,"end":2546,"unit":"utf16","byteStart":2281,"byteEnd":2552},"sha256":"334fec75c850df8eab704ed34147a9c3eb46be9bc5e1679a654e6a0984cbac34","source":"pub async fn apply(request: Request, next: Next) -> Response {\n    let mut response = next.run(request).await;\n    let headers = response.headers_mut();\n    for (name, value) in HEADERS {\n        headers.insert(name, HeaderValue::from_static(value));\n    }\n    response\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2275,"end":2546,"unit":"utf16","byteStart":2281,"byteEnd":2552}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2546,"end":2548,"unit":"utf16","byteStart":2552,"byteEnd":2554},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":2548,"end":3292,"unit":"utf16","byteStart":2554,"byteEnd":3298},"sha256":"ca1c7c62dfa4193769b4b10a3399aafbe310bbb33099aeb4e9ee216024775e42","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn the_policy_pins_scripts_to_this_origin_and_forbids_framing() {\n        assert!(CONTENT_SECURITY_POLICY.contains(\"script-src 'self'\"));\n        assert!(CONTENT_SECURITY_POLICY.contains(\"frame-ancestors 'none'\"));\n        assert!(\n            !CONTENT_SECURITY_POLICY.contains(\"script-src 'self' 'unsafe-inline'\"),\n            \"inline script would re-open the injection path to the localStorage token\"\n        );\n    }\n\n    #[test]\n    fn every_hardening_header_has_a_valid_value() {\n        for (name, value) in HEADERS {\n            assert!(\n                HeaderValue::from_str(value).is_ok(),\n                \"{name} carries an unsendable value\"\n            );\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":2548,"end":3292},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3292,"end":3293,"unit":"utf16","byteStart":3298,"byteEnd":3299},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
