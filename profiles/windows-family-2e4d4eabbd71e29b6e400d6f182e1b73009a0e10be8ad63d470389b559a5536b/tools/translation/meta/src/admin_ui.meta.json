{"integerEncoding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":9,"preserved":10},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":510,"unit":"utf16","byteStart":0,"byteEnd":510},"sha256":"730275e7b21f9b564ce2f770426e929436bd95fc8d9e88d35a08ce691381a82a","source":"//! Serving of the embedded admin UI bundle.\n//!\n//! The React app in `ui/` is built by Vite into `ui/dist` with stable asset\n//! names (`assets/app.js`, `assets/app.css`) and embedded into the binary by\n//! `rust-embed`, so the single-container deployment story holds: no separate\n//! web server, no assets to mount.\n//!\n//! Unknown paths fall back to `index.html` so the client-side app owns its own\n//! routing; unknown paths under `/api/` do not, because a JSON client should\n//! get a `404`, not a page.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"axum","span":{"start":510,"end":537,"unit":"utf16","byteStart":510,"byteEnd":537},"sha256":"e098e0cc91595e54509add946d245738413ef8be724d5ee3acf5fc2d1fcb7917","source":"use axum::extract::Request;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":510,"end":537},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":537,"end":538,"unit":"utf16","byteStart":537,"byteEnd":538},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"axum","span":{"start":538,"end":588,"unit":"utf16","byteStart":538,"byteEnd":588},"sha256":"3e6061655b2db23a37aaac363b60d1ea3aa32e37188e8e1ea676a1f99b8fb4d6","source":"use axum::http::{HeaderValue, StatusCode, header};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":538,"end":588},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":588,"end":589,"unit":"utf16","byteStart":588,"byteEnd":589},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"axum","span":{"start":589,"end":634,"unit":"utf16","byteStart":589,"byteEnd":634},"sha256":"e26e7efadde25f7b4620919b9c4b271d102a07cc76d6b89cf9727d098c01fc4a","source":"use axum::response::{IntoResponse, Response};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":589,"end":634},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":634,"end":635,"unit":"utf16","byteStart":634,"byteEnd":635},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"rust_embed","span":{"start":635,"end":661,"unit":"utf16","byteStart":635,"byteEnd":661},"sha256":"d3a6dbf85c7f1fec7ae74179776cc6d54d668051e62636e6cf4827466bcac8c0","source":"use rust_embed::RustEmbed;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":635,"end":661},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":661,"end":720,"unit":"utf16","byteStart":661,"byteEnd":720},"sha256":"3eb8ae1cfbf77036f5e4b16d5c3ec8af00d6c8a0dfd2c34d6a64378e76e705ef","source":"\n\n/// The built admin UI bundle, embedded at compile time.\n","status":"preserved","diagnostic":null},{"term":"struct","name":"Assets","span":{"start":720,"end":777,"unit":"utf16","byteStart":720,"byteEnd":777},"sha256":"0b47d45066b165c6bacfbc420d0110d05ceff5dec8eef6d8006f563b53a523bd","source":"#[derive(RustEmbed)]\n#[folder = \"ui/dist\"]\nstruct Assets;","status":"carried","diagnostic":{"kind":"unsupported","message":"derive(RustEmbed): derive requires a separately checked capability","span":{"start":729,"end":738},"details":{"construct":"derive(RustEmbed)"}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"derive","span":{"start":0,"end":20},"tokens":["#","[","derive","(","RustEmbed",")","]"],"evaluation":null},{"name":"folder","span":{"start":21,"end":42},"tokens":["#","[","folder","=","\"ui/dist\"","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":777,"end":853,"unit":"utf16","byteStart":777,"byteEnd":853},"sha256":"15e3c3ff92ceb5a52a17243ed48bfb562b1d4cef654eb9f4a625a55950d0b9f0","source":"\n\n/// Serve an embedded asset, falling back to `index.html` for app routes.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"serve_asset","span":{"start":853,"end":1394,"unit":"utf16","byteStart":853,"byteEnd":1394},"sha256":"23731b0825ddf61ef86b79028f69a60241ecb1c1105b747692b1c23e96e8585f","source":"pub async fn serve_asset(request: Request) -> Response {\n    let path = request.uri().path().trim_start_matches('/');\n    if let Some(response) = asset_response(path) {\n        return response;\n    }\n    if request.uri().path().starts_with(\"/api/\") {\n        return (StatusCode::NOT_FOUND, \"not found\").into_response();\n    }\n    asset_response(\"index.html\").unwrap_or_else(|| {\n        (\n            StatusCode::INTERNAL_SERVER_ERROR,\n            \"admin UI bundle is missing from this build\",\n        )\n            .into_response()\n    })\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":853,"end":1394,"unit":"utf16","byteStart":853,"byteEnd":1394}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1394,"end":1472,"unit":"utf16","byteStart":1394,"byteEnd":1472},"sha256":"cc5107e5aa98d4c02d448decc82368eeb3b1956f18ad2b96b3a5c3d06ce6a5eb","source":"\n\n/// Look up one embedded file and wrap it in a response with its MIME type.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"asset_response","span":{"start":1472,"end":2142,"unit":"utf16","byteStart":1472,"byteEnd":2142},"sha256":"7bdbc67a9e60fbe0940be69c8142a21e3b787cfa5c6198dfdff96ed539e08952","source":"fn asset_response(path: &str) -> Option<Response> {\n    let path = if path.is_empty() { \"index.html\" } else { path };\n    let file = Assets::get(path)?;\n    let mime = content_type(path);\n    let mut response = file.data.into_owned().into_response();\n    response\n        .headers_mut()\n        .insert(header::CONTENT_TYPE, HeaderValue::from_static(mime));\n    // The bundle is versioned with the binary, and the operator may upgrade at\n    // any time, so assets are revalidated rather than cached indefinitely.\n    response.headers_mut().insert(\n        header::CACHE_CONTROL,\n        HeaderValue::from_static(\"no-cache, must-revalidate\"),\n    );\n    Some(response)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1472,"end":2142,"unit":"utf16","byteStart":1472,"byteEnd":2142}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2142,"end":2217,"unit":"utf16","byteStart":2142,"byteEnd":2217},"sha256":"ce78998f41a2a18c8e9244c92ed3988505af7977be053f634c922e05f3cbb935","source":"\n\n/// Minimal extension-to-MIME map covering what Vite emits for this app.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"content_type","span":{"start":2217,"end":2729,"unit":"utf16","byteStart":2217,"byteEnd":2729},"sha256":"60655c976701045ffa3bd8b6f808c95f423da1f3fce9a12bacd571d86473dc51","source":"fn content_type(path: &str) -> &'static str {\n    match path.rsplit_once('.').map(|(_, ext)| ext) {\n        Some(\"html\") => \"text/html; charset=utf-8\",\n        Some(\"js\" | \"mjs\") => \"text/javascript; charset=utf-8\",\n        Some(\"css\") => \"text/css; charset=utf-8\",\n        Some(\"json\") => \"application/json\",\n        Some(\"svg\") => \"image/svg+xml\",\n        Some(\"png\") => \"image/png\",\n        Some(\"ico\") => \"image/x-icon\",\n        Some(\"woff2\") => \"font/woff2\",\n        _ => \"application/octet-stream\",\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2217,"end":2729,"unit":"utf16","byteStart":2217,"byteEnd":2729}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2729,"end":2731,"unit":"utf16","byteStart":2729,"byteEnd":2731},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"mod","name":"tests","span":{"start":2731,"end":3277,"unit":"utf16","byteStart":2731,"byteEnd":3277},"sha256":"d8061f22bd1e1e98d2b10ddda520a48ea15d92b5c23ba25bb06dd2b0dc0ae5d9","source":"#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn index_is_embedded() {\n        assert!(Assets::get(\"index.html\").is_some());\n    }\n\n    #[test]\n    fn content_types_are_mapped() {\n        assert_eq!(content_type(\"index.html\"), \"text/html; charset=utf-8\");\n        assert_eq!(\n            content_type(\"assets/app.js\"),\n            \"text/javascript; charset=utf-8\"\n        );\n        assert_eq!(content_type(\"assets/app.css\"), \"text/css; charset=utf-8\");\n        assert_eq!(content_type(\"noext\"), \"application/octet-stream\");\n    }\n}","status":"carried","diagnostic":{"kind":"configuration","message":"source item requires an active checked compilation condition","span":{"start":2731,"end":3277},"details":{}},"comment":false,"configuration":{"status":"inactive","attributes":[{"name":"cfg","span":{"start":0,"end":12},"tokens":["#","[","cfg","(","test",")","]"],"evaluation":{"value":false,"span":{"start":6,"end":10},"diagnostics":[]}}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":3277,"end":3278,"unit":"utf16","byteStart":3277,"byteEnd":3278},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
