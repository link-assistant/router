rs","bytes":6117,"sha256":"54d599033e5a182a3076a0ba23a3550bf8680c99399b0313166b3c42c85b35b9","archiveSha256":"e02a74f9f314bfe362e977798f0df8bf45d7c9218c036192f179db4871d75b7c"},{"path":"serde_json-1.0.151-src-lexical-bhcomp.rs.gz","sourcePath":"serde_json-1.0.151/src/lexical/bhcomp.rs","bytes":7035,"sha256":"26f39d52008225a6b377d7246d326940d44200e160a7b4652733e712e1a45a04","archiveSha256":"cc112f40166e56bd03b5fcae75e2b8a86cd0a62e19009e39ff83e205d725fc06"},{"path":"serde_json-1.0.151-src-lexical-rounding.rs.gz","sourcePath":"serde_json-1.0.151/src/lexical/rounding.rs","bytes":7388,"sha256":"4762af3612880b17468ff2a1bb800c8e99f08330ae439699dd53d8dc5463ad13","archiveSha256":"4b0bb5a7690bebfb5cece63d6e96d2d8073d31945ddefeb32873d4771365e4d7"}]},"runtimeParity":false,"numericBranchImplemented":"not(float_roundtrip) default u64 accumulator","generatedTraitBehavior":false},"compilationProfile":null,"configurationCondition":null,"sourceLanguage":"Rust","targetLanguages":["JavaScript","TypeScript"],"sourcePath":"src/entrypoint_tests.rs","sourceSha256":"8b2a791f7c14b46018ae0725a9e275fc006d27abd06e49cdc6e4288918d31ba2","sourceBytes":1570,"translator":{"repository":"link-foundation/meta-language","commit":"e46e196db5ec34bf13a73b8645aa38d409737e60","structuralFrontend":"formal-ai lexer with Router opaque-literal extensions","pipeline":"Rust syntax → serialized/reparsed checked semantic IR → JavaScript/TypeScript","extensions":["checked Rust strings and scalar domain","monomorphic Option/Result and immutable vectors","Rust raw literals and ASCII continuation normalization","checked mutable scalar control flow and immutable slice indexing","module-local immutable records and algebraic constructors","lazy typed scalar iterators, contextual closures and bounded integer ranges","checked standard-library filesystem/environment reads, lazy async futures and identity-error propagation"]},"semantics":{"integerEncoding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":3,"preserved":4},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":43,"unit":"utf16","byteStart":0,"byteEnd":43},"sha256":"8d39bbc83ba9838784c220091c84568426867ddc355d1bdde7c4f21c9bfec44b","source":"//! Unit tests for [`crate::entrypoint`].\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":43,"end":56,"unit":"utf16","byteStart":43,"byteEnd":56},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":43,"end":56},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":56,"end":403,"unit":"utf16","byteStart":56,"byteEnd":405},"sha256":"62c2addabda1be033e55ee0f4b350bb7075f0ee2106bb934cc0ee25bea2e416c","source":"\n\n/// The entry point runs off the process main thread, so its stack is one this\n/// crate chose rather than one the linker fixed.\n///\n/// Windows fixes the main thread at 1 MB, which a debug build of the router's\n/// entry future exceeded — every subcommand died before doing any work, while\n/// Linux and macOS were fine on their 8 MB defaults.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"the_entry_point_runs_on_a_named_thread_of_its_own","span":{"start":403,"end":879,"unit":"utf16","byteStart":405,"byteEnd":881},"sha256":"76b447f53d4383b2790d41b678d939cc931d71679db6c71b798dd5d49dab3828","source":"#[test]\nfn the_entry_point_runs_on_a_named_thread_of_its_own() {\n    let code = run_on_a_deep_stack(|| async {\n        let thread = std::thread::current();\n        assert_eq!(\n            thread.name(),\n            Some(\"router-main\"),\n            \"the entry point must not run on the process main thread\"\n        );\n        std::process::ExitCode::SUCCESS\n    });\n\n    assert_eq!(\n        format!(\"{code:?}\"),\n        format!(\"{:?}\", std::process::ExitCode::SUCCESS)\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":403,"end":409},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":879,"end":991,"unit":"utf16","byteStart":881,"byteEnd":993},"sha256":"c8d8e033af1c127326164a2d22460f8fc2e45c1c8e76a9b43bc92e126f03a1c2","source":"\n\n/// A deep call chain completes, where the platform's main-thread stack would\n/// decide the outcome instead.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_deep_call_chain_completes","span":{"start":991,"end":1567,"unit":"utf16","byteStart":993,"byteEnd":1569},"sha256":"596267be6060e31e1a1413a718f48d65f6e1581628670fe1d085df0687269238","source":"#[test]\nfn a_deep_call_chain_completes() {\n    fn descend(depth: u32) -> u32 {\n        // Each frame holds a kilobyte, so the chain needs far more than a\n        // 1 MB stack to finish.\n        let ballast = [0u8; 1024];\n        if depth == 0 {\n            return u32::from(ballast[0]);\n        }\n        descend(depth - 1)\n    }\n\n    let code = run_on_a_deep_stack(|| async {\n        assert_eq!(descend(3_000), 0);\n        std::process::ExitCode::SUCCESS\n    });\n\n    assert_eq!(\n        format!(\"{code:?}\"),\n        format!(\"{:?}\", std::process::ExitCode::SUCCESS)\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":991,"end":997},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1567,"end":1568,"unit":"utf16","byteStart":1569,"byteEnd":1570},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
