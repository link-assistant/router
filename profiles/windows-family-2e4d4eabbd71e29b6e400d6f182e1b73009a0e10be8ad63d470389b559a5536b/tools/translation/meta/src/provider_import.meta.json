ntics":{"integerEncoding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":1,"executableFunctions":1,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":6,"preserved":7},"items":[{"term":"use","name":"super","span":{"start":0,"end":57,"unit":"utf16","byteStart":0,"byteEnd":57},"sha256":"97ee1717a0287efe4c46f0b6d18f0962ec767694b40d284dc1d4217dfbe82f0c","source":"use super::{ProviderError, ProviderKind, ProviderUpsert};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":0,"end":57},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":57,"end":448,"unit":"utf16","byteStart":57,"byteEnd":448},"sha256":"3b3a66ae37f9d17f266a01a881cbcf86b54ae4bc37cd286fafd34137e5bd66be","source":"\n\n/// Parse a provider manifest without a store to write it into.\n///\n/// Public so a remote `providers import` can read the manifest on *this*\n/// machine and declare each provider on the selected deployment, which is what\n/// importing into another router means (issue #294).\n///\n/// # Errors\n///\n/// Returns the parse error when the manifest is not readable as provider\n/// declarations.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_provider_import","span":{"start":448,"end":1337,"unit":"utf16","byteStart":448,"byteEnd":1337},"sha256":"a058533b6fdb6fb49333815d51b7261674dd3901fb7a8bd59729e12663ec4ad2","source":"pub fn parse_provider_import(input: &str) -> Result<Vec<ProviderUpsert>, ProviderError> {\n    let trimmed = input.trim_start();\n    let providers = if trimmed.starts_with('{') {\n        let doc: serde_json::Value = serde_json::from_str(input)?;\n        if let Some(providers) = doc.get(\"providers\").and_then(serde_json::Value::as_array) {\n            providers\n                .iter()\n                .cloned()\n                .map(serde_json::from_value)\n                .collect::<Result<Vec<_>, _>>()\n                .map_err(ProviderError::Json)?\n        } else {\n            vec![serde_json::from_value(doc).map_err(ProviderError::Json)?]\n        }\n    } else if trimmed.starts_with('[') {\n        serde_json::from_str(input).map_err(ProviderError::Json)?\n    } else {\n        parse_lenv_or_indented(input)?\n    };\n    reject_plaintext_lefine_imports(&providers)?;\n    Ok(providers)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":448,"end":1337,"unit":"utf16","byteStart":448,"byteEnd":1337}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1337,"end":1339,"unit":"utf16","byteStart":1337,"byteEnd":1339},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"reject_plaintext_lefine_imports","span":{"start":1339,"end":1989,"unit":"utf16","byteStart":1339,"byteEnd":1989},"sha256":"ac32fff0c218d0e278a6d49091a099376b2f05501c7c6508ed2461b349a06f2a","source":"fn reject_plaintext_lefine_imports(providers: &[ProviderUpsert]) -> Result<(), ProviderError> {\n    if providers.iter().any(|provider| {\n        provider\n            .kind\n            .as_deref()\n            .and_then(ProviderKind::from_str_opt)\n            == Some(ProviderKind::Lefine)\n            && provider\n                .api_key\n                .as_deref()\n                .is_some_and(|key| !key.is_empty())\n    }) {\n        return Err(ProviderError::Invalid(\n            \"Lefine import files cannot contain plaintext api_key material; use api_key_env or providers add --api-key-stdin\"\n                .into(),\n        ));\n    }\n    Ok(())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1339,"end":1989,"unit":"utf16","byteStart":1339,"byteEnd":1989}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1989,"end":1991,"unit":"utf16","byteStart":1989,"byteEnd":1991},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_lenv_or_indented","span":{"start":1991,"end":2455,"unit":"utf16","byteStart":1991,"byteEnd":2455},"sha256":"2482ac4b926ce15fa8fec9afedaf61858e47f99242880a7762a4ab0a08de2c4b","source":"fn parse_lenv_or_indented(input: &str) -> Result<Vec<ProviderUpsert>, ProviderError> {\n    if input.lines().any(|line| line.starts_with(\"PROVIDER: \")) {\n        let mut providers = Vec::new();\n        for raw in input.lines() {\n            if let Some(json) = raw.trim().strip_prefix(\"PROVIDER: \") {\n                providers.push(serde_json::from_str(json)?);\n            }\n        }\n        return Ok(providers);\n    }\n    parse_indented_provider_config(input)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1991,"end":2455,"unit":"utf16","byteStart":1991,"byteEnd":2455}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2455,"end":2457,"unit":"utf16","byteStart":2455,"byteEnd":2457},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"parse_indented_provider_config","span":{"start":2457,"end":6363,"unit":"utf16","byteStart":2457,"byteEnd":6363},"sha256":"b954f04a4ae312421a7e433b14adaff834fadf2b5493b8b4ea66cd625477a2d4","source":"fn parse_indented_provider_config(input: &str) -> Result<Vec<ProviderUpsert>, ProviderError> {\n    let mut providers = Vec::new();\n    let mut current: Option<ProviderUpsert> = None;\n    for raw in input.lines() {\n        let line = raw.trim_end();\n        if line.trim().is_empty() || line.trim_start().starts_with('#') {\n            continue;\n        }\n        if !line.starts_with(' ') && !line.starts_with('\\t') {\n            if let Some(provider) = current.take() {\n                providers.push(provider);\n            }\n            current = Some(ProviderUpsert {\n                name: line.trim().to_string(),\n                kind: Some(\"openai-compatible\".into()),\n                base_url: String::new(),\n                default_model: None,\n                models: Some(Vec::new()),\n                supported_clients: Some(Vec::new()),\n                api_key: None,\n                api_key_env: None,\n                encrypted_api_key: None,\n                enabled: Some(true),\n                subscriber_id: None,\n                acknowledge_intermediary_risk: None,\n                acknowledge_unsupported_clients: None,\n                if_absent: false,\n            });\n            continue;\n        }\n        let Some(provider) = current.as_mut() else {\n            return Err(ProviderError::Invalid(\n                \"indented provider field without provider name\".into(),\n            ));\n        };\n        let (key, value) = split_indented_field(line.trim())?;\n        match key {\n            \"kind\" => provider.kind = Some(value),\n            \"base_url\" | \"base-url\" | \"api_base\" | \"api-base\" => provider.base_url = value,\n            \"model\" | \"default_model\" | \"default-model\" => provider.default_model = Some(value),\n            \"models\" => {\n                provider.models = Some(\n                    value\n                        .split(',')\n                        .map(str::trim)\n                        .filter(|s| !s.is_empty())\n                        .map(ToString::to_string)\n                        .collect(),\n                );\n            }\n            \"supported_clients\" | \"supported-clients\" => {\n                provider.supported_clients = Some(\n                    value\n                        .split(',')\n                        .map(str::trim)\n                        .filter(|entry| !entry.is_empty())\n                        .map(ToString::to_string)\n                        .collect(),\n                );\n            }\n            \"api_key\" | \"api-key\" => provider.api_key = Some(value),\n            \"api_key_env\" | \"api-key-env\" => provider.api_key_env = Some(value),\n            \"enabled\" => provider.enabled = Some(matches!(value.as_str(), \"true\" | \"1\" | \"yes\")),\n            \"subscriber_id\" | \"subscriber-id\" => provider.subscriber_id = Some(value),\n            \"acknowledge_intermediary_risk\" | \"acknowledge-intermediary-risk\" => {\n                provider.acknowledge_intermediary_risk =\n                    Some(matches!(value.as_str(), \"true\" | \"1\" | \"yes\"));\n            }\n            \"acknowledge_unsupported_clients\" | \"acknowledge-unsupported-clients\" => {\n                provider.acknowledge_unsupported_clients = Some(\n                    value\n                        .split(',')\n                        .map(str::trim)\n                        .filter(|entry| !entry.is_empty())\n                        .map(ToString::to_string)\n                        .collect(),\n                );\n            }\n            other => {\n                return Err(ProviderError::Invalid(format!(\n                    \"unknown provider field: {other}\"\n                )));\n            }\n        }\n    }\n    if let Some(provider) = current {\n        providers.push(provider);\n    }\n    if providers.is_empty() {\n        return Err(ProviderError::Invalid(\n            \"provider import did not contain any providers\".into(),\n        ));\n    }\n    Ok(providers)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2457,"end":6363,"unit":"utf16","byteStart":2457,"byteEnd":6363}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":6363,"end":6365,"unit":"utf16","byteStart":6363,"byteEnd":6365},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"split_indented_field","span":{"start":6365,"end":6712,"unit":"utf16","byteStart":6365,"byteEnd":6712},"sha256":"4e9e2207be48f3a9cee9a3207dcc9cbdcedf9566d02443635bfbc23bf291cdd9","source":"fn split_indented_field(line: &str) -> Result<(&str, String), ProviderError> {\n    let Some((key, raw_value)) = line.split_once(char::is_whitespace) else {\n        return Err(ProviderError::Invalid(format!(\n            \"provider field must be key value: {line}\"\n        )));\n    };\n    let value = raw_value.trim();\n    Ok((key, unquote(value)))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":6365,"end":6712,"unit":"utf16","byteStart":636