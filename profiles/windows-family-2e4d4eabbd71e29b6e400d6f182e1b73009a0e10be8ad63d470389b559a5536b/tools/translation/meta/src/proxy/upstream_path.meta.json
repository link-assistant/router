semantics":{"integerEncoding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":1,"executableFunctions":1,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":0,"preserved":2},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":687,"unit":"utf16","byteStart":0,"byteEnd":687},"sha256":"6d926c4d980d69e39b1a08ac29bc5804790ba0df2c1e761f22aa2f1536b2d371","source":"//! Mapping an inbound request path to its upstream path.\n//!\n//! Split from `proxy.rs` to keep that file within the repository's 1000-line\n//! limit.\n\n/// Resolve the upstream path from the incoming request path.\n///\n/// Maps all supported API format paths to the correct upstream path:\n/// - `/v1/messages` -> `/v1/messages` (Anthropic Messages)\n/// - `/v1/messages/count_tokens` -> `/v1/messages/count_tokens` (Anthropic Messages)\n/// - `/invoke` -> `/invoke` (Bedrock)\n/// - `/invoke-with-response-stream` -> `/invoke-with-response-stream` (Bedrock)\n/// - Paths ending in `:rawPredict` or `:streamRawPredict` -> pass through (Vertex)\n/// - `/api/latest/anthropic/*` -> `/*` (legacy)\n","status":"preserved","diagnostic":null,"comment":true},{"term":"fn","name":"resolve_upstream_path","span":{"start":687,"end":1472,"unit":"utf16","byteStart":687,"byteEnd":1472},"sha256":"f6e0b6a8d1b6a82416241b45b855013c192e8c394fb07eb3306b4a288e18eaa7","source":"#[must_use]\npub fn resolve_upstream_path(path: &str) -> String {\n    if let Some(rest) = path.strip_prefix(\"/api/services/anthropic\") {\n        return rest.to_string();\n    }\n    if let Some(rest) = path.strip_prefix(\"/api/services/bedrock\") {\n        return rest.to_string();\n    }\n    if let Some(rest) = path.strip_prefix(\"/api/services/vertex\") {\n        return rest.to_string();\n    }\n    if let Some(rest) = path.strip_prefix(\"/api/anthropic\") {\n        return rest.to_string();\n    }\n    // Legacy prefix: strip and forward\n    if let Some(rest) = path.strip_prefix(\"/api/latest/anthropic\") {\n        return rest.to_string();\n    }\n\n    // All other paths (Anthropic /v1/*, Bedrock /invoke*, Vertex *:rawPredict)\n    // are forwarded as-is to the upstream\n    path.to_string()\n}","status":"executable","diagnostic":null,"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]},"semantic":{"checkedIR":{"k":"fn","name":"rp_70726f78792e757073747265616d5f706174682e7265736f6c76655f757073747265616d5f70617468","params":[{"name":"path","type":{"kind":"string","rustSourceType":true,"rustOwnership":{"kind":"borrowed","source":"str"},"rustBorrowLifetime":{"kind":"elided","source":"borrowed-str-type","span":{"start":2922196,"end":2922200},"tokens":[{"kind":"punct","value":"&","span":{"start":2922196,"end":2922197}},{"kind":"identifier","value":"str","span":{"start":2922197,"end":2922200}}]}},"guard":null,"default":null}],"ret":{"kind":"string","patternOwnershipRefusal":"ownership-bearing String type","rustSourceType":true,"rustOwnership":{"kind":"owned","source":"String"}},"body":{"k":"let","name":"ml_pattern_3","value":{"k":"let","name":"ml_text_1","value":{"k":"var","name":"path","type":{"kind":"string","rustSour