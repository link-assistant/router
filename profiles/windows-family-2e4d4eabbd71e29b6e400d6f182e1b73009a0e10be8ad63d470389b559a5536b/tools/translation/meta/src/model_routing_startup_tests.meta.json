ume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":6,"preserved":7},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":92,"unit":"utf16","byteStart":0,"byteEnd":92},"sha256":"29acbfe56a68aebbff8bc0b51c90c0b8b60c67cd8bb6ab15e8228417de71a477","source":"//! Startup catalog health: restored catalogs are starting, not degraded\n//! (issue #665).\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":92,"end":137,"unit":"utf16","byteStart":92,"byteEnd":137},"sha256":"e0e21bbbf72f56d2595a853257d3266eab211dea5b81c99cfcbc692fc6e1898d","source":"use super::health_tests::subscription_report;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":92,"end":137},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":137,"end":138,"unit":"utf16","byteStart":137,"byteEnd":138},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"super","span":{"start":138,"end":167,"unit":"utf16","byteStart":138,"byteEnd":167},"sha256":"f3c2c02bcbb4e7ad5346