diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":255,"end":256,"unit":"utf16","byteStart":255,"byteEnd":256},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"process","span":{"start":256,"end":364,"unit":"utf16","byteStart":256,"byteEnd":364},"sha256":"99aa960007b6cc05887911a1f05084b100ff6e8c8081cd04b9dc99907bd7b0f7","source":"pub(crate) use process::{\n    FILE_DIAGNOSTICS, child_exit, data_dir, diagnostic, event, event_file, run,\n};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":256,"end":364},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":364,"end":430,"unit":"utf16","byteStart":364,"byteEnd":430},"sha256":"8a7b1493c65554864f64c9aaa32d244c249bd3ffd668a54968fcf43db185e1b9","source":"\n\n/// Construct and announce the bounded request-log destination.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"request_log","span":{"start":430,"end":1317,"unit":"utf16","byteStart":430,"byteEnd":1317},"sha256":"15ff100bd94f3cf9cc87bdf0590b74d5978138485f069ca8f0d7a5264e0b409c","source":"#[must_use]\npub fn request_log(\n    data_dir: &std::path::Path,\n    configured_path: Option<&std::path::Path>,\n    max_bytes: u64,\n    max_total_bytes: u64,\n) -> std::sync::Arc<crate::request_log::RequestLog> {\n    let path =\n        configured_path.map_or_else(|| data_dir.join(\"requests\"), std::path::Path::to_path_buf);\n    // Both numbers, because the per-token one was announced alone and read as\n    // the store's size (issue #331).\n    let total = if max_total_bytes == 0 {\n        String::from(\"uncapped\")\n    } else {\n        format!(\"{max_total_bytes} bytes\")\n    };\n    tracing::info!(\n        \"Request log: {} (max {max_bytes} bytes per token, {total} in total)\",\n        path.display()\n    );\n    std::sync::Arc::new(\n        crate::request_log::RequestLog::new(path, max_bytes)\n            .with_total_limit(max_total_bytes)\n            .with_error_log_from_env(),\n    )\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":430,"end":1317,"unit":"utf16","byteStart":430,"byteEnd":1317}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1317,"end":1368,"unit":"utf16","byteStart":1317,"byteEnd":1368},"sha256":"36ffd5b487a181d6d02c2ab5f752b1121507214208604af813f8eb2aefd5e9a2","source":"\n\n/// Install the process-wide tracing subscriber.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"init","span":{"start":1368,"end":1535,"unit":"utf16","byteStart":1368,"byteEnd":1535},"sha256":"03c7891f922915db252ec09d22a46587ef2a680c187b7a4881ae1dfb8c6ef2f2","source":"pub fn init(verbose: bool) {\n    process::install(&crate::config::default_data_dir(), verbose, Vec::new())\n        .expect(\"install persistent operational logging\");\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1368,"end":1535,"unit":"utf16","byteStart":1368,"byteEnd":1535}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1535,"end":1606,"unit":"utf16","byteStart":1535,"byteEnd":1606},"sha256":"83b5cc46de0295b47fbc44ad1bd9cb78e8091bf428b875937bc4116d8d61e447","source":"\n\n/// Build the lazy compatibility logger used by existing proxy code.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"build_lazy","span":{"start":1606,"end":2243,"unit":"utf16","byteStart":1606,"byt