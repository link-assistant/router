ts","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":6,"preserved":7},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":70,"unit":"utf16","byteStart":0,"byteEnd":70},"sha256":"1cd08319fa50231799322c2a1e411db9f4cab097631cd43c2e13fd18791e8b10","source":"//! Unit tests for the shared token table ([`crate::token_report`]).\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"super","span":{"start":70,"end":83,"unit":"utf16","byteStart":70,"byteEnd":83},"sha256":"df1fb510b21459d3fb842c16a1910a058db28e02e19475bbcccf08b6ca3a0600","source":"use super::*;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":70,"end":83},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":83,"end":85,"unit":"utf16","byteStart":83,"byteEnd":85},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"record","span":{"start":85,"end":499,"unit":"utf16","byteStart":85,"byteEnd":499},"sha256":"9252a77fece8434f23d666e74917b35fd9054475de82307b5f1a1edb6585d59c","source":"fn record() -> Value {\n    serde_json::json!({\n        \"id\": \"tok-1\",\n        \"label\": \"ci\",\n        \"issued_at\": 1_700_000_000_i64,\n        \"expires_at\": 1_700_086_400_i64,\n        \"revoked\": false,\n        \"used_requests\": 7,\n        \"max_requests\": 100,\n        \"used_tokens\": 1_234,\n        \"max_tokens\": 50_000,\n        \"reserved_tokens\": 12,\n        \"rate_limit_per_minute\": 60,\n        \"scope\": \"\",\n    })\n}","status":"carried","diagnostic":{"kind":"syntax","message":"expected semicolon or final block value but found \"::\"","span":{"start":122,"end":124},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":499,"end":574,"unit":"utf16","byteStart":499,"byteEnd":574},"sha256":"024c3a6d5bd059f180ea531adbeedfcfa888532a020048678b1e098df93e6f3e","source":"\n\n/// The row carries every column an operator reads, in the local format.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"a_row_reports_usage_against_its_caps","span":{"start":574,"end":1018,"unit":"utf16","byteStart":574,"byteEnd":1018},"sha256":"c9c280f0806e6fbcc5e05297e4dd624e57265a2bda9135ad75811d4574e6ccc8","source":"#[test]\nfn a_row_reports_usage_against_its_caps() {\n    let line = row(&record());\n\n    assert!(line.contains(\"tok-1\"), \"{line}\");\n    assert!(line.contains(\"7/100\"), \"requests used over cap: {line}\");\n    assert!(line.contains(\"1234/50000\"), \"tokens used over cap: {line}\");\n    assert!(line.contains(\"60\"), \"the per-minute rate: {line}\");\n    assert!(\n        line.trim_end().ends_with(\"ci\"),\n        \"the label ends the row: {line}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":574,"end":580},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1018,"end":1197,"unit":"utf16","byteStart":1018,"byteEnd":1199},"sha256":"b131eeae80b0428c90409bc3651f05874acf5c0b66be45df26f8d0a8fdca0067","source":"\n\n/// An absent cap prints as unlimited rather than as zero.\n///\n/// `0/0` would read as a token that can make no requests at all — the opposite\n/// of what an omitted cap means.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_absent_cap_reads_as_unlimited","span":{"start":1197,"end":1682,"unit":"utf16","byteStart":1199,"byteEnd":1684},"sha256":"ec956be12e61422a7d87daa9addfe7cddcadd77c1df8e1c054371c86891fcd99","source":"#[test]\nfn an_absent_cap_reads_as_unlimited() {\n    let mut value = record();\n    value[\"max_requests\"] = Value::Null;\n    value[\"max_tokens\"] = Value::Null;\n    value[\"rate_limit_per_minute\"] = Value::Null;\n\n    let line = row(&value);\n\n    assert!(line.contains(\"7/-\"), \"an unlimited request cap: {line}\");\n    assert!(line.contains(\"1234/-\"), \"an unlimited token cap: {line}\");\n    assert!(\n        line.contains(\" - \"),\n        \"an unlimited rate prints as a dash: {line}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1197,"end":1203},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1682,"end":1746,"unit":"utf16","byteStart":1684,"byteEnd":1748},"sha256":"a4ddbb3ab68d5675075d9090dab64728c041e44c4006e77b71a984ba7eb74734","source":"\n\n/// An empty scope is the ordinary client token, and says so.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_empty_scope_reads_as_client","span":{"start":1746,"end":2048,"unit":"utf16","byteStart":1748,"byteEnd":2050},"sha256":"dbee78edc89c4ded3019bea136d2b77506f8be4ad705213b4c45106eaa0f520f","source":"#[test]\nfn an_empty_scope_reads_as_client() {\n    assert!(row(&record()).contains(\"client\"));\n\n    let mut admin = record();\n    admin[\"scope\"] = Value::String(\"admin\".into());\n    let line = row(&admin);\n    assert!(line.contains(\"admin\"), \"{line}\");\n    assert!(!line.contains(\"client\"), \"{line}\");\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":1746,"end":1752},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2048,"end":2249,"unit":"utf16","byteStart":2050,"byteEnd":2251},"sha256":"da644489b1f31a679b38f6e6cc67d9cc1b68fe85058f8bd399c96dbe2a8a64a4","source":"\n\n/// A record missing fields still renders a row rather than panicking.\n///\n/// The remote path receives whatever the deployment sends, which may be an\n/// older or newer shape than this build knows.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"an_unfamiliar_record_still_renders","span":{"start":2249,"end":2508,"unit":"utf16","byteStart":2251,"byteEnd":2510},"sha256":"7276adaffe420c89be54e1868e15b022458e3e1645757d8dd2fb729cf478e3c4","source":"#[test]\nfn an_unfamiliar_record_still_renders() {\n    let line = row(&serde_json::json!({\"id\": \"tok-2\"}));\n\n    assert!(line.contains(\"tok-2\"), \"{line}\");\n    assert!(\n        line.contains(\"0/-\"),\n        \"unknown usage is zero of unlimited: {line}\"\n    );\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"#[test]: attributes that change compilation are outside the portable core","span":{"start":2249,"end":2255},"details":{"construct":"#[test]"}},"comment":false},{"term":"trivia","name":null,"span":{"start":2508,"end":2509,"unit":"utf16","byteStart":2510,"byteEnd":2511},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
