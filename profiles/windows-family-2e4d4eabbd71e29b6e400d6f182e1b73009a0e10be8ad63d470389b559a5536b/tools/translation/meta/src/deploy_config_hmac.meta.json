emantics":{"integerEncoding":"BigInt with checked fixed-width arithmetic; usize/isize assume 64 bits","assumptions":["Rust integer arithmetic uses checked overflow behavior (debug/test profile); release wrapping arithmetic is outside this draft contract","String case conversion depends on the source and host Unicode tables","Concrete admitted constants require bounded checked evaluation with original parser source links; const fn runtime eligibility alone proves no all-input compile-time behavior","Immutable strings encode scalar values; monomorphic tagged values encode Option/Result; vectors/slices are immutable arrays"],"observation":"checked value results, local scalar mutation, immutable constructors, lazy future polling and named host effects; carried items supply no executable behavior"},"counts":{"executable":0,"executableFunctions":0,"executableConstants":0,"executableTypes":0,"executableConstructors":0,"carried":8,"preserved":9},"items":[{"term":"trivia","name":null,"span":{"start":0,"end":511,"unit":"utf16","byteStart":0,"byteEnd":511},"sha256":"4b3d1f94d1e78dcd67ad60bcc80890998ce63e5238244a76e7dd3fdf06153835","source":"//! Keyed fingerprints for deploy settings that must never be printed.\n//!\n//! A runtime environment value or a provider key changes the launch\n//! specification, so a deployment must notice the change and reconcile, yet\n//! neither may appear in a container label, a log or the JSON report. Both\n//! are identified by HMAC-SHA256 keyed by the deployment's `TOKEN_SECRET`,\n//! truncated to 128 bits: equal inputs give equal fingerprints, and nobody\n//! without the signing secret can test a guess against one.\n\n","status":"preserved","diagnostic":null,"comment":true},{"term":"use","name":"base64","span":{"start":511,"end":535,"unit":"utf16","byteStart":511,"byteEnd":535},"sha256":"fba22a38ecc8204e45578d20216001bbc89aca6ca9e18c4ee65ede9c92a3f478","source":"use base64::Engine as _;","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":511,"end":535},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":535,"end":536,"unit":"utf16","byteStart":535,"byteEnd":536},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"use","name":"jsonwebtoken","span":{"start":536,"end":579,"unit":"utf16","byteStart":536,"byteEnd":579},"sha256":"25cc1e4746925488f376c71fb841643a46b8342a8a708300a6739d51f45f5ef4","source":"use jsonwebtoken::{Algorithm, EncodingKey};","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":536,"end":579},"details":{}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":579,"end":581,"unit":"utf16","byteStart":579,"byteEnd":581},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"const","name":"ENV_CONTEXT","span":{"start":581,"end":669,"unit":"utf16","byteStart":581,"byteEnd":669},"sha256":"5515d3c44d397cef106a64cedb9d247e50ffcd3654b0e677b4e17669d4d6f4c1","source":"const ENV_CONTEXT: &[u8] = b\"link-assistant-router/deploy/runtime-env-fingerprint/v1\\0\";","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":581,"end":669,"unit":"utf16","byteStart":581,"byteEnd":669}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":669,"end":670,"unit":"utf16","byteStart":669,"byteEnd":670},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null},{"term":"const","name":"VALUE_CONTEXT","span":{"start":670,"end":761,"unit":"utf16","byteStart":670,"byteEnd":761},"sha256":"7c008b0df5fb80582c0724aecc3c18b5e28b110422c755f08c7399137c63a5b3","source":"const VALUE_CONTEXT: &[u8] = b\"link-assistant-router/deploy/provider-key-fingerprint/v1\\0\";","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":670,"end":761,"unit":"utf16","byteStart":670,"byteEnd":761}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":761,"end":821,"unit":"utf16","byteStart":761,"byteEnd":821},"sha256":"0a0d4ecbd5a33cdce3d2282fe0b13a6243d3b0d2d09476a471f7e6d996a4d4d2","source":"\n\n/// HMAC-SHA256 of `message` keyed by `key`, hex encoded.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"hmac_sha256_hex","span":{"start":821,"end":1229,"unit":"utf16","byteStart":821,"byteEnd":1229},"sha256":"1689c016e52ac28501ba9214583f20c868b35f5a44aab6f97a77d4bc6a398f7a","source":"#[must_use]\npub fn hmac_sha256_hex(key: &[u8], message: &[u8]) -> String {\n    let signature =\n        jsonwebtoken::crypto::sign(message, &EncodingKey::from_secret(key), Algorithm::HS256)\n            .expect(\"HMAC-SHA256 accepts any key\");\n    let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD\n        .decode(signature)\n        .expect(\"jsonwebtoken returns base64url\");\n    hex::encode(bytes)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":821,"end":1229,"unit":"utf16","byteStart":821,"byteEnd":1229}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1229,"end":1231,"unit":"utf16","byteStart":1229,"byteEnd":1231},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"truncated","span":{"start":1231,"end":1388,"unit":"utf16","byteStart":1231,"byteEnd":1388},"sha256":"497e00062f9e5450c7f89cec6d36cde1c62bb48e6c01c933cbbb39ffa81ec2a1","source":"fn truncated(key: &str, message: &[u8]) -> String {\n    let digest = hmac_sha256_hex(key.as_bytes(), message);\n    format!(\"hmac-sha256:{}\", &digest[..32])\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1231,"end":1388,"unit":"utf16","byteStart":1231,"byteEnd":1388}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":1388,"end":1677,"unit":"utf16","byteStart":1388,"byteEnd":1677},"sha256":"767221ab67afe09f82f66856e5f238cc8f17b33accf7d20cbbe42eb51e7b50f4","source":"\n\n/// Fingerprint of a runtime environment, `None` when it is empty.\n///\n/// Order-independent: the entries are sorted by name first. `None` for an\n/// empty environment keeps the launch specification of a deployment without\n/// passthrough exactly what it was before passthrough existed.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"env_fingerprint","span":{"start":1677,"end":2248,"unit":"utf16","byteStart":1677,"byteEnd":2248},"sha256":"b51e7f05b03a4f13f66d8eec2549f0ac64305c99e272541fc464e412ec3d7d5a","source":"#[must_use]\npub fn env_fingerprint(token_secret: &str, entries: &[(String, String)]) -> Option<String> {\n    if entries.is_empty() {\n        return None;\n    }\n    let mut sorted: Vec<&(String, String)> = entries.iter().collect();\n    sorted.sort_by(|left, right| left.0.cmp(&right.0));\n    let mut message = ENV_CONTEXT.to_vec();\n    for (name, value) in sorted {\n        message.extend_from_slice(name.as_bytes());\n        message.push(0);\n        message.extend_from_slice(value.as_bytes());\n        message.push(0);\n    }\n    Some(truncated(token_secret, &message))\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":1677,"end":2248,"unit":"utf16","byteStart":1677,"byteEnd":2248}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2248,"end":2316,"unit":"utf16","byteStart":2248,"byteEnd":2316},"sha256":"4e5a7efc8ab9d5e9d92ee5922358e123b1986521834fa37c248848c1b184c57a","source":"\n\n/// Fingerprint of one provider key, reported instead of the key.\n","status":"preserved","diagnostic":null},{"term":"fn","name":"value_fingerprint","span":{"start":2316,"end":2532,"unit":"utf16","byteStart":2316,"byteEnd":2532},"sha256":"3f866a5695933f3008c9fe3be78e66bc1a42449c407a6daa0f4b025bafe677ed","source":"#[must_use]\npub fn value_fingerprint(token_secret: &str, value: &str) -> String {\n    let mut message = VALUE_CONTEXT.to_vec();\n    message.extend_from_slice(value.as_bytes());\n    truncated(token_secret, &message)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2316,"end":2532,"unit":"utf16","byteStart":2316,"byteEnd":2532}},"comment":false,"configuration":{"status":"active","attributes":[{"name":"must_use","span":{"start":0,"end":11},"tokens":["#","[","must_use","]"],"evaluation":null}],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2532,"end":2533,"unit":"utf16","byteStart":2532,"byteEnd":2533},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
