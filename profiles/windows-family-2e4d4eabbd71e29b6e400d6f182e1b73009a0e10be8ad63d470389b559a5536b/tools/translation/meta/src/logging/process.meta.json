31e5d8ea8df5364b01","source":"pub fn data_dir() -> PathBuf {\n    DATA_DIR\n        .get()\n        .cloned()\n        .unwrap_or_else(crate::config::default_data_dir)\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":461,"end":596,"unit":"utf16","byteStart":461,"byteEnd":596}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":596,"end":598,"unit":"utf16","byteStart":596,"byteEnd":598},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"install","span":{"start":598,"end":2011,"unit":"utf16","byteStart":598,"byteEnd":2011},"sha256":"2c4222f2c467346ecacf30ad94dc2b840f59281c23c2383696269659ec2cd22a","source":"pub fn install(data_dir: &Path, verbose: bool, mut secrets: Vec<String>) -> std::io::Result<()> {\n    if LOG.get().is_some() {\n        return Ok(());\n    }\n    secrets.extend(std::env::vars_os().filter_map(|(name, value)| {\n        let name = name.to_string_lossy().to_ascii_uppercase();\n        ([\"TOKEN\", \"SECRET\", \"KEY\", \"COOKIE\", \"PASSWORD\"]\n            .iter()\n            .any(|suffix| name.ends_with(suffix)))\n        .then(|| value.to_string_lossy().into_owned())\n    }));\n    secrets.retain(|secret| secret.trim().len() >= 4);\n    secrets.sort_by_key(|secret| std::cmp::Reverse(secret.len()));\n    secrets.dedup();\n    let log = OperationalLog::open(&data_dir.join(\"logs\"), verbose, secrets)?;\n    let filter = super::env_filter(\n        verbose,\n        crate::operation_context::var(\"RUST_LOG\").ok().as_deref(),\n    );\n    let baseline = filter.to_string();\n    let (filter, handle) = tracing_subscriber::reload::Layer::new(filter);\n    tracing_subscriber::registry()\n        .with(filter)\n        .with(\n            tracing_subscriber::fmt::layer()\n                .with_writer(log.clone())\n                .with_ansi(false),\n        )\n        .try_init()\n        .map_err(std::io::Error::other)?;\n    let _ = super::runtime_debug::CONTROL\n        .set(super::runtime_debug::RuntimeDebug::new(handle, baseline));\n    let _ = DATA_DIR.set(data_dir.to_path_buf());\n    let _ = LOG.set(log);\n    Ok(())\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":598,"end":2011,"unit":"utf16","byteStart":598,"byteEnd":2011}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2011,"end":2013,"unit":"utf16","byteStart":2011,"byteEnd":2013},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"diagnostic","span":{"start":2013,"end":2495,"unit":"utf16","byteStart":2013,"byteEnd":2495},"sha256":"c7e305c3036931d92ddd892d9d5189985810b74570d30faad187efeec3d4ea43","source":"pub fn diagnostic(arguments: Arguments<'_>, quiet: bool) {\n    if let Some(log) = LOG.get() {\n        let record = format!(\"{} WARN {}\", chrono::Utc::now().to_rfc3339(), arguments);\n        let result = if quiet {\n            log.record(&record)\n        } else {\n            // Explicit command diagnostics already retain their console channel.\n            log.record_file(&record)\n        };\n        if let Err(error) = result {\n            write_failure(&error);\n        }\n    }\n}","status":"carried","diagnostic":{"kind":"module-binding","message":"body has no checked implementation in its resolved crate scope","span":{"start":2013,"end":2495,"unit":"utf16","byteStart":2013,"byteEnd":2495}},"comment":false,"configuration":{"status":"active","attributes":[],"diagnostics":[]}},{"term":"trivia","name":null,"span":{"start":2495,"end":2497,"unit":"utf16","byteStart":2495,"byteEnd":