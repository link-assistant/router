equires actual resolution","span":{"start":936,"end":966},"details":{"construct":"shadowed Result generic"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1046,"end":1048,"unit":"utf16","byteStart":1046,"byteEnd":1048},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"struct","name":"Violation","span":{"start":1048,"end":1104,"unit":"utf16","byteStart":1048,"byteEnd":1104},"sha256":"ce040e0e6ff1537a6c8be3f31211fb39312ee4b2e737aa2b886c97732ddb5596","source":"struct Violation {\n    file: String,\n    lines: usize,\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown type String","span":{"start":1077,"end":1083},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1104,"end":1106,"unit":"utf16","byteStart":1104,"byteEnd":1106},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":1106,"end":2774,"unit":"utf16","byteStart":1106,"byteEnd":2774},"sha256":"828864d2dda637c4da3f6aa6d09824956dc294269f0fd81ba8274ac7e5928da0","source":"fn main() {\n    println!(\"\\nChecking Rust files for maximum {} lines...\\n\", MAX_LINES);\n\n    let cwd = std::env::current_dir().expect(\"Failed to get current directory\");\n    let mut violations: Vec<Violation> = Vec::new();\n\n    for entry in WalkDir::new(&cwd)\n        .into_iter()\n        .filter_map(|e| e.ok())\n        .filter(|e| e.file_type().is_file())\n    {\n        let path = entry.path();\n\n        if should_exclude(path) {\n            continue;\n        }\n\n        if !has_valid_extension(path) {\n            continue;\n        }\n\n        match count_lines(path) {\n            Ok(line_count) => {\n                if line_count > MAX_LINES {\n                    let relative_path = path\n                        .strip_prefix(&cwd)\n                        .unwrap_or(path)\n                        .to_string_lossy()\n                        .to_string();\n                    violations.push(Violation {\n                        file: relative_path,\n                        lines: line_count,\n                    });\n                }\n            }\n            Err(e) => {\n                eprintln!(\"Warning: Could not read {}: {}\", path.display(), e);\n            }\n        }\n    }\n\n    if violations.is_empty() {\n        println!(\"All files are within the line limit\\n\");\n        exit(0);\n    } else {\n        println!(\"Found files exceeding the line limit:\\n\");\n        for violation in &violations {\n            println!(\n                \"  {}: {} lines (exceeds {})\",\n                violation.file, violation.lines, MAX_LINES\n            );\n        }\n        println!(\"\\nPlease refactor these files to be under {} lines\\n\", MAX_LINES);\n        exit(1);\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":1106,"end":2774},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2774,"end":2775,"unit":"utf16","byteStart":2774,"byteEnd":2775},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
