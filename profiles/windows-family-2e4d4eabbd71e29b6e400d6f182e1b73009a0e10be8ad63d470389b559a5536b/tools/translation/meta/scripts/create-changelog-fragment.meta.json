"kind":"unsupported","message":"draft item use: no supported library declaration emission","span":{"start":430,"end":446},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":446,"end":448,"unit":"utf16","byteStart":446,"byteEnd":448},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"get_arg","span":{"start":448,"end":807,"unit":"utf16","byteStart":448,"byteEnd":807},"sha256":"15bc817b347b32d3ef4acfc4b6d591c59bc867c1d2a0b89b9ba4751666b4ef5a","source":"fn get_arg(name: &str) -> Option<String> {\n    let args: Vec<String> = env::args().collect();\n    let flag = format!(\"--{}\", name);\n\n    if let Some(idx) = args.iter().position(|a| a == &flag) {\n        return args.get(idx + 1).cloned();\n    }\n\n    let env_name = name.to_uppercase().replace('-', \"_\");\n    env::var(&env_name).ok().filter(|s| !s.is_empty())\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":465,"end":469},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":807,"end":809,"unit":"utf16","byteStart":807,"byteEnd":809},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"get_category","span":{"start":809,"end":1024,"unit":"utf16","byteStart":809,"byteEnd":1024},"sha256":"075a067453244fa360b8cc8d9a9079155071e71b6e06c4367716aaace4bce272","source":"fn get_category(bump_type: &str) -> &'static str {\n    match bump_type {\n        \"major\" => \"### Breaking Changes\",\n        \"minor\" => \"### Added\",\n        \"patch\" => \"### Fixed\",\n        _ => \"### Changed\",\n    }\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"shadowed borrowed str type: requires actual standard primitive identity in the source type namespace","span":{"start":836,"end":840},"details":{"construct":"shadowed borrowed str type"}},"comment":false},{"term":"trivia","name":null,"span":{"start":1024,"end":1026,"unit":"utf16","byteStart":1024,"byteEnd":1026},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"generate_timestamp","span":{"start":1026,"end":1113,"unit":"utf16","byteStart":1026,"byteEnd":1113},"sha256":"acf75863266af520669d0dd216a54a38dd7c0a7c3c4f4675db9920447f8b27b2","source":"fn generate_timestamp() -> String {\n    Utc::now().format(\"%Y%m%d%H%M%S\").to_string()\n}","status":"carried","diagnostic":{"kind":"type","message":"unknown type String","span":{"start":1053,"end":1059},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":1113,"end":1115,"unit":"utf16","byteStart":1113,"byteEnd":1115},"sha256":"75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070","source":"\n\n","status":"preserved","diagnostic":null},{"term":"fn","name":"main","span":{"start":1115,"end":2629,"unit":"utf16","byteStart":1115,"byteEnd":2629},"sha256":"82928a6e6335282ca8e62f2ea00addee15677e565dc1bada0ef260f9e44b1a64","source":"fn main() {\n    let bump_type = get_arg(\"bump-type\").unwrap_or_else(|| \"patch\".to_string());\n    let description = get_arg(\"description\");\n\n    // Validate bump type\n    if ![\"major\", \"minor\", \"patch\"].contains(&bump_type.as_str()) {\n        eprintln!(\"Invalid bump type: {}. Must be major, minor, or patch.\", bump_type);\n        exit(1);\n    }\n\n    let changelog_dir = \"changelog.d\";\n    let timestamp = generate_timestamp();\n    let fragment_file = format!(\"{}/{}-manual-{}.md\", changelog_dir, timestamp, bump_type);\n\n    // Determine changelog category based on bump type\n    let category = get_category(&bump_type);\n\n    // Create changelog fragment with frontmatter\n    let description_text = description.unwrap_or_else(|| format!(\"Manual {} release\", bump_type));\n    let fragment_content = format!(\n        \"---\\nbump: {}\\n---\\n\\n{}\\n\\n- {}\\n\",\n        bump_type, category, description_text\n    );\n\n    // Ensure changelog.d directory exists\n    let dir_path = Path::new(changelog_dir);\n    if !dir_path.exists() {\n        if let Err(e) = fs::create_dir_all(dir_path) {\n            eprintln!(\"Error creating directory {}: {}\", changelog_dir, e);\n            exit(1);\n        }\n    }\n\n    // Write the fragment file\n    if let Err(e) = fs::write(&fragment_file, &fragment_content) {\n        eprintln!(\"Error writing fragment file: {}\", e);\n        exit(1);\n    }\n\n    println!(\"Created changelog fragment: {}\", fragment_file);\n    println!();\n    println!(\"Content:\");\n    println!(\"{}\", fragment_content);\n}","status":"carried","diagnostic":{"kind":"unsupported","message":"draft item fn: no supported library declaration emission","span":{"start":1115,"end":2629},"details":{}},"comment":false},{"term":"trivia","name":null,"span":{"start":2629,"end":2630,"unit":"utf16","byteStart":2629,"byteEnd":2630},"sha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","source":"\n","status":"preserved","diagnostic":null}]}
